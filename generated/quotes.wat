  (func (export "author_count") (result i32) (global.get $author_count))
  (func (export "record_count") (result i32) (global.get $record_count))
  (func (export "dedication_count") (result i32) (global.get $dedication_count))
  (func (export "schedule_base") (result i32) (global.get $schedule_base))
  (func (export "schedule_length") (result i32) (global.get $schedule_len))

  ;; fnv1a(ptr, len) -> 32-bit FNV-1a hash of a byte range
  (func $fnv1a (export "fnv1a") (param $ptr i32) (param $len i32) (result i32)
    (local $hash i32) (local $end i32)
    (local.set $hash (i32.const 0x811c9dc5))
    (local.set $end (i32.add (local.get $ptr) (local.get $len)))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $ptr) (local.get $end)))
        (local.set $hash
          (i32.mul (i32.xor (local.get $hash) (i32.load8_u (local.get $ptr)))
                   (i32.const 0x01000193)))
        (local.set $ptr (i32.add (local.get $ptr) (i32.const 1)))
        (br $next)))
    (local.get $hash))

  ;; ========================================================== init ==
  ;;  Runs once at instantiation. A corrupt header or string pool traps,
  ;;  so a module that instantiates is a module that can be trusted.

  (func $assert_ready
    (if (i32.eqz (global.get $ready)) (then (unreachable))))

  (func $init
    (if (i32.ne (i32.load (i32.const 0)) (global.get $MAGIC)) (then (unreachable)))
    (if (i32.ne (i32.load (i32.const 4)) (global.get $FORMAT)) (then (unreachable)))
    (global.set $quote_count   (i32.load (i32.const 8)))
    (global.set $author_count  (i32.load (i32.const 12)))
    (global.set $records       (i32.load (i32.const 16)))
    (global.set $pool          (i32.load (i32.const 20)))
    (global.set $pool_len      (i32.load (i32.const 24)))
    (global.set $schedule      (i32.load (i32.const 28)))
    (global.set $schedule_base (i32.load (i32.const 32)))
    (global.set $schedule_len  (i32.load (i32.const 36)))
    (global.set $scratch       (i32.load (i32.const 40)))
    (global.set $pool_fnv1a    (i32.load (i32.const 44)))
    (global.set $dedication_count (i32.load (i32.const 48)))
    (global.set $dedications      (i32.load (i32.const 52)))
    (global.set $record_count
      (i32.add (global.get $quote_count) (global.get $dedication_count)))
    (global.set $launch (i32.load (i32.const 56)))
    (global.set $legacy (i32.load (i32.const 60)))
    ;; grown: launched with fewer quotes than there are now (and at least 3)
    (global.set $grown
      (i32.and (i32.ge_u (global.get $legacy) (i32.const 3))
               (i32.lt_u (global.get $legacy) (global.get $quote_count))))
    (global.set $fresh_start (i32.add (global.get $launch) (global.get $legacy)))
    (global.set $cycle_start (i32.add (global.get $launch) (global.get $quote_count)))
    (global.set $locale_count (i32.load (i32.const 64)))
    (global.set $locales      (i32.load (i32.const 68)))
    ;; every locale block holds exactly the quotes and the dedications
    (if (i32.eqz (global.get $locale_count)) (then (unreachable)))
    (if (i32.ne (i32.load (i32.const 72)) (global.get $record_count)) (then (unreachable)))
