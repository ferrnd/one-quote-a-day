  (data (i32.const 154344) "Jean de La Bruy\c3\a8re") ;; a0131 pt-BR
  (data (i32.const 154363) "Prov\c3\a9rbio chin\c3\aas") ;; a0132 pt-BR
  (data (i32.const 154381) "Prov\c3\a9rbio africano") ;; a0133 pt-BR
  (data (i32.const 154400) "S\c3\aaneca") ;; a0147 pt-BR
  (data (i32.const 154407) "Martinho Lutero") ;; a0154 pt-BR
  (data (i32.const 154422) "Arist\c3\b3teles") ;; a0157 pt-BR
  (data (i32.const 154434) "C\c3\adcero") ;; a0158 pt-BR
  (data (i32.const 154441) "Fi\c3\b3dor Dostoi\c3\a9vski") ;; a0163 pt-BR
  (data (i32.const 154461) "Prov\c3\a9rbio") ;; a0166 pt-BR
  (data (i32.const 154471) "Prov\c3\a9rbio ingl\c3\aas") ;; a0167 pt-BR
  (data (i32.const 154489) "Pl\c3\adnio, o Velho") ;; a0174 pt-BR
  (data (i32.const 154505) "Salmos") ;; a0176 pt-BR
  (data (i32.const 154511) "Tertuliano") ;; a0180 pt-BR
  (data (i32.const 154521) "Prov\c3\a9rbio latino") ;; a0183 pt-BR
  (data (i32.const 154538) "Liev Tolst\c3\b3i") ;; a0194 pt-BR
  (data (i32.const 154551) "Marco Aur\c3\a9lio") ;; a0195 pt-BR
  (data (i32.const 154565) "Buda") ;; a0196 pt-BR
  (data (i32.const 154569) "S\c3\a3o Francisco de Sales") ;; a0207 pt-BR
  (data (i32.const 154592) "Epicteto") ;; a0220 pt-BR
  (data (i32.const 154600) "Pel\c3\a9") ;; a0238 pt-BR
  (data (i32.const 154605) "Est\c3\a9e Lauder") ;; a0240 pt-BR
  (data (i32.const 154618) "Prov\c3\a9rbio tanzaniano") ;; a0273 pt-BR
  (data (i32.const 154639) "Her\c3\a1clito") ;; a0274 pt-BR
  (data (i32.const 154649) "Hor\c3\a1cio") ;; a0282 pt-BR
  (data (i32.const 154657) "Prov\c3\a9rbio maori") ;; a0283 pt-BR
  (data (i32.const 154673) "Antoine de Saint-Exup\c3\a9ry") ;; a0287 pt-BR
  (data (i32.const 154698) "Publ\c3\adlio Siro") ;; a0297 pt-BR
  (data (i32.const 154712) "Epicuro") ;; a0298 pt-BR
  (data (i32.const 154719) "Prov\c3\a9rbio zen") ;; a0302 pt-BR
  (data (i32.const 154733) "Hillel, o Velho") ;; a0315 pt-BR
  (data (i32.const 154748) "Papa Jo\c3\a3o Paulo II") ;; a0325 pt-BR
  (data (i32.const 154767) "Prov\c3\a9rbio hass\c3\addico") ;; a0330 pt-BR
  (data (i32.const 154788) "Moli\c3\a8re") ;; a0347 pt-BR
  (data (i32.const 154796) "Santo Agostinho") ;; a0349 pt-BR
  (data (i32.const 154811) "Ov\c3\addio") ;; a0351 pt-BR
  (data (i32.const 154818) "Marqu\c3\aas de Vauvenargues") ;; a0355 pt-BR
  (data (i32.const 154842) "Prov\c3\a9rbio holand\c3\aas") ;; a0356 pt-BR
  (data (i32.const 154862) "Esopo") ;; a0358 pt-BR
  (data (i32.const 154867) "Prov\c3\a9rbio sua\c3\adli") ;; a0359 pt-BR
  (data (i32.const 154885) "Homero") ;; a0361 pt-BR
  (data (i32.const 154891) "Prov\c3\a9rbio turco") ;; a0365 pt-BR
  (data (i32.const 154907) "Prov\c3\a9rbio persa") ;; a0367 pt-BR
  (data (i32.const 154923) "An\c3\adbal") ;; a0416 pt-BR
  (data (i32.const 154930) "Joana d'Arc") ;; a0461 pt-BR
  (data (i32.const 154941) "Beyonc\c3\a9") ;; a0462 pt-BR
  (data (i32.const 154949) "Madre Teresa") ;; a0464 pt-BR
  (data (i32.const 154961) "SEALs da Marinha dos EUA") ;; a0471 pt-BR
  (data (i32.const 154985) "Paul Val\c3\a9ry") ;; a0495 pt-BR
  (data (i32.const 154997) "S\c3\b3crates") ;; a0496 pt-BR
  (data (i32.const 155006) "N\c3\a3o importa o qu\c3\a3o devagar voc\c3\aa v\c3\a1, desde que n\c3\a3o pare.") ;; #0000 pt-BR
  (data (i32.const 155066) "Caia sete vezes, levante-se oito.") ;; #0001 pt-BR
  (data (i32.const 155099) "Nossa maior gl\c3\b3ria n\c3\a3o est\c3\a1 em nunca cair, mas em nos levantarmos toda vez que ca\c3\admos.") ;; #0002 pt-BR
  (data (i32.const 155189) "Energia e persist\c3\aancia vencem todas as coisas.") ;; #0003 pt-BR
  (data (i32.const 155236) "Os rios sabem disso: n\c3\a3o h\c3\a1 pressa. Um dia chegaremos l\c3\a1.") ;; #0004 pt-BR
  (data (i32.const 155296) "Perseveran\c3\a7a n\c3\a3o \c3\a9 uma corrida longa; s\c3\a3o muitas corridas curtas, uma ap\c3\b3s a outra.") ;; #0005 pt-BR
  (data (i32.const 155384) "O rio atravessa a rocha n\c3\a3o por causa da sua for\c3\a7a, mas por causa da sua persist\c3\aancia.") ;; #0006 pt-BR
  (data (i32.const 155473) "Muitos dos fracassos da vida s\c3\a3o de pessoas que n\c3\a3o perceberam o qu\c3\a3o perto estavam do sucesso quando desistiram.") ;; #0007 pt-BR
  (data (i32.const 155589) "Ando devagar, mas nunca ando para tr\c3\a1s.") ;; #0008 pt-BR
  (data (i32.const 155629) "Grandes obras n\c3\a3o s\c3\a3o feitas pela for\c3\a7a, mas pela perseveran\c3\a7a.") ;; #0009 pt-BR
  (data (i32.const 155696) "A paci\c3\aancia e a perseveran\c3\a7a t\c3\aam um efeito m\c3\a1gico, diante do qual as dificuldades desaparecem e os obst\c3\a1culos se desfazem.") ;; #0010 pt-BR
  (data (i32.const 155823) "Pela perseveran\c3\a7a, muitas pessoas conquistam o sucesso a partir do que parecia destinado a ser um fracasso certo.") ;; #0011 pt-BR
  (data (i32.const 155937) "O esfor\c3\a7o cont\c3\adnuo, e n\c3\a3o a for\c3\a7a ou a intelig\c3\aancia, \c3\a9 a chave para libertar o nosso potencial.") ;; #0012 pt-BR
  (data (i32.const 156038) "A ambi\c3\a7\c3\a3o \c3\a9 o caminho para o sucesso. A persist\c3\aancia \c3\a9 o ve\c3\adculo em que voc\c3\aa chega l\c3\a1.") ;; #0013 pt-BR
  (data (i32.const 156132) "A diferen\c3\a7a entre uma pessoa bem-sucedida e as outras n\c3\a3o \c3\a9 falta de for\c3\a7a, nem falta de conhecimento, mas falta de vontade.") ;; #0014 pt-BR
  (data (i32.const 156260) "O sucesso \c3\a9 a soma de pequenos esfor\c3\a7os, repetidos dia ap\c3\b3s dia.") ;; #0015 pt-BR
  (data (i32.const 156327) "Tudo parece imposs\c3\advel at\c3\a9 que seja feito.") ;; #0016 pt-BR
  (data (i32.const 156371) "Nada neste mundo pode substituir a persist\c3\aancia.") ;; #0017 pt-BR
  (data (i32.const 156420) "A vit\c3\b3ria pertence aos mais perseverantes.") ;; #0018 pt-BR
  (data (i32.const 156463) "Com talento comum e perseveran\c3\a7a extraordin\c3\a1ria, tudo \c3\a9 poss\c3\advel.") ;; #0019 pt-BR
  (data (i32.const 156532) "As gotas de chuva furam a pedra n\c3\a3o pela viol\c3\aancia, mas por ca\c3\adrem sem cessar.") ;; #0020 pt-BR
  (data (i32.const 156613) "A maioria das coisas importantes do mundo foi conquistada por pessoas que continuaram tentando quando parecia n\c3\a3o haver esperan\c3\a7a nenhuma.") ;; #0021 pt-BR
  (data (i32.const 156753) "Const\c3\a2ncia, perseveran\c3\a7a e persist\c3\aancia apesar de todos os obst\c3\a1culos, des\c3\a2nimos e impossibilidades: \c3\a9 isso que, em tudo, distingue a alma forte da fraca.") ;; #0022 pt-BR
  (data (i32.const 156913) "Nunca desista, pois \c3\a9 justamente nesse lugar e nesse momento que a mar\c3\a9 vai virar.") ;; #0023 pt-BR
  (data (i32.const 156997) "A persist\c3\aancia pode transformar o fracasso em uma conquista extraordin\c3\a1ria.") ;; #0024 pt-BR
  (data (i32.const 157074) "Vence quem resiste.") ;; #0025 pt-BR
  (data (i32.const 157093) "A \c3\a1gua \c3\a9 fluida, macia e flex\c3\advel. Mas a \c3\a1gua desgasta a rocha, que \c3\a9 r\c3\adgida e n\c3\a3o consegue ceder.") ;; #0026 pt-BR
  (data (i32.const 157198) "Paralise a resist\c3\aancia com persist\c3\aancia.") ;; #0027 pt-BR
  (data (i32.const 157240) "O esfor\c3\a7o s\c3\b3 entrega toda a sua recompensa depois que a pessoa se recusa a desistir.") ;; #0028 pt-BR
  (data (i32.const 157326) "Paci\c3\aancia, persist\c3\aancia e suor formam uma combina\c3\a7\c3\a3o imbat\c3\advel para o sucesso.") ;; #0029 pt-BR
  (data (i32.const 157409) "Campe\c3\a3o \c3\a9 aquele que se levanta quando n\c3\a3o consegue.") ;; #0030 pt-BR
  (data (i32.const 157464) "Nunca se renda. Nunca, nunca, nunca, nunca.") ;; #0031 pt-BR
  (data (i32.const 157507) "O sucesso parece estar ligado \c3\a0 a\c3\a7\c3\a3o. Pessoas bem-sucedidas n\c3\a3o param de se mover.") ;; #0032 pt-BR
  (data (i32.const 157593) "Cada erro me deixa mais perto da pr\c3\b3xima rebatida certeira.") ;; #0033 pt-BR
  (data (i32.const 157653) "Simplesmente n\c3\a3o d\c3\a1 para vencer quem nunca desiste.") ;; #0034 pt-BR
  (data (i32.const 157706) "N\c3\a3o fique olhando o rel\c3\b3gio; fa\c3\a7a o que ele faz. Continue andando.") ;; #0035 pt-BR
  (data (i32.const 157775) "O que esperamos um dia fazer com facilidade, precisamos primeiro aprender a fazer com dedica\c3\a7\c3\a3o.") ;; #0036 pt-BR
  (data (i32.const 157873) "No confronto entre o riacho e a rocha, o riacho sempre vence, n\c3\a3o pela for\c3\a7a, mas pela perseveran\c3\a7a.") ;; #0037 pt-BR
  (data (i32.const 157976) "Resistir n\c3\a3o \c3\a9 s\c3\b3 a capacidade de suportar algo dif\c3\adcil, mas de transform\c3\a1-lo em gl\c3\b3ria.") ;; #0038 pt-BR
  (data (i32.const 158070) "Perseveran\c3\a7a, o segredo de todos os triunfos.") ;; #0039 pt-BR
  (data (i32.const 158116) "O caminho para o sucesso est\c3\a1 cheio de vagas tentadoras para estacionar.") ;; #0040 pt-BR
  (data (i32.const 158189) "Se voc\c3\aa caiu ontem, levante-se hoje.") ;; #0041 pt-BR
  (data (i32.const 158226) "Vou persistir at\c3\a9 vencer.") ;; #0042 pt-BR
  (data (i32.const 158252) "\c3\89 poss\c3\advel atravessar a montanha mais alta, um passo de cada vez.") ;; #0043 pt-BR
  (data (i32.const 158319) "Diamantes nada mais s\c3\a3o do que peda\c3\a7os de carv\c3\a3o que n\c3\a3o abandonaram o servi\c3\a7o.") ;; #0044 pt-BR
  (data (i32.const 158403) "Grandes coisas n\c3\a3o s\c3\a3o feitas por impulso, mas por uma s\c3\a9rie de pequenas coisas reunidas.") ;; #0045 pt-BR
  (data (i32.const 158495) "O g\c3\aanio \c3\a9 um por cento inspira\c3\a7\c3\a3o e noventa e nove por cento transpira\c3\a7\c3\a3o.") ;; #0046 pt-BR
  (data (i32.const 158575) "Quanto mais duro o conflito, mais glorioso o triunfo.") ;; #0047 pt-BR
  (data (i32.const 158628) "A persist\c3\aancia garante que os resultados sejam inevit\c3\a1veis.") ;; #0048 pt-BR
  (data (i32.const 158689) "A coragem nem sempre ruge. \c3\80s vezes, a coragem \c3\a9 a voz baixinha no fim do dia dizendo: amanh\c3\a3 eu tento de novo.") ;; #0049 pt-BR
  (data (i32.const 158803) "Aprendi que a coragem n\c3\a3o \c3\a9 a aus\c3\aancia do medo, mas o triunfo sobre ele.") ;; #0050 pt-BR
  (data (i32.const 158878) "Voc\c3\aa ganha for\c3\a7a, coragem e confian\c3\a7a a cada experi\c3\aancia em que realmente para e encara o medo de frente.") ;; #0051 pt-BR
  (data (i32.const 158987) "Coragem \c3\a9 resistir ao medo, dominar o medo, e n\c3\a3o a aus\c3\aancia de medo.") ;; #0052 pt-BR
  (data (i32.const 159059) "A vida encolhe ou se expande na propor\c3\a7\c3\a3o da nossa coragem.") ;; #0053 pt-BR
  (data (i32.const 159120) "\c3\89 preciso coragem para crescer e se tornar quem voc\c3\aa realmente \c3\a9.") ;; #0054 pt-BR
  (data (i32.const 159188) "A coragem \c3\a9, com raz\c3\a3o, considerada a primeira das qualidades humanas, porque \c3\a9 a qualidade que garante todas as outras.") ;; #0055 pt-BR
  (data (i32.const 159311) "O homem corajoso n\c3\a3o \c3\a9 aquele que n\c3\a3o sente medo, mas aquele que vence esse medo.") ;; #0056 pt-BR
  (data (i32.const 159395) "Tenha a coragem de seguir seu cora\c3\a7\c3\a3o e sua intui\c3\a7\c3\a3o.") ;; #0057 pt-BR
  (data (i32.const 159452) "Ser profundamente amado por algu\c3\a9m nos d\c3\a1 for\c3\a7a, enquanto amar algu\c3\a9m profundamente nos d\c3\a1 coragem.") ;; #0058 pt-BR
  (data (i32.const 159556) "Coragem \c3\a9 eleg\c3\a2ncia sob press\c3\a3o.") ;; #0059 pt-BR
  (data (i32.const 159591) "Quem n\c3\a3o tem coragem para correr riscos n\c3\a3o realizar\c3\a1 nada na vida.") ;; #0060 pt-BR
  (data (i32.const 159661) "S\c3\b3 quem se arrisca a ir longe demais consegue descobrir at\c3\a9 onde \c3\a9 poss\c3\advel chegar.") ;; #0061 pt-BR
  (data (i32.const 159748) "A sorte favorece os audazes.") ;; #0062 pt-BR
  (data (i32.const 159776) "A coragem \c3\a9 encontrada nos lugares mais improv\c3\a1veis.") ;; #0063 pt-BR
  (data (i32.const 159830) "At\c3\a9 a menor das pessoas pode mudar o rumo do futuro.") ;; #0064 pt-BR
  (data (i32.const 159883) "Tudo o que temos que decidir \c3\a9 o que fazer com o tempo que nos \c3\a9 dado.") ;; #0065 pt-BR
  (data (i32.const 159955) "\c3\89 preciso muita bravura para enfrentar nossos inimigos, mas tamb\c3\a9m \c3\a9 preciso o mesmo tanto para enfrentar nossos amigos.") ;; #0066 pt-BR
  (data (i32.const 160078) "Fa\c3\a7a aquilo que voc\c3\aa teme, e a morte do medo \c3\a9 certa.") ;; #0067 pt-BR
  (data (i32.const 160134) "O medo s\c3\b3 \c3\a9 t\c3\a3o profundo quanto a mente permite.") ;; #0068 pt-BR
  (data (i32.const 160185) "Tudo o que voc\c3\aa sempre quis est\c3\a1 do outro lado do medo.") ;; #0069 pt-BR
  (data (i32.const 160242) "A ina\c3\a7\c3\a3o gera d\c3\bavida e medo. A a\c3\a7\c3\a3o gera confian\c3\a7a e coragem.") ;; #0070 pt-BR
  (data (i32.const 160309) "Coragem \c3\a9 estar morrendo de medo e montar no cavalo mesmo assim.") ;; #0071 pt-BR
  (data (i32.const 160374) "N\c3\a3o tenho medo de tempestades, pois estou aprendendo a conduzir meu barco.") ;; #0072 pt-BR
  (data (i32.const 160449) "Um navio no porto est\c3\a1 seguro, mas n\c3\a3o \c3\a9 para isso que os navios s\c3\a3o feitos.") ;; #0073 pt-BR
  (data (i32.const 160529) "A caverna em que voc\c3\aa tem medo de entrar guarda o tesouro que voc\c3\aa procura.") ;; #0074 pt-BR
  (data (i32.const 160606) "A coragem \c3\a9 contagiosa. Quando um homem corajoso toma posi\c3\a7\c3\a3o, os outros costumam endireitar a coluna.") ;; #0075 pt-BR
  (data (i32.const 160711) "Nada na vida deve ser temido, apenas compreendido.") ;; #0076 pt-BR
  (data (i32.const 160761) "Bravura \c3\a9 a capacidade de agir bem mesmo quando se est\c3\a1 morrendo de medo.") ;; #0077 pt-BR
  (data (i32.const 160836) "Com coragem, voc\c3\aa ousar\c3\a1 correr riscos, ter\c3\a1 for\c3\a7a para ser compassivo e sabedoria para ser humilde.") ;; #0078 pt-BR
  (data (i32.const 160940) "Ningu\c3\a9m nasce necessariamente com coragem, mas todos nascem com potencial.") ;; #0079 pt-BR
  (data (i32.const 161015) "A coragem \c3\a9 a mais importante de todas as virtudes, porque sem coragem n\c3\a3o \c3\a9 poss\c3\advel praticar nenhuma outra virtude com const\c3\a2ncia.") ;; #0080 pt-BR
  (data (i32.const 161152) "A liberdade est\c3\a1 em ser ousado.") ;; #0081 pt-BR
  (data (i32.const 161184) "A \c3\banica coisa que devemos temer \c3\a9 o pr\c3\b3prio medo.") ;; #0082 pt-BR
  (data (i32.const 161236) "Coragem \c3\a9 saber o que n\c3\a3o temer.") ;; #0083 pt-BR
  (data (i32.const 161270) "Sinta o medo e fa\c3\a7a mesmo assim.") ;; #0084 pt-BR
  (data (i32.const 161303) "Seja ousado, e for\c3\a7as poderosas vir\c3\a3o em seu aux\c3\adlio.") ;; #0085 pt-BR
  (data (i32.const 161359) "N\c3\a3o h\c3\a1 paix\c3\a3o em jogar pequeno.") ;; #0086 pt-BR
  (data (i32.const 161393) "A coragem \c3\a9 como um m\c3\basculo: fica mais forte com o uso.") ;; #0087 pt-BR
  (data (i32.const 161450) "A vulnerabilidade \c3\a9 o ber\c3\a7o da inova\c3\a7\c3\a3o, da criatividade e da mudan\c3\a7a.") ;; #0088 pt-BR
  (data (i32.const 161525) "A coragem come\c3\a7a quando aparecemos e nos deixamos ser vistos.") ;; #0089 pt-BR
  (data (i32.const 161587) "N\c3\a3o tenha medo de abrir m\c3\a3o do bom para buscar o \c3\b3timo.") ;; #0090 pt-BR
  (data (i32.const 161645) "Ousar \c3\a9 perder o equil\c3\adbrio por um instante. N\c3\a3o ousar \c3\a9 perder a si mesmo.") ;; #0091 pt-BR
  (data (i32.const 161724) "N\c3\a3o \c3\a9 a montanha que conquistamos, mas a n\c3\b3s mesmos.") ;; #0092 pt-BR
  (data (i32.const 161779) "Salte, e a rede aparecer\c3\a1.") ;; #0093 pt-BR
  (data (i32.const 161806) "A seguran\c3\a7a \c3\a9, em grande parte, uma supersti\c3\a7\c3\a3o. A vida ou \c3\a9 uma aventura ousada, ou n\c3\a3o \c3\a9 nada.") ;; #0094 pt-BR
  (data (i32.const 161909) "O que seria da vida se n\c3\a3o tiv\c3\a9ssemos coragem de tentar nada?") ;; #0095 pt-BR
  (data (i32.const 161972) "\c3\89 muito melhor ousar coisas grandiosas e conquistar triunfos gloriosos, mesmo marcados por fracassos, do que se juntar aos pobres de esp\c3\adrito que nem desfrutam muito nem sofrem muito.") ;; #0096 pt-BR
  (data (i32.const 162157) "N\c3\a3o \c3\a9 o cr\c3\adtico que importa.") ;; #0097 pt-BR
  (data (i32.const 162188) "O m\c3\a9rito pertence a quem est\c3\a1 de fato na arena.") ;; #0098 pt-BR
  (data (i32.const 162237) "O medo tem dois significados: fugir de tudo ou enfrentar tudo e se erguer.") ;; #0099 pt-BR
  (data (i32.const 162311) "Medo \c3\a9 o que voc\c3\aa est\c3\a1 sentindo. Coragem \c3\a9 o que voc\c3\aa est\c3\a1 fazendo.") ;; #0100 pt-BR
  (data (i32.const 162384) "A coragem \c3\a9 tida como a maior de todas as virtudes, porque, sem ela, o homem n\c3\a3o tem garantia de preservar nenhuma outra.") ;; #0101 pt-BR
  (data (i32.const 162507) "A coragem \c3\a9 a escada pela qual todas as outras virtudes sobem.") ;; #0102 pt-BR
  (data (i32.const 162570) "A coragem n\c3\a3o \c3\a9 apenas uma das virtudes, mas a forma de todas as virtudes no momento da prova.") ;; #0103 pt-BR
  (data (i32.const 162666) "Coragem, querido cora\c3\a7\c3\a3o.") ;; #0104 pt-BR
  (data (i32.const 162693) "Coragem \c3\a9 a for\c3\a7a de abrir m\c3\a3o do que \c3\a9 familiar.") ;; #0105 pt-BR
  (data (i32.const 162746) "Eu n\c3\a3o fracassei. S\c3\b3 descobri 10 mil maneiras que n\c3\a3o funcionam.") ;; #0106 pt-BR
  (data (i32.const 162813) "O fracasso \c3\a9 apenas a oportunidade de come\c3\a7ar de novo, desta vez com mais intelig\c3\aancia.") ;; #0107 pt-BR
  (data (i32.const 162903) "J\c3\a1 tentou. J\c3\a1 fracassou. N\c3\a3o importa. Tente de novo. Fracasse de novo. Fracasse melhor.") ;; #0108 pt-BR
  (data (i32.const 162993) "Fracassei muitas e muitas e muitas vezes na vida. E \c3\a9 por isso que tenho sucesso.") ;; #0109 pt-BR
  (data (i32.const 163075) "S\c3\b3 quem ousa fracassar grandiosamente pode conquistar algo grandioso.") ;; #0110 pt-BR
  (data (i32.const 163145) "O fracasso \c3\a9 o tempero que d\c3\a1 sabor ao sucesso.") ;; #0111 pt-BR
  (data (i32.const 163194) "\c3\89 imposs\c3\advel viver sem fracassar em alguma coisa, a n\c3\a3o ser que voc\c3\aa viva com tanta cautela que seria como n\c3\a3o ter vivido.") ;; #0112 pt-BR
  (data (i32.const 163321) "O fundo do po\c3\a7o se tornou a base s\c3\b3lida sobre a qual reconstru\c3\ad minha vida.") ;; #0113 pt-BR
  (data (i32.const 163399) "N\c3\a3o me julgue pelo meu sucesso, julgue-me por quantas vezes ca\c3\ad e me levantei de novo.") ;; #0114 pt-BR
  (data (i32.const 163487) "O fracasso deve ser nosso professor, n\c3\a3o nosso coveiro.") ;; #0115 pt-BR
  (data (i32.const 163543) "S\c3\b3 existe uma coisa que torna um sonho imposs\c3\advel de realizar: o medo de fracassar.") ;; #0116 pt-BR
  (data (i32.const 163628) "O fracasso n\c3\a3o \c3\a9 o oposto do sucesso; ele faz parte do sucesso.") ;; #0117 pt-BR
  (data (i32.const 163693) "Voc\c3\aa constr\c3\b3i em cima do fracasso. Usa-o como degrau.") ;; #0118 pt-BR
  (data (i32.const 163748) "Um g\c3\aanio n\c3\a3o comete erros. Seus erros s\c3\a3o volunt\c3\a1rios e s\c3\a3o portais para a descoberta.") ;; #0119 pt-BR
  (data (i32.const 163839) "Desistir \c3\a9 a \c3\banica maneira garantida de fracassar.") ;; #0120 pt-BR
  (data (i32.const 163891) "Cada fracasso \c3\a9 um passo rumo ao sucesso.") ;; #0121 pt-BR
  (data (i32.const 163933) "A derrota n\c3\a3o \c3\a9 o pior dos fracassos. N\c3\a3o ter tentado \c3\a9 o verdadeiro fracasso.") ;; #0122 pt-BR
  (data (i32.const 164015) "Os fracassos s\c3\a3o placas indicando o caminho da realiza\c3\a7\c3\a3o.") ;; #0123 pt-BR
  (data (i32.const 164076) "A f\c3\aanix precisa queimar para renascer.") ;; #0124 pt-BR
  (data (i32.const 164115) "Somos todos fracassos; pelo menos os melhores de n\c3\b3s s\c3\a3o.") ;; #0125 pt-BR
  (data (i32.const 164174) "Consigo aceitar o fracasso, todo mundo fracassa em alguma coisa. Mas n\c3\a3o consigo aceitar n\c3\a3o tentar.") ;; #0126 pt-BR
  (data (i32.const 164276) "O sucesso n\c3\a3o \c3\a9 constru\c3\addo sobre o sucesso. \c3\89 constru\c3\addo sobre o fracasso. \c3\89 constru\c3\addo sobre a frustra\c3\a7\c3\a3o.") ;; #0127 pt-BR
  (data (i32.const 164392) "Vencedores n\c3\a3o t\c3\aam medo de perder. Perdedores t\c3\aam. O fracasso faz parte do processo do sucesso.") ;; #0128 pt-BR
  (data (i32.const 164490) "Um inventor fracassa 999 vezes, e se acerta uma, est\c3\a1 feito.") ;; #0129 pt-BR
  (data (i32.const 164551) "Repare que a \c3\a1rvore mais r\c3\adgida \c3\a9 a que se parte com mais facilidade, enquanto o bambu ou o salgueiro sobrevivem curvando-se ao vento.") ;; #0130 pt-BR
  (data (i32.const 164688) "N\c3\a3o tema o fracasso. O crime n\c3\a3o \c3\a9 fracassar, \c3\a9 mirar baixo.") ;; #0131 pt-BR
  (data (i32.const 164752) "O fracasso ensina. Quem realmente pensa aprende tanto com seus fracassos quanto com seus sucessos.") ;; #0132 pt-BR
  (data (i32.const 164850) "Nossa maior fraqueza est\c3\a1 em desistir. O jeito mais certo de vencer \c3\a9 sempre tentar s\c3\b3 mais uma vez.") ;; #0133 pt-BR
  (data (i32.const 164953) "Pessoas boas s\c3\a3o boas porque chegaram \c3\a0 sabedoria atrav\c3\a9s do fracasso.") ;; #0134 pt-BR
  (data (i32.const 165026) "O maior erro que voc\c3\aa pode cometer na vida \c3\a9 viver com medo de errar.") ;; #0135 pt-BR
  (data (i32.const 165097) "Se voc\c3\aa n\c3\a3o estiver disposto a errar, nunca vai criar nada original.") ;; #0136 pt-BR
  (data (i32.const 165167) "Experi\c3\aancia \c3\a9 simplesmente o nome que damos aos nossos erros.") ;; #0137 pt-BR
  (data (i32.const 165230) "Quando nos damos permiss\c3\a3o para fracassar, ao mesmo tempo nos damos permiss\c3\a3o para brilhar.") ;; #0138 pt-BR
  (data (i32.const 165323) "O \c3\banico erro de verdade \c3\a9 aquele com o qual n\c3\a3o aprendemos nada.") ;; #0139 pt-BR
  (data (i32.const 165390) "S\c3\b3 porque voc\c3\aa fracassou uma vez, n\c3\a3o quer dizer que vai fracassar em tudo.") ;; #0140 pt-BR
  (data (i32.const 165468) "Prefiro fracassar em algo que amo a ter sucesso em algo que odeio.") ;; #0141 pt-BR
  (data (i32.const 165534) "N\c3\a3o existe fracasso, a n\c3\a3o ser parar de tentar.") ;; #0142 pt-BR
  (data (i32.const 165583) "O fracasso nunca vai me alcan\c3\a7ar se a minha determina\c3\a7\c3\a3o de vencer for forte o bastante.") ;; #0143 pt-BR
  (data (i32.const 165674) "\c3\80s vezes \c3\a9 preciso lutar uma batalha mais de uma vez para venc\c3\aa-la.") ;; #0144 pt-BR
  (data (i32.const 165744) "Fracassar n\c3\a3o \c3\a9 fatal, mas fracassar em mudar pode ser.") ;; #0145 pt-BR
  (data (i32.const 165801) "Se voc\c3\aa aprende com a derrota, n\c3\a3o perdeu de verdade.") ;; #0146 pt-BR
  (data (i32.const 165856) "O mestre j\c3\a1 fracassou mais vezes do que o iniciante sequer tentou.") ;; #0147 pt-BR
  (data (i32.const 165923) "\c3\89 bom comemorar o sucesso, mas \c3\a9 mais importante prestar aten\c3\a7\c3\a3o \c3\a0s li\c3\a7\c3\b5es do fracasso.") ;; #0148 pt-BR
  (data (i32.const 166017) "Fracassando, a gente avan\c3\a7a rumo ao sucesso.") ;; #0149 pt-BR
  (data (i32.const 166062) "O fracasso \c3\a9 a chave do sucesso; cada erro nos ensina alguma coisa.") ;; #0150 pt-BR
  (data (i32.const 166130) "No caminho para o sucesso, voc\c3\aa sempre passa pelo fracasso.") ;; #0151 pt-BR
  (data (i32.const 166190) "O fracasso n\c3\a3o importa. \c3\89 preciso coragem para fazer papel de bobo.") ;; #0152 pt-BR
  (data (i32.const 166259) "O que \c3\a9 a derrota? Nada al\c3\a9m de aprendizado; nada al\c3\a9m do primeiro passo para algo melhor.") ;; #0153 pt-BR
  (data (i32.const 166352) "Nunca confunda uma \c3\banica derrota com uma derrota definitiva.") ;; #0154 pt-BR
  (data (i32.const 166413) "N\c3\a3o tenha vergonha dos seus fracassos; aprenda com eles e comece de novo.") ;; #0155 pt-BR
  (data (i32.const 166487) "Do sofrimento surgiram as almas mais fortes; os caracteres mais s\c3\b3lidos s\c3\a3o marcados por cicatrizes.") ;; #0156 pt-BR
  (data (i32.const 166589) "O carvalho lutou contra o vento e se quebrou; o salgueiro se curvou quando foi preciso e sobreviveu.") ;; #0157 pt-BR
  (data (i32.const 166689) "Embora o mundo esteja cheio de sofrimento, tamb\c3\a9m est\c3\a1 cheio da supera\c3\a7\c3\a3o dele.") ;; #0158 pt-BR
  (data (i32.const 166772) "O car\c3\a1ter n\c3\a3o se forma na tranquilidade e no sossego. S\c3\b3 pela experi\c3\aancia da prova\c3\a7\c3\a3o e do sofrimento a alma se fortalece, a ambi\c3\a7\c3\a3o se inspira e o sucesso \c3\a9 alcan\c3\a7ado.") ;; #0159 pt-BR
  (data (i32.const 166950) "A vida n\c3\a3o fica mais f\c3\a1cil nem mais generosa; n\c3\b3s \c3\a9 que ficamos mais fortes e mais resilientes.") ;; #0160 pt-BR
  (data (i32.const 167049) "N\c3\a3o pe\c3\a7a uma vida f\c3\a1cil; pe\c3\a7a for\c3\a7a para suportar uma vida dif\c3\adcil.") ;; #0161 pt-BR
  (data (i32.const 167122) "A capacidade humana de carregar peso \c3\a9 como o bambu: muito mais flex\c3\advel do que voc\c3\aa imaginaria \c3\a0 primeira vista.") ;; #0162 pt-BR
  (data (i32.const 167239) "O que me acontece pode me transformar. Mas eu me recuso a ser diminu\c3\adda por isso.") ;; #0163 pt-BR
  (data (i32.const 167321) "Voc\c3\aa pode enfrentar muitas derrotas, mas n\c3\a3o pode se deixar derrotar.") ;; #0164 pt-BR
  (data (i32.const 167392) "Ainda assim, como o ar, eu me levanto.") ;; #0165 pt-BR
  (data (i32.const 167430) "Ela ficou de p\c3\a9 na tempestade e, quando o vento n\c3\a3o soprou a seu favor, ajustou as velas.") ;; #0166 pt-BR
  (data (i32.const 167521) "Tempos dif\c3\adceis n\c3\a3o duram para sempre, mas pessoas fortes sim.") ;; #0167 pt-BR
  (data (i32.const 167585) "Onde n\c3\a3o h\c3\a1 luta, n\c3\a3o h\c3\a1 for\c3\a7a.") ;; #0168 pt-BR
  (data (i32.const 167621) "Transforme suas feridas em sabedoria.") ;; #0169 pt-BR
  (data (i32.const 167658) "Quando tudo parecer estar contra voc\c3\aa, lembre-se de que o avi\c3\a3o decola contra o vento, e n\c3\a3o a favor dele.") ;; #0170 pt-BR
  (data (i32.const 167767) "Das dificuldades nascem milagres.") ;; #0171 pt-BR
  (data (i32.const 167800) "A pedra preciosa n\c3\a3o pode ser polida sem atrito, nem o homem aperfei\c3\a7oado sem prova\c3\a7\c3\b5es.") ;; #0172 pt-BR
  (data (i32.const 167892) "Mar calmo n\c3\a3o faz bom marinheiro.") ;; #0173 pt-BR
  (data (i32.const 167926) "Minhas cicatrizes me lembram de que eu sobrevivi, sim, \c3\a0s minhas feridas mais profundas.") ;; #0174 pt-BR
  (data (i32.const 168015) "A for\c3\a7a n\c3\a3o vem da capacidade f\c3\adsica. Vem de uma vontade indom\c3\a1vel.") ;; #0175 pt-BR
  (data (i32.const 168086) "O mundo quebra todo mundo e, depois, muitos ficam fortes justamente nos lugares onde se quebraram.") ;; #0176 pt-BR
  (data (i32.const 168184) "O que n\c3\a3o me mata me fortalece.") ;; #0177 pt-BR
  (data (i32.const 168216) "Quem tem um porqu\c3\aa para viver suporta quase qualquer como.") ;; #0178 pt-BR
  (data (i32.const 168275) "Quando j\c3\a1 n\c3\a3o somos capazes de mudar uma situa\c3\a7\c3\a3o, somos desafiados a mudar a n\c3\b3s mesmos.") ;; #0179 pt-BR
  (data (i32.const 168369) "Tudo pode ser tirado de um homem, menos uma coisa: a \c3\baltima das liberdades humanas, a de escolher sua atitude diante de qualquer circunst\c3\a2ncia.") ;; #0180 pt-BR
  (data (i32.const 168514) "O bambu que se curva \c3\a9 mais forte que o carvalho que resiste.") ;; #0181 pt-BR
  (data (i32.const 168576) "As dificuldades muitas vezes preparam pessoas comuns para um destino extraordin\c3\a1rio.") ;; #0182 pt-BR
  (data (i32.const 168661) "Nossas feridas costumam ser as aberturas para a parte melhor e mais bonita de n\c3\b3s.") ;; #0183 pt-BR
  (data (i32.const 168744) "Resili\c3\aancia \c3\a9 aceitar sua nova realidade, mesmo que ela seja menos boa do que a que voc\c3\aa tinha antes.") ;; #0184 pt-BR
  (data (i32.const 168848) "O homem nunca criou um material t\c3\a3o resiliente quanto o esp\c3\adrito humano.") ;; #0185 pt-BR
  (data (i32.const 168922) "Luto e resili\c3\aancia caminham juntos.") ;; #0186 pt-BR
  (data (i32.const 168958) "O que importa n\c3\a3o \c3\a9 se voc\c3\aa \c3\a9 derrubado; \c3\a9 se voc\c3\aa se levanta.") ;; #0187 pt-BR
  (data (i32.const 169026) "N\c3\a3o importa o qu\c3\a3o forte voc\c3\aa bate. Importa o quanto voc\c3\aa aguenta apanhar e continuar seguindo em frente.") ;; #0188 pt-BR
  (data (i32.const 169135) "Boa parte da arte de viver \c3\a9 resili\c3\aancia.") ;; #0189 pt-BR
  (data (i32.const 169178) "Nada \c3\a9 imposs\c3\advel. A pr\c3\b3pria palavra, em ingl\c3\aas, diz: \22I'm possible\22, eu sou poss\c3\advel!") ;; #0190 pt-BR
  (data (i32.const 169269) "As estrelas n\c3\a3o brilham sem escurid\c3\a3o.") ;; #0191 pt-BR
  (data (i32.const 169309) "A ferida \c3\a9 o lugar por onde a Luz entra em voc\c3\aa.") ;; #0192 pt-BR
  (data (i32.const 169359) "Quando est\c3\a1 escuro o bastante, d\c3\a1 para ver as estrelas.") ;; #0193 pt-BR
  (data (i32.const 169416) "O fogo \c3\a9 a prova do ouro; a adversidade, a dos homens fortes.") ;; #0194 pt-BR
  (data (i32.const 169478) "As dificuldades fortalecem a mente, assim como o trabalho fortalece o corpo.") ;; #0195 pt-BR
  (data (i32.const 169554) "Embora ningu\c3\a9m possa voltar atr\c3\a1s e fazer um novo come\c3\a7o, qualquer um pode come\c3\a7ar agora e fazer um novo final.") ;; #0196 pt-BR
  (data (i32.const 169669) "Senti um medo absoluto em cada momento da minha vida e nunca deixei que isso me impedisse de fazer uma \c3\banica coisa que eu quisesse.") ;; #0197 pt-BR
  (data (i32.const 169801) "A tristeza \c3\a9 a forma como aprendemos a amar. Seu cora\c3\a7\c3\a3o n\c3\a3o est\c3\a1 se partindo. D\c3\b3i porque est\c3\a1 ficando maior.") ;; #0198 pt-BR
  (data (i32.const 169917) "Quando voc\c3\aa escolhe a esperan\c3\a7a, tudo \c3\a9 poss\c3\advel.") ;; #0199 pt-BR
  (data (i32.const 169970) "N\c3\a3o deixe que o que voc\c3\aa n\c3\a3o pode fazer atrapalhe o que voc\c3\aa pode fazer.") ;; #0200 pt-BR
  (data (i32.const 170046) "A melhor sa\c3\adda \c3\a9 sempre atravessar.") ;; #0201 pt-BR
  (data (i32.const 170083) "Em duas palavras posso resumir tudo o que aprendi sobre a vida: ela continua.") ;; #0202 pt-BR
  (data (i32.const 170160) "A vitalidade se revela n\c3\a3o s\c3\b3 na capacidade de persistir, mas na capacidade de recome\c3\a7ar.") ;; #0203 pt-BR
  (data (i32.const 170252) "Mas o homem n\c3\a3o foi feito para a derrota. Um homem pode ser destru\c3\addo, mas n\c3\a3o derrotado.") ;; #0204 pt-BR
  (data (i32.const 170344) "A vida nem sempre \c3\a9 uma quest\c3\a3o de ter boas cartas, mas, \c3\a0s vezes, de jogar bem uma m\c3\a3o ruim.") ;; #0205 pt-BR
  (data (i32.const 170441) "A esperan\c3\a7a \c3\a9 a coisa com penas que pousa na alma.") ;; #0206 pt-BR
  (data (i32.const 170493) "Tudo o que \c3\a9 feito no mundo \c3\a9 feito pela esperan\c3\a7a.") ;; #0207 pt-BR
  (data (i32.const 170547) "Esperan\c3\a7a \c3\a9 conseguir ver que existe luz apesar de toda a escurid\c3\a3o.") ;; #0208 pt-BR
  (data (i32.const 170618) "Devemos aceitar a decep\c3\a7\c3\a3o finita, mas nunca perder a esperan\c3\a7a infinita.") ;; #0209 pt-BR
  (data (i32.const 170694) "S\c3\b3 na escurid\c3\a3o voc\c3\aa consegue ver as estrelas.") ;; #0210 pt-BR
  (data (i32.const 170743) "At\c3\a9 a noite mais escura vai terminar, e o sol vai nascer.") ;; #0211 pt-BR
  (data (i32.const 170801) "O otimismo \c3\a9 a f\c3\a9 que leva \c3\a0 realiza\c3\a7\c3\a3o. Nada pode ser feito sem esperan\c3\a7a e confian\c3\a7a.") ;; #0212 pt-BR
  (data (i32.const 170895) "Mantenha os olhos nas estrelas e os p\c3\a9s no ch\c3\a3o.") ;; #0213 pt-BR
  (data (i32.const 170945) "A esperan\c3\a7a \c3\a9 um sonho acordado.") ;; #0214 pt-BR
  (data (i32.const 170979) "Enquanto h\c3\a1 vida, h\c3\a1 esperan\c3\a7a.") ;; #0215 pt-BR
  (data (i32.const 171013) "Existe algo de bom neste mundo, e vale a pena lutar por isso.") ;; #0216 pt-BR
  (data (i32.const 171074) "A esperan\c3\a7a \c3\a9 uma coisa boa, talvez a melhor das coisas, e nenhuma coisa boa jamais morre.") ;; #0217 pt-BR
  (data (i32.const 171166) "A hora mais escura tem s\c3\b3 sessenta minutos.") ;; #0218 pt-BR
  (data (i32.const 171210) "Nunca perca a esperan\c3\a7a. Tempestades deixam as pessoas mais fortes e nunca duram para sempre.") ;; #0219 pt-BR
  (data (i32.const 171304) "A esperan\c3\a7a sorri da porta do ano que vem, sussurrando: \22vai ser mais feliz\22.") ;; #0220 pt-BR
  (data (i32.const 171382) "Viver sem esperan\c3\a7a \c3\a9 deixar de viver.") ;; #0221 pt-BR
  (data (i32.const 171422) "Em todas as coisas, \c3\a9 melhor ter esperan\c3\a7a do que se desesperar.") ;; #0222 pt-BR
  (data (i32.const 171488) "A esperan\c3\a7a \c3\a9 importante porque pode tornar o momento presente menos dif\c3\adcil de suportar.") ;; #0223 pt-BR
  (data (i32.const 171580) "Por mais longo que seja o inverno, a primavera sempre vem depois.") ;; #0224 pt-BR
  (data (i32.const 171645) "H\c3\a1 males que v\c3\aam para o bem.") ;; #0225 pt-BR
  (data (i32.const 171675) "O pr\c3\b3prio sol \c3\a9 fraco quando nasce, e vai ganhando for\c3\a7a e coragem conforme o dia avan\c3\a7a.") ;; #0226 pt-BR
  (data (i32.const 171768) "A esperan\c3\a7a \c3\a9 a \c3\banica coisa mais forte que o medo.") ;; #0227 pt-BR
  (data (i32.const 171821) "A felicidade pode ser encontrada mesmo nos tempos mais sombrios, se a gente lembrar de acender a luz.") ;; #0228 pt-BR
  (data (i32.const 171922) "A esperan\c3\a7a come\c3\a7a no escuro: a esperan\c3\a7a teimosa de que, se voc\c3\aa simplesmente aparecer e tentar fazer a coisa certa, o amanhecer vir\c3\a1.") ;; #0229 pt-BR
  (data (i32.const 172062) "Deixe que suas esperan\c3\a7as, e n\c3\a3o suas m\c3\a1goas, moldem seu futuro.") ;; #0230 pt-BR
  (data (i32.const 172129) "A esperan\c3\a7a \c3\a9 renov\c3\a1vel: se ela acabar no fim do dia, voc\c3\aa pode recome\c3\a7ar de manh\c3\a3.") ;; #0231 pt-BR
  (data (i32.const 172218) "O que o oxig\c3\aanio \c3\a9 para os pulm\c3\b5es, a esperan\c3\a7a \c3\a9 para o sentido da vida.") ;; #0232 pt-BR
  (data (i32.const 172296) "O m\c3\adnimo que voc\c3\aa pode fazer na vida \c3\a9 descobrir pelo que voc\c3\aa espera.") ;; #0233 pt-BR
  (data (i32.const 172370) "N\c3\a3o h\c3\a1 rem\c3\a9dio como a esperan\c3\a7a, nem incentivo t\c3\a3o grande, nem t\c3\b4nico t\c3\a3o poderoso quanto a expectativa de algo melhor amanh\c3\a3.") ;; #0234 pt-BR
  (data (i32.const 172504) "A esperan\c3\a7a \c3\a9 o pilar que sustenta o mundo.") ;; #0235 pt-BR
  (data (i32.const 172549) "A esperan\c3\a7a nunca vai se calar.") ;; #0236 pt-BR
  (data (i32.const 172581) "O choro pode durar uma noite, mas a alegria vem pela manh\c3\a3.") ;; #0237 pt-BR
  (data (i32.const 172641) "Envelhe\c3\a7a comigo! O melhor ainda est\c3\a1 por vir.") ;; #0238 pt-BR
  (data (i32.const 172689) "N\c3\a3o \c3\a9 bom pensar que amanh\c3\a3 \c3\a9 um novo dia, ainda sem nenhum erro?") ;; #0239 pt-BR
  (data (i32.const 172758) "Afinal, amanh\c3\a3 \c3\a9 outro dia.") ;; #0240 pt-BR
  (data (i32.const 172787) "Esperan\c3\a7a \c3\a9 paci\c3\aancia com a lamparina acesa.") ;; #0241 pt-BR
  (data (i32.const 172834) "Estou preparado para o pior, mas espero o melhor.") ;; #0242 pt-BR
  (data (i32.const 172883) "Nunca precisamos perder a esperan\c3\a7a, porque nunca podemos ser quebrados sem conserto.") ;; #0243 pt-BR
  (data (i32.const 172969) "N\c3\a3o vamos lamentar; ao contr\c3\a1rio, vamos encontrar for\c3\a7a no que ficou.") ;; #0244 pt-BR
  (data (i32.const 173041) "Seja como o p\c3\a1ssaro que, ao pousar em um galho fr\c3\a1gil demais, sente-o ceder sob seus p\c3\a9s e, mesmo assim, canta, sabendo que tem asas.") ;; #0245 pt-BR
  (data (i32.const 173177) "Enquanto respiro, tenho esperan\c3\a7a.") ;; #0246 pt-BR
  (data (i32.const 173212) "Nem todo dia \c3\a9 bom, mas h\c3\a1 algo de bom em todo dia.") ;; #0247 pt-BR
  (data (i32.const 173265) "No auge do inverno, finalmente aprendi que dentro de mim havia um ver\c3\a3o invenc\c3\advel.") ;; #0248 pt-BR
  (data (i32.const 173350) "\c3\89 nos nossos momentos mais sombrios que precisamos nos concentrar para ver a luz.") ;; #0249 pt-BR
  (data (i32.const 173432) "O mundo \c3\a9 redondo, e o lugar que pode parecer o fim talvez seja apenas o come\c3\a7o.") ;; #0250 pt-BR
  (data (i32.const 173514) "A f\c3\a9 \c3\a9 o p\c3\a1ssaro que sente a luz e canta quando a madrugada ainda est\c3\a1 escura.") ;; #0251 pt-BR
  (data (i32.const 173596) "Por mais longa que seja a noite, o dia vai raiar.") ;; #0252 pt-BR
  (data (i32.const 173645) "Segure firme o chap\c3\a9u. Segure firme a esperan\c3\a7a. E d\c3\aa corda no rel\c3\b3gio, pois amanh\c3\a3 \c3\a9 outro dia.") ;; #0253 pt-BR
  (data (i32.const 173747) "H\c3\a1 coisas muito, muito melhores pela frente do que qualquer coisa que deixamos para tr\c3\a1s.") ;; #0254 pt-BR
  (data (i32.const 173838) "Apesar de tudo, ainda acredito que as pessoas s\c3\a3o boas de cora\c3\a7\c3\a3o.") ;; #0255 pt-BR
  (data (i32.const 173907) "Pense em toda a beleza que ainda existe ao seu redor e seja feliz.") ;; #0256 pt-BR
  (data (i32.const 173973) "Muitas vezes, \c3\a9 nos c\c3\a9us mais escuros que vemos as estrelas mais brilhantes.") ;; #0257 pt-BR
  (data (i32.const 174051) "For\c3\a7a e crescimento s\c3\b3 v\c3\aam com esfor\c3\a7o e luta cont\c3\adnuos.") ;; #0258 pt-BR
  (data (i32.const 174112) "Das suas vulnerabilidades vir\c3\a1 a sua for\c3\a7a.") ;; #0259 pt-BR
  (data (i32.const 174157) "A mulher \c3\a9 como um saquinho de ch\c3\a1: voc\c3\aa n\c3\a3o sabe o quanto ela \c3\a9 forte at\c3\a9 coloc\c3\a1-la na \c3\a1gua quente.") ;; #0260 pt-BR
  (data (i32.const 174265) "A for\c3\a7a \c3\a9 fruto da luta. Voc\c3\aa precisa fazer o que os outros n\c3\a3o fazem para conquistar o que os outros n\c3\a3o conquistam.") ;; #0261 pt-BR
  (data (i32.const 174387) "Os mais fortes de todos os guerreiros s\c3\a3o estes dois: o tempo e a paci\c3\aancia.") ;; #0262 pt-BR
  (data (i32.const 174465) "Ningu\c3\a9m pode fazer voc\c3\aa se sentir inferior sem o seu consentimento.") ;; #0263 pt-BR
  (data (i32.const 174534) "Voc\c3\aa tem poder sobre a sua mente, n\c3\a3o sobre os acontecimentos externos. Perceba isso, e voc\c3\aa encontrar\c3\a1 for\c3\a7a.") ;; #0264 pt-BR
  (data (i32.const 174649) "O obst\c3\a1culo \c3\a0 a\c3\a7\c3\a3o faz a a\c3\a7\c3\a3o avan\c3\a7ar. O que est\c3\a1 no caminho se torna o caminho.") ;; #0265 pt-BR
  (data (i32.const 174737) "Se algo externo o perturba, a dor n\c3\a3o vem da coisa em si, mas do valor que voc\c3\aa d\c3\a1 a ela; e isso voc\c3\aa tem o poder de mudar a qualquer momento.") ;; #0266 pt-BR
  (data (i32.const 174883) "N\c3\a3o perca mais tempo discutindo como um homem bom deveria ser. Seja um.") ;; #0267 pt-BR
  (data (i32.const 174955) "Seja como o rochedo contra o qual as ondas quebram sem parar: ele permanece firme e acalma a f\c3\baria das \c3\a1guas ao seu redor.") ;; #0268 pt-BR
  (data (i32.const 175079) "Grandes carvalhos nascem de pequenas bolotas.") ;; #0269 pt-BR
  (data (i32.const 175124) "N\c3\a3o \c3\a9 porque as coisas s\c3\a3o dif\c3\adceis que n\c3\a3o ousamos; \c3\a9 porque n\c3\a3o ousamos que elas s\c3\a3o dif\c3\adceis.") ;; #0270 pt-BR
  (data (i32.const 175229) "Sofremos mais vezes na imagina\c3\a7\c3\a3o do que na realidade.") ;; #0271 pt-BR
  (data (i32.const 175285) "Dominar os outros \c3\a9 for\c3\a7a. Dominar a si mesmo \c3\a9 o verdadeiro poder.") ;; #0272 pt-BR
  (data (i32.const 175355) "Ainda que algu\c3\a9m ven\c3\a7a mil vezes mil homens em batalha, o mais nobre vencedor \c3\a9 aquele que vence a si mesmo.") ;; #0273 pt-BR
  (data (i32.const 175466) "A for\c3\a7a est\c3\a1 nas diferen\c3\a7as, n\c3\a3o nas semelhan\c3\a7as.") ;; #0274 pt-BR
  (data (i32.const 175520) "Os fracos nunca conseguem perdoar. O perd\c3\a3o \c3\a9 atributo dos fortes.") ;; #0275 pt-BR
  (data (i32.const 175588) "A for\c3\a7a n\c3\a3o vem de vencer. S\c3\a3o as suas lutas que desenvolvem a sua for\c3\a7a.") ;; #0276 pt-BR
  (data (i32.const 175665) "A for\c3\a7a \c3\a9 uma quest\c3\a3o de mente decidida.") ;; #0277 pt-BR
  (data (i32.const 175708) "Sou o senhor do meu destino, sou o capit\c3\a3o da minha alma.") ;; #0278 pt-BR
  (data (i32.const 175766) "Agrade\c3\a7o aos deuses, sejam eles quais forem, pela minha alma invenc\c3\advel.") ;; #0279 pt-BR
  (data (i32.const 175840) "Her\c3\b3i \c3\a9 uma pessoa comum que encontra for\c3\a7a para perseverar e resistir apesar de obst\c3\a1culos esmagadores.") ;; #0280 pt-BR
  (data (i32.const 175948) "O que ficou para tr\c3\a1s e o que est\c3\a1 \c3\a0 nossa frente s\c3\a3o coisas pequenas comparadas ao que existe dentro de n\c3\b3s.") ;; #0281 pt-BR
  (data (i32.const 176062) "O maior teste de coragem na Terra \c3\a9 suportar a derrota sem perder o \c3\a2nimo.") ;; #0282 pt-BR
  (data (i32.const 176138) "De todas as virtudes que podemos aprender, nenhuma \c3\a9 mais \c3\batil, mais essencial para a sobreviv\c3\aancia e mais capaz de melhorar a qualidade de vida do que a capacidade de transformar a adversidade em um desafio prazeroso.") ;; #0283 pt-BR
  (data (i32.const 176359) "Se n\c3\a3o h\c3\a1 luta, n\c3\a3o h\c3\a1 progresso.") ;; #0284 pt-BR
  (data (i32.const 176396) "Seja a hero\c3\adna da sua vida, n\c3\a3o a v\c3\adtima.") ;; #0285 pt-BR
  (data (i32.const 176440) "Fique de p\c3\a9, de cabe\c3\a7a erguida, e perceba quem voc\c3\aa \c3\a9: algu\c3\a9m maior do que as suas circunst\c3\a2ncias.") ;; #0286 pt-BR
  (data (i32.const 176544) "Nunca abaixe a cabe\c3\a7a. Mantenha-a sempre erguida. Olhe o mundo nos olhos.") ;; #0287 pt-BR
  (data (i32.const 176618) "N\c3\a3o h\c3\a1 nada mais forte no mundo do que a delicadeza.") ;; #0288 pt-BR
  (data (i32.const 176672) "Nada \c3\a9 t\c3\a3o forte quanto a delicadeza, e nada \c3\a9 t\c3\a3o delicado quanto a verdadeira for\c3\a7a.") ;; #0289 pt-BR
  (data (i32.const 176763) "O carvalho dorme dentro da semente.") ;; #0290 pt-BR
  (data (i32.const 176798) "Com o novo dia v\c3\aam novas for\c3\a7as e novos pensamentos.") ;; #0291 pt-BR
  (data (i32.const 176852) "Nossa for\c3\a7a nasce das nossas fraquezas.") ;; #0292 pt-BR
  (data (i32.const 176892) "A fortaleza de \c3\a2nimo \c3\a9 a guardi\c3\a3 e o apoio das outras virtudes.") ;; #0293 pt-BR
  (data (i32.const 176958) "N\c3\a3o sou p\c3\a1ssaro, e nenhuma rede me prende: sou um ser humano livre, com vontade pr\c3\b3pria.") ;; #0294 pt-BR
  (data (i32.const 177049) "Minha miss\c3\a3o na vida n\c3\a3o \c3\a9 apenas sobreviver, mas florescer.") ;; #0295 pt-BR
  (data (i32.const 177112) "Voc\c3\aa n\c3\a3o pode hesitar sobre quem voc\c3\aa \c3\a9.") ;; #0296 pt-BR
  (data (i32.const 177156) "A forma mais comum de as pessoas abrirem m\c3\a3o do seu poder \c3\a9 achar que n\c3\a3o t\c3\aam nenhum.") ;; #0297 pt-BR
  (data (i32.const 177245) "Pense como uma rainha. Uma rainha n\c3\a3o tem medo de fracassar.") ;; #0298 pt-BR
  (data (i32.const 177306) "Descubra quem voc\c3\aa \c3\a9 e seja isso de prop\c3\b3sito.") ;; #0299 pt-BR
  (data (i32.const 177355) "Voc\c3\aa nunca deve ter medo do que est\c3\a1 fazendo quando \c3\a9 o certo.") ;; #0300 pt-BR
  (data (i32.const 177420) "Quando eles descem o n\c3\advel, n\c3\b3s subimos.") ;; #0301 pt-BR
  (data (i32.const 177462) "A habilidade pode levar voc\c3\aa ao topo, mas \c3\a9 preciso car\c3\a1ter para se manter l\c3\a1.") ;; #0302 pt-BR
  (data (i32.const 177544) "Quando n\c3\a3o h\c3\a1 inimigo dentro, os inimigos de fora n\c3\a3o podem ferir voc\c3\aa.") ;; #0303 pt-BR
  (data (i32.const 177619) "Nosso medo mais profundo n\c3\a3o \c3\a9 o de sermos inadequados. Nosso medo mais profundo \c3\a9 o de sermos poderosos al\c3\a9m da medida.") ;; #0304 pt-BR
  (data (i32.const 177743) "Confie em si mesmo: todo cora\c3\a7\c3\a3o vibra com essa corda de ferro.") ;; #0305 pt-BR
  (data (i32.const 177808) "\c3\89 voc\c3\aa quem tem as chaves do seu ser. \c3\89 voc\c3\aa quem carrega o passaporte para a sua pr\c3\b3pria felicidade.") ;; #0306 pt-BR
  (data (i32.const 177914) "Somos o que fazemos repetidamente. A excel\c3\aancia, ent\c3\a3o, n\c3\a3o \c3\a9 um ato, mas um h\c3\a1bito.") ;; #0307 pt-BR
  (data (i32.const 178003) "A disciplina \c3\a9 a ponte entre os objetivos e as conquistas.") ;; #0308 pt-BR
  (data (i32.const 178062) "Todos n\c3\b3s precisamos sofrer uma de duas dores: a dor da disciplina ou a dor do arrependimento.") ;; #0309 pt-BR
  (data (i32.const 178157) "A motiva\c3\a7\c3\a3o \c3\a9 o que faz voc\c3\aa come\c3\a7ar. O h\c3\a1bito \c3\a9 o que faz voc\c3\aa continuar.") ;; #0310 pt-BR
  (data (i32.const 178239) "O sucesso n\c3\a3o passa de algumas disciplinas simples, praticadas todos os dias.") ;; #0311 pt-BR
  (data (i32.const 178317) "N\c3\a3o deseje que fosse mais f\c3\a1cil; deseje ser melhor.") ;; #0312 pt-BR
  (data (i32.const 178370) "Ou voc\c3\aa comanda o dia, ou o dia comanda voc\c3\aa.") ;; #0313 pt-BR
  (data (i32.const 178417) "Com autodisciplina, quase tudo \c3\a9 poss\c3\advel.") ;; #0314 pt-BR
  (data (i32.const 178461) "O guerreiro bem-sucedido \c3\a9 um homem comum com um foco de laser.") ;; #0315 pt-BR
  (data (i32.const 178525) "N\c3\a3o temo o homem que praticou 10 mil chutes uma vez, mas temo o homem que praticou um chute 10 mil vezes.") ;; #0316 pt-BR
  (data (i32.const 178631) "Disciplina \c3\a9 escolher entre o que voc\c3\aa quer agora e o que voc\c3\aa mais quer.") ;; #0317 pt-BR
  (data (i32.const 178707) "Nenhum homem \c3\a9 livre se n\c3\a3o for senhor de si mesmo.") ;; #0318 pt-BR
  (data (i32.const 178760) "Primeiro diga a si mesmo o que voc\c3\aa quer ser; depois fa\c3\a7a o que precisa ser feito.") ;; #0319 pt-BR
  (data (i32.const 178844) "A autodisciplina \c3\a9 o poder m\c3\a1gico que torna voc\c3\aa praticamente impar\c3\a1vel.") ;; #0320 pt-BR
  (data (i32.const 178920) "O pre\c3\a7o da excel\c3\aancia \c3\a9 a disciplina. O custo da mediocridade \c3\a9 a decep\c3\a7\c3\a3o.") ;; #0321 pt-BR
  (data (i32.const 179001) "O esfor\c3\a7o vence o talento quando o talento n\c3\a3o se esfor\c3\a7a.") ;; #0322 pt-BR
  (data (i32.const 179062) "Pequenas disciplinas, repetidas com const\c3\a2ncia todos os dias, levam a grandes conquistas alcan\c3\a7adas devagar, com o tempo.") ;; #0323 pt-BR
  (data (i32.const 179185) "Voc\c3\aa nunca vai mudar sua vida at\c3\a9 mudar algo que faz diariamente.") ;; #0324 pt-BR
  (data (i32.const 179252) "A excel\c3\aancia \c3\a9 o resultado gradual de sempre se esfor\c3\a7ar para fazer melhor.") ;; #0325 pt-BR
  (data (i32.const 179330) "Campe\c3\b5es continuam jogando at\c3\a9 acertar.") ;; #0326 pt-BR
  (data (i32.const 179371) "Odiei cada minuto de treino, mas eu dizia: n\c3\a3o desista. Sofra agora e viva o resto da vida como campe\c3\a3o.") ;; #0327 pt-BR
  (data (i32.const 179477) "A luta \c3\a9 ganha ou perdida longe das testemunhas, nos bastidores, na academia e l\c3\a1 fora na estrada, muito antes de eu dan\c3\a7ar sob aquelas luzes.") ;; #0328 pt-BR
  (data (i32.const 179622) "N\c3\a3o conte os dias; fa\c3\a7a os dias contarem.") ;; #0329 pt-BR
  (data (i32.const 179665) "A dedica\c3\a7\c3\a3o faz os sonhos se realizarem.") ;; #0330 pt-BR
  (data (i32.const 179707) "Descanse no fim, n\c3\a3o no meio.") ;; #0331 pt-BR
  (data (i32.const 179737) "N\c3\a3o existem atalhos para nenhum lugar que valha a pena.") ;; #0332 pt-BR
  (data (i32.const 179793) "O \c3\banico lugar onde o sucesso vem antes do trabalho \c3\a9 no dicion\c3\a1rio.") ;; #0333 pt-BR
  (data (i32.const 179863) "Talento \c3\a9 mais barato que sal de cozinha. O que separa a pessoa talentosa da bem-sucedida \c3\a9 muito trabalho duro.") ;; #0334 pt-BR
  (data (i32.const 179977) "Amadores sentam e esperam a inspira\c3\a7\c3\a3o; o resto de n\c3\b3s simplesmente levanta e vai trabalhar.") ;; #0335 pt-BR
  (data (i32.const 180072) "Quanto mais eu treino, mais sorte eu tenho.") ;; #0336 pt-BR
  (data (i32.const 180115) "N\c3\a3o espere o ferro esquentar para malhar; esquente-o malhando.") ;; #0337 pt-BR
  (data (i32.const 180178) "O respeito pr\c3\b3prio \c3\a9 fruto da disciplina; o senso de dignidade cresce com a capacidade de dizer n\c3\a3o a si mesmo.") ;; #0338 pt-BR
  (data (i32.const 180292) "O que voc\c3\aa faz todos os dias importa mais do que o que voc\c3\aa faz de vez em quando.") ;; #0339 pt-BR
  (data (i32.const 180375) "Disciplina \c3\a9 liberdade.") ;; #0340 pt-BR
  (data (i32.const 180399) "Concentre todos os seus pensamentos no trabalho que tem em m\c3\a3os. Os raios do sol n\c3\a3o queimam at\c3\a9 serem concentrados em um foco.") ;; #0341 pt-BR
  (data (i32.const 180529) "Bem feito \c3\a9 melhor do que bem dito.") ;; #0342 pt-BR
  (data (i32.const 180565) "Tempo perdido nunca mais \c3\a9 encontrado.") ;; #0343 pt-BR
  (data (i32.const 180604) "Sem trabalho duro, nada cresce al\c3\a9m de ervas daninhas.") ;; #0344 pt-BR
  (data (i32.const 180659) "O sucesso nem sempre tem a ver com grandeza. Tem a ver com const\c3\a2ncia.") ;; #0345 pt-BR
  (data (i32.const 180730) "O sucesso n\c3\a3o \c3\a9 por acaso. \c3\89 trabalho duro, perseveran\c3\a7a, aprendizado, estudo, sacrif\c3\adcio e, acima de tudo, amor pelo que voc\c3\aa faz.") ;; #0346 pt-BR
  (data (i32.const 180867) "A vontade de vencer \c3\a9 importante, mas a vontade de se preparar \c3\a9 vital.") ;; #0347 pt-BR
  (data (i32.const 180940) "Nunca sonhei com o sucesso. Trabalhei por ele.") ;; #0348 pt-BR
  (data (i32.const 180986) "Nada vai funcionar se voc\c3\aa n\c3\a3o trabalhar.") ;; #0349 pt-BR
  (data (i32.const 181029) "O h\c3\a1bito \c3\a9 o melhor dos servos ou o pior dos patr\c3\b5es.") ;; #0350 pt-BR
  (data (i32.const 181085) "Primeiro criamos nossos h\c3\a1bitos, depois nossos h\c3\a1bitos nos criam.") ;; #0351 pt-BR
  (data (i32.const 181152) "\c3\89 o come\c3\a7o que faz a maioria das pessoas parar.") ;; #0352 pt-BR
  (data (i32.const 181201) "Treinar n\c3\a3o \c3\a9 o que voc\c3\aa faz depois que fica bom. \c3\89 o que voc\c3\aa faz para ficar bom.") ;; #0353 pt-BR
  (data (i32.const 181288) "Fa\c3\a7a hoje algo que o seu eu do futuro vai agradecer.") ;; #0354 pt-BR
  (data (i32.const 181341) "Concentre-se em ser produtivo, e n\c3\a3o em estar ocupado.") ;; #0355 pt-BR
  (data (i32.const 181396) "Disciplina \c3\a9 lembrar o que voc\c3\aa quer.") ;; #0356 pt-BR
  (data (i32.const 181435) "Fa\c3\a7a de cada dia a sua obra-prima.") ;; #0357 pt-BR
  (data (i32.const 181470) "Seja r\c3\a1pido, mas n\c3\a3o tenha pressa.") ;; #0358 pt-BR
  (data (i32.const 181506) "N\c3\a3o tenha medo de crescer devagar; tenha medo apenas de ficar parado.") ;; #0359 pt-BR
  (data (i32.const 181576) "O \c3\banico jeito de entender a mudan\c3\a7a \c3\a9 mergulhar nela, mover-se com ela e entrar na dan\c3\a7a.") ;; #0360 pt-BR
  (data (i32.const 181669) "A vida \c3\a9 como andar de bicicleta. Para manter o equil\c3\adbrio, \c3\a9 preciso continuar em movimento.") ;; #0361 pt-BR
  (data (i32.const 181765) "Dizem que o tempo muda as coisas, mas na verdade \c3\a9 voc\c3\aa quem precisa mud\c3\a1-las.") ;; #0362 pt-BR
  (data (i32.const 181846) "O progresso \c3\a9 imposs\c3\advel sem mudan\c3\a7a, e quem n\c3\a3o consegue mudar a pr\c3\b3pria mente n\c3\a3o consegue mudar nada.") ;; #0363 pt-BR
  (data (i32.const 181956) "A mudan\c3\a7a \c3\a9 a lei da vida. E quem olha apenas para o passado ou para o presente certamente vai perder o futuro.") ;; #0364 pt-BR
  (data (i32.const 182069) "O segredo da mudan\c3\a7a \c3\a9 concentrar toda a sua energia n\c3\a3o em lutar contra o velho, mas em construir o novo.") ;; #0365 pt-BR
  (data (i32.const 182178) "O que voc\c3\aa ganha ao alcan\c3\a7ar seus objetivos n\c3\a3o \c3\a9 t\c3\a3o importante quanto quem voc\c3\aa se torna ao alcan\c3\a7\c3\a1-los.") ;; #0366 pt-BR
  (data (i32.const 182292) "Crescer d\c3\b3i. Mudar d\c3\b3i. Mas nada d\c3\b3i tanto quanto ficar preso em um lugar ao qual voc\c3\aa n\c3\a3o pertence.") ;; #0367 pt-BR
  (data (i32.const 182397) "E chegou o dia em que o risco de continuar fechada em bot\c3\a3o foi mais doloroso do que o risco de florescer.") ;; #0368 pt-BR
  (data (i32.const 182504) "Estou sempre fazendo aquilo que n\c3\a3o sei fazer, para que eu possa aprender a faz\c3\aa-lo.") ;; #0369 pt-BR
  (data (i32.const 182590) "Se voc\c3\aa n\c3\a3o tentar fazer algo al\c3\a9m do que j\c3\a1 domina, nunca vai crescer.") ;; #0370 pt-BR
  (data (i32.const 182665) "Sabemos o que somos, mas n\c3\a3o sabemos o que podemos ser.") ;; #0371 pt-BR
  (data (i32.const 182721) "Nossas d\c3\bavidas s\c3\a3o traidoras e nos fazem perder o bem que muitas vezes poder\c3\adamos conquistar, pelo medo de tentar.") ;; #0372 pt-BR
  (data (i32.const 182838) "Se fiz\c3\a9ssemos todas as coisas de que somos capazes, ficar\c3\adamos literalmente impressionados com n\c3\b3s mesmos.") ;; #0373 pt-BR
  (data (i32.const 182947) "O melhor momento para plantar uma \c3\a1rvore foi 20 anos atr\c3\a1s. O segundo melhor momento \c3\a9 agora.") ;; #0374 pt-BR
  (data (i32.const 183043) "Fa\c3\a7a o que puder, com o que tiver, onde estiver.") ;; #0375 pt-BR
  (data (i32.const 183092) "Daqui a um ano, voc\c3\aa pode desejar ter come\c3\a7ado hoje.") ;; #0376 pt-BR
  (data (i32.const 183146) "Mude seus pensamentos e voc\c3\aa mudar\c3\a1 o seu mundo.") ;; #0377 pt-BR
  (data (i32.const 183196) "Voc\c3\aa n\c3\a3o pode mudar seu destino da noite para o dia, mas pode mudar sua dire\c3\a7\c3\a3o da noite para o dia.") ;; #0378 pt-BR
  (data (i32.const 183300) "Todo mundo pensa em mudar o mundo, mas ningu\c3\a9m pensa em mudar a si mesmo.") ;; #0379 pt-BR
  (data (i32.const 183374) "Melhorar \c3\a9 mudar; ser perfeito \c3\a9 mudar com frequ\c3\aancia.") ;; #0380 pt-BR
  (data (i32.const 183431) "O crescimento come\c3\a7a quando come\c3\a7amos a aceitar nossas pr\c3\b3prias fraquezas.") ;; #0381 pt-BR
  (data (i32.const 183508) "A maior descoberta da minha gera\c3\a7\c3\a3o \c3\a9 que o ser humano pode mudar sua vida mudando suas atitudes.") ;; #0382 pt-BR
  (data (i32.const 183608) "Voc\c3\aa nunca \c3\a9 velho demais para tra\c3\a7ar um novo objetivo ou sonhar um novo sonho.") ;; #0383 pt-BR
  (data (i32.const 183690) "Aja como se o que voc\c3\aa faz fizesse diferen\c3\a7a. Faz.") ;; #0384 pt-BR
  (data (i32.const 183742) "Aquilo que mais tememos fazer costuma ser o que mais precisamos fazer.") ;; #0385 pt-BR
  (data (i32.const 183812) "A zona de conforto \c3\a9 um lugar lindo, mas nada cresce l\c3\a1.") ;; #0386 pt-BR
  (data (i32.const 183870) "N\c3\a3o seguirei para onde o caminho levar; irei para onde n\c3\a3o h\c3\a1 caminho e deixarei uma trilha.") ;; #0387 pt-BR
  (data (i32.const 183965) "Tornar-se \c3\a9 melhor do que ser.") ;; #0388 pt-BR
  (data (i32.const 183996) "Nem tudo o que se enfrenta pode ser mudado, mas nada pode ser mudado enquanto n\c3\a3o for enfrentado.") ;; #0389 pt-BR
  (data (i32.const 184094) "Suas circunst\c3\a2ncias atuais n\c3\a3o determinam aonde voc\c3\aa pode chegar; apenas determinam de onde voc\c3\aa parte.") ;; #0390 pt-BR
  (data (i32.const 184201) "Um dia voc\c3\aa vai acordar e n\c3\a3o haver\c3\a1 mais tempo para fazer as coisas que sempre quis. Fa\c3\a7a agora.") ;; #0391 pt-BR
  (data (i32.const 184302) "Fa\c3\a7a o melhor que puder at\c3\a9 saber fazer melhor. Quando souber, fa\c3\a7a melhor.") ;; #0392 pt-BR
  (data (i32.const 184380) "O bonito de aprender \c3\a9 que ningu\c3\a9m pode tirar isso de voc\c3\aa.") ;; #0393 pt-BR
  (data (i32.const 184442) "A educa\c3\a7\c3\a3o \c3\a9 a arma mais poderosa que voc\c3\aa pode usar para mudar o mundo.") ;; #0394 pt-BR
  (data (i32.const 184518) "Quem n\c3\a3o vence algum medo todos os dias ainda n\c3\a3o aprendeu o segredo da vida.") ;; #0395 pt-BR
  (data (i32.const 184597) "A vida come\c3\a7a onde termina a sua zona de conforto.") ;; #0396 pt-BR
  (data (i32.const 184648) "N\c3\a3o posso mudar a dire\c3\a7\c3\a3o do vento, mas posso ajustar minhas velas para sempre chegar ao meu destino.") ;; #0397 pt-BR
  (data (i32.const 184752) "N\c3\a3o podemos nos tornar o que queremos continuando a ser o que somos.") ;; #0398 pt-BR
  (data (i32.const 184821) "De pouco em pouco, o pouco vira muito.") ;; #0399 pt-BR
  (data (i32.const 184859) "N\c3\a3o h\c3\a1 nada permanente, exceto a mudan\c3\a7a.") ;; #0400 pt-BR
  (data (i32.const 184903) "Ningu\c3\a9m entra duas vezes no mesmo rio, pois o rio j\c3\a1 n\c3\a3o \c3\a9 o mesmo, e a pessoa tamb\c3\a9m n\c3\a3o.") ;; #0401 pt-BR
  (data (i32.const 184999) "Sem crescimento e progresso cont\c3\adnuos, palavras como melhoria, conquista e sucesso n\c3\a3o t\c3\aam sentido.") ;; #0402 pt-BR
  (data (i32.const 185101) "O que h\c3\a1 de dar luz precisa suportar o fogo.") ;; #0403 pt-BR
  (data (i32.const 185146) "O que importa n\c3\a3o \c3\a9 o que acontece com voc\c3\aa, mas como voc\c3\aa reage a isso.") ;; #0404 pt-BR
  (data (i32.const 185222) "Comece agora mesmo a viver, e conte cada dia como uma vida \c3\a0 parte.") ;; #0405 pt-BR
  (data (i32.const 185290) "Comece de onde voc\c3\aa est\c3\a1. Use o que voc\c3\aa tem. Fa\c3\a7a o que voc\c3\aa pode.") ;; #0406 pt-BR
  (data (i32.const 185362) "Admiramos a beleza da borboleta, mas raramente reconhecemos as transforma\c3\a7\c3\b5es pelas quais ela passou para chegar a essa beleza.") ;; #0407 pt-BR
  (data (i32.const 185491) "N\c3\a3o \c3\a9 a esp\c3\a9cie mais forte que sobrevive, nem a mais inteligente, mas a que melhor se adapta \c3\a0 mudan\c3\a7a.") ;; #0408 pt-BR
  (data (i32.const 185599) "Quando abro m\c3\a3o do que sou, torno-me o que poderia ser.") ;; #0409 pt-BR
  (data (i32.const 185655) "N\c3\a3o adianta voltar ao dia de ontem, porque eu era outra pessoa.") ;; #0410 pt-BR
  (data (i32.const 185719) "A mudan\c3\a7a verdadeira, a que dura, acontece um passo de cada vez.") ;; #0411 pt-BR
  (data (i32.const 185784) "Aprendi que o caminho do progresso n\c3\a3o \c3\a9 r\c3\a1pido nem f\c3\a1cil.") ;; #0412 pt-BR
  (data (i32.const 185846) "A adversidade faz alguns homens se quebrarem; outros, quebrarem recordes.") ;; #0413 pt-BR
  (data (i32.const 185919) "A prosperidade n\c3\a3o est\c3\a1 livre de muitos medos e desgostos, e a adversidade n\c3\a3o est\c3\a1 livre de consolos e esperan\c3\a7as.") ;; #0414 pt-BR
  (data (i32.const 186039) "A adversidade \c3\a9 o primeiro caminho para a verdade.") ;; #0415 pt-BR
  (data (i32.const 186090) "As pipas sobem mais alto contra o vento, e n\c3\a3o a favor dele.") ;; #0416 pt-BR
  (data (i32.const 186151) "A adversidade tem o poder de despertar talentos que, em tempos de prosperidade, teriam ficado adormecidos.") ;; #0417 pt-BR
  (data (i32.const 186257) "O bloco de granito que era um obst\c3\a1culo no caminho dos fracos torna-se um degrau no caminho dos fortes.") ;; #0418 pt-BR
  (data (i32.const 186361) "Obst\c3\a1culos s\c3\a3o aquelas coisas assustadoras que voc\c3\aa v\c3\aa quando tira os olhos do seu objetivo.") ;; #0419 pt-BR
  (data (i32.const 186457) "Obst\c3\a1culos n\c3\a3o precisam parar voc\c3\aa. Se der de cara com um muro, n\c3\a3o d\c3\aa meia-volta nem desista. Descubra como escal\c3\a1-lo, atravess\c3\a1-lo ou contorn\c3\a1-lo.") ;; #0420 pt-BR
  (data (i32.const 186613) "Problemas n\c3\a3o s\c3\a3o placas de pare; s\c3\a3o placas de orienta\c3\a7\c3\a3o.") ;; #0421 pt-BR
  (data (i32.const 186677) "Vire o rosto para o sol, e as sombras ficar\c3\a3o para tr\c3\a1s.") ;; #0422 pt-BR
  (data (i32.const 186735) "O homem de car\c3\a1ter encontra uma atra\c3\a7\c3\a3o especial na dificuldade.") ;; #0423 pt-BR
  (data (i32.const 186802) "As dificuldades existem para despertar, n\c3\a3o para desanimar. O esp\c3\adrito humano foi feito para se fortalecer no conflito.") ;; #0424 pt-BR
  (data (i32.const 186923) "Se n\c3\a3o puder voar, corra; se n\c3\a3o puder correr, ande; se n\c3\a3o puder andar, rasteje; mas, fa\c3\a7a o que fizer, continue seguindo em frente.") ;; #0425 pt-BR
  (data (i32.const 187060) "A verdadeira medida de um homem n\c3\a3o \c3\a9 onde ele est\c3\a1 nos momentos de conforto e conveni\c3\aancia, mas onde ele est\c3\a1 nos tempos de desafio e controv\c3\a9rsia.") ;; #0426 pt-BR
  (data (i32.const 187214) "A escurid\c3\a3o n\c3\a3o pode expulsar a escurid\c3\a3o; s\c3\b3 a luz pode fazer isso.") ;; #0427 pt-BR
  (data (i32.const 187286) "F\c3\a9 \c3\a9 dar o primeiro passo mesmo sem ver a escada inteira.") ;; #0428 pt-BR
  (data (i32.const 187345) "N\c3\a3o h\c3\a1 escola como a adversidade.") ;; #0429 pt-BR
  (data (i32.const 187380) "As coisas que doem ensinam.") ;; #0430 pt-BR
  (data (i32.const 187407) "A adversidade \c3\a9 como um vento forte. Ela arranca de n\c3\b3s tudo, menos aquilo que n\c3\a3o pode ser arrancado, e assim nos vemos como realmente somos.") ;; #0431 pt-BR
  (data (i32.const 187552) "O que torna o deserto bonito \c3\a9 que, em algum lugar, ele esconde um po\c3\a7o.") ;; #0432 pt-BR
  (data (i32.const 187626) "O pessimista v\c3\aa dificuldade em cada oportunidade. O otimista v\c3\aa oportunidade em cada dificuldade.") ;; #0433 pt-BR
  (data (i32.const 187725) "Os desafios tornam a vida interessante, e super\c3\a1-los \c3\a9 o que d\c3\a1 sentido a ela.") ;; #0434 pt-BR
  (data (i32.const 187806) "A adversidade \c3\a9 o p\c3\b3 de diamante com que o C\c3\a9u lapida suas joias.") ;; #0435 pt-BR
  (data (i32.const 187874) "As tempestades fazem as \c3\a1rvores criarem ra\c3\adzes mais profundas.") ;; #0436 pt-BR
  (data (i32.const 187938) "Do jeito que eu vejo, se voc\c3\aa quer o arco-\c3\adris, tem que aguentar a chuva.") ;; #0437 pt-BR
  (data (i32.const 188013) "A vida n\c3\a3o \c3\a9 esperar a tempestade passar. \c3\89 aprender a dan\c3\a7ar na chuva.") ;; #0438 pt-BR
  (data (i32.const 188088) "A adversidade revela o g\c3\aanio; a prosperidade o esconde.") ;; #0439 pt-BR
  (data (i32.const 188144) "Quando a coisa aperta, os fortes entram em a\c3\a7\c3\a3o.") ;; #0440 pt-BR
  (data (i32.const 188194) "O her\c3\b3i n\c3\a3o \c3\a9 mais corajoso que um homem comum; ele s\c3\b3 \c3\a9 corajoso por cinco minutos a mais.") ;; #0441 pt-BR
  (data (i32.const 188290) "A pr\c3\b3pria luta rumo ao topo basta para encher o cora\c3\a7\c3\a3o de um homem. \c3\89 preciso imaginar S\c3\adsifo feliz.") ;; #0442 pt-BR
  (data (i32.const 188396) "\c3\80s vezes, a adversidade \c3\a9 justamente o que voc\c3\aa precisa enfrentar para ter sucesso.") ;; #0443 pt-BR
  (data (i32.const 188482) "Tempos dif\c3\adceis n\c3\a3o criam her\c3\b3is. \c3\89 nos tempos dif\c3\adceis que o her\c3\b3i dentro de n\c3\b3s se revela.") ;; #0444 pt-BR
  (data (i32.const 188581) "N\c3\a3o se sobe uma montanha a n\c3\a3o ser por caminhos sinuosos.") ;; #0445 pt-BR
  (data (i32.const 188640) "A dor \c3\a9 inevit\c3\a1vel. O sofrimento \c3\a9 opcional.") ;; #0446 pt-BR
  (data (i32.const 188687) "Problemas s\c3\a3o apenas oportunidades com roupa de trabalho.") ;; #0447 pt-BR
  (data (i32.const 188745) "A calamidade \c3\a9 a prova da integridade.") ;; #0448 pt-BR
  (data (i32.const 188784) "A prosperidade faz amigos; a adversidade os p\c3\b5e \c3\a0 prova.") ;; #0449 pt-BR
  (data (i32.const 188842) "Qualquer um consegue segurar o leme quando o mar est\c3\a1 calmo.") ;; #0450 pt-BR
  (data (i32.const 188903) "Quanto mais dura a batalha, mais doce a vit\c3\b3ria.") ;; #0451 pt-BR
  (data (i32.const 188952) "Doces s\c3\a3o os frutos da adversidade.") ;; #0452 pt-BR
  (data (i32.const 188988) "Toda adversidade, todo fracasso, toda dor no cora\c3\a7\c3\a3o traz consigo a semente de um benef\c3\adcio igual ou maior.") ;; #0453 pt-BR
  (data (i32.const 189098) "Quanto maior a dificuldade, maior a gl\c3\b3ria em super\c3\a1-la.") ;; #0454 pt-BR
  (data (i32.const 189156) "As dificuldades s\c3\a3o o que mostram a uma pessoa quem ela \c3\a9.") ;; #0455 pt-BR
  (data (i32.const 189216) "Nenhuma \c3\a1rvore cria ra\c3\adzes firmes sem que muitos ventos a sacudam.") ;; #0456 pt-BR
  (data (i32.const 189284) "\c3\89 um caminho \c3\a1spero o que leva \c3\a0s alturas da grandeza.") ;; #0457 pt-BR
  (data (i32.const 189341) "Caminhos dif\c3\adceis muitas vezes levam a destinos lindos.") ;; #0458 pt-BR
  (data (i32.const 189397) "No meio do caos, tamb\c3\a9m h\c3\a1 oportunidade.") ;; #0459 pt-BR
  (data (i32.const 189439) "O que nos parece uma prova\c3\a7\c3\a3o amarga muitas vezes \c3\a9 uma b\c3\aan\c3\a7\c3\a3o disfar\c3\a7ada.") ;; #0460 pt-BR
  (data (i32.const 189520) "Grandes esp\c3\adritos sempre enfrentaram oposi\c3\a7\c3\a3o violenta de mentes med\c3\adocres.") ;; #0461 pt-BR
  (data (i32.const 189599) "A dor passa, mas a beleza permanece.") ;; #0462 pt-BR
  (data (i32.const 189635) "As coisas d\c3\a3o mais certo para quem aproveita ao m\c3\a1ximo o jeito como as coisas acontecem.") ;; #0463 pt-BR
  (data (i32.const 189725) "Agora n\c3\a3o \c3\a9 hora de pensar no que voc\c3\aa n\c3\a3o tem. Pense no que pode fazer com o que tem.") ;; #0464 pt-BR
  (data (i32.const 189815) "O obst\c3\a1culo \c3\a9 o caminho.") ;; #0465 pt-BR
  (data (i32.const 189841) "A jornada de mil quil\c3\b4metros come\c3\a7a com um passo.") ;; #0466 pt-BR
  (data (i32.const 189892) "A a\c3\a7\c3\a3o \c3\a9 a chave fundamental de todo sucesso.") ;; #0467 pt-BR
  (data (i32.const 189940) "Voc\c3\aa n\c3\a3o precisa ser \c3\b3timo para come\c3\a7ar, mas precisa come\c3\a7ar para ser \c3\b3timo.") ;; #0468 pt-BR
  (data (i32.const 190022) "O jeito de come\c3\a7ar \c3\a9 parar de falar e come\c3\a7ar a fazer.") ;; #0469 pt-BR
  (data (i32.const 190079) "N\c3\a3o espere; o momento nunca ser\c3\a1 perfeito.") ;; #0470 pt-BR
  (data (i32.const 190123) "Saber n\c3\a3o basta; \c3\a9 preciso aplicar. Querer n\c3\a3o basta; \c3\a9 preciso fazer.") ;; #0471 pt-BR
  (data (i32.const 190197) "A a\c3\a7\c3\a3o nem sempre traz felicidade, mas n\c3\a3o existe felicidade sem a\c3\a7\c3\a3o.") ;; #0472 pt-BR
  (data (i32.const 190272) "Pensar n\c3\a3o vence o medo, mas agir vence.") ;; #0473 pt-BR
  (data (i32.const 190313) "Algum dia n\c3\a3o \c3\a9 um dia da semana.") ;; #0474 pt-BR
  (data (i32.const 190348) "Feito \c3\a9 melhor que perfeito.") ;; #0475 pt-BR
  (data (i32.const 190377) "Pequenos atos realizados valem mais que grandes atos planejados.") ;; #0476 pt-BR
  (data (i32.const 190441) "Voc\c3\aa erra 100% dos chutes que n\c3\a3o d\c3\a1.") ;; #0477 pt-BR
  (data (i32.const 190481) "A inspira\c3\a7\c3\a3o existe, mas ela precisa encontrar voc\c3\aa trabalhando.") ;; #0478 pt-BR
  (data (i32.const 190548) "Vis\c3\a3o sem a\c3\a7\c3\a3o \c3\a9 s\c3\b3 um sonho. A\c3\a7\c3\a3o sem vis\c3\a3o \c3\a9 s\c3\b3 passar o tempo. Vis\c3\a3o com a\c3\a7\c3\a3o pode mudar o mundo.") ;; #0479 pt-BR
  (data (i32.const 190661) "O futuro depende do que voc\c3\aa faz hoje.") ;; #0480 pt-BR
  (data (i32.const 190700) "Nunca deixe para amanh\c3\a3 o que voc\c3\aa pode fazer hoje.") ;; #0481 pt-BR
  (data (i32.const 190753) "Fa\c3\a7a as coisas dif\c3\adceis enquanto ainda s\c3\a3o f\c3\a1ceis, e as grandes enquanto ainda s\c3\a3o pequenas.") ;; #0482 pt-BR
  (data (i32.const 190850) "Come\c3\a7ar bem \c3\a9 metade do caminho.") ;; #0483 pt-BR
  (data (i32.const 190884) "Se voc\c3\aa passar tempo demais pensando em algo, nunca vai faz\c3\aa-lo.") ;; #0484 pt-BR
  (data (i32.const 190950) "O que voc\c3\aa faz fala t\c3\a3o alto que n\c3\a3o consigo ouvir o que voc\c3\aa diz.") ;; #0485 pt-BR
  (data (i32.const 191020) "Siga com confian\c3\a7a na dire\c3\a7\c3\a3o dos seus sonhos. Viva a vida que voc\c3\aa imaginou.") ;; #0486 pt-BR
  (data (i32.const 191101) "Se voc\c3\aa construiu castelos no ar, seu trabalho n\c3\a3o est\c3\a1 perdido; \c3\a9 l\c3\a1 que eles devem estar. Agora, coloque os alicerces embaixo deles.") ;; #0487 pt-BR
  (data (i32.const 191240) "Ideias s\c3\a3o f\c3\a1ceis. Dif\c3\adcil \c3\a9 coloc\c3\a1-las em pr\c3\a1tica.") ;; #0488 pt-BR
  (data (i32.const 191297) "Comece, seja ousado e arrisque-se a ser s\c3\a1bio.") ;; #0489 pt-BR
  (data (i32.const 191344) "Sonhe grande e ouse fracassar.") ;; #0490 pt-BR
  (data (i32.const 191374) "Nunca confunda movimento com a\c3\a7\c3\a3o.") ;; #0491 pt-BR
  (data (i32.const 191410) "N\c3\a3o deixe que o ontem ocupe espa\c3\a7o demais no hoje.") ;; #0492 pt-BR
  (data (i32.const 191462) "Mesmo que voc\c3\aa esteja no caminho certo, vai ser atropelado se ficar parado.") ;; #0493 pt-BR
  (data (i32.const 191538) "Uma ideia que n\c3\a3o vem acompanhada de a\c3\a7\c3\a3o nunca vai crescer al\c3\a9m da c\c3\a9lula cerebral que ocupou.") ;; #0494 pt-BR
  (data (i32.const 191638) "Conversa n\c3\a3o cozinha arroz.") ;; #0495 pt-BR
  (data (i32.const 191666) "Se n\c3\a3o agora, quando?") ;; #0496 pt-BR
  (data (i32.const 191688) "Para come\c3\a7ar, comece.") ;; #0497 pt-BR
  (data (i32.const 191710) "V\c3\a1 atr\c3\a1s do que conquista o seu cora\c3\a7\c3\a3o, n\c3\a3o do que chama a aten\c3\a7\c3\a3o dos seus olhos.") ;; #0498 pt-BR
  (data (i32.const 191800) "A vida \c3\a9 dez por cento o que acontece com voc\c3\aa e noventa por cento como voc\c3\aa reage a isso.") ;; #0499 pt-BR
  (data (i32.const 191893) "Se a oportunidade n\c3\a3o bater, construa uma porta.") ;; #0500 pt-BR
  (data (i32.const 191942) "A \c3\banica jornada imposs\c3\advel \c3\a9 aquela que voc\c3\aa nunca come\c3\a7a.") ;; #0501 pt-BR
  (data (i32.const 192005) "\c3\89 nos seus momentos de decis\c3\a3o que o seu destino \c3\a9 tra\c3\a7ado.") ;; #0502 pt-BR
  (data (i32.const 192068) "Definir metas \c3\a9 o primeiro passo para transformar o invis\c3\advel em vis\c3\advel.") ;; #0503 pt-BR
  (data (i32.const 192144) "Oportunidades n\c3\a3o acontecem. Voc\c3\aa as cria.") ;; #0504 pt-BR
  (data (i32.const 192188) "A d\c3\bavida mata mais sonhos do que o fracasso jamais matar\c3\a1.") ;; #0505 pt-BR
  (data (i32.const 192248) "N\c3\a3o se deixe levar pelos medos da sua mente. Deixe-se guiar pelos sonhos do seu cora\c3\a7\c3\a3o.") ;; #0506 pt-BR
  (data (i32.const 192339) "Coloque o cora\c3\a7\c3\a3o, a mente e a alma at\c3\a9 nos seus menores atos. Esse \c3\a9 o segredo do sucesso.") ;; #0507 pt-BR
  (data (i32.const 192434) "N\c3\a3o se atravessa o mar apenas ficando parado olhando para a \c3\a1gua.") ;; #0508 pt-BR
  (data (i32.const 192501) "O mais dif\c3\adcil \c3\a9 decidir agir; o resto \c3\a9 s\c3\b3 persist\c3\aancia.") ;; #0509 pt-BR
  (data (i32.const 192563) "O jeito mais eficaz de fazer \c3\a9 fazendo.") ;; #0510 pt-BR
  (data (i32.const 192603) "N\c3\a3o fique sentado esperando as oportunidades aparecerem. Levante-se e crie-as.") ;; #0511 pt-BR
  (data (i32.const 192682) "Que maravilhoso \c3\a9 que ningu\c3\a9m precise esperar um \c3\banico instante para come\c3\a7ar a melhorar o mundo.") ;; #0512 pt-BR
  (data (i32.const 192782) "Uma pessoa pode fazer a diferen\c3\a7a, e todos deveriam tentar.") ;; #0513 pt-BR
  (data (i32.const 192842) "Escolhemos ir \c3\a0 Lua nesta d\c3\a9cada, e fazer as outras coisas, n\c3\a3o porque s\c3\a3o f\c3\a1ceis, mas porque s\c3\a3o dif\c3\adceis.") ;; #0514 pt-BR
  (data (i32.const 192956) "As oportunidades se multiplicam \c3\a0 medida que s\c3\a3o aproveitadas.") ;; #0515 pt-BR
  (data (i32.const 193020) "Voc\c3\aa n\c3\a3o pode esperar pela inspira\c3\a7\c3\a3o. Precisa ir atr\c3\a1s dela com um porrete.") ;; #0516 pt-BR
  (data (i32.const 193101) "V\c3\a1 em frente agora. O futuro n\c3\a3o est\c3\a1 prometido a ningu\c3\a9m.") ;; #0517 pt-BR
  (data (i32.const 193163) "Dar o seu melhor neste momento coloca voc\c3\aa no melhor lugar para o pr\c3\b3ximo.") ;; #0518 pt-BR
  (data (i32.const 193239) "O futuro come\c3\a7a hoje, n\c3\a3o amanh\c3\a3.") ;; #0519 pt-BR
  (data (i32.const 193275) "Quer voc\c3\aa ache que consegue, quer ache que n\c3\a3o consegue, voc\c3\aa est\c3\a1 certo.") ;; #0520 pt-BR
  (data (i32.const 193352) "Acredite que voc\c3\aa consegue, e j\c3\a1 ter\c3\a1 percorrido metade do caminho.") ;; #0521 pt-BR
  (data (i32.const 193422) "Nossa vida \c3\a9 aquilo que nossos pensamentos fazem dela.") ;; #0522 pt-BR
  (data (i32.const 193477) "A felicidade da sua vida depende da qualidade dos seus pensamentos.") ;; #0523 pt-BR
  (data (i32.const 193544) "Muito pouco \c3\a9 necess\c3\a1rio para ter uma vida feliz; est\c3\a1 tudo dentro de voc\c3\aa, no seu modo de pensar.") ;; #0524 pt-BR
  (data (i32.const 193646) "Uma atitude positiva pode realmente fazer sonhos se tornarem realidade.") ;; #0525 pt-BR
  (data (i32.const 193717) "O otimismo \c3\a9 um \c3\adm\c3\a3 de felicidade.") ;; #0526 pt-BR
  (data (i32.const 193754) "As limita\c3\a7\c3\b5es s\c3\b3 existem na nossa mente. Mas, se usarmos a imagina\c3\a7\c3\a3o, nossas possibilidades se tornam ilimitadas.") ;; #0527 pt-BR
  (data (i32.const 193873) "O \c3\banico limite para realizarmos o amanh\c3\a3 ser\c3\a3o as nossas d\c3\bavidas de hoje.") ;; #0528 pt-BR
  (data (i32.const 193950) "O otimismo constante multiplica as for\c3\a7as.") ;; #0529 pt-BR
  (data (i32.const 193993) "Se voc\c3\aa ouvir uma voz dentro de voc\c3\aa dizendo que n\c3\a3o sabe pintar, pinte de qualquer jeito, e essa voz ser\c3\a1 silenciada.") ;; #0530 pt-BR
  (data (i32.const 194115) "Tudo o que a mente humana pode conceber e acreditar, ela pode conquistar.") ;; #0531 pt-BR
  (data (i32.const 194188) "Quem confia em si mesmo conquista a confian\c3\a7a dos outros.") ;; #0532 pt-BR
  (data (i32.const 194246) "Quando voc\c3\aa troca os pensamentos negativos por positivos, come\c3\a7a a ter resultados positivos.") ;; #0533 pt-BR
  (data (i32.const 194340) "Quando voc\c3\aa muda a forma de olhar para as coisas, as coisas para as quais voc\c3\aa olha mudam.") ;; #0534 pt-BR
  (data (i32.const 194432) "A felicidade n\c3\a3o \c3\a9 algo pronto. Ela vem das suas pr\c3\b3prias a\c3\a7\c3\b5es.") ;; #0535 pt-BR
  (data (i32.const 194501) "Acreditar em si mesmo e trabalhar duro sempre levam ao sucesso.") ;; #0536 pt-BR
  (data (i32.const 194564) "Muitos de n\c3\b3s n\c3\a3o est\c3\a3o vivendo seus sonhos porque est\c3\a3o vivendo seus medos.") ;; #0537 pt-BR
  (data (i32.const 194644) "Mire na Lua. Mesmo que erre, voc\c3\aa vai parar entre as estrelas.") ;; #0538 pt-BR
  (data (i32.const 194707) "N\c3\a3o importa para o que voc\c3\aa olha, mas o que voc\c3\aa enxerga.") ;; #0539 pt-BR
  (data (i32.const 194767) "N\c3\a3o sou produto das minhas circunst\c3\a2ncias. Sou produto das minhas decis\c3\b5es.") ;; #0540 pt-BR
  (data (i32.const 194845) "A confian\c3\a7a n\c3\a3o vem de estar sempre certo, mas de n\c3\a3o ter medo de errar.") ;; #0541 pt-BR
  (data (i32.const 194920) "Se voc\c3\aa quer se erguer, erga outra pessoa.") ;; #0542 pt-BR
  (data (i32.const 194963) "O sucesso n\c3\a3o deve ser medido tanto pela posi\c3\a7\c3\a3o que algu\c3\a9m alcan\c3\a7ou na vida, mas pelos obst\c3\a1culos que superou.") ;; #0543 pt-BR
  (data (i32.const 195080) "Excel\c3\aancia \c3\a9 fazer uma coisa comum de um jeito incomum.") ;; #0544 pt-BR
  (data (i32.const 195137) "O que voc\c3\aa pensa de si mesmo \c3\a9 muito mais importante do que o que os outros pensam de voc\c3\aa.") ;; #0545 pt-BR
  (data (i32.const 195231) "O homem \c3\a9 apenas o produto dos seus pensamentos. Ele se torna aquilo que pensa.") ;; #0546 pt-BR
  (data (i32.const 195311) "Se voc\c3\aa n\c3\a3o gosta de algo, mude. Se n\c3\a3o puder mudar, mude a sua atitude.") ;; #0547 pt-BR
  (data (i32.const 195386) "Dizem que a motiva\c3\a7\c3\a3o n\c3\a3o dura. Bem, o banho tamb\c3\a9m n\c3\a3o. \c3\89 por isso que recomendamos todos os dias.") ;; #0548 pt-BR
  (data (i32.const 195491) "Sua atitude, e n\c3\a3o sua aptid\c3\a3o, vai determinar a sua altitude.") ;; #0549 pt-BR
  (data (i32.const 195555) "O pensamento positivo permite que voc\c3\aa fa\c3\a7a tudo melhor do que o pensamento negativo.") ;; #0550 pt-BR
  (data (i32.const 195642) "O otimismo \c3\a9 a qualidade mais associada ao sucesso e \c3\a0 felicidade do que qualquer outra.") ;; #0551 pt-BR
  (data (i32.const 195732) "Acredite em voc\c3\aa! Tenha f\c3\a9 nas suas capacidades!") ;; #0552 pt-BR
  (data (i32.const 195782) "Voc\c3\aa precisa esperar grandes coisas de si mesmo antes de conseguir realiz\c3\a1-las.") ;; #0553 pt-BR
  (data (i32.const 195863) "Atribuo meu sucesso a isto: nunca dei nem aceitei desculpas.") ;; #0554 pt-BR
  (data (i32.const 195923) "A imagina\c3\a7\c3\a3o \c3\a9 mais importante que o conhecimento.") ;; #0555 pt-BR
  (data (i32.const 195976) "Aprendi ao longo dos anos que, quando a mente est\c3\a1 decidida, o medo diminui.") ;; #0556 pt-BR
  (data (i32.const 196053) "Voc\c3\aa precisa fazer as coisas que acha que n\c3\a3o consegue fazer.") ;; #0557 pt-BR
  (data (i32.const 196116) "Pensar com clareza exige mais coragem do que intelig\c3\aancia.") ;; #0558 pt-BR
  (data (i32.const 196175) "N\c3\a3o \c3\a9 o peso da carga que derruba voc\c3\aa, mas o jeito como voc\c3\aa a carrega.") ;; #0559 pt-BR
  (data (i32.const 196251) "Habilidade \c3\a9 o que voc\c3\aa \c3\a9 capaz de fazer. A motiva\c3\a7\c3\a3o determina o que voc\c3\aa faz. A atitude determina o qu\c3\a3o bem voc\c3\aa faz.") ;; #0560 pt-BR
  (data (i32.const 196379) "A preocupa\c3\a7\c3\a3o n\c3\a3o esvazia o amanh\c3\a3 da sua tristeza; esvazia o hoje da sua for\c3\a7a.") ;; #0561 pt-BR
  (data (i32.const 196464) "O homem n\c3\a3o se aflige tanto com os problemas reais quanto com as ansiedades que imagina sobre eles.") ;; #0562 pt-BR
  (data (i32.const 196564) "Se voc\c3\aa acha que est\c3\a1 derrotado, voc\c3\aa est\c3\a1.") ;; #0563 pt-BR
  (data (i32.const 196611) "Cedo ou tarde, quem vence \c3\a9 quem acredita que consegue.") ;; #0564 pt-BR
  (data (i32.const 196667) "N\c3\b3s nos tornamos aquilo em que pensamos.") ;; #0565 pt-BR
  (data (i32.const 196708) "Se voc\c3\aa vive tentando ser normal, nunca vai saber o qu\c3\a3o incr\c3\advel pode ser.") ;; #0566 pt-BR
  (data (i32.const 196786) "Ora, \c3\a0s vezes eu j\c3\a1 acreditei em at\c3\a9 seis coisas imposs\c3\adveis antes do caf\c3\a9 da manh\c3\a3.") ;; #0567 pt-BR
  (data (i32.const 196876) "O pior inimigo da criatividade \c3\a9 a d\c3\bavida sobre si mesmo.") ;; #0568 pt-BR
  (data (i32.const 196935) "Eu moro na possibilidade.") ;; #0569 pt-BR
  (data (i32.const 196960) "S\c3\a3o as nossas escolhas que mostram quem realmente somos, muito mais do que as nossas habilidades.") ;; #0570 pt-BR
  (data (i32.const 197058) "Olhe para as estrelas, e n\c3\a3o para os seus p\c3\a9s.") ;; #0571 pt-BR
  (data (i32.const 197106) "Por mais dif\c3\adcil que a vida pare\c3\a7a, sempre existe algo que voc\c3\aa pode fazer e em que pode ter sucesso.") ;; #0572 pt-BR
  (data (i32.const 197210) "N\c3\a3o tenho talentos especiais. Sou apenas apaixonadamente curioso.") ;; #0573 pt-BR
  (data (i32.const 197276) "N\c3\a3o tente se tornar um homem de sucesso, mas sim um homem de valor.") ;; #0574 pt-BR
  (data (i32.const 197344) "A paci\c3\aancia \c3\a9 amarga, mas seu fruto \c3\a9 doce.") ;; #0575 pt-BR
  (data (i32.const 197390) "Adote o ritmo da natureza: o segredo dela \c3\a9 a paci\c3\aancia.") ;; #0576 pt-BR
  (data (i32.const 197448) "A natureza n\c3\a3o tem pressa, e mesmo assim tudo se realiza.") ;; #0577 pt-BR
  (data (i32.const 197506) "As \c3\a1rvores que crescem devagar d\c3\a3o os melhores frutos.") ;; #0578 pt-BR
  (data (i32.const 197562) "O g\c3\aanio \c3\a9 a paci\c3\aancia eterna.") ;; #0579 pt-BR
  (data (i32.const 197594) "A paci\c3\aancia \c3\a9 companheira da sabedoria.") ;; #0580 pt-BR
  (data (i32.const 197635) "Quem tem paci\c3\aancia pode ter o que quiser.") ;; #0581 pt-BR
  (data (i32.const 197677) "Tenha paci\c3\aancia com todas as coisas, mas, antes de tudo, consigo mesmo.") ;; #0582 pt-BR
  (data (i32.const 197749) "Um momento de paci\c3\aancia pode evitar um grande desastre. Um momento de impaci\c3\aancia pode arruinar uma vida inteira.") ;; #0583 pt-BR
  (data (i32.const 197864) "Paci\c3\aancia n\c3\a3o \c3\a9 apenas a capacidade de esperar; \c3\a9 o modo como nos comportamos enquanto esperamos.") ;; #0584 pt-BR
  (data (i32.const 197965) "Roma n\c3\a3o foi constru\c3\adda em um dia.") ;; #0585 pt-BR
  (data (i32.const 198001) "Tudo vem aos poucos e na sua hora certa.") ;; #0586 pt-BR
  (data (i32.const 198041) "Seja paciente e firme; um dia essa dor vai lhe servir.") ;; #0587 pt-BR
  (data (i32.const 198095) "A \c3\a1gua que pinga fura a pedra, n\c3\a3o pela for\c3\a7a, mas pela persist\c3\aancia.") ;; #0588 pt-BR
  (data (i32.const 198168) "Toda a sabedoria humana se resume em duas palavras: esperar e ter esperan\c3\a7a.") ;; #0589 pt-BR
  (data (i32.const 198245) "A chave de tudo \c3\a9 a paci\c3\aancia. Voc\c3\aa consegue a galinha chocando o ovo, n\c3\a3o quebrando-o.") ;; #0590 pt-BR
  (data (i32.const 198336) "A paci\c3\aancia e o tempo fazem mais do que a for\c3\a7a ou a paix\c3\a3o.") ;; #0591 pt-BR
  (data (i32.const 198399) "Nossa paci\c3\aancia vai conquistar mais do que a nossa for\c3\a7a.") ;; #0592 pt-BR
  (data (i32.const 198458) "Como s\c3\a3o pobres os que n\c3\a3o t\c3\aam paci\c3\aancia! Que ferida j\c3\a1 sarou sen\c3\a3o aos poucos?") ;; #0593 pt-BR
  (data (i32.const 198543) "A paci\c3\aancia \c3\a9 a arte de ter esperan\c3\a7a.") ;; #0594 pt-BR
  (data (i32.const 198584) "Um punhado de paci\c3\aancia vale mais que um saco de intelig\c3\aancia.") ;; #0595 pt-BR
  (data (i32.const 198648) "A paci\c3\aancia tamb\c3\a9m \c3\a9 uma forma de a\c3\a7\c3\a3o.") ;; #0596 pt-BR
  (data (i32.const 198692) "Devagar e sempre se vence a corrida.") ;; #0597 pt-BR
  (data (i32.const 198728) "Com tempo e paci\c3\aancia, a folha da amoreira vira um vestido de seda.") ;; #0598 pt-BR
  (data (i32.const 198796) "A paci\c3\aancia atrai a felicidade; ela aproxima o que est\c3\a1 longe.") ;; #0599 pt-BR
  (data (i32.const 198860) "Perder a paci\c3\aancia \c3\a9 perder a batalha.") ;; #0600 pt-BR
  (data (i32.const 198900) "Paci\c3\aancia \c3\a9 poder. Paci\c3\aancia n\c3\a3o \c3\a9 aus\c3\aancia de a\c3\a7\c3\a3o; \c3\a9 saber o momento certo.") ;; #0601 pt-BR
  (data (i32.const 198986) "S\c3\a1bio para decidir e paciente para executar.") ;; #0602 pt-BR
  (data (i32.const 199031) "Sou extraordinariamente paciente, desde que, no fim, as coisas sejam do meu jeito.") ;; #0603 pt-BR
  (data (i32.const 199113) "Se voc\c3\aa tiver paci\c3\aancia em um momento de raiva, escapar\c3\a1 de cem dias de tristeza.") ;; #0604 pt-BR
  (data (i32.const 199197) "A paci\c3\aancia \c3\a9 o apoio da fraqueza; a impaci\c3\aancia, a ru\c3\adna da for\c3\a7a.") ;; #0605 pt-BR
  (data (i32.const 199269) "Resist\c3\aancia \c3\a9 paci\c3\aancia concentrada.") ;; #0606 pt-BR
  (data (i32.const 199308) "A paci\c3\aancia e a dedica\c3\a7\c3\a3o, como a f\c3\a9, movem montanhas.") ;; #0607 pt-BR
  (data (i32.const 199366) "Cuidado com a f\c3\baria de um homem paciente.") ;; #0608 pt-BR
  (data (i32.const 199408) "A paci\c3\aancia \c3\a9 a chave do para\c3\adso.") ;; #0609 pt-BR
  (data (i32.const 199444) "Tenha paci\c3\aancia com tudo o que ainda n\c3\a3o est\c3\a1 resolvido no seu cora\c3\a7\c3\a3o.") ;; #0610 pt-BR
  (data (i32.const 199520) "Nada grandioso \c3\a9 criado de repente.") ;; #0611 pt-BR
  (data (i32.const 199556) "Talvez um dia seja agrad\c3\a1vel lembrar at\c3\a9 disto.") ;; #0612 pt-BR
  (data (i32.const 199605) "Resistam e guardem-se para coisas melhores.") ;; #0613 pt-BR
  (data (i32.const 199648) "Aguente firme, meu cora\c3\a7\c3\a3o; voc\c3\aa j\c3\a1 suportou coisa pior.") ;; #0614 pt-BR
  (data (i32.const 199708) "Isso tamb\c3\a9m vai passar.") ;; #0615 pt-BR
  (data (i32.const 199732) "Nunca desista de um sonho s\c3\b3 por causa do tempo que ele vai levar para se realizar. O tempo vai passar de qualquer jeito.") ;; #0616 pt-BR
  (data (i32.const 199854) "Deixe que tudo lhe aconte\c3\a7a: a beleza e o terror. Apenas continue. Nenhum sentimento \c3\a9 definitivo.") ;; #0617 pt-BR
  (data (i32.const 199954) "Nenhum floco de neve cai no lugar errado.") ;; #0618 pt-BR
  (data (i32.const 199995) "Solte ou seja arrastado.") ;; #0619 pt-BR
  (data (i32.const 200019) "A determina\c3\a7\c3\a3o \c3\a9 o despertador da vontade humana.") ;; #0620 pt-BR
  (data (i32.const 200071) "A diferen\c3\a7a entre o imposs\c3\advel e o poss\c3\advel est\c3\a1 na determina\c3\a7\c3\a3o de uma pessoa.") ;; #0621 pt-BR
  (data (i32.const 200156) "Estabele\c3\a7a metas altas e n\c3\a3o pare at\c3\a9 chegar l\c3\a1.") ;; #0622 pt-BR
  (data (i32.const 200208) "O desejo \c3\a9 a chave da motiva\c3\a7\c3\a3o, mas s\c3\a3o a determina\c3\a7\c3\a3o e o compromisso com a busca incans\c3\a1vel do seu objetivo que permitir\c3\a3o alcan\c3\a7ar o sucesso que voc\c3\aa procura.") ;; #0623 pt-BR
  (data (i32.const 200380) "Os obst\c3\a1culos n\c3\a3o podem me esmagar. Todo obst\c3\a1culo cede diante de uma determina\c3\a7\c3\a3o firme.") ;; #0624 pt-BR
  (data (i32.const 200474) "N\c3\a3o fico desanimado, porque cada tentativa errada que descarto \c3\a9 mais um passo \c3\a0 frente.") ;; #0625 pt-BR
  (data (i32.const 200565) "Nunca deixe o medo de errar impedir voc\c3\aa de entrar no jogo.") ;; #0626 pt-BR
  (data (i32.const 200625) "Se voc\c3\aa n\c3\a3o consegue jogar melhor que eles, trabalhe mais que eles.") ;; #0627 pt-BR
  (data (i32.const 200694) "Acredito mesmo que um campe\c3\a3o n\c3\a3o se define pelas vit\c3\b3rias, mas por como consegue se recuperar quando cai.") ;; #0628 pt-BR
  (data (i32.const 200803) "Voc\c3\aa precisa acreditar em si mesmo quando ningu\c3\a9m mais acredita.") ;; #0629 pt-BR
  (data (i32.const 200869) "Quanto mais dif\c3\adcil a vit\c3\b3ria, maior a felicidade de vencer.") ;; #0630 pt-BR
  (data (i32.const 200931) "Medalhas de ouro n\c3\a3o s\c3\a3o feitas de ouro de verdade. S\c3\a3o feitas de suor, determina\c3\a7\c3\a3o e uma liga rara chamada coragem.") ;; #0631 pt-BR
  (data (i32.const 201053) "Idade n\c3\a3o \c3\a9 barreira. \c3\89 uma limita\c3\a7\c3\a3o que voc\c3\aa coloca na sua mente.") ;; #0632 pt-BR
  (data (i32.const 201126) "A diferen\c3\a7a entre o comum e o extraordin\c3\a1rio \c3\a9 aquele pequeno extra.") ;; #0633 pt-BR
  (data (i32.const 201197) "Vencer n\c3\a3o \c3\a9 tudo, mas querer vencer \c3\a9.") ;; #0634 pt-BR
  (data (i32.const 201239) "A perfei\c3\a7\c3\a3o n\c3\a3o \c3\a9 alcan\c3\a7\c3\a1vel, mas, se perseguirmos a perfei\c3\a7\c3\a3o, podemos alcan\c3\a7ar a excel\c3\aancia.") ;; #0635 pt-BR
  (data (i32.const 201343) "Depois que voc\c3\aa aprende a desistir, isso vira um h\c3\a1bito.") ;; #0636 pt-BR
  (data (i32.const 201401) "Hoje vou fazer o que os outros n\c3\a3o fazem, para que amanh\c3\a3 eu possa conquistar o que os outros n\c3\a3o conseguem.") ;; #0637 pt-BR
  (data (i32.const 201512) "Voc\c3\aa n\c3\a3o pode colocar limite em nada. Quanto mais voc\c3\aa sonha, mais longe chega.") ;; #0638 pt-BR
  (data (i32.const 201594) "H\c3\a1 quem largue melhor do que eu, mas eu termino forte.") ;; #0639 pt-BR
  (data (i32.const 201649) "Nada grandioso jamais foi alcan\c3\a7ado sem entusiasmo.") ;; #0640 pt-BR
  (data (i32.const 201701) "Prefiro ser cinzas a ser p\c3\b3!") ;; #0641 pt-BR
  (data (i32.const 201730) "Decida nunca ficar ocioso.") ;; #0642 pt-BR
  (data (i32.const 201756) "Um sonho n\c3\a3o vira realidade por m\c3\a1gica; \c3\a9 preciso suor, determina\c3\a7\c3\a3o e trabalho duro.") ;; #0643 pt-BR
  (data (i32.const 201846) "N\c3\a3o existem segredos para o sucesso. Ele \c3\a9 o resultado de prepara\c3\a7\c3\a3o, trabalho duro e aprendizado com o fracasso.") ;; #0644 pt-BR
  (data (i32.const 201963) "Nosso maior medo n\c3\a3o deveria ser o fracasso, mas ter sucesso em coisas da vida que n\c3\a3o importam de verdade.") ;; #0645 pt-BR
  (data (i32.const 202072) "Continue faminto, continue tolo.") ;; #0646 pt-BR
  (data (i32.const 202104) "Seu tempo \c3\a9 limitado, ent\c3\a3o n\c3\a3o o desperdice vivendo a vida de outra pessoa.") ;; #0647 pt-BR
  (data (i32.const 202183) "Se voc\c3\aa est\c3\a1 trabalhando em algo empolgante, com que realmente se importa, n\c3\a3o precisa ser empurrado. A vis\c3\a3o puxa voc\c3\aa.") ;; #0648 pt-BR
  (data (i32.const 202308) "O \c3\banico jeito de fazer um grande trabalho \c3\a9 amar o que voc\c3\aa faz.") ;; #0649 pt-BR
  (data (i32.const 202375) "Voc\c3\aa n\c3\a3o consegue ligar os pontos olhando para a frente; s\c3\b3 consegue lig\c3\a1-los olhando para tr\c3\a1s.") ;; #0650 pt-BR
  (data (i32.const 202476) "\c3\80s vezes a vida acerta sua cabe\c3\a7a com um tijolo. N\c3\a3o perca a f\c3\a9.") ;; #0651 pt-BR
  (data (i32.const 202544) "Quando algo \c3\a9 importante o bastante, voc\c3\aa faz, mesmo que as chances n\c3\a3o estejam a seu favor.") ;; #0652 pt-BR
  (data (i32.const 202639) "Tenha sempre em mente que a sua pr\c3\b3pria decis\c3\a3o de vencer \c3\a9 mais importante do que qualquer outra coisa.") ;; #0653 pt-BR
  (data (i32.const 202746) "A dor \c3\a9 tempor\c3\a1ria. Desistir \c3\a9 para sempre.") ;; #0654 pt-BR
  (data (i32.const 202792) "J\c3\a1 fiquei de p\c3\a9 sobre uma montanha de n\c3\a3os por um \c3\banico sim.") ;; #0655 pt-BR
  (data (i32.const 202856) "Tive que criar meu pr\c3\b3prio sustento e minha pr\c3\b3pria oportunidade. Mas consegui!") ;; #0656 pt-BR
  (data (i32.const 202937) "N\c3\a3o cheguei l\c3\a1 desejando ou esperando, mas trabalhando.") ;; #0657 pt-BR
  (data (i32.const 202994) "Lute pelas coisas com que voc\c3\aa se importa, mas fa\c3\a7a isso de um jeito que leve os outros a se juntarem a voc\c3\aa.") ;; #0658 pt-BR
  (data (i32.const 203106) "A vida n\c3\a3o \c3\a9 f\c3\a1cil para nenhum de n\c3\b3s. Mas e da\c3\ad? Precisamos ter perseveran\c3\a7a e, acima de tudo, confian\c3\a7a em n\c3\b3s mesmos.") ;; #0659 pt-BR
  (data (i32.const 203234) "Precisamos acreditar que temos um dom para alguma coisa e que essa coisa, custe o que custar, deve ser alcan\c3\a7ada.") ;; #0660 pt-BR
  (data (i32.const 203348) "Ningu\c3\a9m repara no que j\c3\a1 foi feito; s\c3\b3 se v\c3\aa o que ainda falta fazer.") ;; #0661 pt-BR
  (data (i32.const 203421) "Eu levanto minha voz n\c3\a3o para gritar, mas para que quem n\c3\a3o tem voz possa ser ouvido.") ;; #0662 pt-BR
  (data (i32.const 203508) "Uma crian\c3\a7a, um professor, um livro e uma caneta podem mudar o mundo.") ;; #0663 pt-BR
  (data (i32.const 203578) "Quando o mundo inteiro est\c3\a1 em sil\c3\aancio, at\c3\a9 uma \c3\banica voz se torna poderosa.") ;; #0664 pt-BR
  (data (i32.const 203659) "Porque ela est\c3\a1 l\c3\a1.") ;; #0665 pt-BR
  (data (i32.const 203680) "Este \c3\a9 um pequeno passo para um homem, um salto gigantesco para a humanidade.") ;; #0666 pt-BR
  (data (i32.const 203758) "N\c3\a3o me diga que o c\c3\a9u \c3\a9 o limite quando h\c3\a1 pegadas na Lua.") ;; #0667 pt-BR
  (data (i32.const 203820) "A Terra \c3\a9 o ber\c3\a7o da humanidade, mas a humanidade n\c3\a3o pode ficar no ber\c3\a7o para sempre.") ;; #0668 pt-BR
  (data (i32.const 203910) "Explorar \c3\a9, de fato, a ess\c3\aancia do esp\c3\adrito humano.") ;; #0669 pt-BR
  (data (i32.const 203964) "Guerreiros vitoriosos vencem primeiro e depois v\c3\a3o \c3\a0 guerra, enquanto guerreiros derrotados v\c3\a3o \c3\a0 guerra primeiro e depois tentam vencer.") ;; #0670 pt-BR
  (data (i32.const 204105) "Todos os nossos sonhos podem se tornar realidade, se tivermos coragem de persegui-los.") ;; #0671 pt-BR
  (data (i32.const 204191) "Primeiro, pense. Segundo, sonhe. Terceiro, acredite. E, por fim, ouse.") ;; #0672 pt-BR
  (data (i32.const 204261) "Um sonho que se sonha s\c3\b3 \c3\a9 s\c3\b3 um sonho. Um sonho que se sonha junto \c3\a9 realidade.") ;; #0673 pt-BR
  (data (i32.const 204345) "Agarre-se aos sonhos, pois, se os sonhos morrem, a vida \c3\a9 um p\c3\a1ssaro de asa quebrada que n\c3\a3o pode voar.") ;; #0674 pt-BR
  (data (i32.const 204451) "Os sonhos s\c3\a3o a pedra de toque do nosso car\c3\a1ter.") ;; #0675 pt-BR
  (data (i32.const 204501) "N\c3\a3o deixe ningu\c3\a9m roubar a sua imagina\c3\a7\c3\a3o, a sua criatividade ou a sua curiosidade.") ;; #0676 pt-BR
  (data (i32.const 204588) "Nunca deixe que suas lembran\c3\a7as sejam maiores que seus sonhos.") ;; #0677 pt-BR
  (data (i32.const 204651) "Todos os homens sonham, mas n\c3\a3o da mesma forma.") ;; #0678 pt-BR
  (data (i32.const 204699) "Os sonhos se realizam. Sem essa possibilidade, a natureza n\c3\a3o nos instigaria a t\c3\aa-los.") ;; #0679 pt-BR
  (data (i32.const 204787) "Cuide das suas vis\c3\b5es e dos seus sonhos como filhos da sua alma, as plantas das suas maiores conquistas.") ;; #0680 pt-BR
  (data (i32.const 204892) "O ponto de partida de toda conquista \c3\a9 o desejo.") ;; #0681 pt-BR
  (data (i32.const 204941) "Uma meta \c3\a9 um sonho com prazo.") ;; #0682 pt-BR
  (data (i32.const 204972) "\c3\89 a possibilidade de realizar um sonho que torna a vida interessante.") ;; #0683 pt-BR
  (data (i32.const 205042) "E, quando voc\c3\aa quer alguma coisa, todo o Universo conspira para que voc\c3\aa realize o seu desejo.") ;; #0684 pt-BR
  (data (i32.const 205138) "Sonhe como se fosse viver para sempre. Viva como se fosse morrer hoje.") ;; #0685 pt-BR
  (data (i32.const 205208) "A maior aventura que voc\c3\aa pode viver \c3\a9 a vida dos seus sonhos.") ;; #0686 pt-BR
  (data (i32.const 205272) "Mire alto, pois h\c3\a1 estrelas escondidas em voc\c3\aa. Sonhe fundo, pois todo sonho vem antes da meta.") ;; #0687 pt-BR
  (data (i32.const 205369) "Eu sonho minha pintura e pinto meu sonho.") ;; #0688 pt-BR
  (data (i32.const 205410) "Os sonhos n\c3\a3o funcionam se voc\c3\aa n\c3\a3o trabalhar.") ;; #0689 pt-BR
  (data (i32.const 205459) "Mantenha seus sonhos vivos. Entenda que conquistar qualquer coisa exige f\c3\a9 e confian\c3\a7a em si mesmo, vis\c3\a3o, trabalho duro, determina\c3\a7\c3\a3o e dedica\c3\a7\c3\a3o.") ;; #0690 pt-BR
  (data (i32.const 205613) "Se voc\c3\aa consegue imaginar, consegue realizar.") ;; #0691 pt-BR
  (data (i32.const 205659) "Os sonhadores s\c3\a3o os salvadores do mundo.") ;; #0692 pt-BR
  (data (i32.const 205701) "Sonhe sonhos elevados, e assim como voc\c3\aa sonha, assim voc\c3\aa se tornar\c3\a1.") ;; #0693 pt-BR
  (data (i32.const 205774) "Algumas pessoas sonham com o sucesso, enquanto outras acordam todas as manh\c3\a3s e fazem acontecer.") ;; #0694 pt-BR
  (data (i32.const 205871) "Eu tenho um sonho.") ;; #0695 pt-BR
  (data (i32.const 205889) "O que hoje est\c3\a1 provado um dia foi apenas imaginado.") ;; #0696 pt-BR
  (data (i32.const 205942) "Mire na Lua. Se errar, pode acertar uma estrela.") ;; #0697 pt-BR
  (data (i32.const 205990) "Nada acontece sem que antes a gente sonhe.") ;; #0698 pt-BR
  (data (i32.const 206032) "Quem sonha de dia percebe muitas coisas que escapam a quem s\c3\b3 sonha \c3\a0 noite.") ;; #0699 pt-BR
  (data (i32.const 206110) "Para realizar grandes coisas, n\c3\a3o basta agir; \c3\a9 preciso sonhar. N\c3\a3o basta planejar; \c3\a9 preciso acreditar.") ;; #0700 pt-BR
  (data (i32.const 206218) "Siga a sua felicidade, e o universo abrir\c3\a1 portas onde antes s\c3\b3 havia paredes.") ;; #0701 pt-BR
  (data (i32.const 206298) "Sem saltos de imagina\c3\a7\c3\a3o ou de sonho, perdemos o encanto das possibilidades.") ;; #0702 pt-BR
  (data (i32.const 206376) "Sonhar, afinal, \c3\a9 uma forma de planejar.") ;; #0703 pt-BR
  (data (i32.const 206417) "Voc\c3\aa vai para lugares incr\c3\adveis! Hoje \c3\a9 o seu dia! Sua montanha est\c3\a1 esperando, ent\c3\a3o p\c3\a9 na estrada!") ;; #0704 pt-BR
  (data (i32.const 206523) "Voc\c3\aa tem um c\c3\a9rebro na cabe\c3\a7a. Tem p\c3\a9s nos sapatos. Pode seguir para a dire\c3\a7\c3\a3o que escolher.") ;; #0705 pt-BR
  (data (i32.const 206621) "A n\c3\a3o ser que algu\c3\a9m como voc\c3\aa se importe muito, muito mesmo, nada vai melhorar. Nada.") ;; #0706 pt-BR
  (data (i32.const 206710) "Me diga, o que voc\c3\aa pretende fazer com a sua \c3\banica vida, selvagem e preciosa?") ;; #0707 pt-BR
  (data (i32.const 206789) "Dois caminhos se separavam num bosque, e eu, eu escolhi o menos percorrido, e isso fez toda a diferen\c3\a7a.") ;; #0708 pt-BR
  (data (i32.const 206894) "Nem todos os que vagueiam est\c3\a3o perdidos.") ;; #0709 pt-BR
  (data (i32.const 206936) "Respirei fundo e ouvi o velho orgulho do meu cora\c3\a7\c3\a3o: eu sou, eu sou, eu sou.") ;; #0710 pt-BR
  (data (i32.const 207015) "Talvez todos os drag\c3\b5es da nossa vida sejam princesas apenas esperando nos ver agir, uma \c3\banica vez, com beleza e coragem.") ;; #0711 pt-BR
  (data (i32.const 207138) "O que voc\c3\aa tentaria fazer se soubesse que n\c3\a3o iria fracassar?") ;; #0712 pt-BR
  (data (i32.const 207201) "Vi o anjo no m\c3\a1rmore e esculpi at\c3\a9 libert\c3\a1-lo.") ;; #0713 pt-BR
  (data (i32.const 207250) "Pessoas com metas t\c3\aam sucesso porque sabem para onde est\c3\a3o indo.") ;; #0714 pt-BR
  (data (i32.const 207316) "O que voc\c3\aa procura est\c3\a1 procurando voc\c3\aa.") ;; #0715 pt-BR
  (data (i32.const 207359) "N\c3\a3o sofra. Tudo o que voc\c3\aa perde volta de outra forma.") ;; #0716 pt-BR
  (data (i32.const 207415) "Coloque fogo na sua vida. Procure quem ati\c3\a7a as suas chamas.") ;; #0717 pt-BR
  (data (i32.const 207476) "Ontem eu era esperto, ent\c3\a3o queria mudar o mundo. Hoje sou s\c3\a1bio, ent\c3\a3o estou mudando a mim mesmo.") ;; #0718 pt-BR
  (data (i32.const 207577) "Voc\c3\aa nasceu com asas; por que prefere rastejar pela vida?") ;; #0719 pt-BR
  (data (i32.const 207635) "Responda a todo chamado que entusiasma o seu esp\c3\adrito.") ;; #0720 pt-BR
  (data (i32.const 207690) "Se voc\c3\aa se irrita com cada atrito, como o seu espelho vai ficar polido?") ;; #0721 pt-BR
  (data (i32.const 207762) "Essas dores que voc\c3\aa sente s\c3\a3o mensageiras. Escute-as.") ;; #0722 pt-BR
  (data (i32.const 207818) "A liberdade \c3\a9 o \c3\banico objetivo digno na vida. Ela \c3\a9 conquistada quando deixamos de nos importar com o que est\c3\a1 fora do nosso controle.") ;; #0723 pt-BR
  (data (i32.const 207956) "N\c3\a3o explique sua filosofia. Viva-a.") ;; #0724 pt-BR
  (data (i32.const 207992) "Se voc\c3\aa quer melhorar, aceite ser considerado tolo e ignorante.") ;; #0725 pt-BR
  (data (i32.const 208056) "Enquanto viver, continue aprendendo a viver.") ;; #0726 pt-BR
  (data (i32.const 208100) "\c3\80s vezes, at\c3\a9 viver \c3\a9 um ato de coragem.") ;; #0727 pt-BR
  (data (i32.const 208143) "Para quem n\c3\a3o sabe a que porto se dirige, nenhum vento \c3\a9 favor\c3\a1vel.") ;; #0728 pt-BR
  (data (i32.const 208213) "Sorte \c3\a9 o que acontece quando a prepara\c3\a7\c3\a3o encontra a oportunidade.") ;; #0729 pt-BR
  (data (i32.const 208283) "O ontem \c3\a9 hist\c3\b3ria, o amanh\c3\a3 \c3\a9 mist\c3\a9rio, o hoje \c3\a9 um presente de Deus, e \c3\a9 por isso que se chama presente.") ;; #0730 pt-BR
  (data (i32.const 208396) "Se quer ir r\c3\a1pido, v\c3\a1 sozinho. Se quer ir longe, v\c3\a1 acompanhado.") ;; #0731 pt-BR
  (data (i32.const 208463) "N\c3\a3o tenham medo.") ;; #0732 pt-BR
  (data (i32.const 208480) "N\c3\a3o tenho medo do amanh\c3\a3, porque j\c3\a1 vi o ontem e amo o hoje.") ;; #0733 pt-BR
  (data (i32.const 208543) "Todo dia \c3\a9 um novo dia.") ;; #0734 pt-BR
  (data (i32.const 208567) "A \c3\banica jornada \c3\a9 a que acontece dentro de n\c3\b3s.") ;; #0735 pt-BR
  (data (i32.const 208617) "Ainda estou aprendendo.") ;; #0736 pt-BR
  (data (i32.const 208640) "O que importa n\c3\a3o \c3\a9 a dura\c3\a7\c3\a3o da vida, mas a sua profundidade.") ;; #0737 pt-BR
  (data (i32.const 208706) "Depois que voc\c3\aa toma uma decis\c3\a3o, o universo conspira para que ela aconte\c3\a7a.") ;; #0738 pt-BR
  (data (i32.const 208785) "Ser grande \c3\a9 ser incompreendido.") ;; #0739 pt-BR
  (data (i32.const 208818) "Termine cada dia e deixe-o para tr\c3\a1s. Voc\c3\aa fez o que p\c3\b4de.") ;; #0740 pt-BR
  (data (i32.const 208879) "Os anos ensinam muito do que os dias nunca sabem.") ;; #0741 pt-BR
  (data (i32.const 208928) "Escreva no seu cora\c3\a7\c3\a3o que cada dia \c3\a9 o melhor dia do ano.") ;; #0742 pt-BR
  (data (i32.const 208989) "A vida s\c3\b3 pode ser compreendida olhando para tr\c3\a1s, mas precisa ser vivida olhando para a frente.") ;; #0743 pt-BR
  (data (i32.const 209087) "Come\c3\a7os s\c3\a3o sempre bagun\c3\a7ados.") ;; #0744 pt-BR
  (data (i32.const 209120) "Vis\c3\a3o \c3\a9 a arte de enxergar o que \c3\a9 invis\c3\advel para os outros.") ;; #0745 pt-BR
  (data (i32.const 209184) "Quando uma porta da felicidade se fecha, outra se abre.") ;; #0746 pt-BR
  (data (i32.const 209239) "Sozinhos podemos fazer t\c3\a3o pouco; juntos podemos fazer tanto.") ;; #0747 pt-BR
  (data (i32.const 209301) "A \c3\banica coisa pior do que ser cego \c3\a9 enxergar e n\c3\a3o ter vis\c3\a3o.") ;; #0748 pt-BR
  (data (i32.const 209367) "Nenhum pessimista jamais descobriu o segredo das estrelas, nem navegou para uma terra desconhecida.") ;; #0749 pt-BR
  (data (i32.const 209466) "Podemos fazer qualquer coisa que quisermos, se persistirmos por tempo suficiente.") ;; #0750 pt-BR
  (data (i32.const 209547) "O que procuro n\c3\a3o est\c3\a1 l\c3\a1 fora; est\c3\a1 em mim.") ;; #0751 pt-BR
  (data (i32.const 209595) "Esfor\c3\a7o e coragem n\c3\a3o bastam sem prop\c3\b3sito e dire\c3\a7\c3\a3o.") ;; #0752 pt-BR
  (data (i32.const 209653) "O mundo \c3\a9 transformado pelo seu exemplo, n\c3\a3o pela sua opini\c3\a3o.") ;; #0753 pt-BR
  (data (i32.const 209718) "N\c3\a3o podemos ajudar todo mundo, mas todo mundo pode ajudar algu\c3\a9m.") ;; #0754 pt-BR
  (data (i32.const 209785) "Cada pessoa deve viver a vida como um exemplo para os outros.") ;; #0755 pt-BR
  (data (i32.const 209846) "Se voc\c3\aa n\c3\a3o gosta da estrada em que est\c3\a1 caminhando, comece a pavimentar outra.") ;; #0756 pt-BR
  (data (i32.const 209928) "Voc\c3\aa recebe da vida aquilo que tem coragem de pedir.") ;; #0757 pt-BR
  (data (i32.const 209981) "Sucesso n\c3\a3o tem a ver com quanto dinheiro voc\c3\aa ganha; tem a ver com a diferen\c3\a7a que voc\c3\aa faz na vida das pessoas.") ;; #0758 pt-BR
  (data (i32.const 210098) "N\c3\a3o h\c3\a1 agonia maior do que carregar dentro de si uma hist\c3\b3ria n\c3\a3o contada.") ;; #0759 pt-BR
  (data (i32.const 210176) "S\c3\b3 percebemos a import\c3\a2ncia da nossa voz quando somos silenciados.") ;; #0760 pt-BR
  (data (i32.const 210244) "Sucesso n\c3\a3o \c3\a9 o qu\c3\a3o alto voc\c3\aa subiu, mas como voc\c3\aa faz uma diferen\c3\a7a positiva no mundo.") ;; #0761 pt-BR
  (data (i32.const 210338) "A melhor vingan\c3\a7a \c3\a9 um sucesso enorme.") ;; #0762 pt-BR
  (data (i32.const 210378) "O luto pode ser o jardim da compaix\c3\a3o.") ;; #0763 pt-BR
  (data (i32.const 210417) "Continue em frente, e \c3\a9 prov\c3\a1vel que voc\c3\aa tropece em algo, talvez quando menos espera.") ;; #0764 pt-BR
  (data (i32.const 210506) "Trabalho duro sem talento \c3\a9 uma pena, mas talento sem trabalho duro \c3\a9 uma trag\c3\a9dia.") ;; #0765 pt-BR
  (data (i32.const 210592) "N\c3\a3o acaba at\c3\a9 que acabe.") ;; #0766 pt-BR
  (data (i32.const 210618) "Ou encontraremos um caminho, ou abriremos um.") ;; #0767 pt-BR
  (data (i32.const 210663) "O segredo do sucesso \c3\a9 a const\c3\a2ncia no prop\c3\b3sito.") ;; #0768 pt-BR
  (data (i32.const 210715) "Persista e persevere, e voc\c3\aa descobrir\c3\a1 que a maioria das coisas alcan\c3\a7\c3\a1veis \c3\a9 poss\c3\advel.") ;; #0769 pt-BR
  (data (i32.const 210809) "A maioria das pessoas desiste justamente quando est\c3\a1 prestes a ter sucesso. Elas param a um passo da linha de chegada.") ;; #0770 pt-BR
  (data (i32.const 210928) "Se for duvidar de alguma coisa, duvide dos seus limites.") ;; #0771 pt-BR
  (data (i32.const 210984) "N\c3\a3o h\c3\a1 substituto para o trabalho duro.") ;; #0772 pt-BR
  (data (i32.const 211025) "A diferen\c3\a7a entre tentar e triunfar \c3\a9 s\c3\b3 um pouquinho mais de garra!") ;; #0773 pt-BR
  (data (i32.const 211096) "Perseveran\c3\a7a \c3\a9 fracassar dezenove vezes e ter sucesso na vig\c3\a9sima.") ;; #0774 pt-BR
  (data (i32.const 211165) "A persist\c3\aancia est\c3\a1 para o car\c3\a1ter humano assim como o carbono est\c3\a1 para o a\c3\a7o.") ;; #0775 pt-BR
  (data (i32.const 211249) "Quem consegue ir al\c3\a9m quando o esfor\c3\a7o come\c3\a7a a doer \c3\a9 quem vai vencer.") ;; #0776 pt-BR
  (data (i32.const 211324) "N\c3\a3o desista. Nunca desista.") ;; #0777 pt-BR
  (data (i32.const 211352) "Muitas pessoas foram mais longe do que achavam que podiam porque algu\c3\a9m acreditou que elas podiam.") ;; #0778 pt-BR
  (data (i32.const 211451) "Voc\c3\aa n\c3\a3o consegue subir a escada do sucesso com as m\c3\a3os nos bolsos.") ;; #0779 pt-BR
  (data (i32.const 211521) "As conquistas de hoje foram as impossibilidades de ontem.") ;; #0780 pt-BR
  (data (i32.const 211578) "Nada \c3\a9 especialmente dif\c3\adcil se voc\c3\aa dividir em pequenas tarefas.") ;; #0781 pt-BR
  (data (i32.const 211646) "Perseveran\c3\a7a e \c3\a2nimo fizeram maravilhas em todas as \c3\a9pocas.") ;; #0782 pt-BR
  (data (i32.const 211708) "A coragem \c3\a9 o pre\c3\a7o que a vida cobra para conceder a paz.") ;; #0783 pt-BR
  (data (i32.const 211767) "A aventura vale a pena por si s\c3\b3.") ;; #0784 pt-BR
  (data (i32.const 211801) "Coragem \c3\a9 um caso de amor com o desconhecido.") ;; #0785 pt-BR
  (data (i32.const 211847) "O que voc\c3\aa deve fazer quando n\c3\a3o gosta de algo \c3\a9 mud\c3\a1-lo.") ;; #0786 pt-BR
  (data (i32.const 211908) "Seja corajoso. Corra riscos. Nada pode substituir a experi\c3\aancia.") ;; #0787 pt-BR
  (data (i32.const 211973) "Quem \c3\a9 corajoso \c3\a9 livre.") ;; #0788 pt-BR
  (data (i32.const 211999) "N\c3\a3o devo ter medo. O medo \c3\a9 o assassino da mente.") ;; #0789 pt-BR
  (data (i32.const 212050) "A coragem \c3\a9 a principal qualidade de um l\c3\adder.") ;; #0790 pt-BR
  (data (i32.const 212098) "A coisa mais corajosa que voc\c3\aa pode fazer quando n\c3\a3o se sente corajoso \c3\a9 declarar coragem e agir de acordo.") ;; #0791 pt-BR
  (data (i32.const 212208) "Coragem \c3\a9 fazer aquilo de que voc\c3\aa tem medo. N\c3\a3o existe coragem sem medo.") ;; #0792 pt-BR
  (data (i32.const 212284) "A sorte e o amor favorecem os corajosos.") ;; #0793 pt-BR
  (data (i32.const 212324) "Exponha-se ao seu medo mais profundo; depois disso, o medo n\c3\a3o tem mais poder.") ;; #0794 pt-BR
  (data (i32.const 212403) "A coragem \c3\a9 como o amor: precisa de esperan\c3\a7a para se alimentar.") ;; #0795 pt-BR
  (data (i32.const 212469) "\c3\89 curioso que a coragem f\c3\adsica seja t\c3\a3o comum no mundo, e a coragem moral, t\c3\a3o rara.") ;; #0796 pt-BR
  (data (i32.const 212557) "O oposto da coragem na nossa sociedade n\c3\a3o \c3\a9 a covardia, \c3\a9 o conformismo.") ;; #0797 pt-BR
  (data (i32.const 212633) "Os covardes morrem muitas vezes antes da morte; os valentes s\c3\b3 provam a morte uma vez.") ;; #0798 pt-BR
  (data (i32.const 212720) "N\c3\a3o tenha medo da grandeza: alguns nascem grandes, alguns conquistam a grandeza e a outros a grandeza \c3\a9 imposta.") ;; #0799 pt-BR
  (data (i32.const 212834) "Firme a sua coragem at\c3\a9 o limite, e n\c3\a3o falharemos.") ;; #0800 pt-BR
  (data (i32.const 212887) "Coragem \c3\a9 o medo resistindo um minuto a mais.") ;; #0801 pt-BR
  (data (i32.const 212933) "Fracassar n\c3\a3o \c3\a9 cair, mas se recusar a levantar.") ;; #0802 pt-BR
  (data (i32.const 212983) "O homem bem-sucedido tira proveito dos pr\c3\b3prios erros e tenta de novo de outra maneira.") ;; #0803 pt-BR
  (data (i32.const 213071) "Construa o sucesso a partir dos fracassos. O des\c3\a2nimo e o fracasso s\c3\a3o dois dos degraus mais seguros para o sucesso.") ;; #0804 pt-BR
  (data (i32.const 213189) "Os erros s\c3\a3o sempre perdo\c3\a1veis, se a pessoa tiver coragem de admiti-los.") ;; #0805 pt-BR
  (data (i32.const 213263) "N\c3\a3o tenha medo de errar. N\c3\a3o existem erros.") ;; #0806 pt-BR
  (data (i32.const 213308) "Quando voc\c3\aa comete um erro, s\c3\b3 deve fazer tr\c3\aas coisas: admiti-lo, aprender com ele e n\c3\a3o repeti-lo.") ;; #0807 pt-BR
  (data (i32.const 213411) "O fracasso \c3\a9 um desvio, n\c3\a3o uma rua sem sa\c3\adda.") ;; #0808 pt-BR
  (data (i32.const 213460) "Um fracasso nem sempre \c3\a9 um erro. Pode ser simplesmente o melhor que se p\c3\b4de fazer naquelas circunst\c3\a2ncias. O verdadeiro erro \c3\a9 parar de tentar.") ;; #0809 pt-BR
  (data (i32.const 213608) "Se voc\c3\aa n\c3\a3o fracassa de vez em quando, \c3\a9 sinal de que n\c3\a3o est\c3\a1 fazendo nada muito inovador.") ;; #0810 pt-BR
  (data (i32.const 213704) "O fracasso acontece o tempo todo. Acontece todo dia no treino. O que torna voc\c3\aa melhor \c3\a9 como voc\c3\aa reage a ele.") ;; #0811 pt-BR
  (data (i32.const 213818) "N\c3\a3o existem erros nem fracassos, apenas li\c3\a7\c3\b5es.") ;; #0812 pt-BR
  (data (i32.const 213868) "Aprendi mais com meus erros do que com meus acertos.") ;; #0813 pt-BR
  (data (i32.const 213920) "\c3\89 o fracasso que d\c3\a1 a perspectiva certa sobre o sucesso.") ;; #0814 pt-BR
  (data (i32.const 213978) "Sucesso \c3\a9 o qu\c3\a3o alto voc\c3\aa quica quando chega ao fundo.") ;; #0815 pt-BR
  (data (i32.const 214036) "N\c3\a3o deixe o medo de perder ser maior do que a empolga\c3\a7\c3\a3o de vencer.") ;; #0816 pt-BR
  (data (i32.const 214106) "Aprendemos com o fracasso, n\c3\a3o com o sucesso!") ;; #0817 pt-BR
  (data (i32.const 214152) "Voc\c3\aa n\c3\a3o pode ter medo de fracassar. \c3\89 o \c3\banico jeito de ter sucesso.") ;; #0818 pt-BR
  (data (i32.const 214224) "Um homem n\c3\a3o est\c3\a1 acabado quando \c3\a9 derrotado. Est\c3\a1 acabado quando desiste.") ;; #0819 pt-BR
  (data (i32.const 214302) "O esp\c3\adrito humano \c3\a9 mais forte do que qualquer coisa que possa lhe acontecer.") ;; #0820 pt-BR
  (data (i32.const 214381) "A vida n\c3\a3o \c3\a9 sobre o qu\c3\a3o r\c3\a1pido voc\c3\aa corre ou o qu\c3\a3o alto voc\c3\aa sobe, mas sobre o qu\c3\a3o bem voc\c3\aa se recupera das quedas.") ;; #0821 pt-BR
  (data (i32.const 214509) "Sem lama, n\c3\a3o h\c3\a1 l\c3\b3tus.") ;; #0822 pt-BR
  (data (i32.const 214535) "Se voc\c3\aa quer ver o sol, precisa enfrentar a tempestade.") ;; #0823 pt-BR
  (data (i32.const 214591) "As pessoas mais fortes encontram coragem e carinho para ajudar os outros, mesmo quando est\c3\a3o passando pela pr\c3\b3pria tempestade.") ;; #0824 pt-BR
  (data (i32.const 214719) "N\c3\a3o existe isso de arruinar a vida. A vida, no fim das contas, \c3\a9 bem resiliente.") ;; #0825 pt-BR
  (data (i32.const 214801) "Resili\c3\aancia \c3\a9 saber que s\c3\b3 voc\c3\aa tem o poder e a responsabilidade de se levantar.") ;; #0826 pt-BR
  (data (i32.const 214885) "Depois que voc\c3\aa enfrenta seu medo, nada \c3\a9 t\c3\a3o dif\c3\adcil quanto voc\c3\aa imagina.") ;; #0827 pt-BR
  (data (i32.const 214964) "Quando a vida derrubar voc\c3\aa, tente cair de costas. Porque, se voc\c3\aa consegue olhar para cima, consegue se levantar.") ;; #0828 pt-BR
  (data (i32.const 215080) "De toda crise nasce a chance de renascer.") ;; #0829 pt-BR
  (data (i32.const 215121) "Nada \c3\a9 permanente neste mundo cruel, nem mesmo os nossos problemas.") ;; #0830 pt-BR
  (data (i32.const 215189) "As dificuldades fazem ou destroem as pessoas.") ;; #0831 pt-BR
  (data (i32.const 215234) "Transforme suas cicatrizes em estrelas.") ;; #0832 pt-BR
  (data (i32.const 215273) "O c\c3\a2ncer pode tirar todas as minhas capacidades f\c3\adsicas. Mas n\c3\a3o pode tocar minha mente, n\c3\a3o pode tocar meu cora\c3\a7\c3\a3o e n\c3\a3o pode tocar minha alma.") ;; #0833 pt-BR
  (data (i32.const 215424) "Seja \c3\a1gua, meu amigo.") ;; #0834 pt-BR
  (data (i32.const 215446) "Os dias dif\c3\adceis s\c3\a3o os melhores, porque \c3\a9 neles que os campe\c3\b5es s\c3\a3o feitos.") ;; #0835 pt-BR
  (data (i32.const 215527) "Sempre h\c3\a1 luz, se tivermos coragem de v\c3\aa-la. Se tivermos coragem de ser a luz.") ;; #0836 pt-BR
  (data (i32.const 215607) "Esperan\c3\a7a \c3\a9 um verbo de mangas arrega\c3\a7adas.") ;; #0837 pt-BR
  (data (i32.const 215653) "Ter esperan\c3\a7a \c3\a9 entregar-se ao futuro.") ;; #0838 pt-BR
  (data (i32.const 215693) "A esperan\c3\a7a n\c3\a3o \c3\a9 um bilhete de loteria que voc\c3\aa segura no sof\c3\a1, sentindo-se com sorte. \c3\89 um machado com que voc\c3\aa derruba portas numa emerg\c3\aancia.") ;; #0839 pt-BR
  (data (i32.const 215846) "Tenhamos bom \c3\a2nimo, lembrando que os infort\c3\banios mais dif\c3\adceis de suportar s\c3\a3o aqueles que nunca chegam.") ;; #0840 pt-BR
  (data (i32.const 215954) "O melhor jeito de se animar \c3\a9 tentar animar outra pessoa.") ;; #0841 pt-BR
  (data (i32.const 216012) "Quando o sol est\c3\a1 brilhando, posso fazer qualquer coisa; nenhuma montanha \c3\a9 alta demais, nenhum problema \c3\a9 dif\c3\adcil demais de superar.") ;; #0842 pt-BR
  (data (i32.const 216149) "Nunca duvide de que um pequeno grupo de cidad\c3\a3os conscientes e comprometidos pode mudar o mundo.") ;; #0843 pt-BR
  (data (i32.const 216246) "Mantenha o rosto voltado para o sol e voc\c3\aa n\c3\a3o ver\c3\a1 a sombra.") ;; #0844 pt-BR
  (data (i32.const 216310) "Um dia, olhando para tr\c3\a1s, os anos de luta v\c3\a3o parecer os mais bonitos.") ;; #0845 pt-BR
  (data (i32.const 216383) "No fim, tudo d\c3\a1 certo. Se n\c3\a3o deu certo, \c3\a9 porque ainda n\c3\a3o chegou ao fim.") ;; #0846 pt-BR
  (data (i32.const 216461) "A esperan\c3\a7a \c3\a9 companheira do poder e m\c3\a3e do sucesso.") ;; #0847 pt-BR
  (data (i32.const 216516) "A esperan\c3\a7a j\c3\a1 \c3\a9, em si, uma forma de felicidade.") ;; #0848 pt-BR
  (data (i32.const 216568) "O sol n\c3\a3o brilha sobre n\c3\b3s, mas dentro de n\c3\b3s.") ;; #0849 pt-BR
  (data (i32.const 216617) "A esperan\c3\a7a desperta, como nada mais consegue despertar, uma paix\c3\a3o pelo poss\c3\advel.") ;; #0850 pt-BR
  (data (i32.const 216702) "N\c3\a3o deixe seu fogo se apagar, fa\c3\adsca por fa\c3\adsca insubstitu\c3\advel.") ;; #0851 pt-BR
  (data (i32.const 216769) "Estamos todos na sarjeta, mas alguns de n\c3\b3s est\c3\a3o olhando para as estrelas.") ;; #0852 pt-BR
  (data (i32.const 216846) "Quanto mais escura a noite, mais brilhantes as estrelas; quanto mais profunda a dor, mais perto est\c3\a1 Deus!") ;; #0853 pt-BR
  (data (i32.const 216953) "As nuvens chegam flutuando \c3\a0 minha vida, n\c3\a3o mais para trazer chuva ou anunciar tempestade, mas para dar cor ao meu c\c3\a9u de entardecer.") ;; #0854 pt-BR
  (data (i32.const 217090) "Car\c3\a1ter \c3\a9 poder.") ;; #0855 pt-BR
  (data (i32.const 217108) "N\c3\a3o tenho medo; nasci para fazer isso.") ;; #0856 pt-BR
  (data (i32.const 217147) "Autocontrole \c3\a9 for\c3\a7a. Pensamento correto \c3\a9 dom\c3\adnio. Calma \c3\a9 poder.") ;; #0857 pt-BR
  (data (i32.const 217218) "A maior arma contra o estresse \c3\a9 a nossa capacidade de escolher um pensamento em vez de outro.") ;; #0858 pt-BR
  (data (i32.const 217313) "N\c3\a3o deseje ser nada al\c3\a9m do que voc\c3\aa \c3\a9, e procure ser isso com perfei\c3\a7\c3\a3o.") ;; #0859 pt-BR
  (data (i32.const 217392) "Ningu\c3\a9m nos salva al\c3\a9m de n\c3\b3s mesmos. Ningu\c3\a9m pode e ningu\c3\a9m deve. N\c3\b3s mesmos precisamos trilhar o caminho.") ;; #0860 pt-BR
  (data (i32.const 217505) "O poder n\c3\a3o \c3\a9 dado a voc\c3\aa. Voc\c3\aa precisa tom\c3\a1-lo.") ;; #0861 pt-BR
  (data (i32.const 217558) "N\c3\a3o vou me limitar s\c3\b3 porque as pessoas n\c3\a3o aceitam que eu sou capaz de fazer outra coisa.") ;; #0862 pt-BR
  (data (i32.const 217651) "Ningu\c3\a9m jamais mediu, nem mesmo os poetas, o quanto cabe em um cora\c3\a7\c3\a3o.") ;; #0863 pt-BR
  (data (i32.const 217725) "Nem todos n\c3\b3s podemos fazer grandes coisas. Mas podemos fazer pequenas coisas com grande amor.") ;; #0864 pt-BR
  (data (i32.const 217820) "Ela pode ser pequena, mas \c3\a9 feroz.") ;; #0865 pt-BR
  (data (i32.const 217855) "Voc\c3\aa n\c3\a3o pode fugir de uma fraqueza; uma hora precisa enfrent\c3\a1-la at\c3\a9 o fim, ou sucumbir.") ;; #0866 pt-BR
  (data (i32.const 217948) "N\c3\a3o entre docilmente nessa noite boa. Lute, lute contra o apagar da luz.") ;; #0867 pt-BR
  (data (i32.const 218021) "A for\c3\a7a n\c3\a3o vem do que voc\c3\aa consegue fazer. Vem de superar as coisas que voc\c3\aa um dia achou que n\c3\a3o conseguiria.") ;; #0868 pt-BR
  (data (i32.const 218137) "Excel\c3\aancia n\c3\a3o \c3\a9 uma habilidade. \c3\89 uma atitude.") ;; #0869 pt-BR
  (data (i32.const 218188) "Fa\c3\a7a primeiro as tarefas dif\c3\adceis. As f\c3\a1ceis v\c3\a3o se resolver sozinhas.") ;; #0870 pt-BR
  (data (i32.const 218262) "\c3\89 melhor n\c3\a3o dar desculpa nenhuma do que dar uma desculpa ruim.") ;; #0871 pt-BR
  (data (i32.const 218327) "O trabalho duro s\c3\b3 \c3\a9 uma pris\c3\a3o se n\c3\a3o tiver sentido.") ;; #0872 pt-BR
  (data (i32.const 218384) "Tornamo-nos justos praticando atos justos, moderados praticando atos moderados, corajosos praticando atos corajosos.") ;; #0873 pt-BR
  (data (i32.const 218500) "Nunca confunda atividade com realiza\c3\a7\c3\a3o.") ;; #0874 pt-BR
  (data (i32.const 218542) "Quanto mais voc\c3\aa trabalha, mais dif\c3\adcil \c3\a9 se render.") ;; #0875 pt-BR
  (data (i32.const 218597) "A pr\c3\a1tica n\c3\a3o leva \c3\a0 perfei\c3\a7\c3\a3o. S\c3\b3 a pr\c3\a1tica perfeita leva \c3\a0 perfei\c3\a7\c3\a3o.") ;; #0876 pt-BR
  (data (i32.const 218678) "O sucesso est\c3\a1 onde a prepara\c3\a7\c3\a3o encontra a oportunidade.") ;; #0877 pt-BR
  (data (i32.const 218738) "Qualidade \c3\a9 fazer certo quando ningu\c3\a9m est\c3\a1 olhando.") ;; #0878 pt-BR
  (data (i32.const 218793) "S\c3\a3o as \c3\baltimas tr\c3\aas ou quatro repeti\c3\a7\c3\b5es que fazem o m\c3\basculo crescer.") ;; #0879 pt-BR
  (data (i32.const 218868) "A autodisciplina come\c3\a7a com o dom\c3\adnio dos seus pensamentos.") ;; #0880 pt-BR
  (data (i32.const 218929) "Voc\c3\aa ama a vida? Ent\c3\a3o n\c3\a3o desperdice tempo, pois \c3\a9 dele que a vida \c3\a9 feita.") ;; #0881 pt-BR
  (data (i32.const 219010) "N\c3\a3o paro quando estou cansado. Paro quando termino.") ;; #0882 pt-BR
  (data (i32.const 219062) "O \c3\banico dia f\c3\a1cil foi ontem.") ;; #0883 pt-BR
  (data (i32.const 219092) "Com delicadeza, voc\c3\aa pode sacudir o mundo.") ;; #0884 pt-BR
  (data (i32.const 219135) "Reexamine tudo o que lhe disseram; descarte o que ofende a sua alma.") ;; #0885 pt-BR
  (data (i32.const 219203) "A mudan\c3\a7a \c3\a9 o resultado final de todo aprendizado verdadeiro.") ;; #0886 pt-BR
  (data (i32.const 219266) "Quem para de aprender est\c3\a1 velho, seja aos vinte ou aos oitenta anos.") ;; #0887 pt-BR
  (data (i32.const 219336) "A verdadeira viagem de descoberta n\c3\a3o consiste em buscar novas paisagens, mas em ter novos olhos.") ;; #0888 pt-BR
  (data (i32.const 219434) "S\c3\b3 quando estamos perdidos come\c3\a7amos a compreender a n\c3\b3s mesmos.") ;; #0889 pt-BR
  (data (i32.const 219501) "As coisas n\c3\a3o mudam; n\c3\b3s mudamos.") ;; #0890 pt-BR
  (data (i32.const 219536) "O progresso sempre envolve riscos. Voc\c3\aa n\c3\a3o consegue roubar a segunda base mantendo o p\c3\a9 na primeira.") ;; #0891 pt-BR
  (data (i32.const 219640) "O maior perigo em tempos de turbul\c3\aancia n\c3\a3o \c3\a9 a turbul\c3\aancia; \c3\a9 agir com a l\c3\b3gica de ontem.") ;; #0892 pt-BR
  (data (i32.const 219736) "Precisamos estar dispostos a abrir m\c3\a3o da vida que planejamos para viver a vida que est\c3\a1 \c3\a0 nossa espera.") ;; #0893 pt-BR
  (data (i32.const 219843) "O privil\c3\a9gio de uma vida inteira \c3\a9 se tornar quem voc\c3\aa realmente \c3\a9.") ;; #0894 pt-BR
  (data (i32.const 219914) "Conhecer a pr\c3\b3pria escurid\c3\a3o \c3\a9 o melhor m\c3\a9todo para lidar com a escurid\c3\a3o dos outros.") ;; #0895 pt-BR
  (data (i32.const 220004) "N\c3\a3o h\c3\a1 tomada de consci\c3\aancia sem dor.") ;; #0896 pt-BR
  (data (i32.const 220044) "O que conta \c3\a9 o que voc\c3\aa aprende depois de achar que j\c3\a1 sabe tudo.") ;; #0897 pt-BR
  (data (i32.const 220113) "Nossa tarefa na vida n\c3\a3o \c3\a9 passar \c3\a0 frente dos outros, mas passar \c3\a0 frente de n\c3\b3s mesmos.") ;; #0898 pt-BR
  (data (i32.const 220207) "Ser o que somos e nos tornar o que somos capazes de nos tornar \c3\a9 o \c3\banico prop\c3\b3sito da vida.") ;; #0899 pt-BR
  (data (i32.const 220301) "O que a lagarta chama de fim do mundo, o mestre chama de borboleta.") ;; #0900 pt-BR
  (data (i32.const 220368) "Se voc\c3\aa n\c3\a3o est\c3\a1 disposto a aprender, ningu\c3\a9m pode ajud\c3\a1-lo. Se est\c3\a1 determinado a aprender, ningu\c3\a9m pode impedi-lo.") ;; #0901 pt-BR
  (data (i32.const 220491) "No longo prazo, moldamos nossa vida e moldamos a n\c3\b3s mesmos.") ;; #0902 pt-BR
  (data (i32.const 220552) "Da adversidade nasce a oportunidade.") ;; #0903 pt-BR
  (data (i32.const 220588) "A adversidade sempre foi considerada o estado em que o homem mais facilmente vem a conhecer a si mesmo.") ;; #0904 pt-BR
  (data (i32.const 220691) "Os tempos ruins t\c3\aam um valor cient\c3\adfico. S\c3\a3o ocasi\c3\b5es que um bom aprendiz n\c3\a3o deixaria passar.") ;; #0905 pt-BR
  (data (i32.const 220790) "Toda parede \c3\a9 uma porta.") ;; #0906 pt-BR
  (data (i32.const 220815) "A dor e o sofrimento s\c3\a3o sempre inevit\c3\a1veis para uma grande intelig\c3\aancia e um cora\c3\a7\c3\a3o profundo.") ;; #0907 pt-BR
  (data (i32.const 220915) "Longo e dif\c3\adcil \c3\a9 o caminho que, do inferno, conduz \c3\a0 luz.") ;; #0908 pt-BR
  (data (i32.const 220976) "Aceite desafios, para que possa sentir a euforia da vit\c3\b3ria.") ;; #0909 pt-BR
  (data (i32.const 221037) "Quando ficar claro que as metas n\c3\a3o podem ser alcan\c3\a7adas, n\c3\a3o ajuste as metas; ajuste os passos para chegar l\c3\a1.") ;; #0910 pt-BR
  (data (i32.const 221152) "A vit\c3\b3ria \c3\a9 mais doce quando voc\c3\aa j\c3\a1 conheceu a derrota.") ;; #0911 pt-BR
  (data (i32.const 221212) "\c3\89 um erro olhar longe demais \c3\a0 frente. S\c3\b3 um elo da corrente do destino pode ser segurado de cada vez.") ;; #0912 pt-BR
  (data (i32.const 221317) "N\c3\a3o perca tempo batendo numa parede, esperando transform\c3\a1-la em porta.") ;; #0913 pt-BR
  (data (i32.const 221389) "Comece por qualquer lugar.") ;; #0914 pt-BR
  (data (i32.const 221415) "A a\c3\a7\c3\a3o \c3\a9 eloquente.") ;; #0915 pt-BR
  (data (i32.const 221437) "N\c3\a3o espere por l\c3\adderes; fa\c3\a7a voc\c3\aa mesmo, de pessoa para pessoa.") ;; #0916 pt-BR
  (data (i32.const 221504) "N\c3\a3o julgue cada dia pela colheita que voc\c3\aa faz, mas pelas sementes que voc\c3\aa planta.") ;; #0917 pt-BR
  (data (i32.const 221590) "Fa\c3\a7a algo maravilhoso; as pessoas podem imitar.") ;; #0918 pt-BR
  (data (i32.const 221638) "O momento \c3\a9 sempre certo para fazer o que \c3\a9 certo.") ;; #0919 pt-BR
  (data (i32.const 221690) "Uma meta bem definida est\c3\a1 meio alcan\c3\a7ada.") ;; #0920 pt-BR
  (data (i32.const 221734) "As coisas n\c3\a3o acontecem. As coisas s\c3\a3o feitas para acontecer.") ;; #0921 pt-BR
  (data (i32.const 221797) "Oitenta por cento do sucesso \c3\a9 aparecer.") ;; #0922 pt-BR
  (data (i32.const 221838) "Voc\c3\aa n\c3\a3o constr\c3\b3i uma reputa\c3\a7\c3\a3o com o que vai fazer.") ;; #0923 pt-BR
  (data (i32.const 221895) "Voc\c3\aa pode adiar, mas o tempo n\c3\a3o vai.") ;; #0924 pt-BR
  (data (i32.const 221934) "Escreva algo que valha a pena ler ou fa\c3\a7a algo que valha a pena escrever.") ;; #0925 pt-BR
  (data (i32.const 222008) "Algumas pessoas querem que aconte\c3\a7a, algumas torcem para que aconte\c3\a7a, outras fazem acontecer.") ;; #0926 pt-BR
  (data (i32.const 222104) "Quanto mais eu quero fazer algo, menos chamo isso de trabalho.") ;; #0927 pt-BR
  (data (i32.const 222166) "O pessimista reclama do vento; o otimista espera que ele mude; o realista ajusta as velas.") ;; #0928 pt-BR
  (data (i32.const 222256) "O otimismo \c3\a9 essencial para a realiza\c3\a7\c3\a3o e tamb\c3\a9m \c3\a9 a base da coragem e do verdadeiro progresso.") ;; #0929 pt-BR
  (data (i32.const 222357) "Voc\c3\aa \c3\a9 aquilo que acredita ser.") ;; #0930 pt-BR
  (data (i32.const 222390) "Acredite e aja como se fosse imposs\c3\advel fracassar.") ;; #0931 pt-BR
  (data (i32.const 222441) "A mente \c3\a9 o seu pr\c3\b3prio lugar e, em si mesma, pode fazer do inferno um c\c3\a9u, e do c\c3\a9u um inferno.") ;; #0932 pt-BR
  (data (i32.const 222541) "Se voc\c3\aa percebesse o qu\c3\a3o poderosos s\c3\a3o seus pensamentos, nunca mais teria um pensamento negativo.") ;; #0933 pt-BR
  (data (i32.const 222642) "Eu sou o maior. Eu dizia isso antes mesmo de saber que era.") ;; #0934 pt-BR
  (data (i32.const 222701) "Imposs\c3\advel \c3\a9 s\c3\b3 uma palavra grande usada por homens pequenos.") ;; #0935 pt-BR
  (data (i32.const 222765) "\c3\89 a repeti\c3\a7\c3\a3o das afirma\c3\a7\c3\b5es que leva \c3\a0 cren\c3\a7a.") ;; #0936 pt-BR
  (data (i32.const 222819) "Se minha mente pode conceber e meu cora\c3\a7\c3\a3o pode acreditar, ent\c3\a3o eu posso conquistar.") ;; #0937 pt-BR
  (data (i32.const 222907) "A confian\c3\a7a \c3\a9 contagiosa. A falta de confian\c3\a7a tamb\c3\a9m.") ;; #0938 pt-BR
  (data (i32.const 222965) "Alimente sua mente com grandes pensamentos, pois voc\c3\aa nunca ir\c3\a1 mais alto do que pensa.") ;; #0939 pt-BR
  (data (i32.const 223054) "Tenha grandes pensamentos, mas saboreie os pequenos prazeres.") ;; #0940 pt-BR
  (data (i32.const 223115) "Defenda suas limita\c3\a7\c3\b5es, e com certeza elas ser\c3\a3o suas.") ;; #0941 pt-BR
  (data (i32.const 223173) "Sucesso \c3\a9 gostar de si mesmo, gostar do que voc\c3\aa faz e gostar de como voc\c3\aa faz.") ;; #0942 pt-BR
  (data (i32.const 223255) "A alma se tinge com a cor dos seus pensamentos.") ;; #0943 pt-BR
  (data (i32.const 223302) "O sucesso n\c3\a3o \c3\a9 a chave da felicidade. A felicidade \c3\a9 a chave do sucesso.") ;; #0944 pt-BR
  (data (i32.const 223378) "Paci\c3\aancia \c3\a9 a aceita\c3\a7\c3\a3o serena de que as coisas podem acontecer numa ordem diferente da que voc\c3\aa tem em mente.") ;; #0945 pt-BR
  (data (i32.const 223493) "Paci\c3\aancia e firmeza vencem todas as coisas.") ;; #0946 pt-BR
  (data (i32.const 223537) "Tenha paci\c3\aancia. Todas as coisas s\c3\a3o dif\c3\adceis antes de se tornarem f\c3\a1ceis.") ;; #0947 pt-BR
  (data (i32.const 223615) "A paci\c3\aancia \c3\a9 uma virtude que conquista.") ;; #0948 pt-BR
  (data (i32.const 223657) "Tudo chega para quem corre atr\c3\a1s enquanto espera.") ;; #0949 pt-BR
  (data (i32.const 223707) "Se fiz alguma descoberta valiosa, devo isso mais \c3\a0 aten\c3\a7\c3\a3o paciente do que a qualquer outro talento.") ;; #0950 pt-BR
  (data (i32.const 223810) "A paci\c3\aancia \c3\a9 necess\c3\a1ria, e n\c3\a3o se colhe imediatamente onde se semeou.") ;; #0951 pt-BR
  (data (i32.const 223884) "Com sabedoria e devagar; trope\c3\a7a quem corre depressa.") ;; #0952 pt-BR
  (data (i32.const 223938) "Tamb\c3\a9m servem aqueles que apenas ficam de p\c3\a9 e esperam.") ;; #0953 pt-BR
  (data (i32.const 223995) "S\c3\b3 o tempo pode curar o que a raz\c3\a3o n\c3\a3o consegue.") ;; #0954 pt-BR
  (data (i32.const 224047) "A determina\c3\a7\c3\a3o d\c3\a1 a voc\c3\aa a firmeza para seguir em frente apesar dos obst\c3\a1culos que surgem pelo caminho.") ;; #0955 pt-BR
  (data (i32.const 224155) "Podem vencer aqueles que acreditam que podem.") ;; #0956 pt-BR
  (data (i32.const 224200) "N\c3\a3o existem limites. Existem plat\c3\b4s, mas voc\c3\aa n\c3\a3o deve ficar neles; precisa ir al\c3\a9m.") ;; #0957 pt-BR
  (data (i32.const 224289) "Uma meta nem sempre existe para ser alcan\c3\a7ada; muitas vezes serve simplesmente como algo para onde mirar.") ;; #0958 pt-BR
  (data (i32.const 224395) "Vou usar todas as minhas ferramentas, o talento que Deus me deu, e construir a melhor vida poss\c3\advel com isso.") ;; #0959 pt-BR
  (data (i32.const 224505) "Campe\c3\b5es n\c3\a3o s\c3\a3o feitos na academia. S\c3\a3o feitos de algo que t\c3\aam l\c3\a1 no fundo: um desejo, um sonho, uma vis\c3\a3o.") ;; #0960 pt-BR
  (data (i32.const 224620) "O caminho para o sucesso est\c3\a1 sempre em obras.") ;; #0961 pt-BR
  (data (i32.const 224667) "Ambi\c3\a7\c3\a3o \c3\a9 entusiasmo com prop\c3\b3sito.") ;; #0962 pt-BR
  (data (i32.const 224706) "Os sonhos s\c3\a3o ilustra\c3\a7\c3\b5es do livro que a sua alma est\c3\a1 escrevendo sobre voc\c3\aa.") ;; #0963 pt-BR
  (data (i32.const 224788) "N\c3\a3o sonhe sonhos pequenos, pois eles n\c3\a3o t\c3\aam poder de mover o cora\c3\a7\c3\a3o dos homens.") ;; #0964 pt-BR
  (data (i32.const 224874) "Um homem s\c3\b3 fica velho quando os arrependimentos tomam o lugar dos sonhos.") ;; #0965 pt-BR
  (data (i32.const 224949) "Nos sonhos come\c3\a7a a responsabilidade.") ;; #0966 pt-BR
  (data (i32.const 224987) "Pise devagar, porque voc\c3\aa est\c3\a1 pisando nos meus sonhos.") ;; #0967 pt-BR
  (data (i32.const 225044) "Tudo o que vemos ou parecemos \c3\a9 apenas um sonho dentro de um sonho.") ;; #0968 pt-BR
  (data (i32.const 225112) "N\c3\a3o desista dos seus sonhos, ou seus sonhos v\c3\a3o desistir de voc\c3\aa.") ;; #0969 pt-BR
  (data (i32.const 225180) "N\c3\a3o h\c3\a1 nada como um sonho para criar o futuro.") ;; #0970 pt-BR
  (data (i32.const 225228) "O poder da imagina\c3\a7\c3\a3o nos torna infinitos.") ;; #0971 pt-BR
  (data (i32.const 225272) "Voc\c3\aa v\c3\aa as coisas e pergunta: \22Por qu\c3\aa?\22. Mas eu sonho coisas que nunca existiram e pergunto: \22Por que n\c3\a3o?\22.") ;; #0972 pt-BR
  (data (i32.const 225385) "Atrele sua carro\c3\a7a a uma estrela.") ;; #0973 pt-BR
  (data (i32.const 225419) "Quem avan\c3\a7a com confian\c3\a7a na dire\c3\a7\c3\a3o dos seus sonhos encontra um sucesso inesperado nas horas mais comuns.") ;; #0974 pt-BR
  (data (i32.const 225529) "Nossa vida mais verdadeira \c3\a9 quando sonhamos acordados.") ;; #0975 pt-BR
  (data (i32.const 225585) "V\c3\a1 at\c3\a9 onde voc\c3\aa consegue enxergar; quando chegar l\c3\a1, vai conseguir enxergar mais longe.") ;; #0976 pt-BR
  (data (i32.const 225677) "A melhor forma de realizar seus sonhos \c3\a9 acordar.") ;; #0977 pt-BR
  (data (i32.const 225727) "Quem olha para fora sonha; quem olha para dentro desperta.") ;; #0978 pt-BR
  (data (i32.const 225785) "Nenhum desejo lhe \c3\a9 dado sem que tamb\c3\a9m lhe seja dado o poder de realiz\c3\a1-lo.") ;; #0979 pt-BR
  (data (i32.const 225864) "A vida sem reflex\c3\a3o n\c3\a3o vale a pena ser vivida.") ;; #0980 pt-BR
  (data (i32.const 225913) "A \c3\banica sabedoria verdadeira est\c3\a1 em saber que nada se sabe.") ;; #0981 pt-BR
  (data (i32.const 225975) "Seja gentil, pois cada pessoa que voc\c3\aa encontra est\c3\a1 travando uma batalha dif\c3\adcil.") ;; #0982 pt-BR
  (data (i32.const 226060) "Nenhum ato de bondade, por menor que seja, \c3\a9 desperdi\c3\a7ado.") ;; #0983 pt-BR
  (data (i32.const 226120) "As coisas melhores e mais bonitas do mundo n\c3\a3o podem ser vistas nem tocadas. Precisam ser sentidas com o cora\c3\a7\c3\a3o.") ;; #0984 pt-BR
  (data (i32.const 226236) "Aquilo de que um dia desfrutamos nunca pode ser perdido. Tudo o que amamos profundamente se torna parte de n\c3\b3s.") ;; #0985 pt-BR
  (data (i32.const 226348) "A felicidade n\c3\a3o \c3\a9 um objetivo; \c3\a9 uma consequ\c3\aancia.") ;; #0986 pt-BR
  (data (i32.const 226403) "O prop\c3\b3sito da vida \c3\a9 viv\c3\aa-la, provar a experi\c3\aancia ao m\c3\a1ximo.") ;; #0987 pt-BR
  (data (i32.const 226470) "A arte de ser s\c3\a1bio \c3\a9 a arte de saber o que deixar passar.") ;; #0988 pt-BR
  (data (i32.const 226530) "Quem aprende mas n\c3\a3o pensa est\c3\a1 perdido. Quem pensa mas n\c3\a3o aprende corre grande perigo.") ;; #0989 pt-BR
  (data (i32.const 226621) "A melhor vingan\c3\a7a \c3\a9 n\c3\a3o ser como o seu inimigo.") ;; #0990 pt-BR
  (data (i32.const 226671) "A perda nada mais \c3\a9 que mudan\c3\a7a, e a mudan\c3\a7a \c3\a9 o prazer da Natureza.") ;; #0991 pt-BR
  (data (i32.const 226743) "Contemple a beleza da vida. Observe as estrelas e imagine-se correndo com elas.") ;; #0992 pt-BR
  (data (i32.const 226822) "Ao acordar pela manh\c3\a3, pense no privil\c3\a9gio precioso que \c3\a9 estar vivo.") ;; #0993 pt-BR
  (data (i32.const 226894) "N\c3\a3o \c3\a9 que tenhamos pouco tempo de vida, mas sim que desperdi\c3\a7amos muito dele.") ;; #0994 pt-BR
  (data (i32.const 226974) "Enquanto esperamos pela vida, a vida passa.") ;; #0995 pt-BR
  (data (i32.const 227017) "Onde houver um ser humano, h\c3\a1 uma oportunidade para a bondade.") ;; #0996 pt-BR
  (data (i32.const 227080) "Sofre mais do que o necess\c3\a1rio quem sofre antes que seja necess\c3\a1rio.") ;; #0997 pt-BR
  (data (i32.const 227150) "A ignor\c3\a2ncia \c3\a9 a causa do medo.") ;; #0998 pt-BR
  (data (i32.const 227183) "Viver \c3\a9 a coisa mais rara do mundo. A maioria das pessoas apenas existe.") ;; #0999 pt-BR
  (data (i32.const 227256) "Desculpe por fazer voc\c3\aa sofrer. Eu te amo.") ;; #1000 pt-BR dedication
  (data (i32.const 227299) "Confucio") ;; a0000 es
  (data (i32.const 227307) "Proverbio japon\c3\a9s") ;; a0001 es
  (data (i32.const 227325) "Napole\c3\b3n Bonaparte") ;; a0018 es
  (data (i32.const 227344) "Lucrecio") ;; a0020 es
  (data (i32.const 227352) "Persio") ;; a0025 es
  (data (i32.const 227358) "Lao-Tse") ;; a0026 es
  (data (i32.const 227365) "Virgilio") ;; a0054 es
  (data (i32.const 227373) "Plat\c3\b3n") ;; a0070 es
  (data (i32.const 227380) "Proverbio chino") ;; a0132 es
  (data (i32.const 227395) "Proverbio africano") ;; a0133 es
  (data (i32.const 227413) "S\c3\a9neca") ;; a0147 es
  (data (i32.const 227420) "Mart\c3\adn Lutero") ;; a0154 es
  (data (i32.const 227434) "Cicer\c3\b3n") ;; a0158 es
  (data (i32.const 227442) "Fi\c3\b3dor Dostoievski") ;; a0163 es
  (data (i32.const 227461) "Proverbio") ;; a0166 es
  (data (i32.const 227470) "Proverbio ingl\c3\a9s") ;; a0167 es
  (data (i32.const 227487) "Plinio el Viejo") ;; a0174 es
  (data (i32.const 227502) "Proverbio latino") ;; a0183 es
  (data (i32.const 227518) "Le\c3\b3n Tolst\c3\b3i") ;; a0194 es
  (data (i32.const 227532) "Marco Aurelio") ;; a0195 es
  (data (i32.const 227545) "San Francisco de Sales") ;; a0207 es
  (data (i32.const 227567) "Proverbio tanzano") ;; a0273 es
  (data (i32.const 227584) "Horacio") ;; a0282 es
  (data (i32.const 227591) "Proverbio maor\c3\ad") ;; a0283 es
  (data (i32.const 227607) "Publilio Siro") ;; a0297 es
  (data (i32.const 227620) "Proverbio zen") ;; a0302 es
  (data (i32.const 227633) "Hillel el Anciano") ;; a0315 es
  (data (i32.const 227650) "Papa Juan Pablo II") ;; a0325 es
  (data (i32.const 227668) "Proverbio jas\c3\addico") ;; a0330 es
  (data (i32.const 227687) "San Agust\c3\adn") ;; a0349 es
  (data (i32.const 227699) "Ovidio") ;; a0351 es
  (data (i32.const 227705) "Marqu\c3\a9s de Vauvenargues") ;; a0355 es
  (data (i32.const 227729) "Proverbio holand\c3\a9s") ;; a0356 es
  (data (i32.const 227748) "Proverbio suajili") ;; a0359 es
  (data (i32.const 227765) "Proverbio turco") ;; a0365 es
  (data (i32.const 227780) "Proverbio persa") ;; a0367 es
  (data (i32.const 227795) "Juana de Arco") ;; a0461 es
  (data (i32.const 227808) "SEAL de la Marina de EE. UU.") ;; a0471 es
  (data (i32.const 227836) "No importa lo despacio que vayas, siempre y cuando no te detengas.") ;; #0000 es
  (data (i32.const 227902) "Cae siete veces, lev\c3\a1ntate ocho.") ;; #0001 es
  (data (i32.const 227935) "Nuestra mayor gloria no est\c3\a1 en no caer nunca, sino en levantarnos cada vez que caemos.") ;; #0002 es
  (data (i32.const 228023) "La energ\c3\ada y la persistencia lo conquistan todo.") ;; #0003 es
  (data (i32.const 228072) "Los r\c3\ados lo saben: no hay prisa. Alg\c3\ban d\c3\ada llegaremos.") ;; #0004 es
  (data (i32.const 228129) "La perseverancia no es una carrera larga; son muchas carreras cortas, una tras otra.") ;; #0005 es
  (data (i32.const 228213) "El r\c3\ado atraviesa la roca no por su fuerza, sino por su persistencia.") ;; #0006 es
  (data (i32.const 228282) "Muchos de los fracasos de la vida son de personas que no se dieron cuenta de lo cerca que estaban del \c3\a9xito cuando se rindieron.") ;; #0007 es
  (data (i32.const 228411) "Camino despacio, pero nunca camino hacia atr\c3\a1s.") ;; #0008 es
  (data (i32.const 228459) "Las grandes obras no se hacen con fuerza, sino con perseverancia.") ;; #0009 es
  (data (i32.const 228524) "La paciencia y la perseverancia tienen un efecto m\c3\a1gico ante el cual las dificultades desaparecen y los obst\c3\a1culos se desvanecen.") ;; #0010 es
  (data (i32.const 228655) "Gracias a la perseverancia, muchas personas logran el \c3\a9xito a partir de lo que parec\c3\ada destinado a ser un fracaso seguro.") ;; #0011 es
  (data (i32.const 228778) "El esfuerzo continuo, y no la fuerza o la inteligencia, es la clave para liberar nuestro potencial.") ;; #0012 es
  (data (i32.const 228877) "La ambici\c3\b3n es el camino al \c3\a9xito. La persistencia es el veh\c3\adculo en el que llegas.") ;; #0013 es
  (data (i32.const 228963) "La diferencia entre una persona exitosa y las dem\c3\a1s no es la falta de fuerza ni de conocimiento, sino la falta de voluntad.") ;; #0014 es
  (data (i32.const 229087) "El \c3\a9xito es la suma de peque\c3\b1os esfuerzos repetidos d\c3\ada tras d\c3\ada.") ;; #0015 es
  (data (i32.const 229156) "Siempre parece imposible hasta que se hace.") ;; #0016 es
  (data (i32.const 229199) "Nada en este mundo puede reemplazar a la persistencia.") ;; #0017 es
  (data (i32.const 229253) "La victoria pertenece a los m\c3\a1s perseverantes.") ;; #0018 es
  (data (i32.const 229300) "Con un talento com\c3\ban y una perseverancia extraordinaria, todo es alcanzable.") ;; #0019 es
  (data (i32.const 229377) "Las gotas de lluvia perforan la piedra no por su violencia, sino por caer sin cesar.") ;; #0020 es
  (data (i32.const 229461) "La mayor\c3\ada de las cosas importantes del mundo las lograron personas que siguieron intent\c3\a1ndolo cuando parec\c3\ada no haber ninguna esperanza.") ;; #0021 es
  (data (i32.const 229601) "Constancia, perseverancia y persistencia a pesar de todos los obst\c3\a1culos, des\c3\a1nimos e imposibilidades: eso es lo que, en todo, distingue al alma fuerte de la d\c3\a9bil.") ;; #0022 es
  (data (i32.const 229768) "Nunca te rindas, porque ese es justo el lugar y el momento en que la marea va a cambiar.") ;; #0023 es
  (data (i32.const 229856) "La persistencia puede convertir el fracaso en un logro extraordinario.") ;; #0024 es
  (data (i32.const 229926) "Vence quien resiste.") ;; #0025 es
  (data (i32.const 229946) "El agua es fluida, blanda y flexible. Pero el agua desgasta la roca, que es r\c3\adgida y no puede ceder.") ;; #0026 es
  (data (i32.const 230047) "Paraliza la resistencia con persistencia.") ;; #0027 es
  (data (i32.const 230088) "El esfuerzo solo entrega toda su recompensa cuando la persona se niega a rendirse.") ;; #0028 es
  (data (i32.const 230170) "Paciencia, persistencia y sudor forman una combinaci\c3\b3n imbatible para el \c3\a9xito.") ;; #0029 es
  (data (i32.const 230251) "Un campe\c3\b3n es alguien que se levanta cuando no puede.") ;; #0030 es
  (data (i32.const 230305) "Nunca te rindas. Nunca, nunca, nunca, nunca.") ;; #0031 es
  (data (i32.const 230349) "El \c3\a9xito parece estar ligado a la acci\c3\b3n. Las personas exitosas no dejan de moverse.") ;; #0032 es
  (data (i32.const 230435) "Cada fallo me acerca al pr\c3\b3ximo jonr\c3\b3n.") ;; #0033 es
  (data (i32.const 230476) "Simplemente no se puede vencer a quien nunca se rinde.") ;; #0034 es
  (data (i32.const 230530) "No mires el reloj; haz lo que \c3\a9l hace. Sigue adelante.") ;; #0035 es
  (data (i32.const 230585) "Lo que esperamos alg\c3\ban d\c3\ada hacer con facilidad, primero debemos aprender a hacerlo con dedicaci\c3\b3n.") ;; #0036 es
  (data (i32.const 230686) "En el enfrentamiento entre el arroyo y la roca, el arroyo siempre gana, no por su fuerza, sino por su perseverancia.") ;; #0037 es
  (data (i32.const 230802) "Resistir no es solo la capacidad de soportar algo dif\c3\adcil, sino de convertirlo en gloria.") ;; #0038 es
  (data (i32.const 230892) "Perseverancia, secreto de todos los triunfos.") ;; #0039 es
  (data (i32.const 230937) "El camino al \c3\a9xito est\c3\a1 lleno de tentadores lugares para estacionarse.") ;; #0040 es
  (data (i32.const 231009) "Si ca\c3\adste ayer, lev\c3\a1ntate hoy.") ;; #0041 es
  (data (i32.const 231041) "Persistir\c3\a9 hasta triunfar.") ;; #0042 es
  (data (i32.const 231068) "Se puede cruzar la monta\c3\b1a m\c3\a1s alta, paso a paso.") ;; #0043 es
  (data (i32.const 231119) "Los diamantes no son m\c3\a1s que trozos de carb\c3\b3n que no abandonaron su trabajo.") ;; #0044 es
  (data (i32.const 231197) "Las grandes cosas no se hacen por impulso, sino por una serie de peque\c3\b1as cosas reunidas.") ;; #0045 es
  (data (i32.const 231287) "El genio es uno por ciento inspiraci\c3\b3n y noventa y nueve por ciento transpiraci\c3\b3n.") ;; #0046 es
  (data (i32.const 231371) "Cuanto m\c3\a1s duro el conflicto, m\c3\a1s glorioso el triunfo.") ;; #0047 es
  (data (i32.const 231427) "La persistencia garantiza que los resultados sean inevitables.") ;; #0048 es
  (data (i32.const 231489) "El valor no siempre ruge. A veces el valor es esa voz tranquila al final del d\c3\ada que dice: ma\c3\b1ana lo vuelvo a intentar.") ;; #0049 es
  (data (i32.const 231610) "Aprend\c3\ad que el valor no es la ausencia de miedo, sino el triunfo sobre \c3\a9l.") ;; #0050 es
  (data (i32.const 231686) "Ganas fuerza, valor y confianza con cada experiencia en la que realmente te detienes a mirar el miedo a la cara.") ;; #0051 es
  (data (i32.const 231798) "El valor es resistir al miedo, dominar el miedo, no la ausencia de miedo.") ;; #0052 es
  (data (i32.const 231871) "La vida se encoge o se expande en proporci\c3\b3n al valor de cada uno.") ;; #0053 es
  (data (i32.const 231938) "Hace falta valor para crecer y convertirse en quien realmente eres.") ;; #0054 es
  (data (i32.const 232005) "El valor es, con raz\c3\b3n, considerado la primera de las cualidades humanas, porque es la cualidad que garantiza todas las dem\c3\a1s.") ;; #0055 es
  (data (i32.const 232133) "El hombre valiente no es el que no siente miedo, sino el que vence ese miedo.") ;; #0056 es
  (data (i32.const 232210) "Ten el valor de seguir a tu coraz\c3\b3n y a tu intuici\c3\b3n.") ;; #0057 es
  (data (i32.const 232265) "Ser amado profundamente por alguien te da fuerza, mientras que amar a alguien profundamente te da valor.") ;; #0058 es
  (data (i32.const 232369) "El valor es elegancia bajo presi\c3\b3n.") ;; #0059 es
  (data (i32.const 232405) "Quien no tiene el valor de arriesgarse no lograr\c3\a1 nada en la vida.") ;; #0060 es
  (data (i32.const 232472) "Solo quienes se arriesgan a ir demasiado lejos pueden descubrir hasta d\c3\b3nde es posible llegar.") ;; #0061 es
  (data (i32.const 232567) "La fortuna favorece a los audaces.") ;; #0062 es
  (data (i32.const 232601) "El valor se encuentra en los lugares m\c3\a1s inesperados.") ;; #0063 es
  (data (i32.const 232655) "Incluso la persona m\c3\a1s peque\c3\b1a puede cambiar el curso del futuro.") ;; #0064 es
  (data (i32.const 232722) "Todo lo que tenemos que decidir es qu\c3\a9 hacer con el tiempo que se nos ha dado.") ;; #0065 es
  (data (i32.const 232801) "Hace falta mucha valent\c3\ada para enfrentarse a los enemigos, pero la misma para enfrentarse a los amigos.") ;; #0066 es
  (data (i32.const 232905) "Haz aquello que temes, y la muerte del miedo es segura.") ;; #0067 es
  (data (i32.const 232960) "El miedo es tan profundo como la mente lo permite.") ;; #0068 es
  (data (i32.const 233010) "Todo lo que siempre has querido est\c3\a1 al otro lado del miedo.") ;; #0069 es
  (data (i32.const 233071) "La inacci\c3\b3n engendra duda y miedo. La acci\c3\b3n engendra confianza y valor.") ;; #0070 es
  (data (i32.const 233145) "Valor es estar muerto de miedo y montar el caballo de todos modos.") ;; #0071 es
  (data (i32.const 233211) "No le temo a las tormentas, porque estoy aprendiendo a navegar mi barco.") ;; #0072 es
  (data (i32.const 233283) "Un barco en el puerto est\c3\a1 a salvo, pero los barcos no se construyen para eso.") ;; #0073 es
  (data (i32.const 233362) "La cueva en la que temes entrar guarda el tesoro que buscas.") ;; #0074 es
  (data (i32.const 233422) "El valor es contagioso. Cuando un hombre valiente toma una posici\c3\b3n, los dem\c3\a1s suelen enderezar la espalda.") ;; #0075 es
  (data (i32.const 233531) "Nada en la vida debe ser temido, solamente comprendido.") ;; #0076 es
  (data (i32.const 233586) "La valent\c3\ada es la capacidad de actuar bien incluso cuando est\c3\a1s muerto de miedo.") ;; #0077 es
  (data (i32.const 233668) "Con valor te atrever\c3\a1s a correr riesgos, tendr\c3\a1s fuerza para ser compasivo y sabidur\c3\ada para ser humilde.") ;; #0078 es
  (data (i32.const 233775) "Nadie nace necesariamente con valor, pero todos nacen con potencial.") ;; #0079 es
  (data (i32.const 233843) "El valor es la m\c3\a1s importante de todas las virtudes, porque sin valor no se puede practicar ninguna otra virtud con constancia.") ;; #0080 es
  (data (i32.const 233971) "La libertad est\c3\a1 en ser audaz.") ;; #0081 es
  (data (i32.const 234002) "Lo \c3\banico que debemos temer es al miedo mismo.") ;; #0082 es
  (data (i32.const 234048) "El valor es saber qu\c3\a9 no temer.") ;; #0083 es
  (data (i32.const 234080) "Siente el miedo y hazlo de todos modos.") ;; #0084 es
  (data (i32.const 234119) "S\c3\a9 audaz, y fuerzas poderosas vendr\c3\a1n en tu ayuda.") ;; #0085 es
  (data (i32.const 234171) "No hay pasi\c3\b3n en jugar a lo peque\c3\b1o.") ;; #0086 es
  (data (i32.const 234209) "El valor es como un m\c3\basculo: se fortalece con el uso.") ;; #0087 es
  (data (i32.const 234263) "La vulnerabilidad es la cuna de la innovaci\c3\b3n, la creatividad y el cambio.") ;; #0088 es
  (data (i32.const 234338) "El valor empieza cuando nos presentamos y nos dejamos ver.") ;; #0089 es
  (data (i32.const 234396) "No tengas miedo de renunciar a lo bueno para ir por lo excelente.") ;; #0090 es
  (data (i32.const 234461) "Atreverse es perder el equilibrio por un instante. No atreverse es perderse a uno mismo.") ;; #0091 es
  (data (i32.const 234549) "No es la monta\c3\b1a lo que conquistamos, sino a nosotros mismos.") ;; #0092 es
  (data (i32.const 234611) "Salta, y la red aparecer\c3\a1.") ;; #0093 es
  (data (i32.const 234638) "La seguridad es, en gran parte, una superstici\c3\b3n. La vida es una aventura atrevida o no es nada.") ;; #0094 es
  (data (i32.const 234735) "\c2\bfQu\c3\a9 ser\c3\ada de la vida si no tuvi\c3\a9ramos el valor de intentar nada?") ;; #0095 es
  (data (i32.const 234804) "Es mucho mejor atreverse a cosas grandes y lograr triunfos gloriosos, aunque est\c3\a9n salpicados de fracasos, que unirse a esos pobres esp\c3\adritus que ni disfrutan mucho ni sufren mucho.") ;; #0096 es
  (data (i32.const 234987) "No es el cr\c3\adtico quien cuenta.") ;; #0097 es
  (data (i32.const 235018) "El m\c3\a9rito pertenece a quien est\c3\a1 realmente en la arena.") ;; #0098 es
  (data (i32.const 235075) "El miedo tiene dos significados: huir de todo o enfrentarlo todo y levantarse.") ;; #0099 es
  (data (i32.const 235153) "Miedo es lo que sientes. Valent\c3\ada es lo que haces.") ;; #0100 es
  (data (i32.const 235204) "El valor es considerado la mayor de las virtudes, porque sin \c3\a9l el hombre no tiene garant\c3\ada de conservar ninguna otra.") ;; #0101 es
  (data (i32.const 235324) "El valor es la escalera por la que suben todas las dem\c3\a1s virtudes.") ;; #0102 es
  (data (i32.const 235391) "El valor no es simplemente una de las virtudes, sino la forma de todas las virtudes en el momento de la prueba.") ;; #0103 es
  (data (i32.const 235502) "Valor, querido coraz\c3\b3n.") ;; #0104 es
  (data (i32.const 235526) "El valor es la fuerza de soltar lo conocido.") ;; #0105 es
  (data (i32.const 235570) "No he fracasado. Solo he encontrado 10.000 maneras que no funcionan.") ;; #0106 es
  (data (i32.const 235638) "El fracaso es simplemente la oportunidad de empezar de nuevo, esta vez con m\c3\a1s inteligencia.") ;; #0107 es
  (data (i32.const 235731) "Lo intentaste. Fracasaste. No importa. Int\c3\a9ntalo otra vez. Fracasa otra vez. Fracasa mejor.") ;; #0108 es
  (data (i32.const 235823) "He fracasado una y otra y otra vez en mi vida. Y por eso tengo \c3\a9xito.") ;; #0109 es
  (data (i32.const 235893) "Solo quienes se atreven a fracasar en grande pueden lograr algo grande.") ;; #0110 es
  (data (i32.const 235964) "El fracaso es el condimento que le da sabor al \c3\a9xito.") ;; #0111 es
  (data (i32.const 236018) "Es imposible vivir sin fracasar en algo, a menos que vivas con tanta cautela que sea como no haber vivido.") ;; #0112 es
  (data (i32.const 236124) "Tocar fondo se convirti\c3\b3 en la base s\c3\b3lida sobre la que reconstru\c3\ad mi vida.") ;; #0113 es
  (data (i32.const 236202) "No me juzgues por mis \c3\a9xitos, j\c3\bazgame por cu\c3\a1ntas veces ca\c3\ad y volv\c3\ad a levantarme.") ;; #0114 es
  (data (i32.const 236288) "El fracaso debe ser nuestro maestro, no nuestro enterrador.") ;; #0115 es
  (data (i32.const 236347) "Solo hay una cosa que hace imposible cumplir un sue\c3\b1o: el miedo a fracasar.") ;; #0116 es
  (data (i32.const 236423) "El fracaso no es lo opuesto al \c3\a9xito; es parte del \c3\a9xito.") ;; #0117 es
  (data (i32.const 236482) "Construyes sobre el fracaso. Lo usas como pelda\c3\b1o.") ;; #0118 es
  (data (i32.const 236533) "Un genio no comete errores. Sus errores son voluntarios y son las puertas del descubrimiento.") ;; #0119 es
  (data (i32.const 236626) "Rendirse es la \c3\banica forma segura de fracasar.") ;; #0120 es
  (data (i32.const 236673) "Cada fracaso es un paso hacia el \c3\a9xito.") ;; #0121 es
  (data (i32.const 236713) "La derrota no es el peor de los fracasos. No haberlo intentado es el verdadero fracaso.") ;; #0122 es
  (data (i32.const 236800) "Los fracasos son se\c3\b1ales en el camino hacia el logro.") ;; #0123 es
  (data (i32.const 236854) "El f\c3\a9nix debe arder para renacer.") ;; #0124 es
  (data (i32.const 236888) "Todos somos fracasos; al menos los mejores de nosotros lo son.") ;; #0125 es
  (data (i32.const 236950) "Puedo aceptar el fracaso, todo el mundo fracasa en algo. Pero no puedo aceptar no intentarlo.") ;; #0126 es
  (data (i32.const 237043) "El \c3\a9xito no se construye sobre el \c3\a9xito. Se construye sobre el fracaso. Se construye sobre la frustraci\c3\b3n.") ;; #0127 es
  (data (i32.const 237152) "Los ganadores no le temen a perder. Los perdedores s\c3\ad. El fracaso es parte del proceso del \c3\a9xito.") ;; #0128 es
  (data (i32.const 237251) "Un inventor fracasa 999 veces, y si acierta una, lo logr\c3\b3.") ;; #0129 es
  (data (i32.const 237310) "F\c3\adjate en que el \c3\a1rbol m\c3\a1s r\c3\adgido es el que se quiebra con m\c3\a1s facilidad, mientras que el bamb\c3\ba o el sauce sobreviven dobl\c3\a1ndose con el viento.") ;; #0130 es
  (data (i32.const 237460) "No le temas al fracaso. El crimen no es fracasar, sino apuntar bajo.") ;; #0131 es
  (data (i32.const 237528) "El fracaso ense\c3\b1a. Quien de verdad piensa aprende tanto de sus fracasos como de sus \c3\a9xitos.") ;; #0132 es
  (data (i32.const 237621) "Nuestra mayor debilidad est\c3\a1 en rendirnos. La forma m\c3\a1s segura de triunfar es intentarlo siempre una vez m\c3\a1s.") ;; #0133 es
  (data (i32.const 237733) "Las personas buenas son buenas porque llegaron a la sabidur\c3\ada a trav\c3\a9s del fracaso.") ;; #0134 es
  (data (i32.const 237818) "El mayor error que puedes cometer en la vida es vivir con miedo a equivocarte.") ;; #0135 es
  (data (i32.const 237896) "Si no est\c3\a1s dispuesto a equivocarte, nunca crear\c3\a1s nada original.") ;; #0136 es
  (data (i32.const 237963) "La experiencia es simplemente el nombre que les damos a nuestros errores.") ;; #0137 es
  (data (i32.const 238036) "Cuando nos damos permiso para fracasar, al mismo tiempo nos damos permiso para brillar.") ;; #0138 es
  (data (i32.const 238123) "El \c3\banico error verdadero es aquel del que no aprendemos nada.") ;; #0139 es
  (data (i32.const 238185) "Que hayas fracasado una vez no significa que vayas a fracasar en todo.") ;; #0140 es
  (data (i32.const 238255) "Prefiero fracasar en algo que amo que tener \c3\a9xito en algo que odio.") ;; #0141 es
  (data (i32.const 238323) "No existe el fracaso, salvo cuando dejamos de intentarlo.") ;; #0142 es
  (data (i32.const 238380) "El fracaso nunca me alcanzar\c3\a1 si mi determinaci\c3\b3n de triunfar es lo bastante fuerte.") ;; #0143 es
  (data (i32.const 238466) "A veces hay que librar una batalla m\c3\a1s de una vez para ganarla.") ;; #0144 es
  (data (i32.const 238530) "Fracasar no es fatal, pero no cambiar puede serlo.") ;; #0145 es
  (data (i32.const 238580) "Si aprendes de la derrota, en realidad no has perdido.") ;; #0146 es
  (data (i32.const 238634) "El maestro ha fracasado m\c3\a1s veces de las que el principiante lo ha intentado.") ;; #0147 es
  (data (i32.const 238712) "Est\c3\a1 bien celebrar el \c3\a9xito, pero es m\c3\a1s importante prestar atenci\c3\b3n a las lecciones del fracaso.") ;; #0148 es
  (data (i32.const 238813) "Fracasando se avanza hacia el \c3\a9xito.") ;; #0149 es
  (data (i32.const 238850) "El fracaso es la clave del \c3\a9xito; cada error nos ense\c3\b1a algo.") ;; #0150 es
  (data (i32.const 238913) "En el camino al \c3\a9xito, siempre pasas por el fracaso.") ;; #0151 es
  (data (i32.const 238966) "El fracaso no importa. Hace falta valor para hacer el rid\c3\adculo.") ;; #0152 es
  (data (i32.const 239030) "\c2\bfQu\c3\a9 es la derrota? Nada m\c3\a1s que aprendizaje; nada m\c3\a1s que el primer paso hacia algo mejor.") ;; #0153 es
  (data (i32.const 239125) "Nunca confundas una sola derrota con una derrota definitiva.") ;; #0154 es
  (data (i32.const 239185) "No te averg\c3\bcences de tus fracasos; aprende de ellos y vuelve a empezar.") ;; #0155 es
  (data (i32.const 239257) "Del sufrimiento han surgido las almas m\c3\a1s fuertes; los caracteres m\c3\a1s s\c3\b3lidos est\c3\a1n marcados por cicatrices.") ;; #0156 es
  (data (i32.const 239369) "El roble luch\c3\b3 contra el viento y se quebr\c3\b3; el sauce se dobl\c3\b3 cuando hizo falta y sobrevivi\c3\b3.") ;; #0157 es
  (data (i32.const 239467) "Aunque el mundo est\c3\a1 lleno de sufrimiento, tambi\c3\a9n est\c3\a1 lleno de la superaci\c3\b3n del mismo.") ;; #0158 es
  (data (i32.const 239560) "El car\c3\a1cter no se forma en la calma y la tranquilidad. Solo a trav\c3\a9s de la prueba y el sufrimiento se fortalece el alma, se inspira la ambici\c3\b3n y se alcanza el \c3\a9xito.") ;; #0159 es
  (data (i32.const 239730) "La vida no se vuelve m\c3\a1s f\c3\a1cil ni m\c3\a1s indulgente; nosotros nos volvemos m\c3\a1s fuertes y m\c3\a1s resilientes.") ;; #0160 es
  (data (i32.const 239837) "No pidas una vida f\c3\a1cil; pide la fuerza para soportar una dif\c3\adcil.") ;; #0161 es
  (data (i32.const 239905) "La capacidad humana para cargar peso es como el bamb\c3\ba: mucho m\c3\a1s flexible de lo que creer\c3\adas a primera vista.") ;; #0162 es
  (data (i32.const 240017) "Lo que me sucede puede cambiarme. Pero me niego a que me disminuya.") ;; #0163 es
  (data (i32.const 240084) "Puedes enfrentar muchas derrotas, pero no debes dejarte derrotar.") ;; #0164 es
  (data (i32.const 240149) "Aun as\c3\ad, como el aire, me levanto.") ;; #0165 es
  (data (i32.const 240184) "Se mantuvo de pie en la tormenta y, cuando el viento no sopl\c3\b3 a su favor, ajust\c3\b3 las velas.") ;; #0166 es
  (data (i32.const 240277) "Los tiempos dif\c3\adciles no duran, pero las personas fuertes s\c3\ad.") ;; #0167 es
  (data (i32.const 240340) "Donde no hay lucha, no hay fuerza.") ;; #0168 es
  (data (i32.const 240374) "Convierte tus heridas en sabidur\c3\ada.") ;; #0169 es
  (data (i32.const 240410) "Cuando todo parezca ir en tu contra, recuerda que el avi\c3\b3n despega contra el viento, no a favor de \c3\a9l.") ;; #0170 es
  (data (i32.const 240514) "De las dificultades nacen los milagros.") ;; #0171 es
  (data (i32.const 240553) "La piedra preciosa no se pule sin fricci\c3\b3n, ni el hombre se perfecciona sin pruebas.") ;; #0172 es
  (data (i32.const 240638) "Mar en calma no hace buen marinero.") ;; #0173 es
  (data (i32.const 240673) "Mis cicatrices me recuerdan que s\c3\ad sobreviv\c3\ad a mis heridas m\c3\a1s profundas.") ;; #0174 es
  (data (i32.const 240749) "La fuerza no viene de la capacidad f\c3\adsica. Viene de una voluntad indomable.") ;; #0175 es
  (data (i32.const 240825) "El mundo nos rompe a todos y, despu\c3\a9s, muchos se vuelven fuertes en los lugares rotos.") ;; #0176 es
  (data (i32.const 240912) "Lo que no me mata me hace m\c3\a1s fuerte.") ;; #0177 es
  (data (i32.const 240950) "Quien tiene un porqu\c3\a9 para vivir puede soportar casi cualquier c\c3\b3mo.") ;; #0178 es
  (data (i32.const 241020) "Cuando ya no somos capaces de cambiar una situaci\c3\b3n, nos encontramos ante el desaf\c3\ado de cambiarnos a nosotros mismos.") ;; #0179 es
  (data (i32.const 241139) "Al hombre se le puede arrebatar todo salvo una cosa: la \c3\baltima de las libertades humanas, la de elegir su actitud ante cualquier circunstancia.") ;; #0180 es
  (data (i32.const 241283) "El bamb\c3\ba que se dobla es m\c3\a1s fuerte que el roble que resiste.") ;; #0181 es
  (data (i32.const 241346) "Las dificultades a menudo preparan a personas comunes para un destino extraordinario.") ;; #0182 es
  (data (i32.const 241431) "Nuestras heridas suelen ser las aberturas hacia la parte mejor y m\c3\a1s hermosa de nosotros.") ;; #0183 es
  (data (i32.const 241521) "La resiliencia es aceptar tu nueva realidad, aunque sea menos buena que la que ten\c3\adas antes.") ;; #0184 es
  (data (i32.const 241614) "El hombre nunca ha creado un material tan resiliente como el esp\c3\adritu humano.") ;; #0185 es
  (data (i32.const 241692) "El duelo y la resiliencia conviven.") ;; #0186 es
  (data (i32.const 241727) "Lo que importa no es si te derriban; es si te levantas.") ;; #0187 es
  (data (i32.const 241782) "No importa lo fuerte que golpees. Importa cu\c3\a1nto aguantas que te golpeen y seguir avanzando.") ;; #0188 es
  (data (i32.const 241875) "Buena parte del arte de vivir es la resiliencia.") ;; #0189 es
  (data (i32.const 241923) "Nada es imposible. La propia palabra, en ingl\c3\a9s, lo dice: \22I'm possible\22, \c2\a1soy posible!") ;; #0190 es
  (data (i32.const 242012) "Las estrellas no brillan sin oscuridad.") ;; #0191 es
  (data (i32.const 242051) "La herida es el lugar por donde entra la Luz.") ;; #0192 es
  (data (i32.const 242096) "Cuando est\c3\a1 lo bastante oscuro, se pueden ver las estrellas.") ;; #0193 es
  (data (i32.const 242157) "El fuego es la prueba del oro; la adversidad, la de los hombres fuertes.") ;; #0194 es
  (data (i32.const 242229) "Las dificultades fortalecen la mente, como el trabajo fortalece el cuerpo.") ;; #0195 es
  (data (i32.const 242303) "Aunque nadie puede volver atr\c3\a1s y empezar de nuevo, cualquiera puede empezar ahora y crear un nuevo final.") ;; #0196 es
  (data (i32.const 242410) "He estado absolutamente aterrada en cada momento de mi vida y nunca he dejado que eso me impidiera hacer una sola cosa que quisiera.") ;; #0197 es
  (data (i32.const 242542) "La tristeza es la forma en que aprendemos a amar. Tu coraz\c3\b3n no se est\c3\a1 rompiendo. Duele porque se est\c3\a1 haciendo m\c3\a1s grande.") ;; #0198 es
  (data (i32.const 242670) "Cuando eliges la esperanza, todo es posible.") ;; #0199 es
  (data (i32.const 242714) "No dejes que lo que no puedes hacer interfiera con lo que s\c3\ad puedes hacer.") ;; #0200 es
  (data (i32.const 242789) "La mejor salida siempre es atravesar.") ;; #0201 es
  (data (i32.const 242826) "En dos palabras puedo resumir todo lo que he aprendido de la vida: sigue adelante.") ;; #0202 es
  (data (i32.const 242908) "La vitalidad se demuestra no solo en la capacidad de persistir, sino en la de volver a empezar.") ;; #0203 es
  (data (i32.const 243003) "Pero el hombre no est\c3\a1 hecho para la derrota. Un hombre puede ser destruido, pero no derrotado.") ;; #0204 es
  (data (i32.const 243099) "La vida no siempre consiste en tener buenas cartas, sino a veces en jugar bien una mala mano.") ;; #0205 es
  (data (i32.const 243192) "La esperanza es esa cosa con plumas que se posa en el alma.") ;; #0206 es
  (data (i32.const 243251) "Todo lo que se hace en el mundo se hace por la esperanza.") ;; #0207 es
  (data (i32.const 243308) "La esperanza es poder ver que hay luz a pesar de toda la oscuridad.") ;; #0208 es
  (data (i32.const 243375) "Debemos aceptar la decepci\c3\b3n finita, pero nunca perder la esperanza infinita.") ;; #0209 es
  (data (i32.const 243453) "Solo en la oscuridad puedes ver las estrellas.") ;; #0210 es
  (data (i32.const 243499) "Incluso la noche m\c3\a1s oscura terminar\c3\a1, y el sol saldr\c3\a1.") ;; #0211 es
  (data (i32.const 243557) "El optimismo es la fe que conduce al logro. Nada puede hacerse sin esperanza y confianza.") ;; #0212 es
  (data (i32.const 243646) "Mant\c3\a9n los ojos en las estrellas y los pies en la tierra.") ;; #0213 es
  (data (i32.const 243704) "La esperanza es un sue\c3\b1o despierto.") ;; #0214 es
  (data (i32.const 243740) "Mientras hay vida, hay esperanza.") ;; #0215 es
  (data (i32.const 243773) "Hay algo bueno en este mundo, y vale la pena luchar por ello.") ;; #0216 es
  (data (i32.const 243834) "La esperanza es algo bueno, quiz\c3\a1 lo mejor de todo, y lo bueno nunca muere.") ;; #0217 es
  (data (i32.const 243910) "La hora m\c3\a1s oscura solo tiene sesenta minutos.") ;; #0218 es
  (data (i32.const 243957) "Nunca pierdas la esperanza. Las tormentas hacen m\c3\a1s fuertes a las personas y nunca duran para siempre.") ;; #0219 es
  (data (i32.const 244060) "La esperanza sonr\c3\ade desde el umbral del a\c3\b1o que viene y susurra: \22ser\c3\a1 m\c3\a1s feliz\22.") ;; #0220 es
  (data (i32.const 244146) "Vivir sin esperanza es dejar de vivir.") ;; #0221 es
  (data (i32.const 244184) "En todas las cosas, es mejor tener esperanza que desesperar.") ;; #0222 es
  (data (i32.const 244244) "La esperanza es importante porque puede hacer que el presente sea menos dif\c3\adcil de soportar.") ;; #0223 es
  (data (i32.const 244337) "Por largo que sea el invierno, la primavera siempre llega despu\c3\a9s.") ;; #0224 es
  (data (i32.const 244404) "No hay mal que por bien no venga.") ;; #0225 es
  (data (i32.const 244437) "El propio sol es d\c3\a9bil cuando sale, y va ganando fuerza y valor a medida que avanza el d\c3\ada.") ;; #0226 es
  (data (i32.const 244530) "La esperanza es lo \c3\banico m\c3\a1s fuerte que el miedo.") ;; #0227 es
  (data (i32.const 244581) "La felicidad se puede encontrar incluso en los momentos m\c3\a1s oscuros, si uno recuerda encender la luz.") ;; #0228 es
  (data (i32.const 244683) "La esperanza empieza en la oscuridad: la esperanza terca de que, si simplemente te presentas e intentas hacer lo correcto, llegar\c3\a1 el amanecer.") ;; #0229 es
  (data (i32.const 244827) "Deja que tus esperanzas, y no tus heridas, den forma a tu futuro.") ;; #0230 es
  (data (i32.const 244892) "La esperanza es renovable: si se te acaba al final del d\c3\ada, puedes volver a empezar por la ma\c3\b1ana.") ;; #0231 es
  (data (i32.const 244992) "Lo que el ox\c3\adgeno es para los pulmones, eso es la esperanza para el sentido de la vida.") ;; #0232 es
  (data (i32.const 245080) "Lo m\c3\adnimo que puedes hacer en la vida es descubrir qu\c3\a9 es lo que esperas.") ;; #0233 es
  (data (i32.const 245155) "No hay medicina como la esperanza, ni incentivo tan grande, ni t\c3\b3nico tan poderoso como la expectativa de algo mejor ma\c3\b1ana.") ;; #0234 es
  (data (i32.const 245281) "La esperanza es el pilar que sostiene el mundo.") ;; #0235 es
  (data (i32.const 245328) "La esperanza nunca guardar\c3\a1 silencio.") ;; #0236 es
  (data (i32.const 245366) "Por la noche durar\c3\a1 el llanto, y a la ma\c3\b1ana vendr\c3\a1 la alegr\c3\ada.") ;; #0237 es
  (data (i32.const 245433) "\c2\a1Envejece conmigo! Lo mejor est\c3\a1 por venir.") ;; #0238 es
  (data (i32.const 245478) "\c2\bfNo es agradable pensar que ma\c3\b1ana es un d\c3\ada nuevo, todav\c3\ada sin errores?") ;; #0239 es
  (data (i32.const 245554) "Despu\c3\a9s de todo, ma\c3\b1ana ser\c3\a1 otro d\c3\ada.") ;; #0240 es
  (data (i32.const 245596) "La esperanza es paciencia con la l\c3\a1mpara encendida.") ;; #0241 es
  (data (i32.const 245648) "Estoy preparado para lo peor, pero espero lo mejor.") ;; #0242 es
  (data (i32.const 245699) "Nunca necesitamos perder la esperanza, porque nunca podemos rompernos sin remedio.") ;; #0243 es
  (data (i32.const 245781) "No nos lamentaremos; al contrario, encontraremos fuerza en lo que queda.") ;; #0244 es
  (data (i32.const 245853) "S\c3\a9 como el p\c3\a1jaro que, al posarse en una rama demasiado fr\c3\a1gil, la siente ceder bajo sus patas y, aun as\c3\ad, canta, sabiendo que tiene alas.") ;; #0245 es
  (data (i32.const 245995) "Mientras respiro, tengo esperanza.") ;; #0246 es
  (data (i32.const 246029) "Puede que no todos los d\c3\adas sean buenos, pero hay algo bueno en cada d\c3\ada.") ;; #0247 es
  (data (i32.const 246104) "En lo m\c3\a1s profundo del invierno, aprend\c3\ad por fin que dentro de m\c3\ad hab\c3\ada un verano invencible.") ;; #0248 es
  (data (i32.const 246201) "Es en nuestros momentos m\c3\a1s oscuros cuando debemos concentrarnos para ver la luz.") ;; #0249 es
  (data (i32.const 246283) "El mundo es redondo, y el lugar que puede parecer el final quiz\c3\a1 sea solo el comienzo.") ;; #0250 es
  (data (i32.const 246370) "La fe es el p\c3\a1jaro que siente la luz y canta cuando el amanecer todav\c3\ada est\c3\a1 oscuro.") ;; #0251 es
  (data (i32.const 246457) "Por larga que sea la noche, el d\c3\ada amanecer\c3\a1.") ;; #0252 es
  (data (i32.const 246504) "Sujeta bien tu sombrero. Sujeta bien tu esperanza. Y dale cuerda al reloj, porque ma\c3\b1ana ser\c3\a1 otro d\c3\ada.") ;; #0253 es
  (data (i32.const 246610) "Hay cosas mucho, much\c3\adsimo mejores por delante que cualquiera que dejemos atr\c3\a1s.") ;; #0254 es
  (data (i32.const 246692) "A pesar de todo, sigo creyendo que la gente es buena de coraz\c3\b3n.") ;; #0255 es
  (data (i32.const 246757) "Piensa en toda la belleza que todav\c3\ada queda a tu alrededor y s\c3\a9 feliz.") ;; #0256 es
  (data (i32.const 246829) "A menudo es en los cielos m\c3\a1s oscuros donde vemos las estrellas m\c3\a1s brillantes.") ;; #0257 es
  (data (i32.const 246910) "La fuerza y el crecimiento solo llegan con esfuerzo y lucha continuos.") ;; #0258 es
  (data (i32.const 246980) "De tus vulnerabilidades nacer\c3\a1 tu fuerza.") ;; #0259 es
  (data (i32.const 247022) "Una mujer es como una bolsita de t\c3\a9: no sabes lo fuerte que es hasta que la pones en agua caliente.") ;; #0260 es
  (data (i32.const 247122) "La fuerza es producto de la lucha. Tienes que hacer lo que otros no hacen para lograr lo que otros no logran.") ;; #0261 es
  (data (i32.const 247231) "Los m\c3\a1s fuertes de todos los guerreros son estos dos: el tiempo y la paciencia.") ;; #0262 es
  (data (i32.const 247311) "Nadie puede hacerte sentir inferior sin tu consentimiento.") ;; #0263 es
  (data (i32.const 247369) "Tienes poder sobre tu mente, no sobre los acontecimientos externos. Date cuenta de esto y encontrar\c3\a1s la fuerza.") ;; #0264 es
  (data (i32.const 247482) "El impedimento a la acci\c3\b3n hace avanzar la acci\c3\b3n. Lo que se interpone en el camino se convierte en el camino.") ;; #0265 es
  (data (i32.const 247594) "Si algo externo te angustia, el dolor no se debe a la cosa en s\c3\ad, sino a tu valoraci\c3\b3n de ella; y eso tienes el poder de cambiarlo en cualquier momento.") ;; #0266 es
  (data (i32.const 247748) "No pierdas m\c3\a1s tiempo discutiendo c\c3\b3mo debe ser un hombre bueno. S\c3\a9 uno.") ;; #0267 es
  (data (i32.const 247823) "S\c3\a9 como el promontorio contra el que rompen sin cesar las olas: permanece firme y calma la furia del agua a su alrededor.") ;; #0268 es
  (data (i32.const 247945) "De peque\c3\b1as bellotas crecen grandes robles.") ;; #0269 es
  (data (i32.const 247989) "No es porque las cosas sean dif\c3\adciles que no nos atrevemos; es porque no nos atrevemos que son dif\c3\adciles.") ;; #0270 es
  (data (i32.const 248096) "Sufrimos m\c3\a1s a menudo en la imaginaci\c3\b3n que en la realidad.") ;; #0271 es
  (data (i32.const 248157) "Dominar a los dem\c3\a1s es fuerza. Dominarse a s\c3\ad mismo es el verdadero poder.") ;; #0272 es
  (data (i32.const 248233) "Aunque alguien venza mil veces a mil hombres en batalla, el m\c3\a1s noble vencedor es quien se vence a s\c3\ad mismo.") ;; #0273 es
  (data (i32.const 248343) "La fuerza est\c3\a1 en las diferencias, no en las semejanzas.") ;; #0274 es
  (data (i32.const 248400) "Los d\c3\a9biles nunca pueden perdonar. El perd\c3\b3n es atributo de los fuertes.") ;; #0275 es
  (data (i32.const 248474) "La fuerza no viene de ganar. Son tus luchas las que desarrollan tu fuerza.") ;; #0276 es
  (data (i32.const 248548) "La fuerza es cuesti\c3\b3n de una mente decidida.") ;; #0277 es
  (data (i32.const 248593) "Soy el amo de mi destino, soy el capit\c3\a1n de mi alma.") ;; #0278 es
  (data (i32.const 248646) "Doy gracias a los dioses, sean cuales sean, por mi alma invencible.") ;; #0279 es
  (data (i32.const 248713) "Un h\c3\a9roe es una persona com\c3\ban que encuentra la fuerza para perseverar y resistir a pesar de obst\c3\a1culos abrumadores.") ;; #0280 es
  (data (i32.const 248831) "Lo que queda atr\c3\a1s y lo que tenemos por delante son asuntos min\c3\basculos comparados con lo que hay dentro de nosotros.") ;; #0281 es
  (data (i32.const 248949) "La mayor prueba de valor en la Tierra es soportar la derrota sin perder el \c3\a1nimo.") ;; #0282 es
  (data (i32.const 249031) "De todas las virtudes que podemos aprender, ning\c3\ban rasgo es m\c3\a1s \c3\batil, m\c3\a1s esencial para sobrevivir y m\c3\a1s capaz de mejorar la calidad de vida que la capacidad de transformar la adversidad en un desaf\c3\ado placentero.") ;; #0283 es
  (data (i32.const 249249) "Si no hay lucha, no hay progreso.") ;; #0284 es
  (data (i32.const 249282) "S\c3\a9 la hero\c3\adna de tu vida, no la v\c3\adctima.") ;; #0285 es
  (data (i32.const 249325) "Ponte derecha y date cuenta de qui\c3\a9n eres: alguien m\c3\a1s grande que tus circunstancias.") ;; #0286 es
  (data (i32.const 249412) "Nunca agaches la cabeza. Mantenla siempre en alto. Mira al mundo directamente a los ojos.") ;; #0287 es
  (data (i32.const 249501) "No hay nada m\c3\a1s fuerte en el mundo que la dulzura.") ;; #0288 es
  (data (i32.const 249552) "Nada es tan fuerte como la dulzura, nada tan dulce como la verdadera fuerza.") ;; #0289 es
  (data (i32.const 249628) "El roble duerme en la bellota.") ;; #0290 es
  (data (i32.const 249658) "Con el nuevo d\c3\ada llegan nuevas fuerzas y nuevos pensamientos.") ;; #0291 es
  (data (i32.const 249720) "Nuestra fuerza nace de nuestras debilidades.") ;; #0292 es
  (data (i32.const 249764) "La fortaleza es la guardiana y el sost\c3\a9n de las dem\c3\a1s virtudes.") ;; #0293 es
  (data (i32.const 249829) "No soy un p\c3\a1jaro, y ninguna red me atrapa: soy un ser humano libre, con voluntad propia.") ;; #0294 es
  (data (i32.const 249918) "Mi misi\c3\b3n en la vida no es solo sobrevivir, sino prosperar.") ;; #0295 es
  (data (i32.const 249978) "No puedes dudar de qui\c3\a9n eres.") ;; #0296 es
  (data (i32.const 250009) "La forma m\c3\a1s com\c3\ban en que las personas renuncian a su poder es creer que no tienen ninguno.") ;; #0297 es
  (data (i32.const 250102) "Piensa como una reina. Una reina no tiene miedo a fracasar.") ;; #0298 es
  (data (i32.const 250161) "Descubre qui\c3\a9n eres y s\c3\a9lo a prop\c3\b3sito.") ;; #0299 es
  (data (i32.const 250203) "Nunca debes tener miedo de lo que haces cuando es lo correcto.") ;; #0300 es
  (data (i32.const 250265) "Cuando ellos caen bajo, nosotros nos elevamos.") ;; #0301 es
  (data (i32.const 250311) "La habilidad puede llevarte a la cima, pero hace falta car\c3\a1cter para mantenerte all\c3\ad.") ;; #0302 es
  (data (i32.const 250398) "Cuando no hay enemigo dentro, los enemigos de fuera no pueden hacerte da\c3\b1o.") ;; #0303 es
  (data (i32.const 250474) "Nuestro miedo m\c3\a1s profundo no es ser insuficientes. Nuestro miedo m\c3\a1s profundo es ser poderosos m\c3\a1s all\c3\a1 de toda medida.") ;; #0304 es
  (data (i32.const 250598) "Conf\c3\ada en ti mismo: todo coraz\c3\b3n vibra con esa cuerda de hierro.") ;; #0305 es
  (data (i32.const 250664) "T\c3\ba eres quien tiene las llaves de tu ser. T\c3\ba llevas el pasaporte hacia tu propia felicidad.") ;; #0306 es
  (data (i32.const 250757) "Somos lo que hacemos repetidamente. La excelencia, entonces, no es un acto, sino un h\c3\a1bito.") ;; #0307 es
  (data (i32.const 250849) "La disciplina es el puente entre las metas y los logros.") ;; #0308 es
  (data (i32.const 250905) "Todos debemos sufrir una de dos cosas: el dolor de la disciplina o el dolor del arrepentimiento.") ;; #0309 es
  (data (i32.const 251001) "La motivaci\c3\b3n es lo que te pone en marcha. El h\c3\a1bito es lo que te mantiene en marcha.") ;; #0310 es
  (data (i32.const 251088) "El \c3\a9xito no es m\c3\a1s que unas pocas disciplinas sencillas practicadas cada d\c3\ada.") ;; #0311 es
  (data (i32.const 251168) "No desees que fuera m\c3\a1s f\c3\a1cil; desea ser mejor.") ;; #0312 es
  (data (i32.const 251217) "O diriges el d\c3\ada, o el d\c3\ada te dirige a ti.") ;; #0313 es
  (data (i32.const 251261) "Con autodisciplina, casi todo es posible.") ;; #0314 es
  (data (i32.const 251302) "El guerrero exitoso es un hombre com\c3\ban con un enfoque de l\c3\a1ser.") ;; #0315 es
  (data (i32.const 251367) "No temo al hombre que ha practicado 10.000 patadas una vez, sino al que ha practicado una patada 10.000 veces.") ;; #0316 es
  (data (i32.const 251477) "Disciplina es elegir entre lo que quieres ahora y lo que m\c3\a1s quieres.") ;; #0317 es
  (data (i32.const 251547) "Ning\c3\ban hombre es libre si no es due\c3\b1o de s\c3\ad mismo.") ;; #0318 es
  (data (i32.const 251600) "Primero dite a ti mismo lo que quieres ser; luego haz lo que tengas que hacer.") ;; #0319 es
  (data (i32.const 251678) "La autodisciplina es el poder m\c3\a1gico que te vuelve pr\c3\a1cticamente imparable.") ;; #0320 es
  (data (i32.const 251755) "El precio de la excelencia es la disciplina. El costo de la mediocridad es la decepci\c3\b3n.") ;; #0321 es
  (data (i32.const 251844) "El trabajo duro vence al talento cuando el talento no trabaja duro.") ;; #0322 es
  (data (i32.const 251911) "Peque\c3\b1as disciplinas repetidas con constancia cada d\c3\ada conducen a grandes logros alcanzados poco a poco.") ;; #0323 es
  (data (i32.const 252017) "Nunca cambiar\c3\a1s tu vida hasta que cambies algo que haces a diario.") ;; #0324 es
  (data (i32.const 252084) "La excelencia es el resultado gradual de esforzarse siempre por hacerlo mejor.") ;; #0325 es
  (data (i32.const 252162) "Los campeones siguen jugando hasta hacerlo bien.") ;; #0326 es
  (data (i32.const 252210) "Odi\c3\a9 cada minuto del entrenamiento, pero me dec\c3\ada: no abandones. Sufre ahora y vive el resto de tu vida como un campe\c3\b3n.") ;; #0327 es
  (data (i32.const 252333) "La pelea se gana o se pierde lejos de los testigos, tras bambalinas, en el gimnasio y en la carretera, mucho antes de que yo baile bajo esas luces.") ;; #0328 es
  (data (i32.const 252480) "No cuentes los d\c3\adas; haz que los d\c3\adas cuenten.") ;; #0329 es
  (data (i32.const 252528) "La dedicaci\c3\b3n hace realidad los sue\c3\b1os.") ;; #0330 es
  (data (i32.const 252569) "Descansa al final, no a la mitad.") ;; #0331 es
  (data (i32.const 252602) "No hay atajos hacia ning\c3\ban lugar que valga la pena.") ;; #0332 es
  (data (i32.const 252654) "El \c3\banico lugar donde el \c3\a9xito viene antes que el trabajo es en el diccionario.") ;; #0333 es
  (data (i32.const 252734) "El talento es m\c3\a1s barato que la sal de mesa. Lo que separa a la persona talentosa de la exitosa es mucho trabajo duro.") ;; #0334 es
  (data (i32.const 252853) "Los aficionados se sientan a esperar la inspiraci\c3\b3n; los dem\c3\a1s simplemente nos levantamos y nos ponemos a trabajar.") ;; #0335 es
  (data (i32.const 252970) "Cuanto m\c3\a1s practico, m\c3\a1s suerte tengo.") ;; #0336 es
  (data (i32.const 253010) "No esperes a que el hierro est\c3\a9 caliente para golpearlo; cali\c3\a9ntalo a golpes.") ;; #0337 es
  (data (i32.const 253089) "El respeto por uno mismo es fruto de la disciplina; el sentido de la dignidad crece con la capacidad de decirse que no.") ;; #0338 es
  (data (i32.const 253208) "Lo que haces cada d\c3\ada importa m\c3\a1s que lo que haces de vez en cuando.") ;; #0339 es
  (data (i32.const 253278) "La disciplina es libertad.") ;; #0340 es
  (data (i32.const 253304) "Concentra todos tus pensamientos en el trabajo que tienes entre manos. Los rayos del sol no queman hasta que se concentran en un punto.") ;; #0341 es
  (data (i32.const 253439) "Bien hecho es mejor que bien dicho.") ;; #0342 es
  (data (i32.const 253474) "El tiempo perdido nunca se recupera.") ;; #0343 es
  (data (i32.const 253510) "Sin trabajo duro, solo crecen las malas hierbas.") ;; #0344 es
  (data (i32.const 253558) "El \c3\a9xito no siempre tiene que ver con la grandeza. Tiene que ver con la constancia.") ;; #0345 es
  (data (i32.const 253642) "El \c3\a9xito no es casualidad. Es trabajo duro, perseverancia, aprendizaje, estudio, sacrificio y, sobre todo, amor por lo que haces.") ;; #0346 es
  (data (i32.const 253772) "La voluntad de ganar es importante, pero la voluntad de prepararse es vital.") ;; #0347 es
  (data (i32.const 253848) "Nunca so\c3\b1\c3\a9 con el \c3\a9xito. Trabaj\c3\a9 para conseguirlo.") ;; #0348 es
  (data (i32.const 253902) "Nada funcionar\c3\a1 a menos que t\c3\ba trabajes.") ;; #0349 es
  (data (i32.const 253944) "El h\c3\a1bito es el mejor de los sirvientes o el peor de los amos.") ;; #0350 es
  (data (i32.const 254007) "Primero hacemos nuestros h\c3\a1bitos, y luego nuestros h\c3\a1bitos nos hacen a nosotros.") ;; #0351 es
  (data (i32.const 254089) "Es el comienzo lo que detiene a la mayor\c3\ada de las personas.") ;; #0352 es
  (data (i32.const 254149) "La pr\c3\a1ctica no es lo que haces cuando ya eres bueno. Es lo que haces para llegar a serlo.") ;; #0353 es
  (data (i32.const 254239) "Haz hoy algo que tu yo del futuro te agradecer\c3\a1.") ;; #0354 es
  (data (i32.const 254288) "Conc\c3\a9ntrate en ser productivo, no en estar ocupado.") ;; #0355 es
  (data (i32.const 254340) "La disciplina es recordar lo que quieres.") ;; #0356 es
  (data (i32.const 254381) "Haz de cada d\c3\ada tu obra maestra.") ;; #0357 es
  (data (i32.const 254414) "S\c3\a9 r\c3\a1pido, pero no te apresures.") ;; #0358 es
  (data (i32.const 254448) "No temas crecer despacio; teme solo quedarte quieto.") ;; #0359 es
  (data (i32.const 254500) "La \c3\banica forma de entender el cambio es sumergirse en \c3\a9l, moverse con \c3\a9l y unirse al baile.") ;; #0360 es
  (data (i32.const 254594) "La vida es como andar en bicicleta. Para mantener el equilibrio, hay que seguir movi\c3\a9ndose.") ;; #0361 es
  (data (i32.const 254686) "Siempre dicen que el tiempo cambia las cosas, pero en realidad tienes que cambiarlas t\c3\ba mismo.") ;; #0362 es
  (data (i32.const 254781) "El progreso es imposible sin cambio, y quienes no pueden cambiar su mente no pueden cambiar nada.") ;; #0363 es
  (data (i32.const 254878) "El cambio es la ley de la vida. Y quienes miran solo al pasado o al presente seguramente se perder\c3\a1n el futuro.") ;; #0364 es
  (data (i32.const 254990) "El secreto del cambio es concentrar toda tu energ\c3\ada no en luchar contra lo viejo, sino en construir lo nuevo.") ;; #0365 es
  (data (i32.const 255100) "Lo que obtienes al alcanzar tus metas no es tan importante como en qui\c3\a9n te conviertes al alcanzarlas.") ;; #0366 es
  (data (i32.const 255203) "Crecer duele. Cambiar duele. Pero nada duele tanto como quedarse atrapado en un lugar al que no perteneces.") ;; #0367 es
  (data (i32.const 255310) "Y lleg\c3\b3 el d\c3\ada en que el riesgo de seguir cerrada en un capullo fue m\c3\a1s doloroso que el riesgo de florecer.") ;; #0368 es
  (data (i32.const 255420) "Siempre estoy haciendo lo que no s\c3\a9 hacer, para poder aprender a hacerlo.") ;; #0369 es
  (data (i32.const 255494) "Si no intentas hacer algo m\c3\a1s all\c3\a1 de lo que ya dominas, nunca crecer\c3\a1s.") ;; #0370 es
  (data (i32.const 255569) "Sabemos lo que somos, pero no lo que podemos llegar a ser.") ;; #0371 es
  (data (i32.const 255627) "Nuestras dudas son traidoras y nos hacen perder el bien que a menudo podr\c3\adamos ganar, por miedo a intentarlo.") ;; #0372 es
  (data (i32.const 255737) "Si hici\c3\a9ramos todo aquello de lo que somos capaces, literalmente nos asombrar\c3\adamos.") ;; #0373 es
  (data (i32.const 255822) "El mejor momento para plantar un \c3\a1rbol fue hace 20 a\c3\b1os. El segundo mejor momento es ahora.") ;; #0374 es
  (data (i32.const 255915) "Haz lo que puedas, con lo que tengas, donde est\c3\a9s.") ;; #0375 es
  (data (i32.const 255966) "Dentro de un a\c3\b1o, quiz\c3\a1 desees haber empezado hoy.") ;; #0376 es
  (data (i32.const 256018) "Cambia tus pensamientos y cambiar\c3\a1s tu mundo.") ;; #0377 es
  (data (i32.const 256064) "No puedes cambiar tu destino de la noche a la ma\c3\b1ana, pero s\c3\ad puedes cambiar tu direcci\c3\b3n de la noche a la ma\c3\b1ana.") ;; #0378 es
  (data (i32.const 256182) "Todos piensan en cambiar el mundo, pero nadie piensa en cambiarse a s\c3\ad mismo.") ;; #0379 es
  (data (i32.const 256260) "Mejorar es cambiar; ser perfecto es cambiar a menudo.") ;; #0380 es
  (data (i32.const 256313) "El crecimiento empieza cuando comenzamos a aceptar nuestra propia debilidad.") ;; #0381 es
  (data (i32.const 256389) "El mayor descubrimiento de mi generaci\c3\b3n es que un ser humano puede cambiar su vida cambiando sus actitudes.") ;; #0382 es
  (data (i32.const 256498) "Nunca eres demasiado mayor para fijarte otra meta o so\c3\b1ar un nuevo sue\c3\b1o.") ;; #0383 es
  (data (i32.const 256573) "Act\c3\baa como si lo que haces marcara la diferencia. La marca.") ;; #0384 es
  (data (i32.const 256633) "Lo que m\c3\a1s tememos hacer suele ser lo que m\c3\a1s necesitamos hacer.") ;; #0385 es
  (data (i32.const 256699) "La zona de confort es un lugar hermoso, pero all\c3\ad nunca crece nada.") ;; #0386 es
  (data (i32.const 256767) "No seguir\c3\a9 adonde lleve el camino; ir\c3\a9 donde no hay camino y dejar\c3\a9 un sendero.") ;; #0387 es
  (data (i32.const 256849) "Llegar a ser es mejor que ser.") ;; #0388 es
  (data (i32.const 256879) "No todo lo que se enfrenta puede cambiarse, pero nada puede cambiarse hasta que se enfrenta.") ;; #0389 es
  (data (i32.const 256971) "Tus circunstancias actuales no determinan ad\c3\b3nde puedes llegar; solo determinan d\c3\b3nde empiezas.") ;; #0390 es
  (data (i32.const 257068) "Un d\c3\ada te despertar\c3\a1s y ya no habr\c3\a1 tiempo para hacer las cosas que siempre quisiste. Hazlas ahora.") ;; #0391 es
  (data (i32.const 257170) "Haz lo mejor que puedas hasta que sepas hacerlo mejor. Cuando sepas hacerlo mejor, hazlo mejor.") ;; #0392 es
  (data (i32.const 257265) "Lo bonito de aprender es que nadie te lo puede quitar.") ;; #0393 es
  (data (i32.const 257319) "La educaci\c3\b3n es el arma m\c3\a1s poderosa que puedes usar para cambiar el mundo.") ;; #0394 es
  (data (i32.const 257396) "Quien no vence alg\c3\ban miedo cada d\c3\ada no ha aprendido el secreto de la vida.") ;; #0395 es
  (data (i32.const 257472) "La vida empieza donde termina tu zona de confort.") ;; #0396 es
  (data (i32.const 257521) "No puedo cambiar la direcci\c3\b3n del viento, pero puedo ajustar mis velas para llegar siempre a mi destino.") ;; #0397 es
  (data (i32.const 257626) "No podemos llegar a ser lo que queremos si seguimos siendo lo que somos.") ;; #0398 es
  (data (i32.const 257698) "Poco a poco, lo poco se vuelve mucho.") ;; #0399 es
  (data (i32.const 257735) "No hay nada permanente, excepto el cambio.") ;; #0400 es
  (data (i32.const 257777) "Nadie se ba\c3\b1a dos veces en el mismo r\c3\ado, porque ya no es el mismo r\c3\ado ni \c3\a9l es el mismo hombre.") ;; #0401 es
  (data (i32.const 257876) "Sin crecimiento y progreso continuos, palabras como mejora, logro y \c3\a9xito no tienen sentido.") ;; #0402 es
  (data (i32.const 257969) "Lo que ha de dar luz debe soportar arder.") ;; #0403 es
  (data (i32.const 258010) "Lo que importa no es lo que te pasa, sino c\c3\b3mo reaccionas ante ello.") ;; #0404 es
  (data (i32.const 258079) "Empieza ya a vivir, y cuenta cada d\c3\ada como una vida aparte.") ;; #0405 es
  (data (i32.const 258139) "Empieza donde est\c3\a1s. Usa lo que tienes. Haz lo que puedes.") ;; #0406 es
  (data (i32.const 258198) "Disfrutamos de la belleza de la mariposa, pero rara vez reconocemos los cambios por los que pas\c3\b3 para alcanzar esa belleza.") ;; #0407 es
  (data (i32.const 258322) "No es la especie m\c3\a1s fuerte la que sobrevive, ni la m\c3\a1s inteligente, sino la que mejor responde al cambio.") ;; #0408 es
  (data (i32.const 258430) "Cuando suelto lo que soy, me convierto en lo que podr\c3\ada ser.") ;; #0409 es
  (data (i32.const 258491) "No puedo volver al ayer, porque entonces era una persona distinta.") ;; #0410 es
  (data (i32.const 258557) "El cambio real, el que perdura, sucede paso a paso.") ;; #0411 es
  (data (i32.const 258608) "Me ense\c3\b1aron que el camino del progreso no es r\c3\a1pido ni f\c3\a1cil.") ;; #0412 es
  (data (i32.const 258673) "La adversidad hace que algunos hombres se quiebren; y que otros rompan r\c3\a9cords.") ;; #0413 es
  (data (i32.const 258753) "La prosperidad no est\c3\a1 libre de temores y disgustos, ni la adversidad de consuelos y esperanzas.") ;; #0414 es
  (data (i32.const 258850) "La adversidad es el primer camino hacia la verdad.") ;; #0415 es
  (data (i32.const 258900) "Las cometas se elevan m\c3\a1s alto contra el viento, no a favor de \c3\a9l.") ;; #0416 es
  (data (i32.const 258968) "La adversidad tiene el efecto de despertar talentos que, en tiempos pr\c3\b3speros, habr\c3\adan permanecido dormidos.") ;; #0417 es
  (data (i32.const 259078) "El bloque de granito que era un obst\c3\a1culo en el camino del d\c3\a9bil se convierte en un pelda\c3\b1o en el camino del fuerte.") ;; #0418 es
  (data (i32.const 259197) "Los obst\c3\a1culos son esas cosas aterradoras que ves cuando apartas la vista de tu meta.") ;; #0419 es
  (data (i32.const 259283) "Los obst\c3\a1culos no tienen por qu\c3\a9 detenerte. Si chocas contra un muro, no te des la vuelta ni te rindas. Descubre c\c3\b3mo escalarlo, atravesarlo o rodearlo.") ;; #0420 es
  (data (i32.const 259438) "Los problemas no son se\c3\b1ales de alto; son se\c3\b1ales de orientaci\c3\b3n.") ;; #0421 es
  (data (i32.const 259506) "Vuelve el rostro hacia el sol y las sombras quedar\c3\a1n detr\c3\a1s de ti.") ;; #0422 es
  (data (i32.const 259574) "El hombre de car\c3\a1cter encuentra un atractivo especial en la dificultad.") ;; #0423 es
  (data (i32.const 259646) "Las dificultades existen para despertar, no para desanimar. El esp\c3\adritu humano est\c3\a1 hecho para fortalecerse en el conflicto.") ;; #0424 es
  (data (i32.const 259772) "Si no puedes volar, corre; si no puedes correr, camina; si no puedes caminar, gatea; pero hagas lo que hagas, sigue avanzando.") ;; #0425 es
  (data (i32.const 259898) "La verdadera medida de un hombre no es d\c3\b3nde se sit\c3\baa en momentos de comodidad y conveniencia, sino d\c3\b3nde se sit\c3\baa en tiempos de desaf\c3\ado y controversia.") ;; #0426 es
  (data (i32.const 260055) "La oscuridad no puede expulsar a la oscuridad; solo la luz puede hacerlo.") ;; #0427 es
  (data (i32.const 260128) "La fe es dar el primer paso aunque no veas toda la escalera.") ;; #0428 es
  (data (i32.const 260188) "No hay escuela como la adversidad.") ;; #0429 es
  (data (i32.const 260222) "Lo que duele, ense\c3\b1a.") ;; #0430 es
  (data (i32.const 260244) "La adversidad es como un viento fuerte. Nos arranca todo menos lo que no puede arrancarse, para que nos veamos tal como somos.") ;; #0431 es
  (data (i32.const 260370) "Lo que embellece al desierto es que en alguna parte esconde un pozo.") ;; #0432 es
  (data (i32.const 260438) "El pesimista ve dificultad en cada oportunidad. El optimista ve oportunidad en cada dificultad.") ;; #0433 es
  (data (i32.const 260533) "Los desaf\c3\ados hacen interesante la vida, y superarlos es lo que le da sentido.") ;; #0434 es
  (data (i32.const 260611) "La adversidad es el polvo de diamante con el que el Cielo pule sus joyas.") ;; #0435 es
  (data (i32.const 260684) "Las tormentas hacen que los \c3\a1rboles echen ra\c3\adces m\c3\a1s profundas.") ;; #0436 es
  (data (i32.const 260750) "Tal como yo lo veo, si quieres el arco\c3\adris, tienes que aguantar la lluvia.") ;; #0437 es
  (data (i32.const 260825) "La vida no consiste en esperar a que pase la tormenta. Consiste en aprender a bailar bajo la lluvia.") ;; #0438 es
  (data (i32.const 260925) "La adversidad revela el genio; la prosperidad lo oculta.") ;; #0439 es
  (data (i32.const 260981) "Cuando las cosas se ponen dif\c3\adciles, los fuertes se ponen en marcha.") ;; #0440 es
  (data (i32.const 261050) "Un h\c3\a9roe no es m\c3\a1s valiente que un hombre com\c3\ban; solo es valiente cinco minutos m\c3\a1s.") ;; #0441 es
  (data (i32.const 261138) "La propia lucha hacia las cumbres basta para llenar el coraz\c3\b3n de un hombre. Hay que imaginarse a S\c3\adsifo feliz.") ;; #0442 es
  (data (i32.const 261251) "A veces la adversidad es justo lo que necesitas enfrentar para tener \c3\a9xito.") ;; #0443 es
  (data (i32.const 261327) "Los tiempos dif\c3\adciles no crean h\c3\a9roes. Es en los tiempos dif\c3\adciles cuando se revela el h\c3\a9roe que llevamos dentro.") ;; #0444 es
  (data (i32.const 261444) "Las monta\c3\b1as no se superan sino por caminos sinuosos.") ;; #0445 es
  (data (i32.const 261498) "El dolor es inevitable. El sufrimiento es opcional.") ;; #0446 es
  (data (i32.const 261549) "Los problemas son solo oportunidades con ropa de trabajo.") ;; #0447 es
  (data (i32.const 261606) "La calamidad es la prueba de la integridad.") ;; #0448 es
  (data (i32.const 261649) "La prosperidad hace amigos; la adversidad los pone a prueba.") ;; #0449 es
  (data (i32.const 261709) "Cualquiera puede llevar el tim\c3\b3n cuando el mar est\c3\a1 en calma.") ;; #0450 es
  (data (i32.const 261772) "Cuanto m\c3\a1s dura la batalla, m\c3\a1s dulce la victoria.") ;; #0451 es
  (data (i32.const 261824) "Dulces son los frutos de la adversidad.") ;; #0452 es
  (data (i32.const 261863) "Cada adversidad, cada fracaso, cada pena trae consigo la semilla de un beneficio igual o mayor.") ;; #0453 es
  (data (i32.const 261958) "Cuanto mayor es la dificultad, mayor es la gloria de superarla.") ;; #0454 es
  (data (i32.const 262021) "Las dificultades son las que muestran a una persona qui\c3\a9n es.") ;; #0455 es
  (data (i32.const 262083) "Ning\c3\ban \c3\a1rbol echa ra\c3\adces firmes si no lo azotan muchos vientos.") ;; #0456 es
  (data (i32.const 262149) "Es un camino \c3\a1spero el que conduce a las alturas de la grandeza.") ;; #0457 es
  (data (i32.const 262214) "Los caminos dif\c3\adciles a menudo llevan a destinos hermosos.") ;; #0458 es
  (data (i32.const 262273) "En medio del caos, tambi\c3\a9n hay oportunidad.") ;; #0459 es
  (data (i32.const 262317) "Lo que nos parecen pruebas amargas a menudo son bendiciones disfrazadas.") ;; #0460 es
  (data (i32.const 262389) "Los grandes esp\c3\adritus siempre han encontrado una oposici\c3\b3n violenta de las mentes mediocres.") ;; #0461 es
  (data (i32.const 262483) "El dolor pasa, pero la belleza permanece.") ;; #0462 es
  (data (i32.const 262524) "A las cosas les va mejor a quienes sacan el mejor partido de c\c3\b3mo salen las cosas.") ;; #0463 es
  (data (i32.const 262607) "Ahora no es momento de pensar en lo que no tienes. Piensa en lo que puedes hacer con lo que hay.") ;; #0464 es
  (data (i32.const 262703) "El obst\c3\a1culo es el camino.") ;; #0465 es
  (data (i32.const 262730) "Un viaje de mil millas comienza con un paso.") ;; #0466 es
  (data (i32.const 262774) "La acci\c3\b3n es la clave fundamental de todo \c3\a9xito.") ;; #0467 es
  (data (i32.const 262824) "No tienes que ser grande para empezar, pero tienes que empezar para ser grande.") ;; #0468 es
  (data (i32.const 262903) "La forma de empezar es dejar de hablar y comenzar a hacer.") ;; #0469 es
  (data (i32.const 262961) "No esperes; el momento nunca ser\c3\a1 el perfecto.") ;; #0470 es
  (data (i32.const 263008) "Saber no basta; hay que aplicar. Querer no basta; hay que hacer.") ;; #0471 es
  (data (i32.const 263072) "La acci\c3\b3n no siempre trae felicidad, pero no hay felicidad sin acci\c3\b3n.") ;; #0472 es
  (data (i32.const 263144) "Pensar no vencer\c3\a1 al miedo, pero actuar s\c3\ad.") ;; #0473 es
  (data (i32.const 263189) "Alg\c3\ban d\c3\ada no es un d\c3\ada de la semana.") ;; #0474 es
  (data (i32.const 263228) "Hecho es mejor que perfecto.") ;; #0475 es
  (data (i32.const 263256) "Peque\c3\b1as acciones realizadas son mejores que grandes acciones planeadas.") ;; #0476 es
  (data (i32.const 263329) "Fallas el 100% de los tiros que no haces.") ;; #0477 es
  (data (i32.const 263370) "La inspiraci\c3\b3n existe, pero tiene que encontrarte trabajando.") ;; #0478 es
  (data (i32.const 263432) "La visi\c3\b3n sin acci\c3\b3n es solo un sue\c3\b1o. La acci\c3\b3n sin visi\c3\b3n es solo pasar el tiempo. La visi\c3\b3n con acci\c3\b3n puede cambiar el mundo.") ;; #0479 es
  (data (i32.const 263568) "El futuro depende de lo que hagas hoy.") ;; #0480 es
  (data (i32.const 263606) "No dejes para ma\c3\b1ana lo que puedas hacer hoy.") ;; #0481 es
  (data (i32.const 263652) "Haz las cosas dif\c3\adciles mientras son f\c3\a1ciles, y las grandes mientras son peque\c3\b1as.") ;; #0482 es
  (data (i32.const 263737) "Empezar bien es tener la mitad hecha.") ;; #0483 es
  (data (i32.const 263774) "Si pasas demasiado tiempo pensando en algo, nunca lo har\c3\a1s.") ;; #0484 es
  (data (i32.const 263834) "Lo que haces habla tan alto que no puedo o\c3\adr lo que dices.") ;; #0485 es
  (data (i32.const 263893) "Avanza con confianza en la direcci\c3\b3n de tus sue\c3\b1os. Vive la vida que has imaginado.") ;; #0486 es
  (data (i32.const 263978) "Si has construido castillos en el aire, tu trabajo no est\c3\a1 perdido; ah\c3\ad es donde deben estar. Ahora ponles los cimientos.") ;; #0487 es
  (data (i32.const 264101) "Las ideas son f\c3\a1ciles. Lo dif\c3\adcil es llevarlas a cabo.") ;; #0488 es
  (data (i32.const 264157) "Empieza, s\c3\a9 audaz y atr\c3\a9vete a ser sabio.") ;; #0489 es
  (data (i32.const 264200) "Sue\c3\b1a en grande y atr\c3\a9vete a fracasar.") ;; #0490 es
  (data (i32.const 264240) "Nunca confundas movimiento con acci\c3\b3n.") ;; #0491 es
  (data (i32.const 264279) "No dejes que el ayer ocupe demasiado del hoy.") ;; #0492 es
  (data (i32.const 264324) "Aunque est\c3\a9s en el camino correcto, te atropellar\c3\a1n si te quedas quieto.") ;; #0493 es
  (data (i32.const 264398) "Una idea que no va acompa\c3\b1ada de acci\c3\b3n nunca crecer\c3\a1 m\c3\a1s all\c3\a1 de la neurona que ocupaba.") ;; #0494 es
  (data (i32.const 264492) "Hablar no cocina el arroz.") ;; #0495 es
  (data (i32.const 264518) "Si no es ahora, \c2\bfcu\c3\a1ndo?") ;; #0496 es
  (data (i32.const 264544) "Para empezar, empieza.") ;; #0497 es
  (data (i32.const 264566) "Persigue lo que conquista tu coraz\c3\b3n, no lo que llama la atenci\c3\b3n de tus ojos.") ;; #0498 es
  (data (i32.const 264646) "La vida es un diez por ciento lo que te pasa y un noventa por ciento c\c3\b3mo respondes a ello.") ;; #0499 es
  (data (i32.const 264738) "Si la oportunidad no llama, construye una puerta.") ;; #0500 es
  (data (i32.const 264787) "El \c3\banico viaje imposible es el que nunca empiezas.") ;; #0501 es
  (data (i32.const 264838) "Es en tus momentos de decisi\c3\b3n cuando se forja tu destino.") ;; #0502 es
  (data (i32.const 264897) "Fijarse metas es el primer paso para convertir lo invisible en visible.") ;; #0503 es
  (data (i32.const 264968) "Las oportunidades no suceden. Las creas t\c3\ba.") ;; #0504 es
  (data (i32.const 265012) "La duda mata m\c3\a1s sue\c3\b1os de los que el fracaso matar\c3\a1 jam\c3\a1s.") ;; #0505 es
  (data (i32.const 265075) "No te dejes empujar por los miedos de tu mente. D\c3\a9jate guiar por los sue\c3\b1os de tu coraz\c3\b3n.") ;; #0506 es
  (data (i32.const 265168) "Pon el coraz\c3\b3n, la mente y el alma incluso en tus actos m\c3\a1s peque\c3\b1os. Ese es el secreto del \c3\a9xito.") ;; #0507 es
  (data (i32.const 265270) "No se puede cruzar el mar solo qued\c3\a1ndose de pie mirando el agua.") ;; #0508 es
  (data (i32.const 265336) "Lo m\c3\a1s dif\c3\adcil es decidirse a actuar; lo dem\c3\a1s es pura tenacidad.") ;; #0509 es
  (data (i32.const 265404) "La forma m\c3\a1s eficaz de hacerlo es haci\c3\a9ndolo.") ;; #0510 es
  (data (i32.const 265451) "No te sientes a esperar que lleguen las oportunidades. Lev\c3\a1ntate y cr\c3\a9alas.") ;; #0511 es
  (data (i32.const 265528) "Qu\c3\a9 maravilloso es que nadie necesite esperar ni un solo instante para empezar a mejorar el mundo.") ;; #0512 es
  (data (i32.const 265627) "Una persona puede marcar la diferencia, y todos deber\c3\adan intentarlo.") ;; #0513 es
  (data (i32.const 265696) "Elegimos ir a la Luna en esta d\c3\a9cada, y hacer las otras cosas, no porque sean f\c3\a1ciles, sino porque son dif\c3\adciles.") ;; #0514 es
  (data (i32.const 265812) "Las oportunidades se multiplican a medida que se aprovechan.") ;; #0515 es
  (data (i32.const 265872) "No puedes esperar a la inspiraci\c3\b3n. Tienes que ir tras ella con un garrote.") ;; #0516 es
  (data (i32.const 265948) "Ve por ello ahora. El futuro no le est\c3\a1 prometido a nadie.") ;; #0517 es
  (data (i32.const 266007) "Dar lo mejor de ti en este momento te coloca en el mejor lugar para el siguiente.") ;; #0518 es
  (data (i32.const 266088) "El futuro empieza hoy, no ma\c3\b1ana.") ;; #0519 es
  (data (i32.const 266122) "Tanto si crees que puedes como si crees que no puedes, tienes raz\c3\b3n.") ;; #0520 es
  (data (i32.const 266191) "Cree que puedes y ya tendr\c3\a1s la mitad del camino recorrido.") ;; #0521 es
  (data (i32.const 266251) "Nuestra vida es lo que nuestros pensamientos hacen de ella.") ;; #0522 es
  (data (i32.const 266310) "La felicidad de tu vida depende de la calidad de tus pensamientos.") ;; #0523 es
  (data (i32.const 266376) "Se necesita muy poco para tener una vida feliz; todo est\c3\a1 dentro de ti, en tu forma de pensar.") ;; #0524 es
  (data (i32.const 266471) "Una actitud positiva realmente puede hacer que los sue\c3\b1os se cumplan.") ;; #0525 es
  (data (i32.const 266541) "El optimismo es un im\c3\a1n de felicidad.") ;; #0526 es
  (data (i32.const 266579) "Las limitaciones solo viven en nuestra mente. Pero si usamos la imaginaci\c3\b3n, nuestras posibilidades se vuelven ilimitadas.") ;; #0527 es
  (data (i32.const 266702) "El \c3\banico l\c3\admite para nuestra realizaci\c3\b3n de ma\c3\b1ana ser\c3\a1n nuestras dudas de hoy.") ;; #0528 es
  (data (i32.const 266786) "El optimismo perpetuo multiplica las fuerzas.") ;; #0529 es
  (data (i32.const 266831) "Si oyes una voz en tu interior que dice que no sabes pintar, pinta de todos modos y esa voz se callar\c3\a1.") ;; #0530 es
  (data (i32.const 266935) "Todo lo que la mente humana puede concebir y creer, lo puede lograr.") ;; #0531 es
  (data (i32.const 267003) "Quien tiene confianza en s\c3\ad mismo se gana la confianza de los dem\c3\a1s.") ;; #0532 es
  (data (i32.const 267073) "En cuanto cambias los pensamientos negativos por positivos, empiezas a tener resultados positivos.") ;; #0533 es
  (data (i32.const 267171) "Cuando cambias la forma de mirar las cosas, las cosas que miras cambian.") ;; #0534 es
  (data (i32.const 267243) "La felicidad no es algo que venga hecho. Viene de tus propias acciones.") ;; #0535 es
  (data (i32.const 267314) "Creer en uno mismo y trabajar duro siempre te llevar\c3\a1n al \c3\a9xito.") ;; #0536 es
  (data (i32.const 267380) "Muchos de nosotros no vivimos nuestros sue\c3\b1os porque estamos viviendo nuestros miedos.") ;; #0537 es
  (data (i32.const 267467) "Apunta a la Luna. Aunque falles, aterrizar\c3\a1s entre las estrellas.") ;; #0538 es
  (data (i32.const 267533) "No importa lo que miras, sino lo que ves.") ;; #0539 es
  (data (i32.const 267574) "No soy producto de mis circunstancias. Soy producto de mis decisiones.") ;; #0540 es
  (data (i32.const 267644) "La confianza no viene de tener siempre raz\c3\b3n, sino de no temer equivocarse.") ;; #0541 es
  (data (i32.const 267720) "Si quieres levantarte, levanta a otra persona.") ;; #0542 es
  (data (i32.const 267766) "El \c3\a9xito no se mide tanto por la posici\c3\b3n que uno ha alcanzado en la vida como por los obst\c3\a1culos que ha superado.") ;; #0543 es
  (data (i32.const 267883) "La excelencia es hacer algo com\c3\ban de una manera poco com\c3\ban.") ;; #0544 es
  (data (i32.const 267944) "Lo que piensas de ti mismo es mucho m\c3\a1s importante que lo que los dem\c3\a1s piensan de ti.") ;; #0545 es
  (data (i32.const 268032) "El hombre no es m\c3\a1s que el producto de sus pensamientos. Se convierte en lo que piensa.") ;; #0546 es
  (data (i32.const 268120) "Si algo no te gusta, c\c3\a1mbialo. Si no puedes cambiarlo, cambia tu actitud.") ;; #0547 es
  (data (i32.const 268194) "La gente suele decir que la motivaci\c3\b3n no dura. Bueno, el ba\c3\b1o tampoco. Por eso lo recomendamos a diario.") ;; #0548 es
  (data (i32.const 268301) "Tu actitud, no tu aptitud, determinar\c3\a1 tu altitud.") ;; #0549 es
  (data (i32.const 268352) "El pensamiento positivo te permitir\c3\a1 hacerlo todo mejor que el pensamiento negativo.") ;; #0550 es
  (data (i32.const 268437) "El optimismo es la cualidad m\c3\a1s asociada al \c3\a9xito y a la felicidad, m\c3\a1s que cualquier otra.") ;; #0551 es
  (data (i32.const 268531) "\c2\a1Cree en ti! \c2\a1Ten fe en tus capacidades!") ;; #0552 es
  (data (i32.const 268573) "Debes esperar grandes cosas de ti mismo antes de poder hacerlas.") ;; #0553 es
  (data (i32.const 268637) "Atribuyo mi \c3\a9xito a esto: nunca di ni acept\c3\a9 excusas.") ;; #0554 es
  (data (i32.const 268692) "La imaginaci\c3\b3n es m\c3\a1s importante que el conocimiento.") ;; #0555 es
  (data (i32.const 268747) "Con los a\c3\b1os he aprendido que, cuando uno tiene la mente decidida, el miedo disminuye.") ;; #0556 es
  (data (i32.const 268834) "Debes hacer las cosas que crees que no puedes hacer.") ;; #0557 es
  (data (i32.const 268886) "Pensar con claridad requiere m\c3\a1s valor que inteligencia.") ;; #0558 es
  (data (i32.const 268943) "No es la carga lo que te derrumba, sino la forma en que la llevas.") ;; #0559 es
  (data (i32.const 269009) "La habilidad es lo que eres capaz de hacer. La motivaci\c3\b3n determina lo que haces. La actitud determina lo bien que lo haces.") ;; #0560 es
  (data (i32.const 269134) "La preocupaci\c3\b3n no vac\c3\ada el ma\c3\b1ana de su tristeza; vac\c3\ada el hoy de su fuerza.") ;; #0561 es
  (data (i32.const 269215) "Al hombre no le preocupan tanto los problemas reales como las ansiedades que imagina sobre ellos.") ;; #0562 es
  (data (i32.const 269312) "Si crees que est\c3\a1s vencido, lo est\c3\a1s.") ;; #0563 es
  (data (i32.const 269351) "Tarde o temprano, el que gana es el que cree que puede.") ;; #0564 es
  (data (i32.const 269406) "Nos convertimos en aquello en lo que pensamos.") ;; #0565 es
  (data (i32.const 269452) "Si siempre intentas ser normal, nunca sabr\c3\a1s lo incre\c3\adble que puedes llegar a ser.") ;; #0566 es
  (data (i32.const 269536) "Vaya, a veces he llegado a creer hasta seis cosas imposibles antes del desayuno.") ;; #0567 es
  (data (i32.const 269616) "El peor enemigo de la creatividad es la duda sobre uno mismo.") ;; #0568 es
  (data (i32.const 269677) "Habito en la posibilidad.") ;; #0569 es
  (data (i32.const 269702) "Son nuestras elecciones las que muestran lo que realmente somos, mucho m\c3\a1s que nuestras habilidades.") ;; #0570 es
  (data (i32.const 269803) "Mira hacia las estrellas y no hacia tus pies.") ;; #0571 es
  (data (i32.const 269848) "Por dif\c3\adcil que parezca la vida, siempre hay algo que puedes hacer y en lo que puedes tener \c3\a9xito.") ;; #0572 es
  (data (i32.const 269948) "No tengo talentos especiales. Solo soy apasionadamente curioso.") ;; #0573 es
  (data (i32.const 270011) "No intentes convertirte en un hombre de \c3\a9xito, sino en un hombre de valor.") ;; #0574 es
  (data (i32.const 270086) "La paciencia es amarga, pero su fruto es dulce.") ;; #0575 es
  (data (i32.const 270133) "Adopta el ritmo de la naturaleza: su secreto es la paciencia.") ;; #0576 es
  (data (i32.const 270194) "La naturaleza no tiene prisa, y sin embargo todo se cumple.") ;; #0577 es
  (data (i32.const 270253) "Los \c3\a1rboles que crecen despacio dan los mejores frutos.") ;; #0578 es
  (data (i32.const 270309) "El genio es una paciencia eterna.") ;; #0579 es
  (data (i32.const 270342) "La paciencia es compa\c3\b1era de la sabidur\c3\ada.") ;; #0580 es
  (data (i32.const 270386) "Quien tiene paciencia puede tener lo que quiera.") ;; #0581 es
  (data (i32.const 270434) "Ten paciencia con todas las cosas, pero sobre todo contigo mismo.") ;; #0582 es
  (data (i32.const 270499) "Un momento de paciencia puede evitar un gran desastre. Un momento de impaciencia puede arruinar toda una vida.") ;; #0583 es
  (data (i32.const 270609) "La paciencia no es solo la capacidad de esperar; es c\c3\b3mo nos comportamos mientras esperamos.") ;; #0584 es
  (data (i32.const 270702) "Roma no se construy\c3\b3 en un d\c3\ada.") ;; #0585 es
  (data (i32.const 270735) "Todo llega poco a poco y a su debido tiempo.") ;; #0586 es
  (data (i32.const 270779) "S\c3\a9 paciente y fuerte; alg\c3\ban d\c3\ada este dolor te ser\c3\a1 \c3\batil.") ;; #0587 es
  (data (i32.const 270840) "El agua que gotea horada la piedra, no por la fuerza, sino por la persistencia.") ;; #0588 es
  (data (i32.const 270919) "Toda la sabidur\c3\ada humana se resume en dos palabras: esperar y tener esperanza.") ;; #0589 es
  (data (i32.const 270998) "La clave de todo es la paciencia. La gallina se obtiene incubando el huevo, no rompi\c3\a9ndolo.") ;; #0590 es
  (data (i32.const 271090) "La paciencia y el tiempo hacen m\c3\a1s que la fuerza o la pasi\c3\b3n.") ;; #0591 es
  (data (i32.const 271153) "Nuestra paciencia lograr\c3\a1 m\c3\a1s que nuestra fuerza.") ;; #0592 es
  (data (i32.const 271204) "\c2\a1Qu\c3\a9 pobres son los que no tienen paciencia! \c2\bfQu\c3\a9 herida san\c3\b3 alguna vez sino poco a poco?") ;; #0593 es
  (data (i32.const 271299) "La paciencia es el arte de tener esperanza.") ;; #0594 es
  (data (i32.const 271342) "Un pu\c3\b1ado de paciencia vale m\c3\a1s que un saco de sesos.") ;; #0595 es
  (data (i32.const 271397) "La paciencia tambi\c3\a9n es una forma de acci\c3\b3n.") ;; #0596 es
  (data (i32.const 271443) "Despacio y con constancia se gana la carrera.") ;; #0597 es
  (data (i32.const 271488) "Con tiempo y paciencia, la hoja de morera se convierte en vestido de seda.") ;; #0598 es
  (data (i32.const 271562) "La paciencia atrae la felicidad; acerca lo que est\c3\a1 lejos.") ;; #0599 es
  (data (i32.const 271621) "Perder la paciencia es perder la batalla.") ;; #0600 es
  (data (i32.const 271662) "La paciencia es poder. La paciencia no es ausencia de acci\c3\b3n; es saber elegir el momento.") ;; #0601 es
  (data (i32.const 271752) "Sabio para decidir y paciente para ejecutar.") ;; #0602 es
  (data (i32.const 271796) "Soy extraordinariamente paciente, siempre que al final se haga lo que yo quiero.") ;; #0603 es
  (data (i32.const 271876) "Si eres paciente en un momento de ira, te librar\c3\a1s de cien d\c3\adas de tristeza.") ;; #0604 es
  (data (i32.const 271954) "La paciencia es el apoyo de la debilidad; la impaciencia, la ruina de la fuerza.") ;; #0605 es
  (data (i32.const 272034) "La resistencia es paciencia concentrada.") ;; #0606 es
  (data (i32.const 272074) "La paciencia y la diligencia, como la fe, mueven monta\c3\b1as.") ;; #0607 es
  (data (i32.const 272133) "Cu\c3\addate de la furia de un hombre paciente.") ;; #0608 es
  (data (i32.const 272176) "La paciencia es la llave del para\c3\adso.") ;; #0609 es
  (data (i32.const 272214) "Ten paciencia con todo lo que a\c3\ban no est\c3\a1 resuelto en tu coraz\c3\b3n.") ;; #0610 es
  (data (i32.const 272282) "Nada grande se crea de repente.") ;; #0611 es
  (data (i32.const 272313) "Quiz\c3\a1 alg\c3\ban d\c3\ada sea agradable recordar incluso esto.") ;; #0612 es
  (data (i32.const 272368) "Resistid y guardaos para cosas mejores.") ;; #0613 es
  (data (i32.const 272407) "Aguanta, coraz\c3\b3n m\c3\ado; peores cosas has soportado.") ;; #0614 es
  (data (i32.const 272458) "Esto tambi\c3\a9n pasar\c3\a1.") ;; #0615 es
  (data (i32.const 272480) "Nunca renuncies a un sue\c3\b1o solo por el tiempo que tardar\c3\a1 en cumplirse. El tiempo pasar\c3\a1 de todos modos.") ;; #0616 es
  (data (i32.const 272587) "Deja que todo te suceda: la belleza y el terror. Solo sigue adelante. Ning\c3\ban sentimiento es definitivo.") ;; #0617 es
  (data (i32.const 272691) "Ning\c3\ban copo de nieve cae nunca en el lugar equivocado.") ;; #0618 es
  (data (i32.const 272746) "Suelta o ser\c3\a1s arrastrado.") ;; #0619 es
  (data (i32.const 272773) "La determinaci\c3\b3n es el despertador de la voluntad humana.") ;; #0620 es
  (data (i32.const 272831) "La diferencia entre lo imposible y lo posible est\c3\a1 en la determinaci\c3\b3n de una persona.") ;; #0621 es
  (data (i32.const 272919) "F\c3\adjate metas altas y no te detengas hasta llegar.") ;; #0622 es
  (data (i32.const 272969) "El deseo es la clave de la motivaci\c3\b3n, pero son la determinaci\c3\b3n y el compromiso con la b\c3\basqueda incansable de tu meta los que te permitir\c3\a1n alcanzar el \c3\a9xito que buscas.") ;; #0623 es
  (data (i32.const 273144) "Los obst\c3\a1culos no pueden aplastarme. Todo obst\c3\a1culo cede ante una firme determinaci\c3\b3n.") ;; #0624 es
  (data (i32.const 273233) "No me desanimo, porque cada intento equivocado que descarto es otro paso adelante.") ;; #0625 es
  (data (i32.const 273315) "Nunca dejes que el miedo a fallar te impida jugar el partido.") ;; #0626 es
  (data (i32.const 273376) "Si no puedes jugar mejor que ellos, trabaja m\c3\a1s que ellos.") ;; #0627 es
  (data (i32.const 273435) "De verdad creo que a un campe\c3\b3n no lo definen sus victorias, sino c\c3\b3mo se recupera cuando cae.") ;; #0628 es
  (data (i32.const 273531) "Tienes que creer en ti mismo cuando nadie m\c3\a1s lo hace.") ;; #0629 es
  (data (i32.const 273586) "Cuanto m\c3\a1s dif\c3\adcil la victoria, mayor la alegr\c3\ada de ganar.") ;; #0630 es
  (data (i32.const 273647) "Las medallas de oro no est\c3\a1n hechas de oro. Est\c3\a1n hechas de sudor, determinaci\c3\b3n y una aleaci\c3\b3n dif\c3\adcil de encontrar llamada agallas.") ;; #0631 es
  (data (i32.const 273785) "La edad no es una barrera. Es una limitaci\c3\b3n que le pones a tu mente.") ;; #0632 es
  (data (i32.const 273855) "La diferencia entre lo ordinario y lo extraordinario es ese peque\c3\b1o extra.") ;; #0633 es
  (data (i32.const 273930) "Ganar no lo es todo, pero querer ganar s\c3\ad.") ;; #0634 es
  (data (i32.const 273973) "La perfecci\c3\b3n no es alcanzable, pero si perseguimos la perfecci\c3\b3n podemos alcanzar la excelencia.") ;; #0635 es
  (data (i32.const 274072) "Una vez que aprendes a rendirte, se convierte en un h\c3\a1bito.") ;; #0636 es
  (data (i32.const 274132) "Hoy har\c3\a9 lo que otros no har\c3\a1n, para que ma\c3\b1ana pueda lograr lo que otros no pueden.") ;; #0637 es
  (data (i32.const 274219) "No le puedes poner l\c3\admite a nada. Cuanto m\c3\a1s sue\c3\b1as, m\c3\a1s lejos llegas.") ;; #0638 es
  (data (i32.const 274293) "Hay quien sale mejor que yo, pero yo termino fuerte.") ;; #0639 es
  (data (i32.const 274345) "Nunca se logr\c3\b3 nada grande sin entusiasmo.") ;; #0640 es
  (data (i32.const 274388) "\c2\a1Prefiero ser ceniza que polvo!") ;; #0641 es
  (data (i32.const 274420) "Decide no estar nunca ocioso.") ;; #0642 es
  (data (i32.const 274449) "Un sue\c3\b1o no se hace realidad por arte de magia; hacen falta sudor, determinaci\c3\b3n y trabajo duro.") ;; #0643 es
  (data (i32.const 274547) "No hay secretos para el \c3\a9xito. Es el resultado de la preparaci\c3\b3n, el trabajo duro y el aprendizaje del fracaso.") ;; #0644 es
  (data (i32.const 274660) "Nuestro mayor miedo no deber\c3\ada ser fracasar, sino tener \c3\a9xito en cosas de la vida que realmente no importan.") ;; #0645 es
  (data (i32.const 274770) "Sigue hambriento, sigue alocado.") ;; #0646 es
  (data (i32.const 274802) "Tu tiempo es limitado, as\c3\ad que no lo desperdicies viviendo la vida de otro.") ;; #0647 es
  (data (i32.const 274878) "Si trabajas en algo emocionante que de verdad te importa, no hace falta que te empujen. La visi\c3\b3n tira de ti.") ;; #0648 es
  (data (i32.const 274988) "La \c3\banica forma de hacer un gran trabajo es amar lo que haces.") ;; #0649 es
  (data (i32.const 275050) "No puedes conectar los puntos mirando hacia delante; solo puedes conectarlos mirando hacia atr\c3\a1s.") ;; #0650 es
  (data (i32.const 275148) "A veces la vida te golpea en la cabeza con un ladrillo. No pierdas la fe.") ;; #0651 es
  (data (i32.const 275221) "Cuando algo es lo bastante importante, lo haces aunque las probabilidades no est\c3\a9n a tu favor.") ;; #0652 es
  (data (i32.const 275316) "Ten siempre presente que tu propia determinaci\c3\b3n de triunfar es m\c3\a1s importante que cualquier otra cosa.") ;; #0653 es
  (data (i32.const 275421) "El dolor es temporal. Rendirse es para siempre.") ;; #0654 es
  (data (i32.const 275468) "He estado de pie sobre una monta\c3\b1a de noes por un solo s\c3\ad.") ;; #0655 es
  (data (i32.const 275528) "Tuve que ganarme la vida y crear mi propia oportunidad. \c2\a1Pero lo logr\c3\a9!") ;; #0656 es
  (data (i32.const 275601) "No llegu\c3\a9 ah\c3\ad dese\c3\a1ndolo ni esper\c3\a1ndolo, sino trabajando por ello.") ;; #0657 es
  (data (i32.const 275671) "Lucha por las cosas que te importan, pero hazlo de una manera que lleve a otros a unirse a ti.") ;; #0658 es
  (data (i32.const 275765) "La vida no es f\c3\a1cil para ninguno de nosotros. \c2\bfY qu\c3\a9? Debemos tener perseverancia y, sobre todo, confianza en nosotros mismos.") ;; #0659 es
  (data (i32.const 275894) "Debemos creer que tenemos un don para algo y que ese algo, cueste lo que cueste, debe alcanzarse.") ;; #0660 es
  (data (i32.const 275991) "Uno nunca se fija en lo que ya se ha hecho; solo ve lo que queda por hacer.") ;; #0661 es
  (data (i32.const 276066) "Alzo mi voz no para gritar, sino para que quienes no tienen voz puedan ser escuchados.") ;; #0662 es
  (data (i32.const 276152) "Un ni\c3\b1o, un maestro, un libro y una pluma pueden cambiar el mundo.") ;; #0663 es
  (data (i32.const 276219) "Cuando el mundo entero guarda silencio, incluso una sola voz se vuelve poderosa.") ;; #0664 es
  (data (i32.const 276299) "Porque est\c3\a1 ah\c3\ad.") ;; #0665 es
  (data (i32.const 276317) "Es un peque\c3\b1o paso para el hombre, un gran salto para la humanidad.") ;; #0666 es
  (data (i32.const 276385) "No me digas que el cielo es el l\c3\admite cuando hay huellas en la Luna.") ;; #0667 es
  (data (i32.const 276454) "La Tierra es la cuna de la humanidad, pero la humanidad no puede quedarse en la cuna para siempre.") ;; #0668 es
  (data (i32.const 276552) "Explorar es, en realidad, la esencia del esp\c3\adritu humano.") ;; #0669 es
  (data (i32.const 276610) "Los guerreros victoriosos ganan primero y luego van a la guerra, mientras que los derrotados van primero a la guerra y luego buscan ganar.") ;; #0670 es
  (data (i32.const 276748) "Todos nuestros sue\c3\b1os pueden hacerse realidad si tenemos el valor de perseguirlos.") ;; #0671 es
  (data (i32.const 276831) "Primero, piensa. Segundo, sue\c3\b1a. Tercero, cree. Y por \c3\baltimo, atr\c3\a9vete.") ;; #0672 es
  (data (i32.const 276905) "Un sue\c3\b1o que sue\c3\b1as solo es solo un sue\c3\b1o. Un sue\c3\b1o que sue\c3\b1as con otros es realidad.") ;; #0673 es
  (data (i32.const 276995) "Af\c3\a9rrate a los sue\c3\b1os, porque si los sue\c3\b1os mueren, la vida es un p\c3\a1jaro con las alas rotas que no puede volar.") ;; #0674 es
  (data (i32.const 277110) "Los sue\c3\b1os son la piedra de toque de nuestro car\c3\a1cter.") ;; #0675 es
  (data (i32.const 277166) "No dejes que nadie te robe la imaginaci\c3\b3n, la creatividad o la curiosidad.") ;; #0676 es
  (data (i32.const 277241) "Nunca dejes que tus recuerdos sean m\c3\a1s grandes que tus sue\c3\b1os.") ;; #0677 es
  (data (i32.const 277305) "Todos los hombres sue\c3\b1an, pero no del mismo modo.") ;; #0678 es
  (data (i32.const 277355) "Los sue\c3\b1os se cumplen. Sin esa posibilidad, la naturaleza no nos incitar\c3\ada a tenerlos.") ;; #0679 es
  (data (i32.const 277443) "Cuida tus visiones y tus sue\c3\b1os, porque son hijos de tu alma, los planos de tus mayores logros.") ;; #0680 es
  (data (i32.const 277539) "El punto de partida de todo logro es el deseo.") ;; #0681 es
  (data (i32.const 277585) "Una meta es un sue\c3\b1o con fecha l\c3\admite.") ;; #0682 es
  (data (i32.const 277625) "Es la posibilidad de cumplir un sue\c3\b1o lo que hace interesante la vida.") ;; #0683 es
  (data (i32.const 277696) "Y cuando quieres algo, todo el universo conspira para ayudarte a conseguirlo.") ;; #0684 es
  (data (i32.const 277773) "Sue\c3\b1a como si fueras a vivir para siempre. Vive como si fueras a morir hoy.") ;; #0685 es
  (data (i32.const 277849) "La mayor aventura que puedes emprender es vivir la vida de tus sue\c3\b1os.") ;; #0686 es
  (data (i32.const 277920) "Apunta alto, porque hay estrellas escondidas en ti. Sue\c3\b1a hondo, porque todo sue\c3\b1o precede a la meta.") ;; #0687 es
  (data (i32.const 278023) "Sue\c3\b1o mi pintura y pinto mi sue\c3\b1o.") ;; #0688 es
  (data (i32.const 278059) "Los sue\c3\b1os no funcionan a menos que t\c3\ba trabajes.") ;; #0689 es
  (data (i32.const 278109) "Mant\c3\a9n vivos tus sue\c3\b1os. Entiende que lograr cualquier cosa requiere fe y confianza en ti mismo, visi\c3\b3n, trabajo duro, determinaci\c3\b3n y dedicaci\c3\b3n.") ;; #0690 es
  (data (i32.const 278260) "Si puedes imaginarlo, puedes lograrlo.") ;; #0691 es
  (data (i32.const 278298) "Los so\c3\b1adores son los salvadores del mundo.") ;; #0692 es
  (data (i32.const 278342) "Sue\c3\b1a sue\c3\b1os elevados, y tal como sue\c3\b1es, as\c3\ad llegar\c3\a1s a ser.") ;; #0693 es
  (data (i32.const 278408) "Algunas personas sue\c3\b1an con el \c3\a9xito, mientras que otras se levantan cada ma\c3\b1ana y lo hacen realidad.") ;; #0694 es
  (data (i32.const 278512) "Tengo un sue\c3\b1o.") ;; #0695 es
  (data (i32.const 278528) "Lo que hoy est\c3\a1 demostrado alguna vez fue solo imaginado.") ;; #0696 es
  (data (i32.const 278586) "Apunta a la Luna. Si fallas, puede que aciertes a una estrella.") ;; #0697 es
  (data (i32.const 278649) "Nada sucede a menos que primero lo so\c3\b1emos.") ;; #0698 es
  (data (i32.const 278693) "Quienes sue\c3\b1an de d\c3\ada conocen muchas cosas que escapan a quienes solo sue\c3\b1an de noche.") ;; #0699 es
  (data (i32.const 278782) "Para lograr grandes cosas no solo hay que actuar, sino tambi\c3\a9n so\c3\b1ar; no solo planear, sino tambi\c3\a9n creer.") ;; #0700 es
  (data (i32.const 278891) "Sigue tu dicha, y el universo abrir\c3\a1 puertas donde antes solo hab\c3\ada muros.") ;; #0701 es
  (data (i32.const 278967) "Sin saltos de imaginaci\c3\b3n o de sue\c3\b1o, perdemos la emoci\c3\b3n de las posibilidades.") ;; #0702 es
  (data (i32.const 279049) "So\c3\b1ar, al fin y al cabo, es una forma de planear.") ;; #0703 es
  (data (i32.const 279099) "\c2\a1Vas a lugares incre\c3\adbles! \c2\a1Hoy es tu d\c3\ada! Tu monta\c3\b1a te espera, \c2\a1as\c3\ad que ponte en camino!") ;; #0704 es
  (data (i32.const 279196) "Tienes cerebro en la cabeza. Tienes pies en los zapatos. Puedes ir en la direcci\c3\b3n que elijas.") ;; #0705 es
  (data (i32.const 279291) "A menos que a alguien como t\c3\ba le importe much\c3\adsimo, nada va a mejorar. Nada.") ;; #0706 es
  (data (i32.const 279369) "Dime, \c2\bfqu\c3\a9 piensas hacer con tu \c3\banica vida, salvaje y preciosa?") ;; #0707 es
  (data (i32.const 279435) "Dos caminos se bifurcaban en un bosque, y yo, yo tom\c3\a9 el menos transitado, y eso marc\c3\b3 toda la diferencia.") ;; #0708 es
  (data (i32.const 279543) "No todos los que vagan est\c3\a1n perdidos.") ;; #0709 es
  (data (i32.const 279582) "Respir\c3\a9 hondo y escuch\c3\a9 el viejo alarde de mi coraz\c3\b3n: soy, soy, soy.") ;; #0710 es
  (data (i32.const 279654) "Quiz\c3\a1 todos los dragones de nuestra vida sean princesas que solo esperan vernos actuar, una sola vez, con belleza y valor.") ;; #0711 es
  (data (i32.const 279777) "\c2\bfQu\c3\a9 intentar\c3\adas hacer si supieras que no vas a fracasar?") ;; #0712 es
  (data (i32.const 279837) "Vi el \c3\a1ngel en el m\c3\a1rmol y tall\c3\a9 hasta liberarlo.") ;; #0713 es
  (data (i32.const 279889) "Las personas con metas tienen \c3\a9xito porque saben ad\c3\b3nde van.") ;; #0714 es
  (data (i32.const 279951) "Lo que buscas te est\c3\a1 buscando.") ;; #0715 es
  (data (i32.const 279983) "No te aflijas. Todo lo que pierdes vuelve de otra forma.") ;; #0716 es
  (data (i32.const 280039) "Prende fuego a tu vida. Busca a quienes avivan tus llamas.") ;; #0717 es
  (data (i32.const 280097) "Ayer era listo, as\c3\ad que quer\c3\ada cambiar el mundo. Hoy soy sabio, as\c3\ad que estoy cambi\c3\a1ndome a m\c3\ad mismo.") ;; #0718 es
  (data (i32.const 280203) "Naciste con alas, \c2\bfpor qu\c3\a9 prefieres arrastrarte por la vida?") ;; #0719 es
  (data (i32.const 280266) "Responde a cada llamada que entusiasme a tu esp\c3\adritu.") ;; #0720 es
  (data (i32.const 280320) "Si te irrita cada roce, \c2\bfc\c3\b3mo se pulir\c3\a1 tu espejo?") ;; #0721 es
  (data (i32.const 280373) "Esos dolores que sientes son mensajeros. Esc\c3\bachalos.") ;; #0722 es
  (data (i32.const 280426) "La libertad es la \c3\banica meta digna en la vida. Se gana dejando de preocuparse por lo que est\c3\a1 fuera de nuestro control.") ;; #0723 es
  (data (i32.const 280547) "No expliques tu filosof\c3\ada. Enc\c3\a1rnala.") ;; #0724 es
  (data (i32.const 280586) "Si quieres mejorar, cont\c3\a9ntate con que te consideren tonto e ignorante.") ;; #0725 es
  (data (i32.const 280658) "Mientras vivas, sigue aprendiendo a vivir.") ;; #0726 es
  (data (i32.const 280700) "A veces, incluso vivir es un acto de valor.") ;; #0727 es
  (data (i32.const 280743) "Para quien no sabe a qu\c3\a9 puerto navega, ning\c3\ban viento es favorable.") ;; #0728 es
  (data (i32.const 280812) "La suerte es lo que sucede cuando la preparaci\c3\b3n se encuentra con la oportunidad.") ;; #0729 es
  (data (i32.const 280894) "El ayer es historia, el ma\c3\b1ana es un misterio, el hoy es un regalo de Dios, y por eso se llama presente.") ;; #0730 es
  (data (i32.const 280999) "Si quieres ir r\c3\a1pido, ve solo. Si quieres llegar lejos, ve acompa\c3\b1ado.") ;; #0731 es
  (data (i32.const 281071) "No teng\c3\a1is miedo.") ;; #0732 es
  (data (i32.const 281089) "No le temo al ma\c3\b1ana, porque he visto el ayer y amo el hoy.") ;; #0733 es
  (data (i32.const 281149) "Cada d\c3\ada es un d\c3\ada nuevo.") ;; #0734 es
  (data (i32.const 281176) "El \c3\banico viaje es el viaje interior.") ;; #0735 es
  (data (i32.const 281213) "Todav\c3\ada estoy aprendiendo.") ;; #0736 es
  (data (i32.const 281240) "No importa la duraci\c3\b3n de la vida, sino su profundidad.") ;; #0737 es
  (data (i32.const 281296) "Una vez que tomas una decisi\c3\b3n, el universo conspira para que se cumpla.") ;; #0738 es
  (data (i32.const 281369) "Ser grande es ser incomprendido.") ;; #0739 es
  (data (i32.const 281401) "Termina cada d\c3\ada y d\c3\a9jalo atr\c3\a1s. Hiciste lo que pudiste.") ;; #0740 es
  (data (i32.const 281460) "Los a\c3\b1os ense\c3\b1an mucho que los d\c3\adas nunca saben.") ;; #0741 es
  (data (i32.const 281511) "Escribe en tu coraz\c3\b3n que cada d\c3\ada es el mejor d\c3\ada del a\c3\b1o.") ;; #0742 es
  (data (i32.const 281574) "La vida solo puede entenderse mirando hacia atr\c3\a1s, pero debe vivirse mirando hacia delante.") ;; #0743 es
  (data (i32.const 281666) "Los comienzos siempre son desordenados.") ;; #0744 es
  (data (i32.const 281705) "La visi\c3\b3n es el arte de ver lo que es invisible para los dem\c3\a1s.") ;; #0745 es
  (data (i32.const 281770) "Cuando una puerta de la felicidad se cierra, otra se abre.") ;; #0746 es
  (data (i32.const 281828) "Solos podemos hacer muy poco; juntos podemos hacer mucho.") ;; #0747 es
  (data (i32.const 281885) "Lo \c3\banico peor que ser ciego es tener vista pero no tener visi\c3\b3n.") ;; #0748 es
  (data (i32.const 281951) "Ning\c3\ban pesimista ha descubierto jam\c3\a1s el secreto de las estrellas, ni ha navegado hacia una tierra inexplorada.") ;; #0749 es
  (data (i32.const 282064) "Podemos hacer cualquier cosa que queramos si persistimos el tiempo suficiente.") ;; #0750 es
  (data (i32.const 282142) "Lo que busco no est\c3\a1 ah\c3\ad fuera; est\c3\a1 en m\c3\ad.") ;; #0751 es
  (data (i32.const 282189) "El esfuerzo y el valor no bastan sin prop\c3\b3sito y direcci\c3\b3n.") ;; #0752 es
  (data (i32.const 282250) "El mundo cambia con tu ejemplo, no con tu opini\c3\b3n.") ;; #0753 es
  (data (i32.const 282301) "No podemos ayudar a todos, pero todos podemos ayudar a alguien.") ;; #0754 es
  (data (i32.const 282364) "Cada persona debe vivir su vida como un ejemplo para los dem\c3\a1s.") ;; #0755 es
  (data (i32.const 282428) "Si no te gusta el camino que est\c3\a1s recorriendo, empieza a pavimentar otro.") ;; #0756 es
  (data (i32.const 282503) "Recibes de la vida lo que tienes el valor de pedir.") ;; #0757 es
  (data (i32.const 282554) "El \c3\a9xito no tiene que ver con cu\c3\a1nto dinero ganas; tiene que ver con la diferencia que marcas en la vida de las personas.") ;; #0758 es
  (data (i32.const 282677) "No hay mayor agon\c3\ada que llevar dentro una historia no contada.") ;; #0759 es
  (data (i32.const 282740) "Solo nos damos cuenta de la importancia de nuestra voz cuando nos silencian.") ;; #0760 es
  (data (i32.const 282816) "El \c3\a9xito no es lo alto que has subido, sino c\c3\b3mo marcas una diferencia positiva en el mundo.") ;; #0761 es
  (data (i32.const 282910) "La mejor venganza es un \c3\a9xito enorme.") ;; #0762 es
  (data (i32.const 282948) "El duelo puede ser el jard\c3\adn de la compasi\c3\b3n.") ;; #0763 es
  (data (i32.const 282995) "Sigue adelante, y es probable que tropieces con algo, quiz\c3\a1 cuando menos lo esperes.") ;; #0764 es
  (data (i32.const 283080) "El trabajo duro sin talento es una pena, pero el talento sin trabajo duro es una tragedia.") ;; #0765 es
  (data (i32.const 283170) "No se acaba hasta que se acaba.") ;; #0766 es
  (data (i32.const 283201) "O encontraremos un camino, o lo abriremos.") ;; #0767 es
  (data (i32.const 283243) "El secreto del \c3\a9xito es la constancia en el prop\c3\b3sito.") ;; #0768 es
  (data (i32.const 283299) "Persiste y persevera, y descubrir\c3\a1s que la mayor\c3\ada de las cosas alcanzables son posibles.") ;; #0769 es
  (data (i32.const 283390) "La mayor\c3\ada de la gente se rinde justo cuando est\c3\a1 a punto de tener \c3\a9xito. Abandonan a un paso de la meta.") ;; #0770 es
  (data (i32.const 283498) "Si vas a dudar de algo, duda de tus l\c3\admites.") ;; #0771 es
  (data (i32.const 283543) "No hay sustituto para el trabajo duro.") ;; #0772 es
  (data (i32.const 283581) "\c2\a1La diferencia entre intentar y triunfar es solo un poquito m\c3\a1s de garra!") ;; #0773 es
  (data (i32.const 283656) "La perseverancia es fracasar diecinueve veces y tener \c3\a9xito a la vig\c3\a9sima.") ;; #0774 es
  (data (i32.const 283732) "La persistencia es al car\c3\a1cter del hombre lo que el carbono es al acero.") ;; #0775 es
  (data (i32.const 283805) "El hombre capaz de exigirse m\c3\a1s cuando el esfuerzo empieza a doler es el que ganar\c3\a1.") ;; #0776 es
  (data (i32.const 283891) "No te rindas. Nunca te rindas.") ;; #0777 es
  (data (i32.const 283921) "Muchas personas han llegado m\c3\a1s lejos de lo que cre\c3\adan porque alguien m\c3\a1s crey\c3\b3 que pod\c3\adan.") ;; #0778 es
  (data (i32.const 284017) "No puedes subir la escalera del \c3\a9xito con las manos en los bolsillos.") ;; #0779 es
  (data (i32.const 284087) "Los logros de hoy fueron los imposibles de ayer.") ;; #0780 es
  (data (i32.const 284135) "Nada es especialmente dif\c3\adcil si lo divides en peque\c3\b1as tareas.") ;; #0781 es
  (data (i32.const 284200) "La perseverancia y el \c3\a1nimo han obrado maravillas en todas las \c3\a9pocas.") ;; #0782 es
  (data (i32.const 284272) "El valor es el precio que la vida exige a cambio de conceder la paz.") ;; #0783 es
  (data (i32.const 284340) "La aventura vale la pena por s\c3\ad misma.") ;; #0784 es
  (data (i32.const 284379) "El valor es una historia de amor con lo desconocido.") ;; #0785 es
  (data (i32.const 284431) "Lo que debes hacer cuando algo no te gusta es cambiarlo.") ;; #0786 es
  (data (i32.const 284487) "S\c3\a9 valiente. Arri\c3\a9sgate. Nada puede sustituir a la experiencia.") ;; #0787 es
  (data (i32.const 284552) "Quien es valiente es libre.") ;; #0788 es
  (data (i32.const 284579) "No debo temer. El miedo mata la mente.") ;; #0789 es
  (data (i32.const 284617) "El valor es la principal cualidad del liderazgo.") ;; #0790 es
  (data (i32.const 284665) "Lo m\c3\a1s valiente que puedes hacer cuando no te sientes valiente es declararte valiente y actuar en consecuencia.") ;; #0791 es
  (data (i32.const 284777) "El valor es hacer aquello que te da miedo. No puede haber valor si no tienes miedo.") ;; #0792 es
  (data (i32.const 284860) "La fortuna y el amor favorecen a los valientes.") ;; #0793 es
  (data (i32.const 284907) "Exponte a tu miedo m\c3\a1s profundo; despu\c3\a9s de eso, el miedo ya no tiene poder.") ;; #0794 es
  (data (i32.const 284985) "El valor es como el amor: necesita esperanza para alimentarse.") ;; #0795 es
  (data (i32.const 285047) "Es curioso que el valor f\c3\adsico sea tan com\c3\ban en el mundo, y el valor moral tan raro.") ;; #0796 es
  (data (i32.const 285133) "Lo opuesto al valor en nuestra sociedad no es la cobard\c3\ada, es el conformismo.") ;; #0797 es
  (data (i32.const 285211) "Los cobardes mueren muchas veces antes de su muerte; los valientes prueban la muerte una sola vez.") ;; #0798 es
  (data (i32.const 285309) "No temas a la grandeza: algunos nacen grandes, otros alcanzan la grandeza y a otros la grandeza se les impone.") ;; #0799 es
  (data (i32.const 285419) "Arma tu valor hasta el l\c3\admite y no fracasaremos.") ;; #0800 es
  (data (i32.const 285468) "El valor es el miedo aguantando un minuto m\c3\a1s.") ;; #0801 es
  (data (i32.const 285515) "Fracasar no es caer, sino negarse a levantarse.") ;; #0802 es
  (data (i32.const 285562) "El hombre exitoso saca provecho de sus errores y vuelve a intentarlo de otra manera.") ;; #0803 es
  (data (i32.const 285646) "Construye el \c3\a9xito a partir de los fracasos. El des\c3\a1nimo y el fracaso son dos de los pelda\c3\b1os m\c3\a1s seguros hacia el \c3\a9xito.") ;; #0804 es
  (data (i32.const 285772) "Los errores siempre son perdonables si uno tiene el valor de admitirlos.") ;; #0805 es
  (data (i32.const 285844) "No temas a los errores. No existen.") ;; #0806 es
  (data (i32.const 285879) "Cuando cometes un error, solo debes hacer tres cosas: admitirlo, aprender de \c3\a9l y no repetirlo.") ;; #0807 es
  (data (i32.const 285975) "El fracaso es un desv\c3\ado, no un callej\c3\b3n sin salida.") ;; #0808 es
  (data (i32.const 286028) "Un fracaso no siempre es un error. Puede ser simplemente lo mejor que se pudo hacer en esas circunstancias. El verdadero error es dejar de intentarlo.") ;; #0809 es
  (data (i32.const 286178) "Si no fracasas de vez en cuando, es se\c3\b1al de que no est\c3\a1s haciendo nada muy innovador.") ;; #0810 es
  (data (i32.const 286266) "El fracaso ocurre todo el tiempo. Ocurre cada d\c3\ada en el entrenamiento. Lo que te hace mejor es c\c3\b3mo reaccionas ante \c3\a9l.") ;; #0811 es
  (data (i32.const 286388) "No hay errores ni fracasos, solo lecciones.") ;; #0812 es
  (data (i32.const 286431) "He aprendido m\c3\a1s de mis errores que de mis \c3\a9xitos.") ;; #0813 es
  (data (i32.const 286483) "Es el fracaso el que te da la perspectiva adecuada sobre el \c3\a9xito.") ;; #0814 es
  (data (i32.const 286550) "El \c3\a9xito es lo alto que rebotas cuando tocas fondo.") ;; #0815 es
  (data (i32.const 286602) "No dejes que el miedo a perder sea mayor que la emoci\c3\b3n de ganar.") ;; #0816 es
  (data (i32.const 286668) "\c2\a1Aprendemos del fracaso, no del \c3\a9xito!") ;; #0817 es
  (data (i32.const 286708) "No puedes tener miedo a fracasar. Es la \c3\banica forma de triunfar.") ;; #0818 es
  (data (i32.const 286773) "Un hombre no est\c3\a1 acabado cuando es derrotado. Est\c3\a1 acabado cuando se rinde.") ;; #0819 es
  (data (i32.const 286851) "El esp\c3\adritu humano es m\c3\a1s fuerte que cualquier cosa que pueda sucederle.") ;; #0820 es
  (data (i32.const 286925) "La vida no consiste en lo r\c3\a1pido que corres o lo alto que subes, sino en lo bien que te recuperas de las ca\c3\addas.") ;; #0821 es
  (data (i32.const 287039) "Sin barro, no hay loto.") ;; #0822 es
  (data (i32.const 287062) "Si quieres ver el sol, tienes que aguantar la tormenta.") ;; #0823 es
  (data (i32.const 287117) "Las personas m\c3\a1s fuertes encuentran el valor y el cari\c3\b1o para ayudar a los dem\c3\a1s, aunque est\c3\a9n pasando por su propia tormenta.") ;; #0824 es
  (data (i32.const 287247) "No existe eso de arruinar tu vida. La vida, al final, resulta ser bastante resiliente.") ;; #0825 es
  (data (i32.const 287333) "La resiliencia es saber que solo t\c3\ba tienes el poder y la responsabilidad de levantarte.") ;; #0826 es
  (data (i32.const 287421) "Una vez que enfrentas tu miedo, nada es tan dif\c3\adcil como crees.") ;; #0827 es
  (data (i32.const 287485) "Cuando la vida te derribe, intenta caer de espaldas. Porque si puedes mirar hacia arriba, puedes levantarte.") ;; #0828 es
  (data (i32.const 287593) "De cada crisis surge la oportunidad de renacer.") ;; #0829 es
  (data (i32.const 287640) "Nada es permanente en este mundo cruel, ni siquiera nuestros problemas.") ;; #0830 es
  (data (i32.const 287711) "Las dificultades forjan o destruyen a las personas.") ;; #0831 es
  (data (i32.const 287762) "Convierte tus cicatrices en estrellas.") ;; #0832 es
  (data (i32.const 287800) "El c\c3\a1ncer puede quitarme todas mis capacidades f\c3\adsicas. Pero no puede tocar mi mente, no puede tocar mi coraz\c3\b3n y no puede tocar mi alma.") ;; #0833 es
  (data (i32.const 287940) "S\c3\a9 agua, amigo m\c3\ado.") ;; #0834 es
  (data (i32.const 287961) "Los d\c3\adas dif\c3\adciles son los mejores, porque es cuando se forjan los campeones.") ;; #0835 es
  (data (i32.const 288040) "Siempre hay luz, si tenemos el valor de verla. Si tenemos el valor de serla.") ;; #0836 es
  (data (i32.const 288116) "La esperanza es un verbo con las mangas arremangadas.") ;; #0837 es
  (data (i32.const 288169) "Tener esperanza es entregarse al futuro.") ;; #0838 es
  (data (i32.const 288209) "La esperanza no es un billete de loter\c3\ada que puedes sostener en el sof\c3\a1, sinti\c3\a9ndote afortunado. Es un hacha con la que derribas puertas en una emergencia.") ;; #0839 es
  (data (i32.const 288367) "Tengamos buen \c3\a1nimo, recordando que las desgracias m\c3\a1s dif\c3\adciles de soportar son las que nunca llegan.") ;; #0840 es
  (data (i32.const 288472) "La mejor forma de animarte es intentar animar a otra persona.") ;; #0841 es
  (data (i32.const 288533) "Cuando brilla el sol, puedo hacer cualquier cosa; ninguna monta\c3\b1a es demasiado alta, ning\c3\ban problema demasiado dif\c3\adcil de superar.") ;; #0842 es
  (data (i32.const 288666) "Nunca dudes de que un peque\c3\b1o grupo de ciudadanos conscientes y comprometidos puede cambiar el mundo.") ;; #0843 es
  (data (i32.const 288768) "Mant\c3\a9n el rostro hacia el sol y no ver\c3\a1s la sombra.") ;; #0844 es
  (data (i32.const 288821) "Un d\c3\ada, mirando atr\c3\a1s, los a\c3\b1os de lucha te parecer\c3\a1n los m\c3\a1s hermosos.") ;; #0845 es
  (data (i32.const 288897) "Al final, todo sale bien. Si no sali\c3\b3 bien, es que todav\c3\ada no es el final.") ;; #0846 es
  (data (i32.const 288973) "La esperanza es compa\c3\b1era del poder y madre del \c3\a9xito.") ;; #0847 es
  (data (i32.const 289029) "La esperanza ya es, en s\c3\ad misma, una forma de felicidad.") ;; #0848 es
  (data (i32.const 289086) "El sol no brilla sobre nosotros, sino dentro de nosotros.") ;; #0849 es
  (data (i32.const 289143) "La esperanza despierta, como nada m\c3\a1s puede hacerlo, una pasi\c3\b3n por lo posible.") ;; #0850 es
  (data (i32.const 289224) "No dejes que tu fuego se apague, chispa a chispa irremplazable.") ;; #0851 es
  (data (i32.const 289287) "Todos estamos en la cuneta, pero algunos miramos las estrellas.") ;; #0852 es
  (data (i32.const 289350) "\c2\a1Cuanto m\c3\a1s oscura es la noche, m\c3\a1s brillan las estrellas; cuanto m\c3\a1s profundo es el dolor, m\c3\a1s cerca est\c3\a1 Dios!") ;; #0853 es
  (data (i32.const 289468) "Las nubes llegan flotando a mi vida, ya no para traer lluvia ni anunciar tormenta, sino para dar color a mi cielo del atardecer.") ;; #0854 es
  (data (i32.const 289596) "El car\c3\a1cter es poder.") ;; #0855 es
  (data (i32.const 289618) "No tengo miedo; nac\c3\ad para hacer esto.") ;; #0856 es
  (data (i32.const 289656) "El autocontrol es fuerza. El pensamiento correcto es dominio. La calma es poder.") ;; #0857 es
  (data (i32.const 289736) "La mayor arma contra el estr\c3\a9s es nuestra capacidad de elegir un pensamiento en lugar de otro.") ;; #0858 es
  (data (i32.const 289831) "No desees ser otra cosa que lo que eres, y procura serlo a la perfecci\c3\b3n.") ;; #0859 es
  (data (i32.const 289905) "Nadie nos salva sino nosotros mismos. Nadie puede y nadie debe. Nosotros mismos debemos recorrer el camino.") ;; #0860 es
  (data (i32.const 290012) "El poder no se te da. Tienes que tomarlo.") ;; #0861 es
  (data (i32.const 290053) "No voy a limitarme solo porque la gente no acepte que puedo hacer otra cosa.") ;; #0862 es
  (data (i32.const 290129) "Nadie ha medido nunca, ni siquiera los poetas, cu\c3\a1nto puede contener un coraz\c3\b3n.") ;; #0863 es
  (data (i32.const 290211) "No todos podemos hacer grandes cosas. Pero podemos hacer cosas peque\c3\b1as con un gran amor.") ;; #0864 es
  (data (i32.const 290301) "Aunque sea peque\c3\b1a, es feroz.") ;; #0865 es
  (data (i32.const 290331) "No puedes huir de una debilidad; tarde o temprano debes enfrentarla hasta el final, o sucumbir.") ;; #0866 es
  (data (i32.const 290426) "No entres d\c3\b3cilmente en esa buena noche. Enfur\c3\a9cete, enfur\c3\a9cete contra la muerte de la luz.") ;; #0867 es
  (data (i32.const 290520) "La fuerza no viene de lo que puedes hacer. Viene de superar las cosas que una vez cre\c3\adste que no pod\c3\adas.") ;; #0868 es
  (data (i32.const 290626) "La excelencia no es una habilidad. Es una actitud.") ;; #0869 es
  (data (i32.const 290676) "Haz primero las tareas dif\c3\adciles. Las f\c3\a1ciles se resolver\c3\a1n solas.") ;; #0870 es
  (data (i32.const 290745) "Es mejor no dar ninguna excusa que dar una mala.") ;; #0871 es
  (data (i32.const 290793) "El trabajo duro solo es una condena si no tiene sentido.") ;; #0872 es
  (data (i32.const 290849) "Nos hacemos justos practicando actos justos, moderados practicando actos moderados, valientes practicando actos valientes.") ;; #0873 es
  (data (i32.const 290971) "Nunca confundas actividad con logro.") ;; #0874 es
  (data (i32.const 291007) "Cuanto m\c3\a1s trabajas, m\c3\a1s dif\c3\adcil es rendirse.") ;; #0875 es
  (data (i32.const 291055) "La pr\c3\a1ctica no hace al maestro. Solo la pr\c3\a1ctica perfecta hace al maestro.") ;; #0876 es
  (data (i32.const 291131) "El \c3\a9xito est\c3\a1 donde se encuentran la preparaci\c3\b3n y la oportunidad.") ;; #0877 es
  (data (i32.const 291200) "Calidad es hacerlo bien cuando nadie est\c3\a1 mirando.") ;; #0878 es
  (data (i32.const 291251) "Son las \c3\baltimas tres o cuatro repeticiones las que hacen crecer el m\c3\basculo.") ;; #0879 es
  (data (i32.const 291328) "La autodisciplina comienza con el dominio de tus pensamientos.") ;; #0880 es
  (data (i32.const 291390) "\c2\bfAmas la vida? Entonces no malgastes el tiempo, porque de \c3\a9l est\c3\a1 hecha la vida.") ;; #0881 es
  (data (i32.const 291473) "No paro cuando estoy cansado. Paro cuando termino.") ;; #0882 es
  (data (i32.const 291523) "El \c3\banico d\c3\ada f\c3\a1cil fue ayer.") ;; #0883 es
  (data (i32.const 291554) "Con suavidad, puedes sacudir el mundo.") ;; #0884 es
  (data (i32.const 291592) "Reexamina todo lo que te han dicho; descarta lo que ofende a tu alma.") ;; #0885 es
  (data (i32.const 291661) "El cambio es el resultado final de todo aprendizaje verdadero.") ;; #0886 es
  (data (i32.const 291723) "Quien deja de aprender es viejo, tenga veinte u ochenta a\c3\b1os.") ;; #0887 es
  (data (i32.const 291785) "El verdadero viaje de descubrimiento no consiste en buscar nuevos paisajes, sino en tener nuevos ojos.") ;; #0888 es
  (data (i32.const 291887) "Solo cuando estamos perdidos empezamos a entendernos a nosotros mismos.") ;; #0889 es
  (data (i32.const 291958) "Las cosas no cambian; cambiamos nosotros.") ;; #0890 es
  (data (i32.const 291999) "El progreso siempre implica riesgos. No puedes robar la segunda base sin quitar el pie de la primera.") ;; #0891 es
  (data (i32.const 292100) "El mayor peligro en tiempos de turbulencia no es la turbulencia; es actuar con la l\c3\b3gica de ayer.") ;; #0892 es
  (data (i32.const 292198) "Debemos estar dispuestos a soltar la vida que planeamos para tener la vida que nos espera.") ;; #0893 es
  (data (i32.const 292288) "El privilegio de toda una vida es llegar a ser quien realmente eres.") ;; #0894 es
  (data (i32.const 292356) "Conocer tu propia oscuridad es el mejor m\c3\a9todo para lidiar con la oscuridad de los dem\c3\a1s.") ;; #0895 es
  (data (i32.const 292447) "No hay toma de conciencia sin dolor.") ;; #0896 es
  (data (i32.const 292483) "Lo que cuenta es lo que aprendes despu\c3\a9s de creer que ya lo sabes todo.") ;; #0897 es
  (data (i32.const 292555) "Nuestra tarea en la vida no es adelantar a los dem\c3\a1s, sino adelantarnos a nosotros mismos.") ;; #0898 es
  (data (i32.const 292646) "Ser lo que somos y llegar a ser lo que somos capaces de ser es el \c3\banico fin de la vida.") ;; #0899 es
  (data (i32.const 292734) "Lo que la oruga llama el fin del mundo, el maestro lo llama mariposa.") ;; #0900 es
  (data (i32.const 292803) "Si no est\c3\a1s dispuesto a aprender, nadie puede ayudarte. Si est\c3\a1s decidido a aprender, nadie puede detenerte.") ;; #0901 es
  (data (i32.const 292913) "A la larga, damos forma a nuestra vida y nos damos forma a nosotros mismos.") ;; #0902 es
  (data (i32.const 292988) "De la adversidad nace la oportunidad.") ;; #0903 es
  (data (i32.const 293025) "La adversidad siempre ha sido considerada el estado en el que el hombre llega m\c3\a1s f\c3\a1cilmente a conocerse a s\c3\ad mismo.") ;; #0904 es
  (data (i32.const 293144) "Los malos tiempos tienen un valor cient\c3\adfico. Son ocasiones que un buen aprendiz no dejar\c3\ada pasar.") ;; #0905 es
  (data (i32.const 293244) "Cada muro es una puerta.") ;; #0906 es
  (data (i32.const 293268) "El dolor y el sufrimiento son siempre inevitables para una gran inteligencia y un coraz\c3\b3n profundo.") ;; #0907 es
  (data (i32.const 293368) "Largo y duro es el camino que, desde el infierno, conduce a la luz.") ;; #0908 es
  (data (i32.const 293435) "Acepta desaf\c3\ados para que puedas sentir la euforia de la victoria.") ;; #0909 es
  (data (i32.const 293501) "Cuando sea evidente que las metas no se pueden alcanzar, no ajustes las metas; ajusta los pasos para llegar a ellas.") ;; #0910 es
  (data (i32.const 293617) "La victoria es m\c3\a1s dulce cuando has conocido la derrota.") ;; #0911 es
  (data (i32.const 293674) "Es un error mirar demasiado lejos. Solo se puede sostener un eslab\c3\b3n de la cadena del destino a la vez.") ;; #0912 es
  (data (i32.const 293778) "No pierdas el tiempo golpeando un muro con la esperanza de convertirlo en puerta.") ;; #0913 es
  (data (i32.const 293859) "Empieza por cualquier parte.") ;; #0914 es
  (data (i32.const 293887) "La acci\c3\b3n es elocuencia.") ;; #0915 es
  (data (i32.const 293912) "No esperes a los l\c3\adderes; hazlo t\c3\ba, de persona a persona.") ;; #0916 es
  (data (i32.const 293971) "No juzgues cada d\c3\ada por la cosecha que recoges, sino por las semillas que siembras.") ;; #0917 es
  (data (i32.const 294055) "Haz algo maravilloso; puede que la gente lo imite.") ;; #0918 es
  (data (i32.const 294105) "Siempre es buen momento para hacer lo correcto.") ;; #0919 es
  (data (i32.const 294152) "Una meta bien fijada est\c3\a1 a medio camino de alcanzarse.") ;; #0920 es
  (data (i32.const 294208) "Las cosas no suceden. Las cosas se hacen suceder.") ;; #0921 es
  (data (i32.const 294257) "El ochenta por ciento del \c3\a9xito es presentarse.") ;; #0922 es
  (data (i32.const 294305) "No puedes construir una reputaci\c3\b3n con lo que vas a hacer.") ;; #0923 es
  (data (i32.const 294364) "T\c3\ba puedes aplazar, pero el tiempo no.") ;; #0924 es
  (data (i32.const 294402) "Escribe algo que valga la pena leer o haz algo que valga la pena escribir.") ;; #0925 es
  (data (i32.const 294476) "Algunas personas quieren que suceda, otras desean que suceda, y otras hacen que suceda.") ;; #0926 es
  (data (i32.const 294563) "Cuanto m\c3\a1s quiero hacer algo, menos lo llamo trabajo.") ;; #0927 es
  (data (i32.const 294617) "El pesimista se queja del viento; el optimista espera que cambie; el realista ajusta las velas.") ;; #0928 es
  (data (i32.const 294712) "El optimismo es esencial para el logro y es tambi\c3\a9n la base del valor y del verdadero progreso.") ;; #0929 es
  (data (i32.const 294808) "Eres lo que crees ser.") ;; #0930 es
  (data (i32.const 294830) "Cree y act\c3\baa como si fuera imposible fracasar.") ;; #0931 es
  (data (i32.const 294877) "La mente es su propio lugar y, en s\c3\ad misma, puede hacer del infierno un cielo y del cielo un infierno.") ;; #0932 es
  (data (i32.const 294980) "Si te dieras cuenta de lo poderosos que son tus pensamientos, nunca volver\c3\adas a tener un pensamiento negativo.") ;; #0933 es
  (data (i32.const 295091) "Soy el m\c3\a1s grande. Lo dec\c3\ada incluso antes de saber que lo era.") ;; #0934 es
  (data (i32.const 295155) "Imposible es solo una gran palabra que usan los hombres peque\c3\b1os.") ;; #0935 es
  (data (i32.const 295221) "Es la repetici\c3\b3n de afirmaciones lo que lleva a la creencia.") ;; #0936 es
  (data (i32.const 295282) "Si mi mente puede concebirlo y mi coraz\c3\b3n puede creerlo, entonces puedo lograrlo.") ;; #0937 es
  (data (i32.const 295364) "La confianza es contagiosa. La falta de confianza tambi\c3\a9n.") ;; #0938 es
  (data (i32.const 295423) "Alimenta tu mente con grandes pensamientos, porque nunca llegar\c3\a1s m\c3\a1s alto de lo que piensas.") ;; #0939 es
  (data (i32.const 295518) "Ten grandes pensamientos, pero saborea los peque\c3\b1os placeres.") ;; #0940 es
  (data (i32.const 295580) "Defiende tus limitaciones y, sin duda, ser\c3\a1n tuyas.") ;; #0941 es
  (data (i32.const 295632) "El \c3\a9xito es gustarte a ti mismo, que te guste lo que haces y c\c3\b3mo lo haces.") ;; #0942 es
  (data (i32.const 295709) "El alma se ti\c3\b1e del color de sus pensamientos.") ;; #0943 es
  (data (i32.const 295756) "El \c3\a9xito no es la clave de la felicidad. La felicidad es la clave del \c3\a9xito.") ;; #0944 es
  (data (i32.const 295834) "La paciencia es la aceptaci\c3\b3n serena de que las cosas pueden suceder en un orden distinto al que tienes en mente.") ;; #0945 es
  (data (i32.const 295948) "La paciencia y la fortaleza lo conquistan todo.") ;; #0946 es
  (data (i32.const 295995) "Ten paciencia. Todas las cosas son dif\c3\adciles antes de volverse f\c3\a1ciles.") ;; #0947 es
  (data (i32.const 296068) "La paciencia es una virtud que conquista.") ;; #0948 es
  (data (i32.const 296109) "Todo le llega a quien se esfuerza mientras espera.") ;; #0949 es
  (data (i32.const 296159) "Si he hecho alg\c3\ban descubrimiento valioso, se lo debo m\c3\a1s a la atenci\c3\b3n paciente que a cualquier otro talento.") ;; #0950 es
  (data (i32.const 296271) "La paciencia es necesaria, y no se cosecha de inmediato donde se ha sembrado.") ;; #0951 es
  (data (i32.const 296348) "Con sabidur\c3\ada y despacio; tropiezan los que corren deprisa.") ;; #0952 es
  (data (i32.const 296408) "Tambi\c3\a9n sirven quienes solo se quedan de pie y esperan.") ;; #0953 es
  (data (i32.const 296464) "Solo el tiempo puede curar lo que la raz\c3\b3n no puede.") ;; #0954 es
  (data (i32.const 296517) "La determinaci\c3\b3n te da la firmeza para seguir adelante a pesar de los obst\c3\a1culos que surgen en el camino.") ;; #0955 es
  (data (i32.const 296624) "Pueden vencer quienes creen que pueden.") ;; #0956 es
  (data (i32.const 296663) "No hay l\c3\admites. Hay mesetas, pero no debes quedarte en ellas; debes ir m\c3\a1s all\c3\a1.") ;; #0957 es
  (data (i32.const 296746) "Una meta no siempre est\c3\a1 hecha para alcanzarse; a menudo sirve simplemente como algo a lo que apuntar.") ;; #0958 es
  (data (i32.const 296849) "Voy a usar todas mis herramientas, el talento que Dios me dio, y construir la mejor vida posible con ello.") ;; #0959 es
  (data (i32.const 296955) "Los campeones no se hacen en el gimnasio. Se hacen de algo que llevan muy dentro: un deseo, un sue\c3\b1o, una visi\c3\b3n.") ;; #0960 es
  (data (i32.const 297070) "El camino al \c3\a9xito siempre est\c3\a1 en obras.") ;; #0961 es
  (data (i32.const 297113) "La ambici\c3\b3n es entusiasmo con un prop\c3\b3sito.") ;; #0962 es
  (data (i32.const 297158) "Los sue\c3\b1os son ilustraciones del libro que tu alma est\c3\a1 escribiendo sobre ti.") ;; #0963 es
  (data (i32.const 297237) "No sue\c3\b1es sue\c3\b1os peque\c3\b1os, porque no tienen poder para mover el coraz\c3\b3n de los hombres.") ;; #0964 es
  (data (i32.const 297328) "Un hombre no es viejo hasta que los arrepentimientos ocupan el lugar de los sue\c3\b1os.") ;; #0965 es
  (data (i32.const 297412) "En los sue\c3\b1os empieza la responsabilidad.") ;; #0966 es
  (data (i32.const 297454) "Pisa con suavidad, porque pisas mis sue\c3\b1os.") ;; #0967 es
  (data (i32.const 297498) "Todo lo que vemos o parecemos no es m\c3\a1s que un sue\c3\b1o dentro de un sue\c3\b1o.") ;; #0968 es
  (data (i32.const 297573) "No renuncies a tus sue\c3\b1os, o tus sue\c3\b1os renunciar\c3\a1n a ti.") ;; #0969 es
  (data (i32.const 297633) "No hay nada como un sue\c3\b1o para crear el futuro.") ;; #0970 es
  (data (i32.const 297681) "El poder de la imaginaci\c3\b3n nos hace infinitos.") ;; #0971 es
  (data (i32.const 297728) "T\c3\ba ves las cosas y preguntas: \22\c2\bfPor qu\c3\a9?\22. Pero yo sue\c3\b1o cosas que nunca existieron y pregunto: \22\c2\bfPor qu\c3\a9 no?\22.") ;; #0972 es
  (data (i32.const 297845) "Engancha tu carreta a una estrella.") ;; #0973 es
  (data (i32.const 297880) "Quien avanza con confianza en la direcci\c3\b3n de sus sue\c3\b1os encuentra un \c3\a9xito inesperado en las horas m\c3\a1s comunes.") ;; #0974 es
  (data (i32.const 297996) "Nuestra vida m\c3\a1s verdadera es cuando so\c3\b1amos despiertos.") ;; #0975 es
  (data (i32.const 298054) "Ve hasta donde alcances a ver; cuando llegues all\c3\ad, podr\c3\a1s ver m\c3\a1s lejos.") ;; #0976 es
  (data (i32.const 298130) "La mejor manera de hacer realidad tus sue\c3\b1os es despertar.") ;; #0977 es
  (data (i32.const 298189) "Quien mira hacia fuera, sue\c3\b1a; quien mira hacia dentro, despierta.") ;; #0978 es
  (data (i32.const 298256) "Nunca se te concede un deseo sin que tambi\c3\a9n se te conceda el poder de hacerlo realidad.") ;; #0979 es
  (data (i32.const 298345) "Una vida sin examen no merece ser vivida.") ;; #0980 es
  (data (i32.const 298386) "La \c3\banica sabidur\c3\ada verdadera est\c3\a1 en saber que no se sabe nada.") ;; #0981 es
  (data (i32.const 298452) "S\c3\a9 amable, porque cada persona que conoces est\c3\a1 librando una dura batalla.") ;; #0982 es
  (data (i32.const 298528) "Ning\c3\ban acto de bondad, por peque\c3\b1o que sea, se desperdicia.") ;; #0983 es
  (data (i32.const 298589) "Las cosas mejores y m\c3\a1s hermosas del mundo no se pueden ver ni tocar. Deben sentirse con el coraz\c3\b3n.") ;; #0984 es
  (data (i32.const 298691) "Lo que una vez disfrutamos nunca podemos perderlo. Todo lo que amamos profundamente se convierte en parte de nosotros.") ;; #0985 es
  (data (i32.const 298809) "La felicidad no es una meta; es una consecuencia.") ;; #0986 es
  (data (i32.const 298858) "El prop\c3\b3sito de la vida es vivirla, saborear la experiencia al m\c3\a1ximo.") ;; #0987 es
  (data (i32.const 298930) "El arte de ser sabio es el arte de saber qu\c3\a9 pasar por alto.") ;; #0988 es
  (data (i32.const 298991) "Quien aprende pero no piensa, est\c3\a1 perdido. Quien piensa pero no aprende, corre un gran peligro.") ;; #0989 es
  (data (i32.const 299088) "La mejor venganza es no ser como tu enemigo.") ;; #0990 es
  (data (i32.const 299132) "La p\c3\a9rdida no es m\c3\a1s que cambio, y el cambio es el deleite de la Naturaleza.") ;; #0991 es
  (data (i32.const 299210) "Contempla la belleza de la vida. Observa las estrellas e imag\c3\adnate corriendo con ellas.") ;; #0992 es
  (data (i32.const 299298) "Al levantarte por la ma\c3\b1ana, piensa en el precioso privilegio que es estar vivo.") ;; #0993 es
  (data (i32.const 299379) "No es que tengamos poco tiempo para vivir, sino que desperdiciamos mucho.") ;; #0994 es
  (data (i32.const 299452) "Mientras esperamos la vida, la vida pasa.") ;; #0995 es
  (data (i32.const 299493) "Dondequiera que haya un ser humano, hay una oportunidad para la bondad.") ;; #0996 es
  (data (i32.const 299564) "Sufre m\c3\a1s de lo necesario quien sufre antes de que sea necesario.") ;; #0997 es
  (data (i32.const 299630) "La ignorancia es la causa del miedo.") ;; #0998 es
  (data (i32.const 299666) "Vivir es lo m\c3\a1s raro del mundo. La mayor\c3\ada de la gente solo existe.") ;; #0999 es
  (data (i32.const 299735) "Perd\c3\b3n por hacerte sufrir. Te amo.") ;; #1000 es dedication
  (data (i32.const 299770) "Proverbe japonais") ;; a0001 fr
  (data (i32.const 299787) "Napol\c3\a9on Bonaparte") ;; a0018 fr
  (data (i32.const 299806) "Lucr\c3\a8ce") ;; a0020 fr
  (data (i32.const 299814) "Perse") ;; a0025 fr
  (data (i32.const 299819) "Lao Tseu") ;; a0026 fr
  (data (i32.const 299827) "Virgile") ;; a0054 fr
  (data (i32.const 299834) "Platon") ;; a0070 fr
  (data (i32.const 299840) "Proverbe chinois") ;; a0132 fr
  (data (i32.const 299856) "Proverbe africain") ;; a0133 fr
  (data (i32.const 299873) "S\c3\a9n\c3\a8que") ;; a0147 fr
  (data (i32.const 299882) "Aristote") ;; a0157 fr
  (data (i32.const 299890) "Cic\c3\a9ron") ;; a0158 fr
  (data (i32.const 299898) "Fiodor Dosto\c3\afevski") ;; a0163 fr
  (data (i32.const 299917) "Proverbe") ;; a0166 fr
  (data (i32.const 299925) "Proverbe anglais") ;; a0167 fr
  (data (i32.const 299941) "Pline l'Ancien") ;; a0174 fr
  (data (i32.const 299955) "Psaumes") ;; a0176 fr
  (data (i32.const 299962) "Tertullien") ;; a0180 fr
  (data (i32.const 299972) "Proverbe latin") ;; a0183 fr
  (data (i32.const 299986) "L\c3\a9on Tolsto\c3\af") ;; a0194 fr
  (data (i32.const 300000) "Marc Aur\c3\a8le") ;; a0195 fr
  (data (i32.const 300012) "Bouddha") ;; a0196 fr
  (data (i32.const 300019) "Saint Fran\c3\a7ois de Sales") ;; a0207 fr
  (data (i32.const 300043) "\c3\89pict\c3\a8te") ;; a0220 fr
  (data (i32.const 300053) "Proverbe tanzanien") ;; a0273 fr
  (data (i32.const 300071) "H\c3\a9raclite") ;; a0274 fr
  (data (i32.const 300081) "Proverbe maori") ;; a0283 fr
  (data (i32.const 300095) "\c3\89picure") ;; a0298 fr
  (data (i32.const 300103) "Proverbe zen") ;; a0302 fr
  (data (i32.const 300115) "Hillel l'Ancien") ;; a0315 fr
  (data (i32.const 300130) "Pape Jean-Paul II") ;; a0325 fr
  (data (i32.const 300147) "Proverbe hassidique") ;; a0330 fr
  (data (i32.const 300166) "Saint Augustin") ;; a0349 fr
  (data (i32.const 300180) "Ovide") ;; a0351 fr
  (data (i32.const 300185) "Proverbe n\c3\a9erlandais") ;; a0356 fr
  (data (i32.const 300206) "\c3\89sope") ;; a0358 fr
  (data (i32.const 300212) "Proverbe swahili") ;; a0359 fr
  (data (i32.const 300228) "Hom\c3\a8re") ;; a0361 fr
  (data (i32.const 300235) "Proverbe turc") ;; a0365 fr
  (data (i32.const 300248) "Proverbe persan") ;; a0367 fr
  (data (i32.const 300263) "Jeanne d'Arc") ;; a0461 fr
  (data (i32.const 300275) "M\c3\a8re Teresa") ;; a0464 fr
  (data (i32.const 300287) "Navy SEALs am\c3\a9ricains") ;; a0471 fr
  (data (i32.const 300309) "Socrate") ;; a0496 fr
  (data (i32.const 300316) "Peu importe la lenteur avec laquelle tu avances, tant que tu ne t'arr\c3\aates pas.") ;; #0000 fr
  (data (i32.const 300395) "Tombe sept fois, rel\c3\a8ve-toi huit.") ;; #0001 fr
  (data (i32.const 300429) "Notre plus grande gloire n'est pas de ne jamais tomber, mais de nous relever chaque fois que nous tombons.") ;; #0002 fr
  (data (i32.const 300535) "L'\c3\a9nergie et la pers\c3\a9v\c3\a9rance viennent \c3\a0 bout de tout.") ;; #0003 fr
  (data (i32.const 300592) "Les rivi\c3\a8res le savent : rien ne presse. Nous arriverons un jour.") ;; #0004 fr
  (data (i32.const 300658) "La pers\c3\a9v\c3\a9rance n'est pas une longue course ; c'est une succession de courtes courses, l'une apr\c3\a8s l'autre.") ;; #0005 fr
  (data (i32.const 300768) "La rivi\c3\a8re perce la roche non par sa force, mais par sa pers\c3\a9v\c3\a9rance.") ;; #0006 fr
  (data (i32.const 300840) "Beaucoup d'\c3\a9checs dans la vie sont le fait de personnes qui n'ont pas compris \c3\a0 quel point elles \c3\a9taient proches du succ\c3\a8s quand elles ont abandonn\c3\a9.") ;; #0007 fr
  (data (i32.const 300994) "Je marche lentement, mais je ne recule jamais.") ;; #0008 fr
  (data (i32.const 301040) "Les grandes \c5\93uvres ne s'accomplissent pas par la force, mais par la pers\c3\a9v\c3\a9rance.") ;; #0009 fr
  (data (i32.const 301124) "La patience et la pers\c3\a9v\c3\a9rance ont un effet magique devant lequel les difficult\c3\a9s disparaissent et les obstacles s'\c3\a9vanouissent.") ;; #0010 fr
  (data (i32.const 301256) "Gr\c3\a2ce \c3\a0 la pers\c3\a9v\c3\a9rance, bien des gens r\c3\a9ussissent l\c3\a0 o\c3\b9 l'\c3\a9chec semblait certain.") ;; #0011 fr
  (data (i32.const 301346) "L'effort continu, et non la force ou l'intelligence, est la cl\c3\a9 qui lib\c3\a8re notre potentiel.") ;; #0012 fr
  (data (i32.const 301439) "L'ambition est le chemin du succ\c3\a8s. La pers\c3\a9v\c3\a9rance est le v\c3\a9hicule qui vous y m\c3\a8ne.") ;; #0013 fr
  (data (i32.const 301528) "Ce qui distingue une personne qui r\c3\a9ussit des autres n'est pas un manque de force ni de connaissances, mais un manque de volont\c3\a9.") ;; #0014 fr
  (data (i32.const 301659) "Le succ\c3\a8s est la somme de petits efforts, r\c3\a9p\c3\a9t\c3\a9s jour apr\c3\a8s jour.") ;; #0015 fr
  (data (i32.const 301730) "Cela semble toujours impossible, jusqu'\c3\a0 ce qu'on le fasse.") ;; #0016 fr
  (data (i32.const 301790) "Rien au monde ne peut remplacer la pers\c3\a9v\c3\a9rance.") ;; #0017 fr
  (data (i32.const 301840) "La victoire appartient au plus pers\c3\a9v\c3\a9rant.") ;; #0018 fr
  (data (i32.const 301885) "Avec un talent ordinaire et une pers\c3\a9v\c3\a9rance extraordinaire, tout est possible.") ;; #0019 fr
  (data (i32.const 301966) "Les gouttes de pluie creusent la pierre, non par leur violence, mais \c3\a0 force de tomber.") ;; #0020 fr
  (data (i32.const 302054) "La plupart des grandes choses de ce monde ont \c3\a9t\c3\a9 accomplies par des gens qui ont continu\c3\a9 d'essayer alors qu'il ne semblait plus y avoir le moindre espoir.") ;; #0021 fr
  (data (i32.const 302213) "Constance, pers\c3\a9v\c3\a9rance et t\c3\a9nacit\c3\a9 malgr\c3\a9 tous les obstacles, d\c3\a9couragements et impossibilit\c3\a9s : voil\c3\a0 ce qui, en toute chose, distingue l'\c3\a2me forte de l'\c3\a2me faible.") ;; #0022 fr
  (data (i32.const 302389) "N'abandonne jamais, car c'est pr\c3\a9cis\c3\a9ment \c3\a0 cet endroit et \c3\a0 ce moment que la mar\c3\a9e va tourner.") ;; #0023 fr
  (data (i32.const 302489) "La pers\c3\a9v\c3\a9rance peut transformer l'\c3\a9chec en une r\c3\a9ussite extraordinaire.") ;; #0024 fr
  (data (i32.const 302565) "Celui qui endure triomphe.") ;; #0025 fr
  (data (i32.const 302591) "L'eau est fluide, douce et souple. Mais l'eau use la roche, qui est rigide et ne peut c\c3\a9der.") ;; #0026 fr
  (data (i32.const 302684) "Paralyse la r\c3\a9sistance par la pers\c3\a9v\c3\a9rance.") ;; #0027 fr
  (data (i32.const 302730) "L'effort ne livre toute sa r\c3\a9compense qu'\c3\a0 celui qui refuse d'abandonner.") ;; #0028 fr
  (data (i32.const 302805) "Patience, pers\c3\a9v\c3\a9rance et transpiration forment une combinaison imbattable pour r\c3\a9ussir.") ;; #0029 fr
  (data (i32.const 302896) "Un champion, c'est quelqu'un qui se rel\c3\a8ve quand il n'en peut plus.") ;; #0030 fr
  (data (i32.const 302964) "Ne c\c3\a9dez jamais. Jamais, jamais, jamais, jamais.") ;; #0031 fr
  (data (i32.const 303013) "Le succ\c3\a8s semble li\c3\a9 \c3\a0 l'action. Ceux qui r\c3\a9ussissent ne cessent de bouger.") ;; #0032 fr
  (data (i32.const 303092) "Chaque \c3\a9lan manqu\c3\a9 me rapproche du prochain coup de circuit.") ;; #0033 fr
  (data (i32.const 303154) "On ne peut tout simplement pas battre quelqu'un qui n'abandonne jamais.") ;; #0034 fr
  (data (i32.const 303225) "Ne regarde pas l'horloge ; fais comme elle. Continue d'avancer.") ;; #0035 fr
  (data (i32.const 303288) "Ce que nous esp\c3\a9rons un jour faire avec aisance, nous devons d'abord apprendre \c3\a0 le faire avec application.") ;; #0036 fr
  (data (i32.const 303397) "Dans l'affrontement entre le ruisseau et le rocher, le ruisseau gagne toujours, non par la force, mais par la pers\c3\a9v\c3\a9rance.") ;; #0037 fr
  (data (i32.const 303522) "Endurer, ce n'est pas seulement supporter une chose difficile, c'est la transformer en gloire.") ;; #0038 fr
  (data (i32.const 303616) "Pers\c3\a9v\c3\a9rance, secret de tous les triomphes.") ;; #0039 fr
  (data (i32.const 303661) "La route du succ\c3\a8s est jalonn\c3\a9e de places de parking bien tentantes.") ;; #0040 fr
  (data (i32.const 303731) "Si tu es tomb\c3\a9 hier, rel\c3\a8ve-toi aujourd'hui.") ;; #0041 fr
  (data (i32.const 303777) "Je persisterai jusqu'\c3\a0 ce que je r\c3\a9ussisse.") ;; #0042 fr
  (data (i32.const 303822) "On peut franchir la plus haute montagne, un pas apr\c3\a8s l'autre.") ;; #0043 fr
  (data (i32.const 303885) "Les diamants ne sont que des morceaux de charbon qui se sont accroch\c3\a9s \c3\a0 leur travail.") ;; #0044 fr
  (data (i32.const 303973) "Les grandes choses ne se font pas par impulsion, mais par une s\c3\a9rie de petites choses r\c3\a9unies.") ;; #0045 fr
  (data (i32.const 304069) "Le g\c3\a9nie, c'est un pour cent d'inspiration et quatre-vingt-dix-neuf pour cent de transpiration.") ;; #0046 fr
  (data (i32.const 304165) "Plus le combat est dur, plus le triomphe est glorieux.") ;; #0047 fr
  (data (i32.const 304219) "La pers\c3\a9v\c3\a9rance garantit que les r\c3\a9sultats sont in\c3\a9vitables.") ;; #0048 fr
  (data (i32.const 304283) "Le courage ne rugit pas toujours. Parfois, le courage est cette petite voix, \c3\a0 la fin de la journ\c3\a9e, qui dit : demain, je r\c3\a9essaierai.") ;; #0049 fr
  (data (i32.const 304420) "J'ai appris que le courage n'est pas l'absence de peur, mais la capacit\c3\a9 de la vaincre.") ;; #0050 fr
  (data (i32.const 304508) "On gagne en force, en courage et en confiance \c3\a0 chaque exp\c3\a9rience o\c3\b9 l'on s'arr\c3\aate vraiment pour regarder la peur en face.") ;; #0051 fr
  (data (i32.const 304634) "Le courage, c'est r\c3\a9sister \c3\a0 la peur, la ma\c3\aetriser, et non l'absence de peur.") ;; #0052 fr
  (data (i32.const 304714) "La vie se r\c3\a9tr\c3\a9cit ou s'\c3\a9largit \c3\a0 la mesure de notre courage.") ;; #0053 fr
  (data (i32.const 304779) "Il faut du courage pour grandir et devenir qui l'on est vraiment.") ;; #0054 fr
  (data (i32.const 304844) "Le courage est \c3\a0 juste titre consid\c3\a9r\c3\a9 comme la premi\c3\a8re des qualit\c3\a9s humaines, car c'est la qualit\c3\a9 qui garantit toutes les autres.") ;; #0055 fr
  (data (i32.const 304982) "L'homme courageux n'est pas celui qui n'a pas peur, mais celui qui triomphe de cette peur.") ;; #0056 fr
  (data (i32.const 305072) "Ayez le courage de suivre votre c\c5\93ur et votre intuition.") ;; #0057 fr
  (data (i32.const 305129) "\c3\8atre profond\c3\a9ment aim\c3\a9 par quelqu'un nous donne de la force ; aimer quelqu'un profond\c3\a9ment nous donne du courage.") ;; #0058 fr
  (data (i32.const 305246) "Le courage, c'est la gr\c3\a2ce sous la pression.") ;; #0059 fr
  (data (i32.const 305291) "Celui qui n'a pas le courage de prendre des risques n'accomplira rien dans la vie.") ;; #0060 fr
  (data (i32.const 305373) "Seuls ceux qui risquent d'aller trop loin peuvent d\c3\a9couvrir jusqu'o\c3\b9 il est possible d'aller.") ;; #0061 fr
  (data (i32.const 305468) "La fortune sourit aux audacieux.") ;; #0062 fr
  (data (i32.const 305500) "Le courage se trouve dans les endroits les plus inattendus.") ;; #0063 fr
  (data (i32.const 305559) "M\c3\aame la plus petite personne peut changer le cours de l'avenir.") ;; #0064 fr
  (data (i32.const 305623) "Tout ce que nous avons \c3\a0 d\c3\a9cider, c'est ce que nous devons faire du temps qui nous est imparti.") ;; #0065 fr
  (data (i32.const 305720) "Il faut beaucoup de bravoure pour tenir t\c3\aate \c3\a0 ses ennemis, mais tout autant pour tenir t\c3\aate \c3\a0 ses amis.") ;; #0066 fr
  (data (i32.const 305828) "Fais ce que tu crains, et la mort de la peur est certaine.") ;; #0067 fr
  (data (i32.const 305886) "La peur n'est profonde que dans la mesure o\c3\b9 l'esprit le permet.") ;; #0068 fr
  (data (i32.const 305951) "Tout ce que tu as toujours voulu se trouve de l'autre c\c3\b4t\c3\a9 de la peur.") ;; #0069 fr
  (data (i32.const 306023) "L'inaction engendre le doute et la peur. L'action engendre la confiance et le courage.") ;; #0070 fr
  (data (i32.const 306109) "Le courage, c'est \c3\aatre mort de peur et monter quand m\c3\aame en selle.") ;; #0071 fr
  (data (i32.const 306177) "Je n'ai pas peur des temp\c3\aates, car j'apprends \c3\a0 mener mon navire.") ;; #0072 fr
  (data (i32.const 306244) "Un navire est en s\c3\a9curit\c3\a9 au port, mais ce n'est pas pour cela qu'on construit les navires.") ;; #0073 fr
  (data (i32.const 306337) "La grotte o\c3\b9 tu as peur d'entrer renferme le tr\c3\a9sor que tu cherches.") ;; #0074 fr
  (data (i32.const 306407) "Le courage est contagieux. Quand un homme brave prend position, les autres se redressent souvent.") ;; #0075 fr
  (data (i32.const 306504) "Rien dans la vie n'est \c3\a0 craindre, tout est \c3\a0 comprendre.") ;; #0076 fr
  (data (i32.const 306563) "La bravoure, c'est la capacit\c3\a9 d'agir correctement m\c3\aame quand on est mort de peur.") ;; #0077 fr
  (data (i32.const 306647) "Avec du courage, tu oseras prendre des risques, tu auras la force d'\c3\aatre compatissant et la sagesse d'\c3\aatre humble.") ;; #0078 fr
  (data (i32.const 306763) "On ne na\c3\aet pas forc\c3\a9ment courageux, mais on na\c3\aet avec un potentiel.") ;; #0079 fr
  (data (i32.const 306833) "Le courage est la plus importante de toutes les vertus, car sans courage, on ne peut pratiquer aucune autre vertu avec constance.") ;; #0080 fr
  (data (i32.const 306962) "La libert\c3\a9 consiste \c3\a0 \c3\aatre audacieux.") ;; #0081 fr
  (data (i32.const 307002) "La seule chose que nous ayons \c3\a0 craindre, c'est la peur elle-m\c3\aame.") ;; #0082 fr
  (data (i32.const 307070) "Le courage, c'est savoir ce qu'il ne faut pas craindre.") ;; #0083 fr
  (data (i32.const 307125) "Ressens la peur et fais-le quand m\c3\aame.") ;; #0084 fr
  (data (i32.const 307164) "Sois audacieux, et des forces puissantes viendront \c3\a0 ton aide.") ;; #0085 fr
  (data (i32.const 307227) "Il n'y a aucune passion \c3\a0 jouer petit.") ;; #0086 fr
  (data (i32.const 307266) "Le courage est comme un muscle : il se renforce \c3\a0 l'usage.") ;; #0087 fr
  (data (i32.const 307325) "La vuln\c3\a9rabilit\c3\a9 est le berceau de l'innovation, de la cr\c3\a9ativit\c3\a9 et du changement.") ;; #0088 fr
  (data (i32.const 307412) "Le courage commence par se pr\c3\a9senter et se laisser voir.") ;; #0089 fr
  (data (i32.const 307469) "N'aie pas peur de renoncer au bien pour viser l'excellent.") ;; #0090 fr
  (data (i32.const 307527) "Oser, c'est perdre pied momentan\c3\a9ment. Ne pas oser, c'est se perdre soi-m\c3\aame.") ;; #0091 fr
  (data (i32.const 307606) "Ce n'est pas la montagne que nous conqu\c3\a9rons, mais nous-m\c3\aames.") ;; #0092 fr
  (data (i32.const 307670) "Saute, et le filet appara\c3\aetra.") ;; #0093 fr
  (data (i32.const 307701) "La s\c3\a9curit\c3\a9 est surtout une superstition. La vie est une aventure audacieuse, ou elle n'est rien.") ;; #0094 fr
  (data (i32.const 307800) "Que serait la vie si nous n'avions pas le courage de tenter quoi que ce soit ?") ;; #0095 fr
  (data (i32.const 307878) "Mieux vaut oser de grandes choses et remporter de glorieux triomphes, m\c3\aame entach\c3\a9s d'\c3\a9checs, que de se ranger parmi ces pauvres esprits qui ne connaissent ni grande joie ni grande souffrance.") ;; #0096 fr
  (data (i32.const 308073) "Ce n'est pas le critique qui compte.") ;; #0097 fr
  (data (i32.const 308109) "Le m\c3\a9rite revient \c3\a0 celui qui est r\c3\a9ellement dans l'ar\c3\a8ne.") ;; #0098 fr
  (data (i32.const 308171) "La peur a deux sens : tout fuir, ou tout affronter et se relever.") ;; #0099 fr
  (data (i32.const 308236) "Avoir peur, c'est ce que tu ressens. \c3\8atre courageux, c'est ce que tu fais.") ;; #0100 fr
  (data (i32.const 308311) "Le courage est tenu pour la plus grande des vertus, car sans elle, l'homme n'a aucune garantie de pr\c3\a9server les autres.") ;; #0101 fr
  (data (i32.const 308431) "Le courage est l'\c3\a9chelle par laquelle montent toutes les autres vertus.") ;; #0102 fr
  (data (i32.const 308503) "Le courage n'est pas simplement l'une des vertus, mais la forme de toutes les vertus au moment de l'\c3\a9preuve.") ;; #0103 fr
  (data (i32.const 308612) "Courage, cher c\c5\93ur.") ;; #0104 fr
  (data (i32.const 308632) "Le courage, c'est la force de l\c3\a2cher ce qui nous est familier.") ;; #0105 fr
  (data (i32.const 308695) "Je n'ai pas \c3\a9chou\c3\a9. J'ai simplement trouv\c3\a9 10 000 solutions qui ne fonctionnent pas.") ;; #0106 fr
  (data (i32.const 308782) "L'\c3\a9chec n'est que l'occasion de recommencer, cette fois plus intelligemment.") ;; #0107 fr
  (data (i32.const 308859) "D\c3\a9j\c3\a0 essay\c3\a9. D\c3\a9j\c3\a0 \c3\a9chou\c3\a9. Peu importe. Essaie encore. \c3\89choue encore. \c3\89choue mieux.") ;; #0108 fr
  (data (i32.const 308950) "J'ai \c3\a9chou\c3\a9 encore et encore et encore dans ma vie. Et c'est pour cela que je r\c3\a9ussis.") ;; #0109 fr
  (data (i32.const 309039) "Seuls ceux qui osent \c3\a9chouer grandement peuvent r\c3\a9ussir grandement.") ;; #0110 fr
  (data (i32.const 309108) "L'\c3\a9chec est le condiment qui donne sa saveur au succ\c3\a8s.") ;; #0111 fr
  (data (i32.const 309165) "Il est impossible de vivre sans \c3\a9chouer en quelque chose, \c3\a0 moins de vivre avec tant de prudence que c'est comme si l'on n'avait pas v\c3\a9cu.") ;; #0112 fr
  (data (i32.const 309306) "Toucher le fond est devenu la base solide sur laquelle j'ai reconstruit ma vie.") ;; #0113 fr
  (data (i32.const 309385) "Ne me jugez pas sur mes succ\c3\a8s, jugez-moi sur le nombre de fois o\c3\b9 je suis tomb\c3\a9 et me suis relev\c3\a9.") ;; #0114 fr
  (data (i32.const 309488) "L'\c3\a9chec doit \c3\aatre notre professeur, pas notre fossoyeur.") ;; #0115 fr
  (data (i32.const 309546) "Une seule chose rend un r\c3\aave impossible \c3\a0 r\c3\a9aliser : la peur d'\c3\a9chouer.") ;; #0116 fr
  (data (i32.const 309621) "L'\c3\a9chec n'est pas le contraire du succ\c3\a8s ; il en fait partie.") ;; #0117 fr
  (data (i32.const 309684) "On construit sur l'\c3\a9chec. On s'en sert comme d'un tremplin.") ;; #0118 fr
  (data (i32.const 309744) "Un homme de g\c3\a9nie ne commet pas d'erreurs. Ses erreurs sont volontaires et sont les portes de la d\c3\a9couverte.") ;; #0119 fr
  (data (i32.const 309854) "Abandonner est le seul moyen s\c3\bbr d'\c3\a9chouer.") ;; #0120 fr
  (data (i32.const 309899) "Chaque \c3\a9chec est un pas vers le succ\c3\a8s.") ;; #0121 fr
  (data (i32.const 309940) "La d\c3\a9faite n'est pas le pire des \c3\a9checs. Ne pas avoir essay\c3\a9, voil\c3\a0 le v\c3\a9ritable \c3\a9chec.") ;; #0122 fr
  (data (i32.const 310033) "Les \c3\a9checs sont des panneaux indicateurs sur la route de la r\c3\a9ussite.") ;; #0123 fr
  (data (i32.const 310104) "Le ph\c3\a9nix doit br\c3\bbler pour rena\c3\aetre.") ;; #0124 fr
  (data (i32.const 310143) "Nous sommes tous des rat\c3\a9s, du moins les meilleurs d'entre nous.") ;; #0125 fr
  (data (i32.const 310208) "Je peux accepter l'\c3\a9chec, tout le monde \c3\a9choue \c3\a0 quelque chose. Mais je ne peux pas accepter de ne pas essayer.") ;; #0126 fr
  (data (i32.const 310322) "Le succ\c3\a8s ne se construit pas sur le succ\c3\a8s. Il se construit sur l'\c3\a9chec. Il se construit sur la frustration.") ;; #0127 fr
  (data (i32.const 310434) "Les gagnants n'ont pas peur de perdre. Les perdants, si. L'\c3\a9chec fait partie du chemin vers le succ\c3\a8s.") ;; #0128 fr
  (data (i32.const 310538) "Un inventeur \c3\a9choue 999 fois, et s'il r\c3\a9ussit une seule fois, c'est gagn\c3\a9.") ;; #0129 fr
  (data (i32.const 310615) "Remarquez que l'arbre le plus rigide est celui qui se brise le plus facilement, tandis que le bambou ou le saule survivent en pliant sous le vent.") ;; #0130 fr
  (data (i32.const 310761) "Ne crains pas l'\c3\a9chec. Le crime n'est pas d'\c3\a9chouer, mais de viser trop bas.") ;; #0131 fr
  (data (i32.const 310839) "L'\c3\a9chec est instructif. Celui qui r\c3\a9fl\c3\a9chit vraiment apprend autant de ses \c3\a9checs que de ses r\c3\a9ussites.") ;; #0132 fr
  (data (i32.const 310947) "Notre plus grande faiblesse est d'abandonner. La fa\c3\a7on la plus s\c3\bbre de r\c3\a9ussir est toujours d'essayer une fois de plus.") ;; #0133 fr
  (data (i32.const 311069) "Les gens bons sont bons parce qu'ils sont parvenus \c3\a0 la sagesse \c3\a0 travers l'\c3\a9chec.") ;; #0134 fr
  (data (i32.const 311154) "La plus grande erreur que l'on puisse faire dans la vie est d'avoir sans cesse peur d'en faire une.") ;; #0135 fr
  (data (i32.const 311253) "Si tu n'es pas pr\c3\aat \c3\a0 te tromper, tu ne cr\c3\a9eras jamais rien d'original.") ;; #0136 fr
  (data (i32.const 311327) "L'exp\c3\a9rience est simplement le nom que nous donnons \c3\a0 nos erreurs.") ;; #0137 fr
  (data (i32.const 311395) "Quand nous nous donnons la permission d'\c3\a9chouer, nous nous donnons en m\c3\aame temps la permission d'exceller.") ;; #0138 fr
  (data (i32.const 311503) "La seule vraie erreur est celle dont on n'apprend rien.") ;; #0139 fr
  (data (i32.const 311558) "Ce n'est pas parce que tu as \c3\a9chou\c3\a9 une fois que tu vas \c3\a9chouer en tout.") ;; #0140 fr
  (data (i32.const 311633) "Je pr\c3\a9f\c3\a8re \c3\a9chouer dans ce que j'aime que r\c3\a9ussir dans ce que je d\c3\a9teste.") ;; #0141 fr
  (data (i32.const 311711) "Il n'y a d'\c3\a9chec que lorsqu'on cesse d'essayer.") ;; #0142 fr
  (data (i32.const 311759) "L'\c3\a9chec ne me rattrapera jamais si ma volont\c3\a9 de r\c3\a9ussir est assez forte.") ;; #0143 fr
  (data (i32.const 311835) "Il faut parfois livrer une bataille plus d'une fois pour la gagner.") ;; #0144 fr
  (data (i32.const 311902) "L'\c3\a9chec n'est pas fatal, mais ne pas changer pourrait l'\c3\aatre.") ;; #0145 fr
  (data (i32.const 311965) "Si tu tires une le\c3\a7on de la d\c3\a9faite, tu n'as pas vraiment perdu.") ;; #0146 fr
  (data (i32.const 312031) "Le ma\c3\aetre a \c3\a9chou\c3\a9 plus de fois que le d\c3\a9butant n'a m\c3\aame essay\c3\a9.") ;; #0147 fr
  (data (i32.const 312101) "Il est bon de c\c3\a9l\c3\a9brer le succ\c3\a8s, mais il est plus important de tirer les le\c3\a7ons de l'\c3\a9chec.") ;; #0148 fr
  (data (i32.const 312198) "On avance vers le succ\c3\a8s en \c3\a9chouant.") ;; #0149 fr
  (data (i32.const 312237) "L'\c3\a9chec est la cl\c3\a9 du succ\c3\a8s ; chaque erreur nous apprend quelque chose.") ;; #0150 fr
  (data (i32.const 312312) "Sur le chemin du succ\c3\a8s, on passe toujours par l'\c3\a9chec.") ;; #0151 fr
  (data (i32.const 312369) "L'\c3\a9chec n'a pas d'importance. Il faut du courage pour se ridiculiser.") ;; #0152 fr
  (data (i32.const 312439) "Qu'est-ce que la d\c3\a9faite ? Rien d'autre qu'une le\c3\a7on ; rien d'autre que le premier pas vers quelque chose de meilleur.") ;; #0153 fr
  (data (i32.const 312559) "Ne confonds jamais une d\c3\a9faite avec la d\c3\a9faite finale.") ;; #0154 fr
  (data (i32.const 312615) "N'aie pas honte de tes \c3\a9checs ; apprends d'eux et recommence.") ;; #0155 fr
  (data (i32.const 312677) "De la souffrance sont n\c3\a9es les \c3\a2mes les plus fortes ; les caract\c3\a8res les plus solides portent des cicatrices.") ;; #0156 fr
  (data (i32.const 312789) "Le ch\c3\aane a lutt\c3\a9 contre le vent et s'est bris\c3\a9 ; le saule a pli\c3\a9 quand il le fallait et a surv\c3\a9cu.") ;; #0157 fr
  (data (i32.const 312892) "Bien que le monde soit plein de souffrance, il est aussi plein de victoires sur elle.") ;; #0158 fr
  (data (i32.const 312977) "Le caract\c3\a8re ne se forge pas dans la facilit\c3\a9 et le calme. Ce n'est que par l'\c3\a9preuve et la souffrance que l'\c3\a2me se fortifie, que l'ambition s'\c3\a9veille et que le succ\c3\a8s s'obtient.") ;; #0159 fr
  (data (i32.const 313161) "La vie ne devient ni plus facile ni plus indulgente ; c'est nous qui devenons plus forts et plus r\c3\a9silients.") ;; #0160 fr
  (data (i32.const 313270) "Ne prie pas pour une vie facile ; prie pour avoir la force d'en supporter une difficile.") ;; #0161 fr
  (data (i32.const 313358) "La capacit\c3\a9 humaine \c3\a0 porter des fardeaux est comme le bambou : bien plus souple qu'on ne le croirait au premier regard.") ;; #0162 fr
  (data (i32.const 313480) "Ce qui m'arrive peut me changer. Mais je refuse d'en \c3\aatre diminu\c3\a9e.") ;; #0163 fr
  (data (i32.const 313549) "Tu conna\c3\aetras peut-\c3\aatre bien des d\c3\a9faites, mais tu ne dois pas \c3\aatre vaincu.") ;; #0164 fr
  (data (i32.const 313628) "Et pourtant, comme l'air, je m'\c3\a9l\c3\a8ve.") ;; #0165 fr
  (data (i32.const 313667) "Elle se tenait debout dans la temp\c3\aate et, quand le vent ne soufflait pas dans son sens, elle ajustait ses voiles.") ;; #0166 fr
  (data (i32.const 313781) "Les temps difficiles ne durent pas, les gens solides, si.") ;; #0167 fr
  (data (i32.const 313838) "L\c3\a0 o\c3\b9 il n'y a pas de lutte, il n'y a pas de force.") ;; #0168 fr
  (data (i32.const 313891) "Transforme tes blessures en sagesse.") ;; #0169 fr
  (data (i32.const 313927) "Quand tout semble aller contre toi, souviens-toi que l'avion d\c3\a9colle face au vent, et non avec lui.") ;; #0170 fr
  (data (i32.const 314027) "Des difficult\c3\a9s naissent les miracles.") ;; #0171 fr
  (data (i32.const 314066) "On ne peut polir la pierre pr\c3\a9cieuse sans frottement, ni perfectionner l'homme sans \c3\a9preuves.") ;; #0172 fr
  (data (i32.const 314161) "Mer calme n'a jamais fait bon marin.") ;; #0173 fr
  (data (i32.const 314197) "Mes cicatrices me rappellent que j'ai bel et bien surv\c3\a9cu \c3\a0 mes blessures les plus profondes.") ;; #0174 fr
  (data (i32.const 314292) "La force ne vient pas des capacit\c3\a9s physiques. Elle vient d'une volont\c3\a9 indomptable.") ;; #0175 fr
  (data (i32.const 314378) "Le monde brise tout le monde, et ensuite beaucoup deviennent forts \c3\a0 l'endroit de la fracture.") ;; #0176 fr
  (data (i32.const 314473) "Ce qui ne me tue pas me rend plus fort.") ;; #0177 fr
  (data (i32.const 314512) "Celui qui a un pourquoi qui lui tient lieu de but peut supporter presque n'importe quel comment.") ;; #0178 fr
  (data (i32.const 314608) "Lorsque nous ne sommes plus en mesure de changer une situation, nous sommes mis au d\c3\a9fi de nous changer nous-m\c3\aames.") ;; #0179 fr
  (data (i32.const 314725) "On peut tout enlever \c3\a0 un homme, sauf une chose : la derni\c3\a8re des libert\c3\a9s humaines, celle de choisir son attitude face aux circonstances.") ;; #0180 fr
  (data (i32.const 314866) "Le bambou qui plie est plus fort que le ch\c3\aane qui r\c3\a9siste.") ;; #0181 fr
  (data (i32.const 314926) "Les \c3\a9preuves pr\c3\a9parent souvent des gens ordinaires \c3\a0 un destin extraordinaire.") ;; #0182 fr
  (data (i32.const 315007) "Nos blessures sont souvent les ouvertures vers la part la meilleure et la plus belle de nous-m\c3\aames.") ;; #0183 fr
  (data (i32.const 315107) "La r\c3\a9silience, c'est accepter sa nouvelle r\c3\a9alit\c3\a9, m\c3\aame si elle est moins bonne que celle d'avant.") ;; #0184 fr
  (data (i32.const 315209) "L'homme n'a jamais fabriqu\c3\a9 de mat\c3\a9riau aussi r\c3\a9silient que l'esprit humain.") ;; #0185 fr
  (data (i32.const 315288) "Le deuil et la r\c3\a9silience vont de pair.") ;; #0186 fr
  (data (i32.const 315328) "Ce qui compte, ce n'est pas d'\c3\aatre mis \c3\a0 terre, c'est de se relever.") ;; #0187 fr
  (data (i32.const 315398) "Ce n'est pas la force de tes coups qui compte. C'est ta capacit\c3\a9 \c3\a0 encaisser et \c3\a0 continuer d'avancer.") ;; #0188 fr
  (data (i32.const 315503) "Une bonne moiti\c3\a9 de l'art de vivre est la r\c3\a9silience.") ;; #0189 fr
  (data (i32.const 315558) "Rien n'est impossible. Le mot lui-m\c3\aame, en anglais, le dit : \c2\ab I'm possible \c2\bb, je suis possible !") ;; #0190 fr
  (data (i32.const 315658) "Les \c3\a9toiles ne peuvent briller sans obscurit\c3\a9.") ;; #0191 fr
  (data (i32.const 315706) "La blessure est l'endroit par o\c3\b9 la Lumi\c3\a8re entre en toi.") ;; #0192 fr
  (data (i32.const 315765) "Quand il fait assez sombre, on peut voir les \c3\a9toiles.") ;; #0193 fr
  (data (i32.const 315819) "Le feu \c3\a9prouve l'or ; l'adversit\c3\a9, les hommes forts.") ;; #0194 fr
  (data (i32.const 315873) "Les difficult\c3\a9s fortifient l'esprit, comme le travail fortifie le corps.") ;; #0195 fr
  (data (i32.const 315946) "M\c3\aame si personne ne peut revenir en arri\c3\a8re pour prendre un nouveau d\c3\a9part, chacun peut commencer maintenant et \c3\a9crire une nouvelle fin.") ;; #0196 fr
  (data (i32.const 316086) "J'ai \c3\a9t\c3\a9 absolument terrifi\c3\a9e \c3\a0 chaque instant de ma vie, et je ne l'ai jamais laiss\c3\a9 m'emp\c3\aacher de faire une seule chose que je voulais faire.") ;; #0197 fr
  (data (i32.const 316235) "Le chagrin est la fa\c3\a7on dont nous apprenons \c3\a0 aimer. Ton c\c5\93ur ne se brise pas. Il a mal parce qu'il s'agrandit.") ;; #0198 fr
  (data (i32.const 316349) "D\c3\a8s que tu choisis l'espoir, tout est possible.") ;; #0199 fr
  (data (i32.const 316397) "Ne laisse pas ce que tu ne peux pas faire t'emp\c3\aacher de faire ce que tu peux.") ;; #0200 fr
  (data (i32.const 316475) "Le meilleur moyen d'en sortir, c'est toujours de passer \c3\a0 travers.") ;; #0201 fr
  (data (i32.const 316542) "En deux mots, je peux r\c3\a9sumer tout ce que j'ai appris sur la vie : elle continue.") ;; #0202 fr
  (data (i32.const 316624) "La vitalit\c3\a9 se r\c3\a9v\c3\a8le non seulement dans la capacit\c3\a9 \c3\a0 pers\c3\a9v\c3\a9rer, mais aussi dans celle de recommencer.") ;; #0203 fr
  (data (i32.const 316735) "Mais l'homme n'est pas fait pour la d\c3\a9faite. Un homme, \c3\a7a peut \c3\aatre d\c3\a9truit, mais pas vaincu.") ;; #0204 fr
  (data (i32.const 316832) "La vie n'est pas toujours une question de bonnes cartes, mais parfois de bien jouer une mauvaise main.") ;; #0205 fr
  (data (i32.const 316934) "L'espoir est cette chose avec des plumes qui se perche dans l'\c3\a2me.") ;; #0206 fr
  (data (i32.const 317001) "Tout ce qui se fait dans le monde se fait par l'espoir.") ;; #0207 fr
  (data (i32.const 317056) "L'espoir, c'est pouvoir voir qu'il y a de la lumi\c3\a8re malgr\c3\a9 toute l'obscurit\c3\a9.") ;; #0208 fr
  (data (i32.const 317137) "Nous devons accepter la d\c3\a9ception finie, mais ne jamais perdre l'espoir infini.") ;; #0209 fr
  (data (i32.const 317217) "Ce n'est que dans l'obscurit\c3\a9 qu'on peut voir les \c3\a9toiles.") ;; #0210 fr
  (data (i32.const 317277) "M\c3\aame la nuit la plus sombre prendra fin, et le soleil se l\c3\a8vera.") ;; #0211 fr
  (data (i32.const 317343) "L'optimisme est la foi qui m\c3\a8ne \c3\a0 la r\c3\a9ussite. Rien ne peut se faire sans espoir ni confiance.") ;; #0212 fr
  (data (i32.const 317440) "Garde les yeux sur les \c3\a9toiles et les pieds sur terre.") ;; #0213 fr
  (data (i32.const 317495) "L'espoir est un r\c3\aave \c3\a9veill\c3\a9.") ;; #0214 fr
  (data (i32.const 317527) "Tant qu'il y a de la vie, il y a de l'espoir.") ;; #0215 fr
  (data (i32.const 317572) "Il y a du bon en ce monde, et cela vaut la peine de se battre pour lui.") ;; #0216 fr
  (data (i32.const 317643) "L'espoir est une bonne chose, peut-\c3\aatre la meilleure de toutes, et une bonne chose ne meurt jamais.") ;; #0217 fr
  (data (i32.const 317743) "L'heure la plus sombre ne dure que soixante minutes.") ;; #0218 fr
  (data (i32.const 317795) "Ne perds jamais espoir. Les temp\c3\aates rendent les gens plus forts et ne durent jamais \c3\a9ternellement.") ;; #0219 fr
  (data (i32.const 317896) "L'espoir sourit au seuil de l'ann\c3\a9e qui vient, en murmurant : \c2\ab elle sera plus heureuse \c2\bb.") ;; #0220 fr
  (data (i32.const 317989) "Vivre sans espoir, c'est cesser de vivre.") ;; #0221 fr
  (data (i32.const 318030) "En toute chose, il vaut mieux esp\c3\a9rer que d\c3\a9sesp\c3\a9rer.") ;; #0222 fr
  (data (i32.const 318086) "L'espoir est important car il peut rendre le moment pr\c3\a9sent moins difficile \c3\a0 supporter.") ;; #0223 fr
  (data (i32.const 318176) "Aussi long que soit l'hiver, le printemps finit toujours par venir.") ;; #0224 fr
  (data (i32.const 318243) "\c3\80 quelque chose malheur est bon.") ;; #0225 fr
  (data (i32.const 318276) "Le soleil lui-m\c3\aame est faible \c3\a0 son lever, et il prend force et courage \c3\a0 mesure que le jour avance.") ;; #0226 fr
  (data (i32.const 318379) "L'espoir est la seule chose plus forte que la peur.") ;; #0227 fr
  (data (i32.const 318430) "On peut trouver le bonheur m\c3\aame dans les moments les plus sombres, si l'on pense \c3\a0 allumer la lumi\c3\a8re.") ;; #0228 fr
  (data (i32.const 318535) "L'espoir commence dans le noir : l'espoir obstin\c3\a9 que, si l'on se pr\c3\a9sente et qu'on essaie de bien faire, l'aube finira par venir.") ;; #0229 fr
  (data (i32.const 318667) "Laisse tes espoirs, et non tes blessures, fa\c3\a7onner ton avenir.") ;; #0230 fr
  (data (i32.const 318730) "L'espoir est une ressource renouvelable : si tu en manques \c3\a0 la fin de la journ\c3\a9e, tu peux recommencer le matin.") ;; #0231 fr
  (data (i32.const 318844) "Ce que l'oxyg\c3\a8ne est aux poumons, l'espoir l'est au sens de la vie.") ;; #0232 fr
  (data (i32.const 318912) "Le minimum que tu puisses faire dans ta vie, c'est de d\c3\a9couvrir ce que tu esp\c3\a8res.") ;; #0233 fr
  (data (i32.const 318996) "Il n'y a pas de rem\c3\a8de comme l'espoir, pas de stimulant aussi grand, pas de tonique aussi puissant que l'attente de quelque chose de meilleur demain.") ;; #0234 fr
  (data (i32.const 319146) "L'espoir est le pilier qui soutient le monde.") ;; #0235 fr
  (data (i32.const 319191) "L'espoir ne se taira jamais.") ;; #0236 fr
  (data (i32.const 319219) "Le soir arrivent les pleurs, et le matin l'all\c3\a9gresse.") ;; #0237 fr
  (data (i32.const 319274) "Vieillis avec moi ! Le meilleur reste \c3\a0 venir.") ;; #0238 fr
  (data (i32.const 319321) "N'est-ce pas agr\c3\a9able de penser que demain est un jour nouveau, encore sans aucune erreur ?") ;; #0239 fr
  (data (i32.const 319413) "Apr\c3\a8s tout, demain est un autre jour.") ;; #0240 fr
  (data (i32.const 319451) "L'espoir, c'est la patience avec la lampe allum\c3\a9e.") ;; #0241 fr
  (data (i32.const 319502) "Je suis pr\c3\a9par\c3\a9 au pire, mais j'esp\c3\a8re le meilleur.") ;; #0242 fr
  (data (i32.const 319556) "Nous n'avons jamais \c3\a0 d\c3\a9sesp\c3\a9rer, car nous ne pouvons jamais \c3\aatre bris\c3\a9s sans retour.") ;; #0243 fr
  (data (i32.const 319646) "Nous ne pleurerons pas, mais trouverons plut\c3\b4t de la force dans ce qui demeure.") ;; #0244 fr
  (data (i32.const 319726) "Soyons comme l'oiseau pos\c3\a9 pour un instant sur des rameaux trop fr\c3\aales, qui sent ployer la branche et qui chante pourtant, sachant qu'il a des ailes.") ;; #0245 fr
  (data (i32.const 319877) "Tant que je respire, j'esp\c3\a8re.") ;; #0246 fr
  (data (i32.const 319908) "Chaque jour n'est peut-\c3\aatre pas bon, mais il y a du bon dans chaque jour.") ;; #0247 fr
  (data (i32.const 319982) "Au milieu de l'hiver, j'ai d\c3\a9couvert en moi un invincible \c3\a9t\c3\a9.") ;; #0248 fr
  (data (i32.const 320047) "C'est dans nos moments les plus sombres que nous devons nous concentrer pour voir la lumi\c3\a8re.") ;; #0249 fr
  (data (i32.const 320141) "Le monde est rond, et ce qui peut sembler la fin n'est peut-\c3\aatre que le commencement.") ;; #0250 fr
  (data (i32.const 320227) "La foi est l'oiseau qui sent la lumi\c3\a8re et chante quand l'aube est encore sombre.") ;; #0251 fr
  (data (i32.const 320309) "Aussi longue que soit la nuit, le jour finira par se lever.") ;; #0252 fr
  (data (i32.const 320368) "Tiens bon ton chapeau. Tiens bon ton espoir. Et remonte l'horloge, car demain est un autre jour.") ;; #0253 fr
  (data (i32.const 320464) "Il y a devant nous des choses bien, bien meilleures que tout ce que nous laissons derri\c3\a8re.") ;; #0254 fr
  (data (i32.const 320556) "Malgr\c3\a9 tout, je crois encore que les gens sont fonci\c3\a8rement bons.") ;; #0255 fr
  (data (i32.const 320623) "Pense \c3\a0 toute la beaut\c3\a9 qui reste autour de toi et sois heureux.") ;; #0256 fr
  (data (i32.const 320689) "C'est souvent dans les ciels les plus sombres que l'on voit les \c3\a9toiles les plus brillantes.") ;; #0257 fr
  (data (i32.const 320782) "La force et la croissance ne viennent que par l'effort et la lutte continus.") ;; #0258 fr
  (data (i32.const 320858) "De tes vuln\c3\a9rabilit\c3\a9s na\c3\aetra ta force.") ;; #0259 fr
  (data (i32.const 320899) "Une femme est comme un sachet de th\c3\a9 : on ne sait pas \c3\a0 quel point elle est forte avant de la plonger dans l'eau chaude.") ;; #0260 fr
  (data (i32.const 321021) "La force na\c3\aet de la lutte. Il faut faire ce que les autres ne font pas pour obtenir ce que les autres n'obtiennent pas.") ;; #0261 fr
  (data (i32.const 321141) "Les plus forts de tous les guerriers sont ces deux-l\c3\a0 : le temps et la patience.") ;; #0262 fr
  (data (i32.const 321222) "Personne ne peut vous faire sentir inf\c3\a9rieur sans votre consentement.") ;; #0263 fr
  (data (i32.const 321292) "Tu as du pouvoir sur ton esprit, pas sur les \c3\a9v\c3\a9nements ext\c3\a9rieurs. Comprends cela, et tu trouveras la force.") ;; #0264 fr
  (data (i32.const 321404) "L'obstacle \c3\a0 l'action fait avancer l'action. Ce qui barre le chemin devient le chemin.") ;; #0265 fr
  (data (i32.const 321491) "Si une chose ext\c3\a9rieure te tourmente, ce n'est pas elle qui te trouble, mais le jugement que tu portes sur elle ; et ce jugement, tu peux l'effacer \c3\a0 tout instant.") ;; #0266 fr
  (data (i32.const 321656) "Ne perds plus de temps \c3\a0 discuter de ce que doit \c3\aatre un homme de bien. Sois-en un.") ;; #0267 fr
  (data (i32.const 321741) "Ressemble au promontoire contre lequel les vagues se brisent sans cesse : il reste debout et calme la fureur des flots autour de lui.") ;; #0268 fr
  (data (i32.const 321874) "Les grands ch\c3\aanes naissent de petits glands.") ;; #0269 fr
  (data (i32.const 321919) "Ce n'est pas parce que les choses sont difficiles que nous n'osons pas, c'est parce que nous n'osons pas qu'elles sont difficiles.") ;; #0270 fr
  (data (i32.const 322049) "Nous souffrons plus souvent en imagination qu'en r\c3\a9alit\c3\a9.") ;; #0271 fr
  (data (i32.const 322108) "Ma\c3\aetriser les autres est une force. Se ma\c3\aetriser soi-m\c3\aame est le vrai pouvoir.") ;; #0272 fr
  (data (i32.const 322189) "M\c3\aame si l'on vainc mille fois mille hommes au combat, le plus noble vainqueur est celui qui se vainc lui-m\c3\aame.") ;; #0273 fr
  (data (i32.const 322301) "La force r\c3\a9side dans les diff\c3\a9rences, non dans les ressemblances.") ;; #0274 fr
  (data (i32.const 322368) "Le faible ne peut jamais pardonner. Le pardon est l'attribut des forts.") ;; #0275 fr
  (data (i32.const 322439) "La force ne vient pas de la victoire. Ce sont tes luttes qui d\c3\a9veloppent ta force.") ;; #0276 fr
  (data (i32.const 322522) "La force est une affaire d'esprit r\c3\a9solu.") ;; #0277 fr
  (data (i32.const 322564) "Je suis le ma\c3\aetre de mon destin, je suis le capitaine de mon \c3\a2me.") ;; #0278 fr
  (data (i32.const 322631) "Je remercie les dieux, quels qu'ils soient, pour mon \c3\a2me invincible.") ;; #0279 fr
  (data (i32.const 322700) "Un h\c3\a9ros est une personne ordinaire qui trouve la force de pers\c3\a9v\c3\a9rer et d'endurer malgr\c3\a9 des obstacles \c3\a9crasants.") ;; #0280 fr
  (data (i32.const 322819) "Ce qui est derri\c3\a8re nous et ce qui est devant nous sont peu de chose compar\c3\a9 \c3\a0 ce qui est en nous.") ;; #0281 fr
  (data (i32.const 322920) "La plus grande \c3\a9preuve de courage sur terre est de supporter la d\c3\a9faite sans perdre c\c5\93ur.") ;; #0282 fr
  (data (i32.const 323012) "De toutes les vertus que nous pouvons acqu\c3\a9rir, aucune n'est plus utile, plus essentielle \c3\a0 la survie et plus \c3\a0 m\c3\aame d'am\c3\a9liorer la qualit\c3\a9 de vie que la capacit\c3\a9 de transformer l'adversit\c3\a9 en un d\c3\a9fi agr\c3\a9able.") ;; #0283 fr
  (data (i32.const 323232) "Sans lutte, il n'y a pas de progr\c3\a8s.") ;; #0284 fr
  (data (i32.const 323269) "Sois l'h\c3\a9ro\c3\afne de ta vie, pas la victime.") ;; #0285 fr
  (data (i32.const 323312) "Tiens-toi droite et prends conscience de qui tu es : tu domines tes circonstances.") ;; #0286 fr
  (data (i32.const 323394) "Ne baisse jamais la t\c3\aate. Garde-la toujours haute. Regarde le monde droit dans les yeux.") ;; #0287 fr
  (data (i32.const 323483) "Il n'y a rien de plus fort au monde que la douceur.") ;; #0288 fr
  (data (i32.const 323534) "Rien n'est si fort que la douceur, rien n'est si doux que la vraie force.") ;; #0289 fr
  (data (i32.const 323607) "Le ch\c3\aane dort dans le gland.") ;; #0290 fr
  (data (i32.const 323636) "Avec le jour nouveau viennent de nouvelles forces et de nouvelles pens\c3\a9es.") ;; #0291 fr
  (data (i32.const 323711) "Notre force na\c3\aet de nos faiblesses.") ;; #0292 fr
  (data (i32.const 323747) "Le courage est la garde et le soutien des autres vertus.") ;; #0293 fr
  (data (i32.const 323803) "Je ne suis pas un oiseau, et aucun filet ne me retient : je suis un \c3\aatre humain libre, dot\c3\a9 d'une volont\c3\a9 ind\c3\a9pendante.") ;; #0294 fr
  (data (i32.const 323926) "Ma mission dans la vie n'est pas seulement de survivre, mais de m'\c3\a9panouir.") ;; #0295 fr
  (data (i32.const 324002) "Tu ne peux pas h\c3\a9siter sur qui tu es.") ;; #0296 fr
  (data (i32.const 324040) "La fa\c3\a7on la plus courante dont les gens renoncent \c3\a0 leur pouvoir est de croire qu'ils n'en ont pas.") ;; #0297 fr
  (data (i32.const 324141) "Pense comme une reine. Une reine n'a pas peur d'\c3\a9chouer.") ;; #0298 fr
  (data (i32.const 324198) "D\c3\a9couvre qui tu es, et sois-le d\c3\a9lib\c3\a9r\c3\a9ment.") ;; #0299 fr
  (data (i32.const 324246) "Tu ne dois jamais avoir peur de ce que tu fais quand c'est juste.") ;; #0300 fr
  (data (i32.const 324311) "Quand ils s'abaissent, nous nous \c3\a9levons.") ;; #0301 fr
  (data (i32.const 324353) "Le talent peut te mener au sommet, mais il faut du caract\c3\a8re pour y rester.") ;; #0302 fr
  (data (i32.const 324429) "Quand il n'y a pas d'ennemi \c3\a0 l'int\c3\a9rieur, les ennemis du dehors ne peuvent te nuire.") ;; #0303 fr
  (data (i32.const 324516) "Notre peur la plus profonde n'est pas d'\c3\aatre inad\c3\a9quats. Notre peur la plus profonde est d'\c3\aatre puissants au-del\c3\a0 de toute mesure.") ;; #0304 fr
  (data (i32.const 324650) "Aie confiance en toi : chaque c\c5\93ur vibre \c3\a0 cette corde de fer.") ;; #0305 fr
  (data (i32.const 324714) "C'est toi qui d\c3\a9tiens les cl\c3\a9s de ton \c3\aatre. C'est toi qui portes le passeport de ton propre bonheur.") ;; #0306 fr
  (data (i32.const 324817) "Nous sommes ce que nous faisons de mani\c3\a8re r\c3\a9p\c3\a9t\c3\a9e. L'excellence n'est donc pas un acte, mais une habitude.") ;; #0307 fr
  (data (i32.const 324928) "La discipline est le pont entre les objectifs et les r\c3\a9alisations.") ;; #0308 fr
  (data (i32.const 324995) "Nous devons tous souffrir de l'une de ces deux choses : la douleur de la discipline ou la douleur du regret.") ;; #0309 fr
  (data (i32.const 325103) "La motivation te fait d\c3\a9marrer. L'habitude te fait continuer.") ;; #0310 fr
  (data (i32.const 325165) "Le succ\c3\a8s n'est rien d'autre que quelques disciplines simples, pratiqu\c3\a9es chaque jour.") ;; #0311 fr
  (data (i32.const 325253) "Ne souhaite pas que ce soit plus facile ; souhaite \c3\aatre meilleur.") ;; #0312 fr
  (data (i32.const 325319) "Soit tu m\c3\a8nes ta journ\c3\a9e, soit c'est elle qui te m\c3\a8ne.") ;; #0313 fr
  (data (i32.const 325376) "Avec de l'autodiscipline, presque tout est possible.") ;; #0314 fr
  (data (i32.const 325428) "Le guerrier qui r\c3\a9ussit est un homme ordinaire dot\c3\a9 d'une concentration de laser.") ;; #0315 fr
  (data (i32.const 325511) "Je ne crains pas l'homme qui a pratiqu\c3\a9 10 000 coups de pied une fois, mais je crains l'homme qui a pratiqu\c3\a9 un coup de pied 10 000 fois.") ;; #0316 fr
  (data (i32.const 325650) "La discipline, c'est choisir entre ce que l'on veut maintenant et ce que l'on veut le plus.") ;; #0317 fr
  (data (i32.const 325741) "Nul n'est libre s'il n'est ma\c3\aetre de lui-m\c3\aame.") ;; #0318 fr
  (data (i32.const 325789) "Dis-toi d'abord ce que tu veux \c3\aatre ; puis fais ce que tu as \c3\a0 faire.") ;; #0319 fr
  (data (i32.const 325860) "L'autodiscipline est le pouvoir magique qui te rend pratiquement inarr\c3\aatable.") ;; #0320 fr
  (data (i32.const 325938) "Le prix de l'excellence est la discipline. Le co\c3\bbt de la m\c3\a9diocrit\c3\a9 est la d\c3\a9ception.") ;; #0321 fr
  (data (i32.const 326027) "Le travail acharn\c3\a9 bat le talent quand le talent ne travaille pas.") ;; #0322 fr
  (data (i32.const 326094) "De petites disciplines r\c3\a9p\c3\a9t\c3\a9es avec constance chaque jour m\c3\a8nent \c3\a0 de grandes r\c3\a9ussites, obtenues lentement au fil du temps.") ;; #0323 fr
  (data (i32.const 326225) "Tu ne changeras jamais ta vie tant que tu ne changeras pas quelque chose que tu fais chaque jour.") ;; #0324 fr
  (data (i32.const 326322) "L'excellence est le r\c3\a9sultat progressif d'un effort constant pour faire mieux.") ;; #0325 fr
  (data (i32.const 326401) "Les champions continuent de jouer jusqu'\c3\a0 ce qu'ils y arrivent.") ;; #0326 fr
  (data (i32.const 326465) "J'ai d\c3\a9test\c3\a9 chaque minute d'entra\c3\aenement, mais je me disais : n'abandonne pas. Souffre maintenant et vis le reste de ta vie en champion.") ;; #0327 fr
  (data (i32.const 326605) "Le combat se gagne ou se perd loin des t\c3\a9moins, en coulisses, \c3\a0 la salle et sur la route, bien avant que je danse sous ces projecteurs.") ;; #0328 fr
  (data (i32.const 326742) "Ne compte pas les jours ; fais que les jours comptent.") ;; #0329 fr
  (data (i32.const 326796) "Le d\c3\a9vouement fait des r\c3\aaves une r\c3\a9alit\c3\a9.") ;; #0330 fr
  (data (i32.const 326841) "Repose-toi \c3\a0 la fin, pas au milieu.") ;; #0331 fr
  (data (i32.const 326877) "Il n'y a pas de raccourci vers un endroit qui en vaut la peine.") ;; #0332 fr
  (data (i32.const 326940) "Le seul endroit o\c3\b9 le succ\c3\a8s vient avant le travail, c'est dans le dictionnaire.") ;; #0333 fr
  (data (i32.const 327022) "Le talent co\c3\bbte moins cher que le sel de table. Ce qui s\c3\a9pare la personne talentueuse de celle qui r\c3\a9ussit, c'est beaucoup de travail acharn\c3\a9.") ;; #0334 fr
  (data (i32.const 327168) "Les amateurs attendent l'inspiration ; nous autres, nous nous levons et nous allons travailler.") ;; #0335 fr
  (data (i32.const 327263) "Plus je m'entra\c3\aene, plus j'ai de la chance.") ;; #0336 fr
  (data (i32.const 327307) "N'attends pas que le fer soit chaud pour le battre ; rends-le chaud en le battant.") ;; #0337 fr
  (data (i32.const 327389) "Le respect de soi est le fruit de la discipline ; le sens de la dignit\c3\a9 grandit avec la capacit\c3\a9 de se dire non.") ;; #0338 fr
  (data (i32.const 327503) "Ce que tu fais chaque jour compte plus que ce que tu fais de temps en temps.") ;; #0339 fr
  (data (i32.const 327579) "La discipline, c'est la libert\c3\a9.") ;; #0340 fr
  (data (i32.const 327612) "Concentre toutes tes pens\c3\a9es sur la t\c3\a2che en cours. Les rayons du soleil ne br\c3\bblent que lorsqu'ils sont concentr\c3\a9s en un point.") ;; #0341 fr
  (data (i32.const 327743) "Bien faire vaut mieux que bien dire.") ;; #0342 fr
  (data (i32.const 327779) "Le temps perdu ne se rattrape jamais.") ;; #0343 fr
  (data (i32.const 327816) "Sans travail acharn\c3\a9, rien ne pousse \c3\a0 part les mauvaises herbes.") ;; #0344 fr
  (data (i32.const 327883) "Le succ\c3\a8s n'est pas toujours une question de grandeur. C'est une question de constance.") ;; #0345 fr
  (data (i32.const 327971) "Le succ\c3\a8s n'est pas un hasard. C'est du travail, de la pers\c3\a9v\c3\a9rance, de l'apprentissage, de l'\c3\a9tude, des sacrifices et, surtout, l'amour de ce que l'on fait.") ;; #0346 fr
  (data (i32.const 328132) "La volont\c3\a9 de gagner est importante, mais la volont\c3\a9 de se pr\c3\a9parer est vitale.") ;; #0347 fr
  (data (i32.const 328214) "Je n'ai jamais r\c3\aav\c3\a9 de succ\c3\a8s. J'ai travaill\c3\a9 pour lui.") ;; #0348 fr
  (data (i32.const 328273) "Rien ne marchera si tu ne travailles pas.") ;; #0349 fr
  (data (i32.const 328314) "L'habitude est soit le meilleur des serviteurs, soit le pire des ma\c3\aetres.") ;; #0350 fr
  (data (i32.const 328388) "D'abord nous faisons nos habitudes, ensuite nos habitudes nous font.") ;; #0351 fr
  (data (i32.const 328456) "C'est le d\c3\a9part qui arr\c3\aate la plupart des gens.") ;; #0352 fr
  (data (i32.const 328505) "L'entra\c3\aenement n'est pas ce que tu fais une fois que tu es bon. C'est ce que tu fais pour le devenir.") ;; #0353 fr
  (data (i32.const 328607) "Fais aujourd'hui quelque chose dont ton futur toi te remerciera.") ;; #0354 fr
  (data (i32.const 328671) "Concentre-toi sur le fait d'\c3\aatre productif plut\c3\b4t qu'occup\c3\a9.") ;; #0355 fr
  (data (i32.const 328734) "La discipline, c'est se souvenir de ce que l'on veut.") ;; #0356 fr
  (data (i32.const 328787) "Fais de chaque jour ton chef-d'\c5\93uvre.") ;; #0357 fr
  (data (i32.const 328825) "Sois rapide, mais ne te pr\c3\a9cipite pas.") ;; #0358 fr
  (data (i32.const 328864) "N'aie pas peur de grandir lentement ; aie seulement peur de rester immobile.") ;; #0359 fr
  (data (i32.const 328940) "La seule fa\c3\a7on de donner un sens au changement est de s'y plonger, d'avancer avec lui et d'entrer dans la danse.") ;; #0360 fr
  (data (i32.const 329053) "La vie, c'est comme une bicyclette : il faut avancer pour ne pas perdre l'\c3\a9quilibre.") ;; #0361 fr
  (data (i32.const 329138) "On dit toujours que le temps change les choses, mais en r\c3\a9alit\c3\a9, c'est \c3\a0 toi de les changer.") ;; #0362 fr
  (data (i32.const 329233) "Le progr\c3\a8s est impossible sans changement, et ceux qui ne peuvent changer d'avis ne peuvent rien changer.") ;; #0363 fr
  (data (i32.const 329339) "Le changement est la loi de la vie. Et ceux qui ne regardent que le pass\c3\a9 ou le pr\c3\a9sent manqueront certainement l'avenir.") ;; #0364 fr
  (data (i32.const 329462) "Le secret du changement consiste \c3\a0 concentrer toute son \c3\a9nergie non pas \c3\a0 lutter contre le pass\c3\a9, mais \c3\a0 construire l'avenir.") ;; #0365 fr
  (data (i32.const 329592) "Ce que tu obtiens en atteignant tes objectifs est moins important que ce que tu deviens en les atteignant.") ;; #0366 fr
  (data (i32.const 329698) "Grandir fait mal. Changer fait mal. Mais rien ne fait aussi mal que de rester coinc\c3\a9 l\c3\a0 o\c3\b9 l'on n'a pas sa place.") ;; #0367 fr
  (data (i32.const 329814) "Et vint le jour o\c3\b9 le risque de rester enferm\c3\a9e dans le bouton fut plus douloureux que le risque d'\c3\a9clore.") ;; #0368 fr
  (data (i32.const 329923) "Je fais toujours ce que je ne sais pas faire, pour apprendre \c3\a0 le faire.") ;; #0369 fr
  (data (i32.const 329996) "Si tu n'essaies pas de faire quelque chose au-del\c3\a0 de ce que tu ma\c3\aetrises d\c3\a9j\c3\a0, tu ne grandiras jamais.") ;; #0370 fr
  (data (i32.const 330103) "Nous savons ce que nous sommes, mais non ce que nous pouvons \c3\aatre.") ;; #0371 fr
  (data (i32.const 330170) "Nos doutes sont des tra\c3\aetres qui nous font perdre le bien que nous pourrions souvent gagner, par peur d'essayer.") ;; #0372 fr
  (data (i32.const 330283) "Si nous faisions tout ce dont nous sommes capables, nous nous \c3\a9tonnerions litt\c3\a9ralement nous-m\c3\aames.") ;; #0373 fr
  (data (i32.const 330385) "Le meilleur moment pour planter un arbre, c'\c3\a9tait il y a 20 ans. Le deuxi\c3\a8me meilleur moment, c'est maintenant.") ;; #0374 fr
  (data (i32.const 330498) "Fais ce que tu peux, avec ce que tu as, l\c3\a0 o\c3\b9 tu es.") ;; #0375 fr
  (data (i32.const 330552) "Dans un an, tu regretteras peut-\c3\aatre de ne pas avoir commenc\c3\a9 aujourd'hui.") ;; #0376 fr
  (data (i32.const 330628) "Change tes pens\c3\a9es et tu changeras ton monde.") ;; #0377 fr
  (data (i32.const 330674) "Tu ne peux pas changer ta destination du jour au lendemain, mais tu peux changer de direction du jour au lendemain.") ;; #0378 fr
  (data (i32.const 330789) "Tout le monde pense \c3\a0 changer le monde, mais personne ne pense \c3\a0 se changer soi-m\c3\aame.") ;; #0379 fr
  (data (i32.const 330877) "S'am\c3\a9liorer, c'est changer ; \c3\aatre parfait, c'est changer souvent.") ;; #0380 fr
  (data (i32.const 330944) "La croissance commence quand nous commen\c3\a7ons \c3\a0 accepter nos propres faiblesses.") ;; #0381 fr
  (data (i32.const 331025) "La plus grande d\c3\a9couverte de ma g\c3\a9n\c3\a9ration, c'est qu'un \c3\aatre humain peut changer sa vie en changeant son attitude.") ;; #0382 fr
  (data (i32.const 331143) "On n'est jamais trop vieux pour se fixer un nouvel objectif ou faire un nouveau r\c3\aave.") ;; #0383 fr
  (data (i32.const 331229) "Agis comme si ce que tu fais faisait une diff\c3\a9rence. C'est le cas.") ;; #0384 fr
  (data (i32.const 331296) "Ce que nous craignons le plus de faire est g\c3\a9n\c3\a9ralement ce que nous avons le plus besoin de faire.") ;; #0385 fr
  (data (i32.const 331396) "La zone de confort est un bel endroit, mais rien n'y pousse jamais.") ;; #0386 fr
  (data (i32.const 331463) "Je ne suivrai pas le chemin l\c3\a0 o\c3\b9 il m\c3\a8ne ; j'irai l\c3\a0 o\c3\b9 il n'y a pas de chemin, et je laisserai une trace.") ;; #0387 fr
  (data (i32.const 331575) "Devenir vaut mieux qu'\c3\aatre.") ;; #0388 fr
  (data (i32.const 331603) "Tout ce que l'on affronte ne peut pas \c3\aatre chang\c3\a9, mais rien ne peut \c3\aatre chang\c3\a9 tant qu'on ne l'affronte pas.") ;; #0389 fr
  (data (i32.const 331717) "Ta situation actuelle ne d\c3\a9termine pas o\c3\b9 tu peux aller ; elle d\c3\a9termine seulement d'o\c3\b9 tu pars.") ;; #0390 fr
  (data (i32.const 331817) "Un jour, tu te r\c3\a9veilleras et il n'y aura plus de temps pour faire ce que tu as toujours voulu faire. Fais-le maintenant.") ;; #0391 fr
  (data (i32.const 331939) "Fais de ton mieux jusqu'\c3\a0 ce que tu saches mieux faire. Et quand tu sauras mieux faire, fais mieux.") ;; #0392 fr
  (data (i32.const 332039) "Ce qui est beau dans le fait d'apprendre, c'est que personne ne peut te l'enlever.") ;; #0393 fr
  (data (i32.const 332121) "L'\c3\a9ducation est l'arme la plus puissante que l'on puisse utiliser pour changer le monde.") ;; #0394 fr
  (data (i32.const 332210) "Celui qui ne vainc pas chaque jour une peur n'a pas appris le secret de la vie.") ;; #0395 fr
  (data (i32.const 332289) "La vie commence l\c3\a0 o\c3\b9 finit ta zone de confort.") ;; #0396 fr
  (data (i32.const 332338) "Je ne peux pas changer la direction du vent, mais je peux ajuster mes voiles pour toujours atteindre ma destination.") ;; #0397 fr
  (data (i32.const 332454) "Nous ne pouvons pas devenir ce que nous voulons en restant ce que nous sommes.") ;; #0398 fr
  (data (i32.const 332532) "Petit \c3\a0 petit, peu devient beaucoup.") ;; #0399 fr
  (data (i32.const 332569) "Rien n'est permanent, sauf le changement.") ;; #0400 fr
  (data (i32.const 332610) "On ne se baigne jamais deux fois dans le m\c3\aame fleuve, car ce n'est plus le m\c3\aame fleuve, et l'on n'est plus le m\c3\aame homme.") ;; #0401 fr
  (data (i32.const 332734) "Sans croissance et sans progr\c3\a8s continus, des mots comme am\c3\a9lioration, r\c3\a9ussite et succ\c3\a8s n'ont aucun sens.") ;; #0402 fr
  (data (i32.const 332845) "Ce qui doit donner de la lumi\c3\a8re doit supporter de br\c3\bbler.") ;; #0403 fr
  (data (i32.const 332905) "Ce n'est pas ce qui t'arrive qui compte, mais la fa\c3\a7on dont tu y r\c3\a9agis.") ;; #0404 fr
  (data (i32.const 332979) "Commence d\c3\a8s maintenant \c3\a0 vivre, et compte chaque jour comme une vie \c3\a0 part.") ;; #0405 fr
  (data (i32.const 333058) "Commence l\c3\a0 o\c3\b9 tu es. Utilise ce que tu as. Fais ce que tu peux.") ;; #0406 fr
  (data (i32.const 333124) "Nous admirons la beaut\c3\a9 du papillon, mais nous reconnaissons rarement les transformations qu'il a travers\c3\a9es pour atteindre cette beaut\c3\a9.") ;; #0407 fr
  (data (i32.const 333264) "Ce n'est pas l'esp\c3\a8ce la plus forte qui survit, ni la plus intelligente, mais celle qui s'adapte le mieux au changement.") ;; #0408 fr
  (data (i32.const 333385) "Quand je l\c3\a2che ce que je suis, je deviens ce que je pourrais \c3\aatre.") ;; #0409 fr
  (data (i32.const 333453) "Je ne peux pas revenir \c3\a0 hier, car j'\c3\a9tais alors une autre personne.") ;; #0410 fr
  (data (i32.const 333523) "Le vrai changement, celui qui dure, se fait un pas \c3\a0 la fois.") ;; #0411 fr
  (data (i32.const 333585) "On m'a appris que le chemin du progr\c3\a8s n'est ni rapide ni facile.") ;; #0412 fr
  (data (i32.const 333651) "L'adversit\c3\a9 brise certains hommes ; d'autres battent des records.") ;; #0413 fr
  (data (i32.const 333717) "La prosp\c3\a9rit\c3\a9 ne va pas sans craintes ni d\c3\a9go\c3\bbts, et l'adversit\c3\a9 ne va pas sans r\c3\a9conforts ni espoirs.") ;; #0414 fr
  (data (i32.const 333825) "L'adversit\c3\a9 est le premier chemin vers la v\c3\a9rit\c3\a9.") ;; #0415 fr
  (data (i32.const 333877) "Les cerfs-volants montent le plus haut face au vent, et non avec lui.") ;; #0416 fr
  (data (i32.const 333946) "L'adversit\c3\a9 a pour effet de r\c3\a9v\c3\a9ler des talents qui, dans la prosp\c3\a9rit\c3\a9, seraient rest\c3\a9s endormis.") ;; #0417 fr
  (data (i32.const 334050) "Le bloc de granit qui \c3\a9tait un obstacle sur le chemin du faible devient une marche sur le chemin du fort.") ;; #0418 fr
  (data (i32.const 334156) "Les obstacles sont ces choses effrayantes que tu vois quand tu quittes ton but des yeux.") ;; #0419 fr
  (data (i32.const 334244) "Les obstacles ne doivent pas t'arr\c3\aater. Si tu te heurtes \c3\a0 un mur, ne fais pas demi-tour et n'abandonne pas. Trouve comment l'escalader, le traverser ou le contourner.") ;; #0420 fr
  (data (i32.const 334413) "Les probl\c3\a8mes ne sont pas des panneaux stop ; ce sont des indications.") ;; #0421 fr
  (data (i32.const 334484) "Tourne ton visage vers le soleil, et les ombres tomberont derri\c3\a8re toi.") ;; #0422 fr
  (data (i32.const 334556) "L'homme de caract\c3\a8re trouve une attirance particuli\c3\a8re dans la difficult\c3\a9.") ;; #0423 fr
  (data (i32.const 334633) "Les difficult\c3\a9s sont faites pour \c3\a9veiller, non pour d\c3\a9courager. L'esprit humain doit se fortifier dans le conflit.") ;; #0424 fr
  (data (i32.const 334750) "Si tu ne peux pas voler, cours ; si tu ne peux pas courir, marche ; si tu ne peux pas marcher, rampe ; mais quoi que tu fasses, continue d'avancer.") ;; #0425 fr
  (data (i32.const 334897) "La v\c3\a9ritable mesure d'un homme n'est pas sa position dans les moments de confort et de facilit\c3\a9, mais sa position dans les moments de d\c3\a9fi et de controverse.") ;; #0426 fr
  (data (i32.const 335057) "L'obscurit\c3\a9 ne peut chasser l'obscurit\c3\a9 ; seule la lumi\c3\a8re le peut.") ;; #0427 fr
  (data (i32.const 335127) "La foi, c'est faire le premier pas m\c3\aame quand on ne voit pas tout l'escalier.") ;; #0428 fr
  (data (i32.const 335205) "Il n'y a pas de meilleure \c3\a9cole que l'adversit\c3\a9.") ;; #0429 fr
  (data (i32.const 335255) "Ce qui blesse instruit.") ;; #0430 fr
  (data (i32.const 335278) "L'adversit\c3\a9 est comme un vent violent. Elle nous arrache tout, sauf ce qui ne peut \c3\aatre arrach\c3\a9, afin que nous nous voyions tels que nous sommes vraiment.") ;; #0431 fr
  (data (i32.const 335435) "Ce qui embellit le d\c3\a9sert, c'est qu'il cache un puits quelque part.") ;; #0432 fr
  (data (i32.const 335503) "Le pessimiste voit la difficult\c3\a9 dans chaque opportunit\c3\a9. L'optimiste voit l'opportunit\c3\a9 dans chaque difficult\c3\a9.") ;; #0433 fr
  (data (i32.const 335619) "Les d\c3\a9fis rendent la vie int\c3\a9ressante, et les surmonter lui donne un sens.") ;; #0434 fr
  (data (i32.const 335695) "L'adversit\c3\a9 est la poussi\c3\a8re de diamant avec laquelle le Ciel polit ses joyaux.") ;; #0435 fr
  (data (i32.const 335776) "Les temp\c3\aates font pousser aux arbres des racines plus profondes.") ;; #0436 fr
  (data (i32.const 335841) "\c3\80 mon avis, si tu veux l'arc-en-ciel, il faut supporter la pluie.") ;; #0437 fr
  (data (i32.const 335907) "La vie, ce n'est pas d'attendre que l'orage passe, c'est d'apprendre \c3\a0 danser sous la pluie.") ;; #0438 fr
  (data (i32.const 336000) "L'adversit\c3\a9 r\c3\a9v\c3\a8le le g\c3\a9nie, la prosp\c3\a9rit\c3\a9 le cache.") ;; #0439 fr
  (data (i32.const 336058) "Quand les choses se corsent, les durs se mettent en marche.") ;; #0440 fr
  (data (i32.const 336117) "Un h\c3\a9ros n'est pas plus courageux qu'un homme ordinaire ; il est seulement courageux cinq minutes de plus.") ;; #0441 fr
  (data (i32.const 336224) "La lutte elle-m\c3\aame vers les sommets suffit \c3\a0 remplir un c\c5\93ur d'homme. Il faut imaginer Sisyphe heureux.") ;; #0442 fr
  (data (i32.const 336330) "Parfois, l'adversit\c3\a9 est justement ce qu'il faut affronter pour r\c3\a9ussir.") ;; #0443 fr
  (data (i32.const 336404) "Les temps difficiles ne cr\c3\a9ent pas les h\c3\a9ros. C'est dans les temps difficiles que se r\c3\a9v\c3\a8le le h\c3\a9ros qui est en nous.") ;; #0444 fr
  (data (i32.const 336526) "On ne gravit les montagnes que par des chemins sinueux.") ;; #0445 fr
  (data (i32.const 336581) "La douleur est in\c3\a9vitable. La souffrance est facultative.") ;; #0446 fr
  (data (i32.const 336639) "Les probl\c3\a8mes ne sont que des opportunit\c3\a9s en tenue de travail.") ;; #0447 fr
  (data (i32.const 336704) "La calamit\c3\a9 est l'\c3\a9preuve de l'int\c3\a9grit\c3\a9.") ;; #0448 fr
  (data (i32.const 336749) "La prosp\c3\a9rit\c3\a9 fait les amis, l'adversit\c3\a9 les \c3\a9prouve.") ;; #0449 fr
  (data (i32.const 336806) "N'importe qui peut tenir la barre quand la mer est calme.") ;; #0450 fr
  (data (i32.const 336863) "Plus la bataille est dure, plus la victoire est douce.") ;; #0451 fr
  (data (i32.const 336917) "Doux sont les fruits de l'adversit\c3\a9.") ;; #0452 fr
  (data (i32.const 336954) "Chaque adversit\c3\a9, chaque \c3\a9chec, chaque peine de c\c5\93ur porte en lui la graine d'un bienfait \c3\a9gal ou sup\c3\a9rieur.") ;; #0453 fr
  (data (i32.const 337067) "Plus la difficult\c3\a9 est grande, plus il y a de gloire \c3\a0 la surmonter.") ;; #0454 fr
  (data (i32.const 337137) "Ce sont les difficult\c3\a9s qui montrent ce que vaut une personne.") ;; #0455 fr
  (data (i32.const 337200) "Aucun arbre ne devient solide et bien enracin\c3\a9 s'il n'est pas souvent battu par le vent.") ;; #0456 fr
  (data (i32.const 337289) "C'est une route rude qui m\c3\a8ne aux sommets de la grandeur.") ;; #0457 fr
  (data (i32.const 337347) "Les routes difficiles m\c3\a8nent souvent \c3\a0 de belles destinations.") ;; #0458 fr
  (data (i32.const 337411) "Au c\c5\93ur du chaos, il y a aussi des opportunit\c3\a9s.") ;; #0459 fr
  (data (i32.const 337461) "Ce qui nous semble des \c3\a9preuves am\c3\a8res est souvent une b\c3\a9n\c3\a9diction d\c3\a9guis\c3\a9e.") ;; #0460 fr
  (data (i32.const 337543) "Les grands esprits ont toujours rencontr\c3\a9 une opposition violente de la part des esprits m\c3\a9diocres.") ;; #0461 fr
  (data (i32.const 337644) "La douleur passe, la beaut\c3\a9 reste.") ;; #0462 fr
  (data (i32.const 337679) "Les choses tournent au mieux pour ceux qui tirent le meilleur parti de la fa\c3\a7on dont les choses tournent.") ;; #0463 fr
  (data (i32.const 337785) "Ce n'est pas le moment de penser \c3\a0 ce que tu n'as pas. Pense \c3\a0 ce que tu peux faire avec ce que tu as.") ;; #0464 fr
  (data (i32.const 337889) "L'obstacle est le chemin.") ;; #0465 fr
  (data (i32.const 337914) "Un voyage de mille lieues commence toujours par un premier pas.") ;; #0466 fr
  (data (i32.const 337977) "L'action est la cl\c3\a9 fondamentale de tout succ\c3\a8s.") ;; #0467 fr
  (data (i32.const 338027) "Pas besoin d'\c3\aatre grand pour commencer, mais il faut commencer pour devenir grand.") ;; #0468 fr
  (data (i32.const 338110) "Pour commencer, il faut cesser de parler et se mettre \c3\a0 agir.") ;; #0469 fr
  (data (i32.const 338172) "N'attends pas ; le moment ne sera jamais parfait.") ;; #0470 fr
  (data (i32.const 338221) "Savoir ne suffit pas, il faut appliquer. Vouloir ne suffit pas, il faut agir.") ;; #0471 fr
  (data (i32.const 338298) "L'action n'apporte pas toujours le bonheur, mais il n'y a pas de bonheur sans action.") ;; #0472 fr
  (data (i32.const 338383) "La r\c3\a9flexion ne vaincra pas la peur, mais l'action, si.") ;; #0473 fr
  (data (i32.const 338439) "Un jour n'est pas un jour de la semaine.") ;; #0474 fr
  (data (i32.const 338479) "Mieux vaut fait que parfait.") ;; #0475 fr
  (data (i32.const 338507) "Les petites actions accomplies valent mieux que les grandes actions projet\c3\a9es.") ;; #0476 fr
  (data (i32.const 338586) "Tu rates 100 % des tirs que tu ne tentes pas.") ;; #0477 fr
  (data (i32.const 338631) "L'inspiration existe, mais elle doit te trouver au travail.") ;; #0478 fr
  (data (i32.const 338690) "Une vision sans action n'est qu'un r\c3\aave. Une action sans vision ne fait que passer le temps. Une vision suivie d'action peut changer le monde.") ;; #0479 fr
  (data (i32.const 338833) "L'avenir d\c3\a9pend de ce que tu fais aujourd'hui.") ;; #0480 fr
  (data (i32.const 338880) "Ne remets jamais \c3\a0 demain ce que tu peux faire aujourd'hui.") ;; #0481 fr
  (data (i32.const 338940) "Fais les choses difficiles tant qu'elles sont faciles, et les grandes tant qu'elles sont petites.") ;; #0482 fr
  (data (i32.const 339037) "Bien commencer, c'est d\c3\a9j\c3\a0 avoir fait la moiti\c3\a9 du chemin.") ;; #0483 fr
  (data (i32.const 339098) "Si tu passes trop de temps \c3\a0 r\c3\a9fl\c3\a9chir \c3\a0 une chose, tu ne la feras jamais.") ;; #0484 fr
  (data (i32.const 339176) "Ce que tu fais parle si fort que je n'entends pas ce que tu dis.") ;; #0485 fr
  (data (i32.const 339240) "Avance avec confiance dans la direction de tes r\c3\aaves. Vis la vie que tu as imagin\c3\a9e.") ;; #0486 fr
  (data (i32.const 339326) "Si tu as b\c3\a2ti des ch\c3\a2teaux en l'air, ton travail n'est pas perdu ; c'est l\c3\a0 qu'ils doivent \c3\aatre. Maintenant, mets-leur des fondations.") ;; #0487 fr
  (data (i32.const 339464) "Les id\c3\a9es, c'est facile. Les r\c3\a9aliser, c'est difficile.") ;; #0488 fr
  (data (i32.const 339521) "Commence, sois audacieux et ose \c3\aatre sage.") ;; #0489 fr
  (data (i32.const 339564) "R\c3\aave grand et ose \c3\a9chouer.") ;; #0490 fr
  (data (i32.const 339592) "Ne confonds jamais mouvement et action.") ;; #0491 fr
  (data (i32.const 339631) "Ne laisse pas hier prendre trop de place dans aujourd'hui.") ;; #0492 fr
  (data (i32.const 339689) "M\c3\aame si tu es sur la bonne voie, tu te feras \c3\a9craser si tu restes assis l\c3\a0.") ;; #0493 fr
  (data (i32.const 339767) "Une id\c3\a9e qui n'est pas suivie d'action ne grandira jamais au-del\c3\a0 du neurone qu'elle occupait.") ;; #0494 fr
  (data (i32.const 339863) "Les paroles ne font pas cuire le riz.") ;; #0495 fr
  (data (i32.const 339900) "Si ce n'est pas maintenant, quand ?") ;; #0496 fr
  (data (i32.const 339935) "Pour commencer, commence.") ;; #0497 fr
  (data (i32.const 339960) "Poursuis ce qui touche ton c\c5\93ur, pas ce qui attire tes yeux.") ;; #0498 fr
  (data (i32.const 340021) "La vie, c'est dix pour cent ce qui t'arrive et quatre-vingt-dix pour cent la fa\c3\a7on dont tu y r\c3\a9agis.") ;; #0499 fr
  (data (i32.const 340123) "Si l'occasion ne frappe pas \c3\a0 ta porte, construis une porte.") ;; #0500 fr
  (data (i32.const 340184) "Le seul voyage impossible est celui que tu ne commences jamais.") ;; #0501 fr
  (data (i32.const 340247) "C'est dans tes moments de d\c3\a9cision que se fa\c3\a7onne ton destin.") ;; #0502 fr
  (data (i32.const 340310) "Se fixer des objectifs est la premi\c3\a8re \c3\a9tape pour rendre visible l'invisible.") ;; #0503 fr
  (data (i32.const 340389) "Les opportunit\c3\a9s n'arrivent pas toutes seules. C'est toi qui les cr\c3\a9es.") ;; #0504 fr
  (data (i32.const 340462) "Le doute tue plus de r\c3\aaves que l'\c3\a9chec ne le fera jamais.") ;; #0505 fr
  (data (i32.const 340521) "Ne te laisse pas bousculer par les peurs de ton esprit. Laisse-toi guider par les r\c3\aaves de ton c\c5\93ur.") ;; #0506 fr
  (data (i32.const 340623) "Mets ton c\c5\93ur, ton esprit et ton \c3\a2me jusque dans tes plus petits actes. C'est l\c3\a0 le secret du succ\c3\a8s.") ;; #0507 fr
  (data (i32.const 340728) "On ne traverse pas la mer en restant plant\c3\a9 \c3\a0 regarder l'eau.") ;; #0508 fr
  (data (i32.const 340791) "Le plus difficile est de d\c3\a9cider d'agir ; le reste n'est que t\c3\a9nacit\c3\a9.") ;; #0509 fr
  (data (i32.const 340864) "La fa\c3\a7on la plus efficace de le faire, c'est de le faire.") ;; #0510 fr
  (data (i32.const 340922) "Ne reste pas assis \c3\a0 attendre que les occasions arrivent. L\c3\a8ve-toi et cr\c3\a9e-les.") ;; #0511 fr
  (data (i32.const 341004) "Comme il est merveilleux que personne n'ait besoin d'attendre un seul instant avant de commencer \c3\a0 am\c3\a9liorer le monde.") ;; #0512 fr
  (data (i32.const 341124) "Une personne peut faire la diff\c3\a9rence, et chacun devrait essayer.") ;; #0513 fr
  (data (i32.const 341190) "Nous avons choisi d'aller sur la Lune au cours de cette d\c3\a9cennie, et de faire ces autres choses, non pas parce que c'est facile, mais parce que c'est difficile.") ;; #0514 fr
  (data (i32.const 341351) "Les occasions se multiplient \c3\a0 mesure qu'on les saisit.") ;; #0515 fr
  (data (i32.const 341407) "On ne peut pas attendre l'inspiration. Il faut lui courir apr\c3\a8s avec une massue.") ;; #0516 fr
  (data (i32.const 341488) "Lance-toi maintenant. L'avenir n'est promis \c3\a0 personne.") ;; #0517 fr
  (data (i32.const 341544) "Donner le meilleur de soi en ce moment te place au meilleur endroit pour le moment suivant.") ;; #0518 fr
  (data (i32.const 341635) "L'avenir commence aujourd'hui, pas demain.") ;; #0519 fr
  (data (i32.const 341677) "Que tu penses pouvoir le faire ou ne pas pouvoir le faire, tu as raison.") ;; #0520 fr
  (data (i32.const 341749) "Crois que tu le peux, et tu as d\c3\a9j\c3\a0 fait la moiti\c3\a9 du chemin.") ;; #0521 fr
  (data (i32.const 341813) "Notre vie est ce que nos pens\c3\a9es en font.") ;; #0522 fr
  (data (i32.const 341855) "Le bonheur de ta vie d\c3\a9pend de la qualit\c3\a9 de tes pens\c3\a9es.") ;; #0523 fr
  (data (i32.const 341915) "Il faut bien peu de chose pour une vie heureuse ; tout est en toi, dans ta fa\c3\a7on de penser.") ;; #0524 fr
  (data (i32.const 342007) "Une attitude positive peut vraiment faire de vos r\c3\aaves une r\c3\a9alit\c3\a9.") ;; #0525 fr
  (data (i32.const 342077) "L'optimisme est un aimant \c3\a0 bonheur.") ;; #0526 fr
  (data (i32.const 342114) "Les limites n'existent que dans notre esprit. Mais si nous utilisons notre imagination, nos possibilit\c3\a9s deviennent illimit\c3\a9es.") ;; #0527 fr
  (data (i32.const 342243) "La seule limite \c3\a0 notre \c3\a9panouissement de demain, ce sont nos doutes d'aujourd'hui.") ;; #0528 fr
  (data (i32.const 342328) "L'optimisme perp\c3\a9tuel d\c3\a9multiplie les forces.") ;; #0529 fr
  (data (i32.const 342375) "Si tu entends une voix en toi te dire que tu ne sais pas peindre, peins, par tous les moyens, et cette voix se taira.") ;; #0530 fr
  (data (i32.const 342492) "Tout ce que l'esprit humain peut concevoir et croire, il peut le r\c3\a9aliser.") ;; #0531 fr
  (data (i32.const 342567) "Celui qui a confiance en lui gagne la confiance des autres.") ;; #0532 fr
  (data (i32.const 342626) "D\c3\a8s que tu remplaces les pens\c3\a9es n\c3\a9gatives par des pens\c3\a9es positives, tu commences \c3\a0 obtenir des r\c3\a9sultats positifs.") ;; #0533 fr
  (data (i32.const 342748) "Quand tu changes ta fa\c3\a7on de regarder les choses, les choses que tu regardes changent.") ;; #0534 fr
  (data (i32.const 342835) "Le bonheur n'est pas une chose toute faite. Il vient de tes propres actions.") ;; #0535 fr
  (data (i32.const 342911) "La confiance en soi et le travail acharn\c3\a9 te m\c3\a8neront toujours au succ\c3\a8s.") ;; #0536 fr
  (data (i32.const 342987) "Beaucoup d'entre nous ne vivent pas leurs r\c3\aaves parce qu'ils vivent leurs peurs.") ;; #0537 fr
  (data (i32.const 343068) "Vise la Lune. M\c3\aame si tu la manques, tu atterriras parmi les \c3\a9toiles.") ;; #0538 fr
  (data (i32.const 343139) "Ce qui compte, ce n'est pas ce que tu regardes, c'est ce que tu vois.") ;; #0539 fr
  (data (i32.const 343208) "Je ne suis pas le produit de mes circonstances. Je suis le produit de mes d\c3\a9cisions.") ;; #0540 fr
  (data (i32.const 343293) "La confiance ne vient pas du fait d'avoir toujours raison, mais du fait de ne pas craindre d'avoir tort.") ;; #0541 fr
  (data (i32.const 343397) "Si tu veux t'\c3\a9lever, \c3\a9l\c3\a8ve quelqu'un d'autre.") ;; #0542 fr
  (data (i32.const 343445) "Le succ\c3\a8s se mesure moins \c3\a0 la position que l'on a atteinte dans la vie qu'aux obstacles que l'on a surmont\c3\a9s.") ;; #0543 fr
  (data (i32.const 343558) "L'excellence, c'est faire une chose ordinaire d'une mani\c3\a8re extraordinaire.") ;; #0544 fr
  (data (i32.const 343634) "Ce que tu penses de toi est bien plus important que ce que les autres pensent de toi.") ;; #0545 fr
  (data (i32.const 343719) "L'homme n'est que le produit de ses pens\c3\a9es. Il devient ce qu'il pense.") ;; #0546 fr
  (data (i32.const 343791) "Si quelque chose ne te pla\c3\aet pas, change-le. Si tu ne peux pas le changer, change ton attitude.") ;; #0547 fr
  (data (i32.const 343887) "On dit souvent que la motivation ne dure pas. Eh bien, la douche non plus. C'est pour \c3\a7a qu'on la recommande tous les jours.") ;; #0548 fr
  (data (i32.const 344012) "C'est ton attitude, et non ton aptitude, qui d\c3\a9terminera ton altitude.") ;; #0549 fr
  (data (i32.const 344083) "La pens\c3\a9e positive te permettra de tout faire mieux que la pens\c3\a9e n\c3\a9gative.") ;; #0550 fr
  (data (i32.const 344161) "L'optimisme est la qualit\c3\a9 la plus associ\c3\a9e au succ\c3\a8s et au bonheur, plus que toute autre.") ;; #0551 fr
  (data (i32.const 344254) "Crois en toi ! Aie foi en tes capacit\c3\a9s !") ;; #0552 fr
  (data (i32.const 344296) "Tu dois attendre de grandes choses de toi avant de pouvoir les accomplir.") ;; #0553 fr
  (data (i32.const 344369) "J'attribue mon succ\c3\a8s \c3\a0 ceci : je n'ai jamais donn\c3\a9 ni accept\c3\a9 d'excuse.") ;; #0554 fr
  (data (i32.const 344445) "L'imagination est plus importante que le savoir.") ;; #0555 fr
  (data (i32.const 344493) "J'ai appris avec les ann\c3\a9es que, lorsque l'esprit est d\c3\a9cid\c3\a9, la peur diminue.") ;; #0556 fr
  (data (i32.const 344574) "Tu dois faire les choses que tu crois ne pas pouvoir faire.") ;; #0557 fr
  (data (i32.const 344633) "Penser clairement demande du courage plut\c3\b4t que de l'intelligence.") ;; #0558 fr
  (data (i32.const 344700) "Ce n'est pas le poids du fardeau qui te brise, c'est la fa\c3\a7on dont tu le portes.") ;; #0559 fr
  (data (i32.const 344781) "Le talent, c'est ce que tu es capable de faire. La motivation d\c3\a9termine ce que tu fais. L'attitude d\c3\a9termine \c3\a0 quel point tu le fais bien.") ;; #0560 fr
  (data (i32.const 344922) "L'inqui\c3\a9tude ne vide pas demain de son chagrin, elle vide aujourd'hui de sa force.") ;; #0561 fr
  (data (i32.const 345005) "L'homme est moins tourment\c3\a9 par les probl\c3\a8mes r\c3\a9els que par les angoisses qu'il imagine \c3\a0 leur sujet.") ;; #0562 fr
  (data (i32.const 345110) "Si tu penses \c3\aatre battu, tu l'es.") ;; #0563 fr
  (data (i32.const 345144) "T\c3\b4t ou tard, celui qui gagne est celui qui pense pouvoir y arriver.") ;; #0564 fr
  (data (i32.const 345212) "Nous devenons ce \c3\a0 quoi nous pensons.") ;; #0565 fr
  (data (i32.const 345250) "Si tu essaies toujours d'\c3\aatre normal, tu ne sauras jamais \c3\a0 quel point tu peux \c3\aatre extraordinaire.") ;; #0566 fr
  (data (i32.const 345352) "Il m'est arriv\c3\a9 de croire jusqu'\c3\a0 six choses impossibles avant le petit-d\c3\a9jeuner.") ;; #0567 fr
  (data (i32.const 345436) "Le pire ennemi de la cr\c3\a9ativit\c3\a9 est le doute de soi.") ;; #0568 fr
  (data (i32.const 345490) "J'habite la possibilit\c3\a9.") ;; #0569 fr
  (data (i32.const 345515) "Ce sont nos choix qui montrent ce que nous sommes vraiment, bien plus que nos capacit\c3\a9s.") ;; #0570 fr
  (data (i32.const 345604) "Regarde les \c3\a9toiles, et non tes pieds.") ;; #0571 fr
  (data (i32.const 345643) "Aussi difficile que la vie puisse para\c3\aetre, il y a toujours quelque chose que tu peux faire et r\c3\a9ussir.") ;; #0572 fr
  (data (i32.const 345748) "Je n'ai pas de talent particulier. Je suis seulement passionn\c3\a9ment curieux.") ;; #0573 fr
  (data (i32.const 345824) "N'essaie pas de devenir un homme qui a du succ\c3\a8s, essaie plut\c3\b4t de devenir un homme qui a de la valeur.") ;; #0574 fr
  (data (i32.const 345929) "La patience est am\c3\a8re, mais son fruit est doux.") ;; #0575 fr
  (data (i32.const 345977) "Adopte le rythme de la nature : son secret est la patience.") ;; #0576 fr
  (data (i32.const 346036) "La nature ne se presse pas, et pourtant tout s'accomplit.") ;; #0577 fr
  (data (i32.const 346093) "Les arbres lents \c3\a0 cro\c3\aetre portent les meilleurs fruits.") ;; #0578 fr
  (data (i32.const 346151) "Le g\c3\a9nie est une \c3\a9ternelle patience.") ;; #0579 fr
  (data (i32.const 346189) "La patience est la compagne de la sagesse.") ;; #0580 fr
  (data (i32.const 346231) "Qui sait \c3\aatre patient peut avoir ce qu'il veut.") ;; #0581 fr
  (data (i32.const 346279) "Aie de la patience avec toutes choses, mais d'abord avec toi-m\c3\aame.") ;; #0582 fr
  (data (i32.const 346346) "Un moment de patience peut \c3\a9viter un grand malheur. Un moment d'impatience peut ruiner toute une vie.") ;; #0583 fr
  (data (i32.const 346448) "La patience n'est pas simplement la capacit\c3\a9 d'attendre ; c'est la fa\c3\a7on dont nous nous comportons pendant que nous attendons.") ;; #0584 fr
  (data (i32.const 346576) "Rome ne s'est pas faite en un jour.") ;; #0585 fr
  (data (i32.const 346611) "Tout vient peu \c3\a0 peu et \c3\a0 son heure.") ;; #0586 fr
  (data (i32.const 346649) "Sois patient et tiens bon ; un jour, cette douleur te sera utile.") ;; #0587 fr
  (data (i32.const 346714) "La goutte d'eau creuse la pierre, non par la force, mais par la pers\c3\a9v\c3\a9rance.") ;; #0588 fr
  (data (i32.const 346793) "Toute la sagesse humaine sera dans ces deux mots : attendre et esp\c3\a9rer.") ;; #0589 fr
  (data (i32.const 346865) "La cl\c3\a9 de tout, c'est la patience. On obtient le poussin en couvant l'\c5\93uf, pas en le cassant.") ;; #0590 fr
  (data (i32.const 346960) "Patience et longueur de temps font plus que force ni que rage.") ;; #0591 fr
  (data (i32.const 347022) "Notre patience accomplira davantage que notre force.") ;; #0592 fr
  (data (i32.const 347074) "Qu'ils sont pauvres, ceux qui n'ont pas de patience ! Quelle blessure a jamais gu\c3\a9ri autrement que peu \c3\a0 peu ?") ;; #0593 fr
  (data (i32.const 347186) "La patience est l'art d'esp\c3\a9rer.") ;; #0594 fr
  (data (i32.const 347219) "Une poign\c3\a9e de patience vaut mieux qu'un boisseau de cervelle.") ;; #0595 fr
  (data (i32.const 347282) "La patience est aussi une forme d'action.") ;; #0596 fr
  (data (i32.const 347323) "Rien ne sert de courir ; il faut partir \c3\a0 point.") ;; #0597 fr
  (data (i32.const 347372) "Avec le temps et la patience, la feuille de m\c3\bbrier devient robe de soie.") ;; #0598 fr
  (data (i32.const 347445) "La patience attire le bonheur ; elle rapproche ce qui est loin.") ;; #0599 fr
  (data (i32.const 347508) "Perdre patience, c'est perdre la bataille.") ;; #0600 fr
  (data (i32.const 347550) "La patience est un pouvoir. La patience n'est pas l'absence d'action ; c'est le sens du bon moment.") ;; #0601 fr
  (data (i32.const 347649) "Sage pour d\c3\a9cider, patient pour accomplir.") ;; #0602 fr
  (data (i32.const 347692) "Je suis extraordinairement patiente, pourvu qu'\c3\a0 la fin j'obtienne ce que je veux.") ;; #0603 fr
  (data (i32.const 347775) "Si tu es patient dans un moment de col\c3\a8re, tu \c3\a9chapperas \c3\a0 cent jours de chagrin.") ;; #0604 fr
  (data (i32.const 347859) "La patience est le soutien de la faiblesse ; l'impatience, la ruine de la force.") ;; #0605 fr
  (data (i32.const 347939) "L'endurance, c'est de la patience concentr\c3\a9e.") ;; #0606 fr
  (data (i32.const 347985) "La patience et l'application, comme la foi, d\c3\a9placent les montagnes.") ;; #0607 fr
  (data (i32.const 348054) "M\c3\a9fiez-vous de la col\c3\a8re d'un homme patient.") ;; #0608 fr
  (data (i32.const 348100) "La patience est la cl\c3\a9 du paradis.") ;; #0609 fr
  (data (i32.const 348135) "Sois patient envers tout ce qui n'est pas r\c3\a9solu dans ton c\c5\93ur.") ;; #0610 fr
  (data (i32.const 348200) "Rien de grand ne se cr\c3\a9e soudainement.") ;; #0611 fr
  (data (i32.const 348239) "Peut-\c3\aatre un jour sera-t-il doux de se souvenir m\c3\aame de ceci.") ;; #0612 fr
  (data (i32.const 348302) "Tenez bon, et gardez-vous pour des jours meilleurs.") ;; #0613 fr
  (data (i32.const 348353) "Patience, mon c\c5\93ur ; tu as support\c3\a9 pire que cela.") ;; #0614 fr
  (data (i32.const 348405) "Cela aussi passera.") ;; #0615 fr
  (data (i32.const 348424) "Ne renonce jamais \c3\a0 un r\c3\aave \c3\a0 cause du temps qu'il faudra pour le r\c3\a9aliser. Le temps passera de toute fa\c3\a7on.") ;; #0616 fr
  (data (i32.const 348537) "Laisse tout t'arriver : la beaut\c3\a9 et l'effroi. Continue simplement. Aucun sentiment n'est d\c3\a9finitif.") ;; #0617 fr
  (data (i32.const 348639) "Aucun flocon de neige ne tombe jamais au mauvais endroit.") ;; #0618 fr
  (data (i32.const 348696) "L\c3\a2che prise ou sois entra\c3\aen\c3\a9.") ;; #0619 fr
  (data (i32.const 348728) "La d\c3\a9termination est le r\c3\a9veil de la volont\c3\a9 humaine.") ;; #0620 fr
  (data (i32.const 348784) "La diff\c3\a9rence entre l'impossible et le possible r\c3\a9side dans la d\c3\a9termination d'une personne.") ;; #0621 fr
  (data (i32.const 348879) "Fixe-toi des objectifs \c3\a9lev\c3\a9s et ne t'arr\c3\aate pas avant de les atteindre.") ;; #0622 fr
  (data (i32.const 348954) "Le d\c3\a9sir est la cl\c3\a9 de la motivation, mais ce sont la d\c3\a9termination et l'engagement dans une poursuite acharn\c3\a9e de ton objectif qui te permettront d'atteindre le succ\c3\a8s que tu cherches.") ;; #0623 fr
  (data (i32.const 349144) "Les obstacles ne peuvent m'\c3\a9craser. Tout obstacle c\c3\a8de devant une ferme r\c3\a9solution.") ;; #0624 fr
  (data (i32.const 349230) "Je ne suis pas d\c3\a9courag\c3\a9, car chaque tentative rat\c3\a9e que j'\c3\a9carte est un pas de plus en avant.") ;; #0625 fr
  (data (i32.const 349328) "Ne laisse jamais la peur de rater t'emp\c3\aacher de jouer le jeu.") ;; #0626 fr
  (data (i32.const 349390) "Si tu ne peux pas mieux jouer qu'eux, travaille plus qu'eux.") ;; #0627 fr
  (data (i32.const 349450) "Je pense vraiment qu'un champion ne se d\c3\a9finit pas par ses victoires, mais par sa fa\c3\a7on de se relever quand il tombe.") ;; #0628 fr
  (data (i32.const 349569) "Tu dois croire en toi quand personne d'autre n'y croit.") ;; #0629 fr
  (data (i32.const 349624) "Plus la victoire est difficile, plus la joie de gagner est grande.") ;; #0630 fr
  (data (i32.const 349690) "Les m\c3\a9dailles d'or ne sont pas vraiment en or. Elles sont faites de sueur, de d\c3\a9termination et d'un alliage rare appel\c3\a9 le cran.") ;; #0631 fr
  (data (i32.const 349821) "L'\c3\a2ge n'est pas un obstacle. C'est une limite que tu imposes \c3\a0 ton esprit.") ;; #0632 fr
  (data (i32.const 349897) "La diff\c3\a9rence entre l'ordinaire et l'extraordinaire, c'est ce petit plus.") ;; #0633 fr
  (data (i32.const 349971) "Gagner n'est pas tout, mais vouloir gagner, si.") ;; #0634 fr
  (data (i32.const 350018) "La perfection n'est pas atteignable, mais si nous poursuivons la perfection, nous pouvons atteindre l'excellence.") ;; #0635 fr
  (data (i32.const 350131) "Une fois qu'on apprend \c3\a0 abandonner, cela devient une habitude.") ;; #0636 fr
  (data (i32.const 350195) "Aujourd'hui, je ferai ce que les autres ne font pas, pour que demain je puisse accomplir ce que les autres ne peuvent pas.") ;; #0637 fr
  (data (i32.const 350317) "On ne peut fixer de limite \c3\a0 rien. Plus tu r\c3\aaves, plus tu vas loin.") ;; #0638 fr
  (data (i32.const 350386) "Il y a de meilleurs partants que moi, mais je suis un grand finisseur.") ;; #0639 fr
  (data (i32.const 350456) "Rien de grand ne s'est jamais accompli sans enthousiasme.") ;; #0640 fr
  (data (i32.const 350513) "Je pr\c3\a9f\c3\a8re \c3\aatre cendre que poussi\c3\a8re !") ;; #0641 fr
  (data (i32.const 350555) "D\c3\a9cide de ne jamais rester oisif.") ;; #0642 fr
  (data (i32.const 350589) "Un r\c3\aave ne devient pas r\c3\a9alit\c3\a9 par magie ; il faut de la sueur, de la d\c3\a9termination et du travail acharn\c3\a9.") ;; #0643 fr
  (data (i32.const 350700) "Il n'y a pas de secret pour r\c3\a9ussir. C'est le r\c3\a9sultat de la pr\c3\a9paration, du travail acharn\c3\a9 et des le\c3\a7ons tir\c3\a9es de l'\c3\a9chec.") ;; #0644 fr
  (data (i32.const 350832) "Notre plus grande peur ne devrait pas \c3\aatre l'\c3\a9chec, mais la r\c3\a9ussite dans des choses qui ne comptent pas vraiment.") ;; #0645 fr
  (data (i32.const 350949) "Restez affam\c3\a9s, restez fous.") ;; #0646 fr
  (data (i32.const 350978) "Votre temps est limit\c3\a9, alors ne le g\c3\a2chez pas \c3\a0 vivre la vie de quelqu'un d'autre.") ;; #0647 fr
  (data (i32.const 351064) "Si tu travailles sur quelque chose de passionnant qui te tient vraiment \c3\a0 c\c5\93ur, tu n'as pas besoin d'\c3\aatre pouss\c3\a9. La vision t'entra\c3\aene.") ;; #0648 fr
  (data (i32.const 351204) "La seule fa\c3\a7on de faire du bon travail est d'aimer ce que vous faites.") ;; #0649 fr
  (data (i32.const 351275) "On ne peut pas relier les points en regardant vers l'avant ; on ne peut les relier qu'en regardant en arri\c3\a8re.") ;; #0650 fr
  (data (i32.const 351386) "Parfois, la vie vous frappe \c3\a0 la t\c3\aate avec une brique. Ne perdez pas la foi.") ;; #0651 fr
  (data (i32.const 351464) "Quand quelque chose est assez important, on le fait m\c3\aame si les chances ne sont pas de notre c\c3\b4t\c3\a9.") ;; #0652 fr
  (data (i32.const 351565) "Garde toujours \c3\a0 l'esprit que ta propre r\c3\a9solution de r\c3\a9ussir est plus importante que tout le reste.") ;; #0653 fr
  (data (i32.const 351668) "La douleur est temporaire. L'abandon est \c3\a9ternel.") ;; #0654 fr
  (data (i32.const 351718) "Je me suis tenue sur une montagne de non pour un seul oui.") ;; #0655 fr
  (data (i32.const 351776) "J'ai d\c3\bb gagner ma vie et cr\c3\a9er ma propre chance. Mais j'y suis arriv\c3\a9e !") ;; #0656 fr
  (data (i32.const 351851) "Je n'y suis pas arriv\c3\a9e en le souhaitant ou en l'esp\c3\a9rant, mais en travaillant pour.") ;; #0657 fr
  (data (i32.const 351937) "Battez-vous pour ce qui vous tient \c3\a0 c\c5\93ur, mais faites-le d'une mani\c3\a8re qui incite les autres \c3\a0 vous rejoindre.") ;; #0658 fr
  (data (i32.const 352052) "La vie n'est facile pour aucun de nous. Mais quoi ? Il faut avoir de la pers\c3\a9v\c3\a9rance et surtout de la confiance en soi.") ;; #0659 fr
  (data (i32.const 352173) "Il faut croire que l'on est dou\c3\a9 pour quelque chose, et que cette chose, il faut l'atteindre co\c3\bbte que co\c3\bbte.") ;; #0660 fr
  (data (i32.const 352285) "On ne fait jamais attention \c3\a0 ce qui a \c3\a9t\c3\a9 fait ; on ne voit que ce qui reste \c3\a0 faire.") ;; #0661 fr
  (data (i32.const 352375) "J'\c3\a9l\c3\a8ve la voix non pas pour crier, mais pour que ceux qui n'ont pas de voix puissent \c3\aatre entendus.") ;; #0662 fr
  (data (i32.const 352478) "Un enfant, un enseignant, un livre et un stylo peuvent changer le monde.") ;; #0663 fr
  (data (i32.const 352550) "Quand le monde entier se tait, m\c3\aame une seule voix devient puissante.") ;; #0664 fr
  (data (i32.const 352620) "Parce qu'elle est l\c3\a0.") ;; #0665 fr
  (data (i32.const 352642) "C'est un petit pas pour l'homme, un bond de g\c3\a9ant pour l'humanit\c3\a9.") ;; #0666 fr
  (data (i32.const 352710) "Ne me dis pas que le ciel est la limite quand il y a des empreintes de pas sur la Lune.") ;; #0667 fr
  (data (i32.const 352797) "La Terre est le berceau de l'humanit\c3\a9, mais on ne passe pas sa vie enti\c3\a8re dans un berceau.") ;; #0668 fr
  (data (i32.const 352890) "L'exploration est vraiment l'essence de l'esprit humain.") ;; #0669 fr
  (data (i32.const 352946) "Les guerriers victorieux gagnent d'abord et partent ensuite en guerre, tandis que les vaincus partent d'abord en guerre et cherchent ensuite \c3\a0 gagner.") ;; #0670 fr
  (data (i32.const 353097) "Tous nos r\c3\aaves peuvent devenir r\c3\a9alit\c3\a9 si nous avons le courage de les poursuivre.") ;; #0671 fr
  (data (i32.const 353182) "D'abord, pense. Ensuite, r\c3\aave. Puis, crois. Et enfin, ose.") ;; #0672 fr
  (data (i32.const 353241) "Un r\c3\aave que l'on fait seul n'est qu'un r\c3\aave. Un r\c3\aave que l'on fait ensemble est une r\c3\a9alit\c3\a9.") ;; #0673 fr
  (data (i32.const 353338) "Accroche-toi aux r\c3\aaves, car si les r\c3\aaves meurent, la vie est un oiseau aux ailes bris\c3\a9es qui ne peut plus voler.") ;; #0674 fr
  (data (i32.const 353453) "Les r\c3\aaves sont la pierre de touche de notre caract\c3\a8re.") ;; #0675 fr
  (data (i32.const 353509) "Ne laisse personne te voler ton imagination, ta cr\c3\a9ativit\c3\a9 ou ta curiosit\c3\a9.") ;; #0676 fr
  (data (i32.const 353587) "Ne laisse jamais tes souvenirs \c3\aatre plus grands que tes r\c3\aaves.") ;; #0677 fr
  (data (i32.const 353651) "Tous les hommes r\c3\aavent, mais pas de la m\c3\aame fa\c3\a7on.") ;; #0678 fr
  (data (i32.const 353704) "Les r\c3\aaves se r\c3\a9alisent. Sans cette possibilit\c3\a9, la nature ne nous pousserait pas \c3\a0 en avoir.") ;; #0679 fr
  (data (i32.const 353800) "Ch\c3\a9ris tes visions et tes r\c3\aaves, car ce sont les enfants de ton \c3\a2me, les plans de tes plus belles r\c3\a9ussites.") ;; #0680 fr
  (data (i32.const 353912) "Le point de d\c3\a9part de toute r\c3\a9ussite est le d\c3\a9sir.") ;; #0681 fr
  (data (i32.const 353965) "Un objectif est un r\c3\aave avec une date limite.") ;; #0682 fr
  (data (i32.const 354011) "C'est la possibilit\c3\a9 de r\c3\a9aliser un r\c3\aave qui rend la vie int\c3\a9ressante.") ;; #0683 fr
  (data (i32.const 354085) "Quand tu veux quelque chose, tout l'Univers conspire \c3\a0 te permettre de r\c3\a9aliser ton d\c3\a9sir.") ;; #0684 fr
  (data (i32.const 354178) "R\c3\aave comme si tu allais vivre \c3\a9ternellement. Vis comme si tu allais mourir aujourd'hui.") ;; #0685 fr
  (data (i32.const 354267) "La plus grande aventure que tu puisses vivre, c'est de vivre la vie de tes r\c3\aaves.") ;; #0686 fr
  (data (i32.const 354349) "Vise haut, car des \c3\a9toiles sont cach\c3\a9es en toi. R\c3\aave profond, car chaque r\c3\aave pr\c3\a9c\c3\a8de le but.") ;; #0687 fr
  (data (i32.const 354448) "Je r\c3\aave ma peinture, et je peins mon r\c3\aave.") ;; #0688 fr
  (data (i32.const 354492) "Les r\c3\aaves ne fonctionnent que si tu travailles.") ;; #0689 fr
  (data (i32.const 354540) "Garde tes r\c3\aaves vivants. Comprends que r\c3\a9ussir quoi que ce soit demande de la foi et de la confiance en soi, de la vision, du travail acharn\c3\a9, de la d\c3\a9termination et du d\c3\a9vouement.") ;; #0690 fr
  (data (i32.const 354725) "Si tu peux l'imaginer, tu peux le r\c3\a9aliser.") ;; #0691 fr
  (data (i32.const 354769) "Les r\c3\aaveurs sont les sauveurs du monde.") ;; #0692 fr
  (data (i32.const 354809) "Fais de grands r\c3\aaves, et tel que tu r\c3\aaves, tel tu deviendras.") ;; #0693 fr
  (data (i32.const 354872) "Certaines personnes r\c3\aavent de r\c3\a9ussite, tandis que d'autres se l\c3\a8vent chaque matin pour la faire advenir.") ;; #0694 fr
  (data (i32.const 354980) "J'ai un r\c3\aave.") ;; #0695 fr
  (data (i32.const 354994) "Ce qui est prouv\c3\a9 aujourd'hui n'\c3\a9tait autrefois qu'imagin\c3\a9.") ;; #0696 fr
  (data (i32.const 355056) "Vise la Lune. Si tu la manques, tu toucheras peut-\c3\aatre une \c3\a9toile.") ;; #0697 fr
  (data (i32.const 355124) "Rien n'arrive sans qu'on l'ait d'abord r\c3\aav\c3\a9.") ;; #0698 fr
  (data (i32.const 355170) "Ceux qui r\c3\aavent le jour savent bien des choses qui \c3\a9chappent \c3\a0 ceux qui ne r\c3\aavent que la nuit.") ;; #0699 fr
  (data (i32.const 355268) "Pour accomplir de grandes choses, il ne suffit pas d'agir, il faut r\c3\aaver ; ni de calculer, il faut croire.") ;; #0700 fr
  (data (i32.const 355375) "Suis ta f\c3\a9licit\c3\a9, et l'univers ouvrira des portes l\c3\a0 o\c3\b9 il n'y avait que des murs.") ;; #0701 fr
  (data (i32.const 355461) "Sans les \c3\a9lans de l'imagination ou du r\c3\aave, nous perdons l'enthousiasme des possibles.") ;; #0702 fr
  (data (i32.const 355549) "R\c3\aaver, apr\c3\a8s tout, est une fa\c3\a7on de planifier.") ;; #0703 fr
  (data (i32.const 355598) "Tu vas vers des endroits formidables ! C'est aujourd'hui ton jour ! Ta montagne t'attend, alors mets-toi en route !") ;; #0704 fr
  (data (i32.const 355713) "Tu as un cerveau dans la t\c3\aate. Tu as des pieds dans tes chaussures. Tu peux aller dans la direction de ton choix.") ;; #0705 fr
  (data (i32.const 355827) "\c3\80 moins que quelqu'un comme toi ne s'en soucie \c3\a9norm\c3\a9ment, rien ne s'arrangera. Rien du tout.") ;; #0706 fr
  (data (i32.const 355923) "Dis-moi, que comptes-tu faire de ton unique vie, sauvage et pr\c3\a9cieuse ?") ;; #0707 fr
  (data (i32.const 355995) "Deux routes divergeaient dans un bois, et moi, j'ai pris la moins fr\c3\a9quent\c3\a9e, et c'est ce qui a fait toute la diff\c3\a9rence.") ;; #0708 fr
  (data (i32.const 356119) "Tous ceux qui errent ne sont pas perdus.") ;; #0709 fr
  (data (i32.const 356159) "J'ai pris une grande inspiration et \c3\a9cout\c3\a9 la vieille vantardise de mon c\c5\93ur : je suis, je suis, je suis.") ;; #0710 fr
  (data (i32.const 356267) "Peut-\c3\aatre tous les dragons de notre vie sont-ils des princesses qui n'attendent que de nous voir agir, une seule fois, avec beaut\c3\a9 et courage.") ;; #0711 fr
  (data (i32.const 356411) "Que tenterais-tu de faire si tu savais que tu ne pouvais pas \c3\a9chouer ?") ;; #0712 fr
  (data (i32.const 356482) "J'ai vu l'ange dans le marbre et j'ai sculpt\c3\a9 jusqu'\c3\a0 le lib\c3\a9rer.") ;; #0713 fr
  (data (i32.const 356550) "Les gens qui ont des objectifs r\c3\a9ussissent parce qu'ils savent o\c3\b9 ils vont.") ;; #0714 fr
  (data (i32.const 356627) "Ce que tu cherches te cherche aussi.") ;; #0715 fr
  (data (i32.const 356663) "Ne t'afflige pas. Tout ce que tu perds revient sous une autre forme.") ;; #0716 fr
  (data (i32.const 356731) "Mets le feu \c3\a0 ta vie. Cherche ceux qui attisent tes flammes.") ;; #0717 fr
  (data (i32.const 356792) "Hier, j'\c3\a9tais intelligent, alors je voulais changer le monde. Aujourd'hui, je suis sage, alors je me change moi-m\c3\aame.") ;; #0718 fr
  (data (i32.const 356911) "Tu es n\c3\a9 avec des ailes, pourquoi pr\c3\a9f\c3\a9rer ramper dans la vie ?") ;; #0719 fr
  (data (i32.const 356977) "R\c3\a9ponds \c3\a0 chaque appel qui enthousiasme ton esprit.") ;; #0720 fr
  (data (i32.const 357030) "Si chaque frottement t'irrite, comment ton miroir sera-t-il poli ?") ;; #0721 fr
  (data (i32.const 357096) "Ces douleurs que tu ressens sont des messag\c3\a8res. \c3\89coute-les.") ;; #0722 fr
  (data (i32.const 357158) "La libert\c3\a9 est le seul but digne dans la vie. Elle s'obtient en se d\c3\a9tachant de ce qui ne d\c3\a9pend pas de nous.") ;; #0723 fr
  (data (i32.const 357270) "N'explique pas ta philosophie. Incarne-la.") ;; #0724 fr
  (data (i32.const 357312) "Si tu veux progresser, accepte de passer pour un sot et un ignorant.") ;; #0725 fr
  (data (i32.const 357380) "Tant que tu vis, continue d'apprendre \c3\a0 vivre.") ;; #0726 fr
  (data (i32.const 357427) "Parfois, m\c3\aame vivre est un acte de courage.") ;; #0727 fr
  (data (i32.const 357471) "Il n'y a point de vent favorable pour celui qui ne sait pas o\c3\b9 il va.") ;; #0728 fr
  (data (i32.const 357541) "La chance, c'est ce qui arrive quand la pr\c3\a9paration rencontre l'opportunit\c3\a9.") ;; #0729 fr
  (data (i32.const 357619) "Hier est de l'histoire, demain est un myst\c3\a8re, aujourd'hui est un cadeau de Dieu, c'est pourquoi on l'appelle le pr\c3\a9sent.") ;; #0730 fr
  (data (i32.const 357742) "Seul, on va plus vite ; ensemble, on va plus loin.") ;; #0731 fr
  (data (i32.const 357792) "N'ayez pas peur.") ;; #0732 fr
  (data (i32.const 357808) "Je n'ai pas peur de demain, car j'ai vu hier et j'aime aujourd'hui.") ;; #0733 fr
  (data (i32.const 357875) "Chaque jour est un jour nouveau.") ;; #0734 fr
  (data (i32.const 357907) "Le seul voyage est le voyage int\c3\a9rieur.") ;; #0735 fr
  (data (i32.const 357947) "J'apprends encore.") ;; #0736 fr
  (data (i32.const 357965) "Ce n'est pas la longueur de la vie qui compte, mais sa profondeur.") ;; #0737 fr
  (data (i32.const 358031) "Une fois que tu prends une d\c3\a9cision, l'univers conspire \c3\a0 la r\c3\a9aliser.") ;; #0738 fr
  (data (i32.const 358104) "\c3\8atre grand, c'est \c3\aatre incompris.") ;; #0739 fr
  (data (i32.const 358139) "Termine chaque journ\c3\a9e et laisse-la derri\c3\a8re toi. Tu as fait ce que tu as pu.") ;; #0740 fr
  (data (i32.const 358218) "Les ann\c3\a9es enseignent bien des choses que les jours ignorent.") ;; #0741 fr
  (data (i32.const 358280) "\c3\89cris dans ton c\c5\93ur que chaque jour est le meilleur jour de l'ann\c3\a9e.") ;; #0742 fr
  (data (i32.const 358351) "La vie ne peut \c3\aatre comprise qu'en regardant en arri\c3\a8re, mais elle ne peut \c3\aatre v\c3\a9cue qu'en regardant en avant.") ;; #0743 fr
  (data (i32.const 358466) "Les d\c3\a9buts sont toujours d\c3\a9sordonn\c3\a9s.") ;; #0744 fr
  (data (i32.const 358506) "La vision est l'art de voir ce qui est invisible aux autres.") ;; #0745 fr
  (data (i32.const 358566) "Quand une porte du bonheur se ferme, une autre s'ouvre.") ;; #0746 fr
  (data (i32.const 358621) "Seuls, nous pouvons si peu ; ensemble, nous pouvons tant.") ;; #0747 fr
  (data (i32.const 358678) "La seule chose pire que d'\c3\aatre aveugle, c'est d'avoir la vue mais aucune vision.") ;; #0748 fr
  (data (i32.const 358759) "Aucun pessimiste n'a jamais d\c3\a9couvert le secret des \c3\a9toiles ni navigu\c3\a9 vers une terre inconnue.") ;; #0749 fr
  (data (i32.const 358857) "Nous pouvons faire tout ce que nous voulons si nous pers\c3\a9v\c3\a9rons assez longtemps.") ;; #0750 fr
  (data (i32.const 358939) "Ce que je cherche n'est pas l\c3\a0-bas, c'est en moi.") ;; #0751 fr
  (data (i32.const 358989) "L'effort et le courage ne suffisent pas sans but ni direction.") ;; #0752 fr
  (data (i32.const 359051) "Le monde change par ton exemple, pas par ton opinion.") ;; #0753 fr
  (data (i32.const 359104) "Nous ne pouvons pas aider tout le monde, mais chacun peut aider quelqu'un.") ;; #0754 fr
  (data (i32.const 359178) "Chacun doit vivre sa vie comme un mod\c3\a8le pour les autres.") ;; #0755 fr
  (data (i32.const 359236) "Si la route que tu suis ne te pla\c3\aet pas, commence \c3\a0 en paver une autre.") ;; #0756 fr
  (data (i32.const 359309) "Tu obtiens de la vie ce que tu as le courage de demander.") ;; #0757 fr
  (data (i32.const 359366) "Le succ\c3\a8s ne se mesure pas \c3\a0 l'argent que tu gagnes, mais \c3\a0 la diff\c3\a9rence que tu fais dans la vie des gens.") ;; #0758 fr
  (data (i32.const 359477) "Il n'y a pas de plus grande souffrance que de porter en soi une histoire inexprim\c3\a9e.") ;; #0759 fr
  (data (i32.const 359562) "Nous ne prenons conscience de l'importance de notre voix que lorsqu'on nous r\c3\a9duit au silence.") ;; #0760 fr
  (data (i32.const 359657) "Le succ\c3\a8s, ce n'est pas la hauteur \c3\a0 laquelle tu es mont\c3\a9, mais la fa\c3\a7on dont tu changes positivement le monde.") ;; #0761 fr
  (data (i32.const 359772) "La meilleure vengeance, c'est un immense succ\c3\a8s.") ;; #0762 fr
  (data (i32.const 359821) "Le deuil peut \c3\aatre le jardin de la compassion.") ;; #0763 fr
  (data (i32.const 359868) "Continue d'avancer, et il y a des chances que tu tombes sur quelque chose, peut-\c3\aatre au moment o\c3\b9 tu t'y attends le moins.") ;; #0764 fr
  (data (i32.const 359992) "Le travail sans talent est dommage, mais le talent sans travail est une trag\c3\a9die.") ;; #0765 fr
  (data (i32.const 360074) "Ce n'est pas fini tant que ce n'est pas fini.") ;; #0766 fr
  (data (i32.const 360119) "Nous trouverons un chemin, ou nous en cr\c3\a9erons un.") ;; #0767 fr
  (data (i32.const 360170) "Le secret de la r\c3\a9ussite est la constance dans le but.") ;; #0768 fr
  (data (i32.const 360225) "Persiste et pers\c3\a9v\c3\a8re, et tu d\c3\a9couvriras que la plupart des choses atteignables sont possibles.") ;; #0769 fr
  (data (i32.const 360323) "La plupart des gens abandonnent juste au moment o\c3\b9 ils sont sur le point de r\c3\a9ussir. Ils renoncent \c3\a0 un m\c3\a8tre de la ligne d'arriv\c3\a9e.") ;; #0770 fr
  (data (i32.const 360460) "Si tu dois douter de quelque chose, doute de tes limites.") ;; #0771 fr
  (data (i32.const 360517) "Rien ne remplace le travail acharn\c3\a9.") ;; #0772 fr
  (data (i32.const 360554) "La diff\c3\a9rence entre essayer et triompher, c'est juste un petit peu d'\c3\a9lan !") ;; #0773 fr
  (data (i32.const 360631) "La pers\c3\a9v\c3\a9rance, c'est \c3\a9chouer dix-neuf fois et r\c3\a9ussir la vingti\c3\a8me.") ;; #0774 fr
  (data (i32.const 360705) "La pers\c3\a9v\c3\a9rance est au caract\c3\a8re de l'homme ce que le carbone est \c3\a0 l'acier.") ;; #0775 fr
  (data (i32.const 360785) "Celui qui parvient \c3\a0 se pousser plus loin quand l'effort devient douloureux est celui qui gagnera.") ;; #0776 fr
  (data (i32.const 360884) "N'abandonne pas. N'abandonne jamais.") ;; #0777 fr
  (data (i32.const 360920) "Beaucoup de gens sont all\c3\a9s plus loin qu'ils ne le pensaient parce que quelqu'un d'autre croyait qu'ils en \c3\a9taient capables.") ;; #0778 fr
  (data (i32.const 361046) "On ne gravit pas l'\c3\a9chelle du succ\c3\a8s les mains dans les poches.") ;; #0779 fr
  (data (i32.const 361111) "Les r\c3\a9ussites d'aujourd'hui \c3\a9taient les impossibles d'hier.") ;; #0780 fr
  (data (i32.const 361172) "Rien n'est particuli\c3\a8rement difficile si on le divise en petites t\c3\a2ches.") ;; #0781 fr
  (data (i32.const 361246) "La pers\c3\a9v\c3\a9rance et l'ardeur ont fait des merveilles \c3\a0 toutes les \c3\a9poques.") ;; #0782 fr
  (data (i32.const 361323) "Le courage est le prix que la vie exige pour accorder la paix.") ;; #0783 fr
  (data (i32.const 361385) "L'aventure vaut la peine en elle-m\c3\aame.") ;; #0784 fr
  (data (i32.const 361424) "Le courage est une histoire d'amour avec l'inconnu.") ;; #0785 fr
  (data (i32.const 361475) "Ce que tu dois faire quand une chose ne te pla\c3\aet pas, c'est la changer.") ;; #0786 fr
  (data (i32.const 361547) "Sois courageux. Prends des risques. Rien ne remplace l'exp\c3\a9rience.") ;; #0787 fr
  (data (i32.const 361614) "Celui qui est courageux est libre.") ;; #0788 fr
  (data (i32.const 361648) "Je ne dois pas avoir peur. La peur tue l'esprit.") ;; #0789 fr
  (data (i32.const 361696) "Le courage est la qualit\c3\a9 principale du leadership.") ;; #0790 fr
  (data (i32.const 361748) "La chose la plus courageuse que tu puisses faire quand tu n'es pas courageux, c'est d'affirmer ton courage et d'agir en cons\c3\a9quence.") ;; #0791 fr
  (data (i32.const 361881) "Le courage, c'est faire ce dont on a peur. Il ne peut y avoir de courage sans peur.") ;; #0792 fr
  (data (i32.const 361964) "La fortune et l'amour sourient aux audacieux.") ;; #0793 fr
  (data (i32.const 362009) "Expose-toi \c3\a0 ta peur la plus profonde ; apr\c3\a8s cela, la peur n'a plus de pouvoir.") ;; #0794 fr
  (data (i32.const 362091) "Le courage est comme l'amour : il veut de l'esp\c3\a9rance pour nourriture.") ;; #0795 fr
  (data (i32.const 362162) "Il est curieux que le courage physique soit si r\c3\a9pandu dans le monde, et le courage moral si rare.") ;; #0796 fr
  (data (i32.const 362261) "Le contraire du courage dans notre soci\c3\a9t\c3\a9 n'est pas la l\c3\a2chet\c3\a9, c'est le conformisme.") ;; #0797 fr
  (data (i32.const 362351) "Les l\c3\a2ches meurent plusieurs fois avant leur mort ; les vaillants ne go\c3\bbtent la mort qu'une seule fois.") ;; #0798 fr
  (data (i32.const 362456) "N'aie pas peur de la grandeur : certains naissent grands, d'autres atteignent la grandeur, et d'autres encore se la voient imposer.") ;; #0799 fr
  (data (i32.const 362587) "Tends ton courage jusqu'au bout, et nous n'\c3\a9chouerons pas.") ;; #0800 fr
  (data (i32.const 362646) "Le courage, c'est la peur qui tient une minute de plus.") ;; #0801 fr
  (data (i32.const 362701) "\c3\89chouer, ce n'est pas tomber, c'est refuser de se relever.") ;; #0802 fr
  (data (i32.const 362760) "L'homme qui r\c3\a9ussit tire profit de ses erreurs et r\c3\a9essaie d'une autre mani\c3\a8re.") ;; #0803 fr
  (data (i32.const 362842) "B\c3\a2tis le succ\c3\a8s \c3\a0 partir de tes \c3\a9checs. Le d\c3\a9couragement et l'\c3\a9chec sont deux des marches les plus s\c3\bbres vers le succ\c3\a8s.") ;; #0804 fr
  (data (i32.const 362970) "Les erreurs sont toujours pardonnables, si l'on a le courage de les reconna\c3\aetre.") ;; #0805 fr
  (data (i32.const 363051) "Ne crains pas les erreurs. Il n'y en a pas.") ;; #0806 fr
  (data (i32.const 363094) "Quand tu fais une erreur, il n'y a que trois choses \c3\a0 faire : la reconna\c3\aetre, en tirer une le\c3\a7on et ne pas la r\c3\a9p\c3\a9ter.") ;; #0807 fr
  (data (i32.const 363217) "L'\c3\a9chec est un d\c3\a9tour, pas une impasse.") ;; #0808 fr
  (data (i32.const 363258) "Un \c3\a9chec n'est pas toujours une erreur. C'est peut-\c3\aatre simplement le mieux que l'on pouvait faire dans ces circonstances. La vraie erreur, c'est d'arr\c3\aater d'essayer.") ;; #0809 fr
  (data (i32.const 363427) "Si tu n'\c3\a9choues pas de temps en temps, c'est le signe que tu ne fais rien de tr\c3\a8s innovant.") ;; #0810 fr
  (data (i32.const 363520) "L'\c3\a9chec arrive tout le temps. Il arrive chaque jour \c3\a0 l'entra\c3\aenement. Ce qui te rend meilleur, c'est la fa\c3\a7on dont tu y r\c3\a9agis.") ;; #0811 fr
  (data (i32.const 363652) "Il n'y a ni erreurs ni \c3\a9checs, seulement des le\c3\a7ons.") ;; #0812 fr
  (data (i32.const 363706) "J'ai appris davantage de mes erreurs que de mes r\c3\a9ussites.") ;; #0813 fr
  (data (i32.const 363765) "C'est l'\c3\a9chec qui te donne la juste perspective sur le succ\c3\a8s.") ;; #0814 fr
  (data (i32.const 363829) "Le succ\c3\a8s, c'est la hauteur \c3\a0 laquelle tu rebondis quand tu touches le fond.") ;; #0815 fr
  (data (i32.const 363907) "Ne laisse pas la peur de perdre \c3\aatre plus forte que l'envie de gagner.") ;; #0816 fr
  (data (i32.const 363978) "Nous apprenons de l'\c3\a9chec, pas du succ\c3\a8s !") ;; #0817 fr
  (data (i32.const 364022) "Tu ne peux pas avoir peur d'\c3\a9chouer. C'est la seule fa\c3\a7on de r\c3\a9ussir.") ;; #0818 fr
  (data (i32.const 364094) "Un homme n'est pas fini quand il est vaincu. Il est fini quand il abandonne.") ;; #0819 fr
  (data (i32.const 364170) "L'esprit humain est plus fort que tout ce qui peut lui arriver.") ;; #0820 fr
  (data (i32.const 364233) "La vie, ce n'est pas la vitesse \c3\a0 laquelle tu cours ou la hauteur \c3\a0 laquelle tu montes, mais la fa\c3\a7on dont tu rebondis.") ;; #0821 fr
  (data (i32.const 364355) "Pas de boue, pas de lotus.") ;; #0822 fr
  (data (i32.const 364381) "Si tu veux voir le soleil, tu dois affronter la temp\c3\aate.") ;; #0823 fr
  (data (i32.const 364438) "Les personnes les plus fortes trouvent le courage et la bienveillance d'aider les autres, m\c3\aame quand elles traversent leur propre temp\c3\aate.") ;; #0824 fr
  (data (i32.const 364578) "G\c3\a2cher sa vie, \c3\a7a n'existe pas. La vie, en fin de compte, est une chose plut\c3\b4t r\c3\a9siliente.") ;; #0825 fr
  (data (i32.const 364672) "La r\c3\a9silience, c'est savoir que tu es le seul \c3\a0 avoir le pouvoir et la responsabilit\c3\a9 de te relever.") ;; #0826 fr
  (data (i32.const 364775) "Une fois que tu affrontes ta peur, rien n'est jamais aussi difficile que tu le crois.") ;; #0827 fr
  (data (i32.const 364860) "Quand la vie te met \c3\a0 terre, essaie de tomber sur le dos. Car si tu peux lever les yeux, tu peux te relever.") ;; #0828 fr
  (data (i32.const 364969) "De chaque crise na\c3\aet la chance de rena\c3\aetre.") ;; #0829 fr
  (data (i32.const 365014) "Rien n'est permanent dans ce monde cruel, pas m\c3\aame nos ennuis.") ;; #0830 fr
  (data (i32.const 365077) "Les \c3\a9preuves font ou d\c3\a9font les gens.") ;; #0831 fr
  (data (i32.const 365116) "Transforme tes cicatrices en \c3\a9toiles.") ;; #0832 fr
  (data (i32.const 365154) "Le cancer peut m'enlever toutes mes capacit\c3\a9s physiques. Il ne peut pas toucher mon esprit, il ne peut pas toucher mon c\c5\93ur, il ne peut pas toucher mon \c3\a2me.") ;; #0833 fr
  (data (i32.const 365313) "Sois l'eau, mon ami.") ;; #0834 fr
  (data (i32.const 365333) "Les jours difficiles sont les meilleurs, car c'est l\c3\a0 que naissent les champions.") ;; #0835 fr
  (data (i32.const 365415) "Il y a toujours de la lumi\c3\a8re, si seulement nous avons le courage de la voir. Si seulement nous avons le courage de l'\c3\aatre.") ;; #0836 fr
  (data (i32.const 365540) "L'espoir est un verbe aux manches retrouss\c3\a9es.") ;; #0837 fr
  (data (i32.const 365587) "Esp\c3\a9rer, c'est se donner \c3\a0 l'avenir.") ;; #0838 fr
  (data (i32.const 365625) "L'espoir n'est pas un ticket de loterie que l'on serre sur son canap\c3\a9 en se sentant chanceux. C'est une hache avec laquelle on enfonce les portes en cas d'urgence.") ;; #0839 fr
  (data (i32.const 365789) "Gardons bon courage, en nous rappelant que les malheurs les plus difficiles \c3\a0 supporter sont ceux qui n'arrivent jamais.") ;; #0840 fr
  (data (i32.const 365910) "La meilleure fa\c3\a7on de se remonter le moral est d'essayer de remonter celui de quelqu'un d'autre.") ;; #0841 fr
  (data (i32.const 366007) "Quand le soleil brille, je peux tout faire ; aucune montagne n'est trop haute, aucun probl\c3\a8me trop difficile \c3\a0 surmonter.") ;; #0842 fr
  (data (i32.const 366130) "Ne doutez jamais qu'un petit groupe de citoyens engag\c3\a9s et r\c3\a9fl\c3\a9chis puisse changer le monde.") ;; #0843 fr
  (data (i32.const 366226) "Garde ton visage tourn\c3\a9 vers le soleil et tu ne verras pas l'ombre.") ;; #0844 fr
  (data (i32.const 366294) "Un jour, en y repensant, les ann\c3\a9es de lutte te para\c3\aetront les plus belles.") ;; #0845 fr
  (data (i32.const 366371) "\c3\80 la fin, tout s'arrange. Si \c3\a7a ne s'est pas arrang\c3\a9, c'est que ce n'est pas encore la fin.") ;; #0846 fr
  (data (i32.const 366465) "L'espoir est le compagnon de la puissance et la m\c3\a8re du succ\c3\a8s.") ;; #0847 fr
  (data (i32.const 366530) "L'espoir est lui-m\c3\aame une forme de bonheur.") ;; #0848 fr
  (data (i32.const 366574) "Le soleil ne brille pas sur nous, mais en nous.") ;; #0849 fr
  (data (i32.const 366621) "L'espoir \c3\a9veille, comme rien d'autre ne peut le faire, une passion pour le possible.") ;; #0850 fr
  (data (i32.const 366706) "Ne laisse pas ton feu s'\c3\a9teindre, \c3\a9tincelle apr\c3\a8s \c3\a9tincelle irrempla\c3\a7able.") ;; #0851 fr
  (data (i32.const 366785) "Nous sommes tous dans le caniveau, mais certains d'entre nous regardent les \c3\a9toiles.") ;; #0852 fr
  (data (i32.const 366870) "Plus la nuit est sombre, plus les \c3\a9toiles brillent ; plus le chagrin est profond, plus Dieu est proche !") ;; #0853 fr
  (data (i32.const 366975) "Les nuages viennent flotter dans ma vie, non plus pour apporter la pluie ou annoncer l'orage, mais pour colorer mon ciel de couchant.") ;; #0854 fr
  (data (i32.const 367108) "Le caract\c3\a8re, c'est la puissance.") ;; #0855 fr
  (data (i32.const 367142) "Je n'ai pas peur ; je suis n\c3\a9e pour cela.") ;; #0856 fr
  (data (i32.const 367184) "La ma\c3\aetrise de soi est une force. La pens\c3\a9e juste est une ma\c3\aetrise. Le calme est un pouvoir.") ;; #0857 fr
  (data (i32.const 367279) "La meilleure arme contre le stress est notre capacit\c3\a9 \c3\a0 choisir une pens\c3\a9e plut\c3\b4t qu'une autre.") ;; #0858 fr
  (data (i32.const 367378) "Ne d\c3\a9sire rien \c3\aatre d'autre que ce que tu es, et efforce-toi de l'\c3\aatre parfaitement.") ;; #0859 fr
  (data (i32.const 367465) "Personne ne nous sauve, sinon nous-m\c3\aames. Personne ne le peut, personne ne le doit. Nous devons nous-m\c3\aames parcourir le chemin.") ;; #0860 fr
  (data (i32.const 367594) "Le pouvoir ne se donne pas. Il faut le prendre.") ;; #0861 fr
  (data (i32.const 367641) "Je ne vais pas me limiter simplement parce que les gens n'acceptent pas que je puisse faire autre chose.") ;; #0862 fr
  (data (i32.const 367745) "Personne n'a jamais mesur\c3\a9, pas m\c3\aame les po\c3\a8tes, tout ce que peut contenir un c\c5\93ur.") ;; #0863 fr
  (data (i32.const 367832) "Nous ne pouvons pas tous faire de grandes choses. Mais nous pouvons faire de petites choses avec un grand amour.") ;; #0864 fr
  (data (i32.const 367944) "Elle a beau \c3\aatre petite, elle est f\c3\a9roce.") ;; #0865 fr
  (data (i32.const 367987) "On ne peut pas fuir une faiblesse ; il faut un jour l'affronter jusqu'au bout, ou p\c3\a9rir.") ;; #0866 fr
  (data (i32.const 368076) "N'entre pas sans violence dans cette bonne nuit. Rage, rage contre la mort de la lumi\c3\a8re.") ;; #0867 fr
  (data (i32.const 368166) "La force ne vient pas de ce que tu sais faire. Elle vient du fait de surmonter ce que tu croyais autrefois impossible.") ;; #0868 fr
  (data (i32.const 368284) "L'excellence n'est pas une comp\c3\a9tence. C'est une attitude.") ;; #0869 fr
  (data (i32.const 368343) "Fais d'abord les t\c3\a2ches difficiles. Les faciles se r\c3\a9gleront d'elles-m\c3\aames.") ;; #0870 fr
  (data (i32.const 368421) "Mieux vaut ne donner aucune excuse qu'en donner une mauvaise.") ;; #0871 fr
  (data (i32.const 368482) "Le travail acharn\c3\a9 n'est une prison que s'il n'a pas de sens.") ;; #0872 fr
  (data (i32.const 368544) "C'est en pratiquant les actions justes que nous devenons justes, les actions mod\c3\a9r\c3\a9es que nous devenons mod\c3\a9r\c3\a9s, les actions courageuses que nous devenons courageux.") ;; #0873 fr
  (data (i32.const 368713) "Ne confonds jamais activit\c3\a9 et accomplissement.") ;; #0874 fr
  (data (i32.const 368761) "Plus tu travailles dur, plus il est difficile d'abandonner.") ;; #0875 fr
  (data (i32.const 368820) "La pratique ne rend pas parfait. Seule une pratique parfaite rend parfait.") ;; #0876 fr
  (data (i32.const 368894) "Le succ\c3\a8s se trouve l\c3\a0 o\c3\b9 la pr\c3\a9paration rencontre l'opportunit\c3\a9.") ;; #0877 fr
  (data (i32.const 368964) "La qualit\c3\a9, c'est bien faire m\c3\aame quand personne ne regarde.") ;; #0878 fr
  (data (i32.const 369026) "Ce sont les trois ou quatre derni\c3\a8res r\c3\a9p\c3\a9titions qui font grossir le muscle.") ;; #0879 fr
  (data (i32.const 369106) "L'autodiscipline commence par la ma\c3\aetrise de tes pens\c3\a9es.") ;; #0880 fr
  (data (i32.const 369165) "Aimes-tu la vie ? Alors ne gaspille pas le temps, car c'est l'\c3\a9toffe dont la vie est faite.") ;; #0881 fr
  (data (i32.const 369257) "Je ne m'arr\c3\aate pas quand je suis fatigu\c3\a9. Je m'arr\c3\aate quand j'ai fini.") ;; #0882 fr
  (data (i32.const 369330) "Le seul jour facile, c'\c3\a9tait hier.") ;; #0883 fr
  (data (i32.const 369365) "Avec douceur, tu peux \c3\a9branler le monde.") ;; #0884 fr
  (data (i32.const 369406) "R\c3\a9examine tout ce qu'on t'a dit ; rejette ce qui insulte ton \c3\a2me.") ;; #0885 fr
  (data (i32.const 369473) "Le changement est le r\c3\a9sultat final de tout v\c3\a9ritable apprentissage.") ;; #0886 fr
  (data (i32.const 369543) "Celui qui cesse d'apprendre est vieux, qu'il ait vingt ou quatre-vingts ans.") ;; #0887 fr
  (data (i32.const 369619) "Le v\c3\a9ritable voyage de d\c3\a9couverte ne consiste pas \c3\a0 chercher de nouveaux paysages, mais \c3\a0 avoir de nouveaux yeux.") ;; #0888 fr
  (data (i32.const 369736) "Ce n'est que lorsque nous sommes perdus que nous commen\c3\a7ons \c3\a0 nous comprendre.") ;; #0889 fr
  (data (i32.const 369816) "Les choses ne changent pas ; c'est nous qui changeons.") ;; #0890 fr
  (data (i32.const 369870) "Le progr\c3\a8s implique toujours des risques. On ne peut pas voler la deuxi\c3\a8me base en gardant le pied sur la premi\c3\a8re.") ;; #0891 fr
  (data (i32.const 369988) "Le plus grand danger en p\c3\a9riode de turbulence n'est pas la turbulence ; c'est d'agir avec la logique d'hier.") ;; #0892 fr
  (data (i32.const 370097) "Nous devons \c3\aatre pr\c3\aats \c3\a0 renoncer \c3\a0 la vie que nous avions pr\c3\a9vue pour vivre celle qui nous attend.") ;; #0893 fr
  (data (i32.const 370201) "Le privil\c3\a8ge d'une vie, c'est de devenir qui l'on est vraiment.") ;; #0894 fr
  (data (i32.const 370265) "Conna\c3\aetre sa propre obscurit\c3\a9 est la meilleure fa\c3\a7on de faire face \c3\a0 l'obscurit\c3\a9 des autres.") ;; #0895 fr
  (data (i32.const 370362) "Il n'y a pas de prise de conscience sans douleur.") ;; #0896 fr
  (data (i32.const 370411) "Ce qui compte, c'est ce que tu apprends apr\c3\a8s avoir cru tout savoir.") ;; #0897 fr
  (data (i32.const 370480) "Notre t\c3\a2che dans la vie n'est pas de devancer les autres, mais de nous devancer nous-m\c3\aames.") ;; #0898 fr
  (data (i32.const 370573) "\c3\8atre ce que nous sommes, et devenir ce que nous sommes capables de devenir, voil\c3\a0 le seul but de la vie.") ;; #0899 fr
  (data (i32.const 370679) "Ce que la chenille appelle la fin du monde, le ma\c3\aetre l'appelle papillon.") ;; #0900 fr
  (data (i32.const 370753) "Si tu n'es pas pr\c3\aat \c3\a0 apprendre, personne ne peut t'aider. Si tu es d\c3\a9termin\c3\a9 \c3\a0 apprendre, personne ne peut t'arr\c3\aater.") ;; #0901 fr
  (data (i32.const 370877) "\c3\80 long terme, nous fa\c3\a7onnons notre vie et nous nous fa\c3\a7onnons nous-m\c3\aames.") ;; #0902 fr
  (data (i32.const 370954) "De l'adversit\c3\a9 na\c3\aet l'opportunit\c3\a9.") ;; #0903 fr
  (data (i32.const 370991) "L'adversit\c3\a9 a toujours \c3\a9t\c3\a9 consid\c3\a9r\c3\a9e comme l'\c3\a9tat dans lequel l'homme apprend le plus facilement \c3\a0 se conna\c3\aetre.") ;; #0904 fr
  (data (i32.const 371112) "Les mauvais moments ont une valeur scientifique. Ce sont des occasions qu'un bon \c3\a9l\c3\a8ve ne laisserait pas passer.") ;; #0905 fr
  (data (i32.const 371226) "Chaque mur est une porte.") ;; #0906 fr
  (data (i32.const 371251) "La douleur et la souffrance sont toujours in\c3\a9vitables pour une vaste intelligence et un c\c5\93ur profond.") ;; #0907 fr
  (data (i32.const 371354) "Long et dur est le chemin qui de l'enfer m\c3\a8ne \c3\a0 la lumi\c3\a8re.") ;; #0908 fr
  (data (i32.const 371416) "Accepte les d\c3\a9fis, afin de go\c3\bbter l'exaltation de la victoire.") ;; #0909 fr
  (data (i32.const 371480) "Quand il est \c3\a9vident que les objectifs ne peuvent pas \c3\aatre atteints, n'ajuste pas les objectifs ; ajuste les \c3\a9tapes pour y arriver.") ;; #0910 fr
  (data (i32.const 371614) "La victoire est plus douce quand on a connu la d\c3\a9faite.") ;; #0911 fr
  (data (i32.const 371670) "C'est une erreur de regarder trop loin devant. On ne peut saisir qu'un seul maillon de la cha\c3\aene du destin \c3\a0 la fois.") ;; #0912 fr
  (data (i32.const 371789) "Ne perds pas ton temps \c3\a0 frapper contre un mur en esp\c3\a9rant le transformer en porte.") ;; #0913 fr
  (data (i32.const 371874) "Commence n'importe o\c3\b9.") ;; #0914 fr
  (data (i32.const 371897) "L'action est \c3\a9loquente.") ;; #0915 fr
  (data (i32.const 371921) "N'attendez pas de chefs ; faites-le seuls, de personne \c3\a0 personne.") ;; #0916 fr
  (data (i32.const 371988) "Ne juge pas chaque jour \c3\a0 la r\c3\a9colte que tu fais, mais aux graines que tu s\c3\a8mes.") ;; #0917 fr
  (data (i32.const 372071) "Fais quelque chose de merveilleux ; les gens pourraient t'imiter.") ;; #0918 fr
  (data (i32.const 372136) "C'est toujours le bon moment pour faire ce qui est juste.") ;; #0919 fr
  (data (i32.const 372193) "Un objectif bien fix\c3\a9 est \c3\a0 moiti\c3\a9 atteint.") ;; #0920 fr
  (data (i32.const 372239) "Les choses n'arrivent pas toutes seules. On les fait arriver.") ;; #0921 fr
  (data (i32.const 372300) "Quatre-vingts pour cent du succ\c3\a8s, c'est d'\c3\aatre pr\c3\a9sent.") ;; #0922 fr
  (data (i32.const 372359) "On ne b\c3\a2tit pas une r\c3\a9putation sur ce qu'on va faire.") ;; #0923 fr
  (data (i32.const 372414) "Tu peux remettre \c3\a0 plus tard, mais le temps, lui, ne le fera pas.") ;; #0924 fr
  (data (i32.const 372480) "\c3\89cris quelque chose qui vaille la peine d'\c3\aatre lu, ou fais quelque chose qui vaille la peine d'\c3\aatre \c3\a9crit.") ;; #0925 fr
  (data (i32.const 372590) "Certains veulent que cela arrive, d'autres souhaitent que cela arrive, d'autres encore le font arriver.") ;; #0926 fr
  (data (i32.const 372693) "Plus je veux faire une chose, moins je l'appelle travail.") ;; #0927 fr
  (data (i32.const 372750) "Le pessimiste se plaint du vent ; l'optimiste esp\c3\a8re qu'il va changer ; le r\c3\a9aliste ajuste ses voiles.") ;; #0928 fr
  (data (i32.const 372854) "L'optimisme est essentiel \c3\a0 la r\c3\a9ussite, et c'est aussi le fondement du courage et du v\c3\a9ritable progr\c3\a8s.") ;; #0929 fr
  (data (i32.const 372962) "Tu es ce que tu crois \c3\aatre.") ;; #0930 fr
  (data (i32.const 372990) "Crois et agis comme s'il \c3\a9tait impossible d'\c3\a9chouer.") ;; #0931 fr
  (data (i32.const 373044) "L'esprit est \c3\a0 lui-m\c3\aame sa propre demeure, il peut faire en soi un Ciel de l'Enfer, un Enfer du Ciel.") ;; #0932 fr
  (data (i32.const 373147) "Si tu savais \c3\a0 quel point tes pens\c3\a9es sont puissantes, tu n'aurais plus jamais une pens\c3\a9e n\c3\a9gative.") ;; #0933 fr
  (data (i32.const 373250) "Je suis le plus grand. Je le disais avant m\c3\aame de savoir que je l'\c3\a9tais.") ;; #0934 fr
  (data (i32.const 373324) "Impossible n'est qu'un grand mot utilis\c3\a9 par de petits hommes.") ;; #0935 fr
  (data (i32.const 373387) "C'est la r\c3\a9p\c3\a9tition des affirmations qui m\c3\a8ne \c3\a0 la croyance.") ;; #0936 fr
  (data (i32.const 373451) "Si mon esprit peut le concevoir et mon c\c5\93ur le croire, alors je peux le r\c3\a9aliser.") ;; #0937 fr
  (data (i32.const 373534) "La confiance est contagieuse. Le manque de confiance aussi.") ;; #0938 fr
  (data (i32.const 373593) "Nourris ton esprit de grandes pens\c3\a9es, car tu ne t'\c3\a9l\c3\a8veras jamais plus haut que tes pens\c3\a9es.") ;; #0939 fr
  (data (i32.const 373690) "Aie de grandes pens\c3\a9es, mais savoure les petits plaisirs.") ;; #0940 fr
  (data (i32.const 373748) "D\c3\a9fends tes limites, et elles seront \c3\a0 coup s\c3\bbr les tiennes.") ;; #0941 fr
  (data (i32.const 373811) "Le succ\c3\a8s, c'est s'aimer soi-m\c3\aame, aimer ce que l'on fait et aimer la fa\c3\a7on dont on le fait.") ;; #0942 fr
  (data (i32.const 373906) "L'\c3\a2me prend la couleur de ses pens\c3\a9es.") ;; #0943 fr
  (data (i32.const 373946) "Le succ\c3\a8s n'est pas la cl\c3\a9 du bonheur. Le bonheur est la cl\c3\a9 du succ\c3\a8s.") ;; #0944 fr
  (data (i32.const 374021) "La patience, c'est accepter sereinement que les choses puissent arriver dans un autre ordre que celui qu'on avait en t\c3\aate.") ;; #0945 fr
  (data (i32.const 374144) "La patience et la force d'\c3\a2me viennent \c3\a0 bout de tout.") ;; #0946 fr
  (data (i32.const 374200) "Sois patient. Toutes les choses sont difficiles avant de devenir faciles.") ;; #0947 fr
  (data (i32.const 374273) "La patience est une vertu conqu\c3\a9rante.") ;; #0948 fr
  (data (i32.const 374312) "Tout vient \c3\a0 point \c3\a0 qui se d\c3\a9m\c3\a8ne en attendant.") ;; #0949 fr
  (data (i32.const 374364) "Si j'ai fait quelque d\c3\a9couverte de valeur, je la dois plus \c3\a0 une attention patiente qu'\c3\a0 tout autre talent.") ;; #0950 fr
  (data (i32.const 374474) "La patience est n\c3\a9cessaire, et l'on ne peut r\c3\a9colter tout de suite l\c3\a0 o\c3\b9 l'on a sem\c3\a9.") ;; #0951 fr
  (data (i32.const 374564) "Sagement et lentement ; ceux qui courent vite tr\c3\a9buchent.") ;; #0952 fr
  (data (i32.const 374622) "Ceux-l\c3\a0 aussi servent, qui ne font que se tenir debout et attendre.") ;; #0953 fr
  (data (i32.const 374690) "Seul le temps peut gu\c3\a9rir ce que la raison ne peut pas gu\c3\a9rir.") ;; #0954 fr
  (data (i32.const 374754) "La d\c3\a9termination te donne la r\c3\a9solution de continuer malgr\c3\a9 les obstacles qui se dressent devant toi.") ;; #0955 fr
  (data (i32.const 374858) "Ils peuvent vaincre, ceux qui croient pouvoir vaincre.") ;; #0956 fr
  (data (i32.const 374912) "Il n'y a pas de limites. Il y a des paliers, mais il ne faut pas y rester ; il faut aller au-del\c3\a0.") ;; #0957 fr
  (data (i32.const 375011) "Un objectif n'est pas toujours fait pour \c3\aatre atteint ; il sert souvent simplement de point de mire.") ;; #0958 fr
  (data (i32.const 375112) "Je vais utiliser tous mes outils, le talent que Dieu m'a donn\c3\a9, et faire la meilleure vie possible avec.") ;; #0959 fr
  (data (i32.const 375217) "Les champions ne se font pas dans les salles de sport. Ils sont faits de quelque chose de profond\c3\a9ment ancr\c3\a9 en eux : un d\c3\a9sir, un r\c3\aave, une vision.") ;; #0960 fr
  (data (i32.const 375369) "La route du succ\c3\a8s est toujours en travaux.") ;; #0961 fr
  (data (i32.const 375413) "L'ambition, c'est de l'enthousiasme avec un but.") ;; #0962 fr
  (data (i32.const 375461) "Les r\c3\aaves sont les illustrations du livre que ton \c3\a2me \c3\a9crit sur toi.") ;; #0963 fr
  (data (i32.const 375532) "Ne fais pas de petits r\c3\aaves, car ils n'ont pas le pouvoir d'\c3\a9mouvoir le c\c5\93ur des hommes.") ;; #0964 fr
  (data (i32.const 375623) "Un homme n'est pas vieux tant que les regrets n'ont pas pris la place des r\c3\aaves.") ;; #0965 fr
  (data (i32.const 375704) "Dans les r\c3\aaves commence la responsabilit\c3\a9.") ;; #0966 fr
  (data (i32.const 375748) "Marche doucement, car tu marches sur mes r\c3\aaves.") ;; #0967 fr
  (data (i32.const 375796) "Tout ce que nous voyons ou paraissons n'est qu'un r\c3\aave dans un r\c3\aave.") ;; #0968 fr
  (data (i32.const 375866) "N'abandonne pas tes r\c3\aaves, ou tes r\c3\aaves t'abandonneront.") ;; #0969 fr
  (data (i32.const 375924) "Rien ne fait l'avenir comme un r\c3\aave.") ;; #0970 fr
  (data (i32.const 375961) "Le pouvoir de l'imagination nous rend infinis.") ;; #0971 fr
  (data (i32.const 376007) "Tu vois des choses et tu dis : \c2\ab Pourquoi ? \c2\bb Mais moi, je r\c3\aave de choses qui n'ont jamais exist\c3\a9 et je dis : \c2\ab Pourquoi pas ? \c2\bb") ;; #0972 fr
  (data (i32.const 376141) "Accroche ta charrette \c3\a0 une \c3\a9toile.") ;; #0973 fr
  (data (i32.const 376178) "Si l'on avance avec confiance dans la direction de ses r\c3\aaves, on rencontre un succ\c3\a8s inattendu dans les heures ordinaires.") ;; #0974 fr
  (data (i32.const 376302) "Notre vie la plus vraie, c'est quand nous r\c3\aavons \c3\a9veill\c3\a9s.") ;; #0975 fr
  (data (i32.const 376363) "Va aussi loin que tu peux voir ; une fois l\c3\a0-bas, tu pourras voir plus loin.") ;; #0976 fr
  (data (i32.const 376440) "La meilleure fa\c3\a7on de r\c3\a9aliser ses r\c3\aaves, c'est de se r\c3\a9veiller.") ;; #0977 fr
  (data (i32.const 376508) "Celui qui regarde \c3\a0 l'ext\c3\a9rieur r\c3\aave ; celui qui regarde \c3\a0 l'int\c3\a9rieur s'\c3\a9veille.") ;; #0978 fr
  (data (i32.const 376595) "On ne te donne jamais un d\c3\a9sir sans te donner aussi le pouvoir de le r\c3\a9aliser.") ;; #0979 fr
  (data (i32.const 376675) "Une vie sans examen ne vaut pas la peine d'\c3\aatre v\c3\a9cue.") ;; #0980 fr
  (data (i32.const 376731) "La seule vraie sagesse est de savoir que l'on ne sait rien.") ;; #0981 fr
  (data (i32.const 376790) "Sois bienveillant, car chaque personne que tu rencontres m\c3\a8ne un dur combat.") ;; #0982 fr
  (data (i32.const 376867) "Aucun acte de bont\c3\a9, si petit soit-il, n'est jamais perdu.") ;; #0983 fr
  (data (i32.const 376926) "Les plus belles choses du monde ne peuvent \c3\aatre vues ni m\c3\aame touch\c3\a9es. Elles doivent \c3\aatre ressenties avec le c\c5\93ur.") ;; #0984 fr
  (data (i32.const 377045) "Ce dont nous avons joui un jour, nous ne pouvons jamais le perdre. Tout ce que nous aimons profond\c3\a9ment devient une part de nous.") ;; #0985 fr
  (data (i32.const 377175) "Le bonheur n'est pas un but ; c'est une cons\c3\a9quence.") ;; #0986 fr
  (data (i32.const 377228) "Le but de la vie est de la vivre, de go\c3\bbter l'exp\c3\a9rience jusqu'au bout.") ;; #0987 fr
  (data (i32.const 377301) "L'art d'\c3\aatre sage est l'art de savoir ce qu'il faut ignorer.") ;; #0988 fr
  (data (i32.const 377362) "Celui qui apprend sans r\c3\a9fl\c3\a9chir est perdu. Celui qui r\c3\a9fl\c3\a9chit sans apprendre est en grand danger.") ;; #0989 fr
  (data (i32.const 377465) "La meilleure vengeance est de ne pas ressembler \c3\a0 ton ennemi.") ;; #0990 fr
  (data (i32.const 377527) "La perte n'est rien d'autre que le changement, et le changement fait les d\c3\a9lices de la Nature.") ;; #0991 fr
  (data (i32.const 377622) "Attarde-toi sur la beaut\c3\a9 de la vie. Regarde les \c3\a9toiles et vois-toi courir avec elles.") ;; #0992 fr
  (data (i32.const 377711) "Quand tu te l\c3\a8ves le matin, pense au pr\c3\a9cieux privil\c3\a8ge d'\c3\aatre en vie.") ;; #0993 fr
  (data (i32.const 377785) "Ce n'est pas que nous ayons peu de temps \c3\a0 vivre, c'est que nous en perdons beaucoup.") ;; #0994 fr
  (data (i32.const 377871) "Pendant que nous attendons de vivre, la vie passe.") ;; #0995 fr
  (data (i32.const 377921) "Partout o\c3\b9 il y a un \c3\aatre humain, il y a une occasion de faire le bien.") ;; #0996 fr
  (data (i32.const 377994) "Il souffre plus qu'il n'est n\c3\a9cessaire, celui qui souffre avant que ce soit n\c3\a9cessaire.") ;; #0997 fr
  (data (i32.const 378083) "L'ignorance est la cause de la peur.") ;; #0998 fr
  (data (i32.const 378119) "Vivre est la chose la plus rare du monde. La plupart des gens existent, voil\c3\a0 tout.") ;; #0999 fr
  (data (i32.const 378203) "Pardon de t'avoir fait souffrir. Je t'aime.") ;; #1000 fr dedication
  (data (i32.const 378246) "Proverbio giapponese") ;; a0001 it
  (data (i32.const 378266) "Napoleone Bonaparte") ;; a0018 it
  (data (i32.const 378285) "Lucrezio") ;; a0020 it
  (data (i32.const 378293) "Platone") ;; a0070 it
  (data (i32.const 378300) "Proverbio cinese") ;; a0132 it
  (data (i32.const 378316) "Martin Lutero") ;; a0154 it
  (data (i32.const 378329) "Aristotele") ;; a0157 it
  (data (i32.const 378339) "Cicerone") ;; a0158 it
  (data (i32.const 378347) "F\c3\abdor Dostoevskij") ;; a0163 it
  (data (i32.const 378365) "Proverbio inglese") ;; a0167 it
  (data (i32.const 378382) "Plinio il Vecchio") ;; a0174 it
  (data (i32.const 378399) "Salmi") ;; a0176 it
  (data (i32.const 378404) "Tertulliano") ;; a0180 it
  (data (i32.const 378415) "Lev Tolstoj") ;; a0194 it
  (data (i32.const 378426) "San Francesco di Sales") ;; a0207 it
  (data (i32.const 378448) "Epitteto") ;; a0220 it
  (data (i32.const 378456) "Proverbio tanzaniano") ;; a0273 it
  (data (i32.const 378476) "Eraclito") ;; a0274 it
  (data (i32.const 378484) "Orazio") ;; a0282 it
  (data (i32.const 378490) "Proverbio maori") ;; a0283 it
  (data (i32.const 378505) "Hillel il Vecchio") ;; a0315 it
  (data (i32.const 378522) "Papa Giovanni Paolo II") ;; a0325 it
  (data (i32.const 378544) "Proverbio chassidico") ;; a0330 it
  (data (i32.const 378564) "Sant'Agostino") ;; a0349 it
  (data (i32.const 378577) "Marchese di Vauvenargues") ;; a0355 it
  (data (i32.const 378601) "Proverbio olandese") ;; a0356 it
  (data (i32.const 378619) "Proverbio swahili") ;; a0359 it
  (data (i32.const 378636) "Omero") ;; a0361 it
  (data (i32.const 378641) "Proverbio persiano") ;; a0367 it
  (data (i32.const 378659) "Annibale") ;; a0416 it
  (data (i32.const 378667) "Giovanna d'Arco") ;; a0461 it
  (data (i32.const 378682) "Navy SEAL americani") ;; a0471 it
  (data (i32.const 378701) "Non importa quanto vai piano, l'importante \c3\a8 non fermarsi.") ;; #0000 it
  (data (i32.const 378760) "Cadi sette volte, rialzati otto.") ;; #0001 it
  (data (i32.const 378792) "La nostra pi\c3\b9 grande gloria non sta nel non cadere mai, ma nel rialzarci ogni volta che cadiamo.") ;; #0002 it
  (data (i32.const 378889) "L'energia e la perseveranza vincono ogni cosa.") ;; #0003 it
  (data (i32.const 378935) "I fiumi lo sanno: non c'\c3\a8 fretta. Un giorno arriveremo.") ;; #0004 it
  (data (i32.const 378991) "La perseveranza non \c3\a8 una lunga corsa; sono tante corse brevi, una dopo l'altra.") ;; #0005 it
  (data (i32.const 379072) "Il fiume attraversa la roccia non per la sua forza, ma per la sua perseveranza.") ;; #0006 it
  (data (i32.const 379151) "Molti dei fallimenti della vita sono di persone che non si sono rese conto di quanto fossero vicine al successo quando hanno rinunciato.") ;; #0007 it
  (data (i32.const 379287) "Cammino piano, ma non torno mai indietro.") ;; #0008 it
  (data (i32.const 379328) "Le grandi opere non si compiono con la forza, ma con la perseveranza.") ;; #0009 it
  (data (i32.const 379397) "La pazienza e la perseveranza hanno un effetto magico davanti al quale le difficolt\c3\a0 scompaiono e gli ostacoli svaniscono.") ;; #0010 it
  (data (i32.const 379520) "Grazie alla perseveranza, molte persone ottengono il successo da ci\c3\b2 che sembrava destinato a un sicuro fallimento.") ;; #0011 it
  (data (i32.const 379636) "Lo sforzo continuo, non la forza o l'intelligenza, \c3\a8 la chiave per liberare il nostro potenziale.") ;; #0012 it
  (data (i32.const 379734) "L'ambizione \c3\a8 la strada verso il successo. La perseveranza \c3\a8 il mezzo con cui ci arrivi.") ;; #0013 it
  (data (i32.const 379824) "La differenza tra una persona di successo e le altre non \c3\a8 la mancanza di forza o di conoscenza, ma la mancanza di volont\c3\a0.") ;; #0014 it
  (data (i32.const 379949) "Il successo \c3\a8 la somma di piccoli sforzi, ripetuti giorno dopo giorno.") ;; #0015 it
  (data (i32.const 380020) "Sembra sempre impossibile, finch\c3\a9 non viene fatto.") ;; #0016 it
  (data (i32.const 380071) "Niente al mondo pu\c3\b2 sostituire la perseveranza.") ;; #0017 it
  (data (i32.const 380119) "La vittoria appartiene ai pi\c3\b9 perseveranti.") ;; #0018 it
  (data (i32.const 380163) "Con un talento ordinario e una perseveranza straordinaria, tutto \c3\a8 possibile.") ;; #0019 it
  (data (i32.const 380241) "Le gocce di pioggia scavano la pietra non con la violenza, ma cadendo di continuo.") ;; #0020 it
  (data (i32.const 380323) "La maggior parte delle cose importanti al mondo \c3\a8 stata realizzata da persone che hanno continuato a provarci quando sembrava non esserci pi\c3\b9 alcuna speranza.") ;; #0021 it
  (data (i32.const 380483) "Costanza, perseveranza e tenacia nonostante tutti gli ostacoli, gli scoraggiamenti e le impossibilit\c3\a0: \c3\a8 questo che, in ogni cosa, distingue l'anima forte da quella debole.") ;; #0022 it
  (data (i32.const 380657) "Non arrenderti mai, perch\c3\a9 \c3\a8 proprio quello il luogo e il momento in cui la marea cambier\c3\a0.") ;; #0023 it
  (data (i32.const 380751) "La perseveranza pu\c3\b2 trasformare il fallimento in un risultato straordinario.") ;; #0024 it
  (data (i32.const 380828) "Vince chi resiste.") ;; #0025 it
  (data (i32.const 380846) "L'acqua \c3\a8 fluida, morbida e cedevole. Ma l'acqua consuma la roccia, che \c3\a8 rigida e non pu\c3\b2 cedere.") ;; #0026 it
  (data (i32.const 380947) "Paralizza la resistenza con la perseveranza.") ;; #0027 it
  (data (i32.const 380991) "Lo sforzo d\c3\a0 tutta la sua ricompensa solo quando una persona si rifiuta di mollare.") ;; #0028 it
  (data (i32.const 381075) "Pazienza, perseveranza e sudore formano una combinazione imbattibile per il successo.") ;; #0029 it
  (data (i32.const 381160) "Un campione \c3\a8 uno che si rialza quando non ce la fa pi\c3\b9.") ;; #0030 it
  (data (i32.const 381218) "Non arrendetevi mai. Mai, mai, mai, mai.") ;; #0031 it
  (data (i32.const 381258) "Il successo sembra legato all'azione. Le persone di successo non smettono mai di muoversi.") ;; #0032 it
  (data (i32.const 381348) "Ogni colpo mancato mi avvicina al prossimo fuoricampo.") ;; #0033 it
  (data (i32.const 381402) "Semplicemente non puoi battere chi non si arrende mai.") ;; #0034 it
  (data (i32.const 381456) "Non guardare l'orologio; fai come lui. Vai avanti.") ;; #0035 it
  (data (i32.const 381506) "Ci\c3\b2 che speriamo un giorno di fare con facilit\c3\a0, dobbiamo prima imparare a farlo con impegno.") ;; #0036 it
  (data (i32.const 381601) "Nello scontro tra il ruscello e la roccia, il ruscello vince sempre, non con la forza, ma con la perseveranza.") ;; #0037 it
  (data (i32.const 381711) "Resistere non \c3\a8 solo la capacit\c3\a0 di sopportare una cosa difficile, ma di trasformarla in gloria.") ;; #0038 it
  (data (i32.const 381809) "Perseveranza, segreto di tutti i trionfi.") ;; #0039 it
  (data (i32.const 381850) "La strada verso il successo \c3\a8 piena di invitanti parcheggi.") ;; #0040 it
  (data (i32.const 381910) "Se ieri sei caduto, rialzati oggi.") ;; #0041 it
  (data (i32.const 381944) "Persister\c3\b2 finch\c3\a9 non avr\c3\b2 successo.") ;; #0042 it
  (data (i32.const 381983) "Si pu\c3\b2 attraversare la montagna pi\c3\b9 alta, un passo alla volta.") ;; #0043 it
  (data (i32.const 382047) "I diamanti non sono altro che pezzi di carbone che non hanno mollato il loro lavoro.") ;; #0044 it
  (data (i32.const 382131) "Le grandi cose non si fanno d'impulso, ma con una serie di piccole cose messe insieme.") ;; #0045 it
  (data (i32.const 382217) "Il genio \c3\a8 per l'uno per cento ispirazione e per il novantanove per cento traspirazione.") ;; #0046 it
  (data (i32.const 382306) "Pi\c3\b9 duro \c3\a8 il conflitto, pi\c3\b9 glorioso \c3\a8 il trionfo.") ;; #0047 it
  (data (i32.const 382361) "La perseveranza garantisce che i risultati siano inevitabili.") ;; #0048 it
  (data (i32.const 382422) "Il coraggio non sempre ruggisce. A volte il coraggio \c3\a8 la voce sommessa alla fine della giornata che dice: domani ci riprovo.") ;; #0049 it
  (data (i32.const 382548) "Ho imparato che il coraggio non \c3\a8 l'assenza di paura, ma il trionfo su di essa.") ;; #0050 it
  (data (i32.const 382628) "Acquisti forza, coraggio e fiducia da ogni esperienza in cui ti fermi davvero a guardare la paura in faccia.") ;; #0051 it
  (data (i32.const 382736) "Il coraggio \c3\a8 resistenza alla paura, dominio della paura, non assenza di paura.") ;; #0052 it
  (data (i32.const 382816) "La vita si restringe o si espande in proporzione al proprio coraggio.") ;; #0053 it
  (data (i32.const 382885) "Ci vuole coraggio per crescere e diventare chi sei davvero.") ;; #0054 it
  (data (i32.const 382944) "Il coraggio \c3\a8 giustamente considerato la prima delle qualit\c3\a0 umane, perch\c3\a9 \c3\a8 la qualit\c3\a0 che garantisce tutte le altre.") ;; #0055 it
  (data (i32.const 383067) "L'uomo coraggioso non \c3\a8 colui che non ha paura, ma colui che vince quella paura.") ;; #0056 it
  (data (i32.const 383148) "Abbiate il coraggio di seguire il vostro cuore e il vostro intuito.") ;; #0057 it
  (data (i32.const 383215) "Essere profondamente amati da qualcuno ci d\c3\a0 forza, mentre amare qualcuno profondamente ci d\c3\a0 coraggio.") ;; #0058 it
  (data (i32.const 383320) "Il coraggio \c3\a8 grazia sotto pressione.") ;; #0059 it
  (data (i32.const 383358) "Chi non ha il coraggio di rischiare non realizzer\c3\a0 nulla nella vita.") ;; #0060 it
  (data (i32.const 383427) "Solo chi rischia di spingersi troppo oltre pu\c3\b2 scoprire fin dove \c3\a8 possibile arrivare.") ;; #0061 it
  (data (i32.const 383515) "La fortuna aiuta gli audaci.") ;; #0062 it
  (data (i32.const 383543) "Il coraggio si trova nei luoghi pi\c3\b9 impensati.") ;; #0063 it
  (data (i32.const 383590) "Anche la persona pi\c3\b9 piccola pu\c3\b2 cambiare il corso del futuro.") ;; #0064 it
  (data (i32.const 383654) "Tutto ci\c3\b2 che dobbiamo decidere \c3\a8 cosa fare con il tempo che ci viene dato.") ;; #0065 it
  (data (i32.const 383731) "Ci vuole molto coraggio per opporsi ai propri nemici, ma altrettanto per opporsi ai propri amici.") ;; #0066 it
  (data (i32.const 383828) "Fai ci\c3\b2 che temi, e la morte della paura \c3\a8 certa.") ;; #0067 it
  (data (i32.const 383879) "La paura \c3\a8 profonda solo quanto la mente le permette di esserlo.") ;; #0068 it
  (data (i32.const 383944) "Tutto ci\c3\b2 che hai sempre desiderato si trova dall'altra parte della paura.") ;; #0069 it
  (data (i32.const 384019) "L'inazione genera dubbio e paura. L'azione genera fiducia e coraggio.") ;; #0070 it
  (data (i32.const 384088) "Il coraggio \c3\a8 essere morti di paura, e montare in sella lo stesso.") ;; #0071 it
  (data (i32.const 384155) "Non ho paura delle tempeste, perch\c3\a9 sto imparando a guidare la mia nave.") ;; #0072 it
  (data (i32.const 384228) "Una nave in porto \c3\a8 al sicuro, ma non \c3\a8 per questo che le navi sono state costruite.") ;; #0073 it
  (data (i32.const 384314) "La caverna in cui hai paura di entrare custodisce il tesoro che cerchi.") ;; #0074 it
  (data (i32.const 384385) "Il coraggio \c3\a8 contagioso. Quando un uomo coraggioso prende posizione, spesso anche gli altri raddrizzano la schiena.") ;; #0075 it
  (data (i32.const 384502) "Nella vita non c'\c3\a8 nulla da temere, solo da capire.") ;; #0076 it
  (data (i32.const 384554) "Il coraggio \c3\a8 la capacit\c3\a0 di agire nel modo giusto anche quando si \c3\a8 morti di paura.") ;; #0077 it
  (data (i32.const 384641) "Con il coraggio oserai correre rischi, avrai la forza di essere compassionevole e la saggezza di essere umile.") ;; #0078 it
  (data (i32.const 384751) "Non si nasce necessariamente coraggiosi, ma si nasce con un potenziale.") ;; #0079 it
  (data (i32.const 384822) "Il coraggio \c3\a8 la pi\c3\b9 importante di tutte le virt\c3\b9, perch\c3\a9 senza coraggio non si pu\c3\b2 praticare con costanza nessun'altra virt\c3\b9.") ;; #0080 it
  (data (i32.const 384954) "La libert\c3\a0 sta nell'essere audaci.") ;; #0081 it
  (data (i32.const 384989) "L'unica cosa di cui dobbiamo avere paura \c3\a8 la paura stessa.") ;; #0082 it
  (data (i32.const 385049) "Il coraggio \c3\a8 sapere che cosa non temere.") ;; #0083 it
  (data (i32.const 385091) "Senti la paura e fallo comunque.") ;; #0084 it
  (data (i32.const 385123) "Sii audace, e forze potenti verranno in tuo aiuto.") ;; #0085 it
  (data (i32.const 385173) "Non c'\c3\a8 passione nel giocare in piccolo.") ;; #0086 it
  (data (i32.const 385214) "Il coraggio \c3\a8 come un muscolo: si rafforza con l'uso.") ;; #0087 it
  (data (i32.const 385268) "La vulnerabilit\c3\a0 \c3\a8 la culla dell'innovazione, della creativit\c3\a0 e del cambiamento.") ;; #0088 it
  (data (i32.const 385352) "Il coraggio comincia quando ci presentiamo e ci lasciamo vedere.") ;; #0089 it
  (data (i32.const 385416) "Non aver paura di rinunciare al buono per puntare all'eccellente.") ;; #0090 it
  (data (i32.const 385481) "Osare \c3\a8 perdere l'equilibrio per un momento. Non osare \c3\a8 perdere s\c3\a9 stessi.") ;; #0091 it
  (data (i32.const 385559) "Non \c3\a8 la montagna che conquistiamo, ma noi stessi.") ;; #0092 it
  (data (i32.const 385610) "Salta, e la rete apparir\c3\a0.") ;; #0093 it
  (data (i32.const 385637) "La sicurezza \c3\a8 per lo pi\c3\b9 una superstizione. La vita o \c3\a8 un'avventura audace, o non \c3\a8 niente.") ;; #0094 it
  (data (i32.const 385734) "Cosa sarebbe la vita se non avessimo il coraggio di tentare qualcosa?") ;; #0095 it
  (data (i32.const 385803) "\c3\88 di gran lunga meglio osare cose grandi e ottenere trionfi gloriosi, anche se segnati dal fallimento, che schierarsi con quei poveri spiriti che non godono molto n\c3\a9 soffrono molto.") ;; #0096 it
  (data (i32.const 385986) "Non \c3\a8 il critico che conta.") ;; #0097 it
  (data (i32.const 386014) "Il merito appartiene a chi si trova davvero nell'arena.") ;; #0098 it
  (data (i32.const 386069) "La paura ha due significati: fuggire da tutto, oppure affrontare tutto e rialzarsi.") ;; #0099 it
  (data (i32.const 386152) "La paura \c3\a8 ci\c3\b2 che senti. Il coraggio \c3\a8 ci\c3\b2 che fai.") ;; #0100 it
  (data (i32.const 386208) "Il coraggio \c3\a8 ritenuto la pi\c3\b9 grande di tutte le virt\c3\b9, perch\c3\a9 senza di esso l'uomo non ha alcuna garanzia di conservare le altre.") ;; #0101 it
  (data (i32.const 386342) "Il coraggio \c3\a8 la scala su cui salgono tutte le altre virt\c3\b9.") ;; #0102 it
  (data (i32.const 386403) "Il coraggio non \c3\a8 semplicemente una delle virt\c3\b9, ma la forma di ogni virt\c3\b9 nel momento della prova.") ;; #0103 it
  (data (i32.const 386505) "Coraggio, caro cuore.") ;; #0104 it
  (data (i32.const 386526) "Il coraggio \c3\a8 la forza di lasciar andare ci\c3\b2 che \c3\a8 familiare.") ;; #0105 it
  (data (i32.const 386590) "Non ho fallito. Ho solo trovato 10.000 modi che non funzionano.") ;; #0106 it
  (data (i32.const 386653) "Il fallimento \c3\a8 solo l'opportunit\c3\a0 di ricominciare, questa volta in modo pi\c3\b9 intelligente.") ;; #0107 it
  (data (i32.const 386746) "Hai provato. Hai fallito. Non importa. Prova ancora. Fallisci ancora. Fallisci meglio.") ;; #0108 it
  (data (i32.const 386832) "Ho fallito ancora e ancora e ancora nella mia vita. Ed \c3\a8 per questo che ho successo.") ;; #0109 it
  (data (i32.const 386917) "Solo chi osa fallire in grande pu\c3\b2 ottenere grandi risultati.") ;; #0110 it
  (data (i32.const 386979) "Il fallimento \c3\a8 il condimento che d\c3\a0 sapore al successo.") ;; #0111 it
  (data (i32.const 387037) "\c3\88 impossibile vivere senza fallire in qualcosa, a meno di vivere con tanta cautela da non aver vissuto affatto.") ;; #0112 it
  (data (i32.const 387149) "Toccare il fondo \c3\a8 diventato la base solida su cui ho ricostruito la mia vita.") ;; #0113 it
  (data (i32.const 387228) "Non giudicatemi dai miei successi, giudicatemi da quante volte sono caduto e mi sono rialzato.") ;; #0114 it
  (data (i32.const 387322) "Il fallimento dovrebbe essere il nostro maestro, non il nostro becchino.") ;; #0115 it
  (data (i32.const 387394) "C'\c3\a8 una sola cosa che rende impossibile realizzare un sogno: la paura di fallire.") ;; #0116 it
  (data (i32.const 387476) "Il fallimento non \c3\a8 il contrario del successo; ne fa parte.") ;; #0117 it
  (data (i32.const 387536) "Si costruisce sul fallimento. Lo si usa come trampolino.") ;; #0118 it
  (data (i32.const 387592) "Un uomo di genio non commette errori. I suoi errori sono volontari e sono i portali della scoperta.") ;; #0119 it
  (data (i32.const 387691) "Arrendersi \c3\a8 l'unico modo sicuro per fallire.") ;; #0120 it
  (data (i32.const 387737) "Ogni fallimento \c3\a8 un passo verso il successo.") ;; #0121 it
  (data (i32.const 387783) "La sconfitta non \c3\a8 il peggiore dei fallimenti. Non averci provato \c3\a8 il vero fallimento.") ;; #0122 it
  (data (i32.const 387872) "I fallimenti sono cartelli indicatori sulla strada della riuscita.") ;; #0123 it
  (data (i32.const 387938) "La fenice deve bruciare per rinascere.") ;; #0124 it
  (data (i32.const 387976) "Siamo tutti dei falliti, almeno i migliori di noi.") ;; #0125 it
  (data (i32.const 388026) "Posso accettare il fallimento, tutti falliscono in qualcosa. Ma non posso accettare di non provarci.") ;; #0126 it
  (data (i32.const 388126) "Il successo non si costruisce sul successo. Si costruisce sul fallimento. Si costruisce sulla frustrazione.") ;; #0127 it
  (data (i32.const 388233) "I vincenti non hanno paura di perdere. I perdenti s\c3\ac. Il fallimento fa parte del percorso verso il successo.") ;; #0128 it
  (data (i32.const 388342) "Un inventore fallisce 999 volte, e se ci riesce una volta sola, ce l'ha fatta.") ;; #0129 it
  (data (i32.const 388420) "Nota che l'albero pi\c3\b9 rigido \c3\a8 quello che si spezza pi\c3\b9 facilmente, mentre il bamb\c3\b9 o il salice sopravvivono piegandosi al vento.") ;; #0130 it
  (data (i32.const 388553) "Non temere il fallimento. Il crimine non \c3\a8 fallire, ma mirare in basso.") ;; #0131 it
  (data (i32.const 388625) "Il fallimento \c3\a8 istruttivo. Chi pensa davvero impara tanto dai suoi fallimenti quanto dai suoi successi.") ;; #0132 it
  (data (i32.const 388730) "La nostra pi\c3\b9 grande debolezza sta nell'arrenderci. Il modo pi\c3\b9 sicuro per riuscire \c3\a8 provarci sempre ancora una volta.") ;; #0133 it
  (data (i32.const 388852) "Le persone buone sono buone perch\c3\a9 sono arrivate alla saggezza attraverso il fallimento.") ;; #0134 it
  (data (i32.const 388941) "L'errore pi\c3\b9 grande che si possa fare nella vita \c3\a8 temere continuamente di farne uno.") ;; #0135 it
  (data (i32.const 389028) "Se non sei disposto a sbagliare, non creerai mai nulla di originale.") ;; #0136 it
  (data (i32.const 389096) "L'esperienza \c3\a8 semplicemente il nome che diamo ai nostri errori.") ;; #0137 it
  (data (i32.const 389161) "Quando ci diamo il permesso di fallire, allo stesso tempo ci diamo il permesso di eccellere.") ;; #0138 it
  (data (i32.const 389253) "L'unico vero errore \c3\a8 quello da cui non impariamo nulla.") ;; #0139 it
  (data (i32.const 389310) "Solo perch\c3\a9 hai fallito una volta non significa che fallirai in tutto.") ;; #0140 it
  (data (i32.const 389381) "Preferisco fallire in qualcosa che amo piuttosto che avere successo in qualcosa che odio.") ;; #0141 it
  (data (i32.const 389470) "Non c'\c3\a8 fallimento, se non quando si smette di provare.") ;; #0142 it
  (data (i32.const 389526) "Il fallimento non mi raggiunger\c3\a0 mai, se la mia determinazione a riuscire \c3\a8 abbastanza forte.") ;; #0143 it
  (data (i32.const 389621) "A volte bisogna combattere una battaglia pi\c3\b9 di una volta per vincerla.") ;; #0144 it
  (data (i32.const 389693) "Il fallimento non \c3\a8 fatale, ma non cambiare potrebbe esserlo.") ;; #0145 it
  (data (i32.const 389755) "Se impari dalla sconfitta, non hai davvero perso.") ;; #0146 it
  (data (i32.const 389804) "Il maestro ha fallito pi\c3\b9 volte di quante il principiante abbia mai provato.") ;; #0147 it
  (data (i32.const 389881) "\c3\88 bello festeggiare il successo, ma \c3\a8 pi\c3\b9 importante ascoltare le lezioni del fallimento.") ;; #0148 it
  (data (i32.const 389973) "Si avanza verso il successo fallendo.") ;; #0149 it
  (data (i32.const 390010) "Il fallimento \c3\a8 la chiave del successo; ogni errore ci insegna qualcosa.") ;; #0150 it
  (data (i32.const 390083) "Sulla strada del successo si passa sempre dal fallimento.") ;; #0151 it
  (data (i32.const 390140) "Il fallimento non \c3\a8 importante. Ci vuole coraggio per rendersi ridicoli.") ;; #0152 it
  (data (i32.const 390213) "Che cos'\c3\a8 la sconfitta? Nient'altro che un insegnamento; nient'altro che il primo passo verso qualcosa di meglio.") ;; #0153 it
  (data (i32.const 390327) "Non confondere mai una singola sconfitta con la sconfitta definitiva.") ;; #0154 it
  (data (i32.const 390396) "Non vergognarti dei tuoi fallimenti; impara da essi e ricomincia.") ;; #0155 it
  (data (i32.const 390461) "Dalla sofferenza sono emerse le anime pi\c3\b9 forti; i caratteri pi\c3\b9 saldi sono segnati da cicatrici.") ;; #0156 it
  (data (i32.const 390560) "La quercia lott\c3\b2 contro il vento e si spezz\c3\b2; il salice si pieg\c3\b2 quando fu necessario e sopravvisse.") ;; #0157 it
  (data (i32.const 390663) "Sebbene il mondo sia pieno di sofferenza, \c3\a8 anche pieno del suo superamento.") ;; #0158 it
  (data (i32.const 390740) "Il carattere non si forma nella facilit\c3\a0 e nella quiete. Solo attraverso la prova e la sofferenza l'anima si rafforza, l'ambizione si ispira e il successo si raggiunge.") ;; #0159 it
  (data (i32.const 390909) "La vita non diventa pi\c3\b9 facile n\c3\a9 pi\c3\b9 indulgente; siamo noi a diventare pi\c3\b9 forti e pi\c3\b9 resilienti.") ;; #0160 it
  (data (i32.const 391013) "Non pregare per una vita facile; prega per avere la forza di sopportarne una difficile.") ;; #0161 it
  (data (i32.const 391100) "La capacit\c3\a0 umana di sopportare i pesi \c3\a8 come il bamb\c3\b9: molto pi\c3\b9 flessibile di quanto si creda a prima vista.") ;; #0162 it
  (data (i32.const 391214) "Ci\c3\b2 che mi accade pu\c3\b2 cambiarmi. Ma mi rifiuto di esserne sminuita.") ;; #0163 it
  (data (i32.const 391283) "Potrai incontrare molte sconfitte, ma non devi lasciarti sconfiggere.") ;; #0164 it
  (data (i32.const 391352) "Eppure, come l'aria, io mi sollevo.") ;; #0165 it
  (data (i32.const 391387) "Rimase in piedi nella tempesta e, quando il vento non soffi\c3\b2 a suo favore, regol\c3\b2 le vele.") ;; #0166 it
  (data (i32.const 391479) "I tempi duri non durano, le persone forti s\c3\ac.") ;; #0167 it
  (data (i32.const 391525) "Dove non c'\c3\a8 lotta, non c'\c3\a8 forza.") ;; #0168 it
  (data (i32.const 391561) "Trasforma le tue ferite in saggezza.") ;; #0169 it
  (data (i32.const 391597) "Quando tutto sembra andare contro di te, ricorda che l'aereo decolla controvento, non con il vento a favore.") ;; #0170 it
  (data (i32.const 391705) "Dalle difficolt\c3\a0 nascono i miracoli.") ;; #0171 it
  (data (i32.const 391742) "La gemma non si pu\c3\b2 lucidare senza attrito, n\c3\a9 l'uomo perfezionare senza prove.") ;; #0172 it
  (data (i32.const 391823) "Mare calmo non fa buon marinaio.") ;; #0173 it
  (data (i32.const 391855) "Le mie cicatrici mi ricordano che sono davvero sopravvissuto alle mie ferite pi\c3\b9 profonde.") ;; #0174 it
  (data (i32.const 391946) "La forza non viene dalla capacit\c3\a0 fisica. Viene da una volont\c3\a0 indomabile.") ;; #0175 it
  (data (i32.const 392022) "Il mondo spezza tutti, e poi molti diventano forti proprio nei punti spezzati.") ;; #0176 it
  (data (i32.const 392100) "Ci\c3\b2 che non mi uccide mi rende pi\c3\b9 forte.") ;; #0177 it
  (data (i32.const 392143) "Chi ha un perch\c3\a9 per vivere pu\c3\b2 sopportare quasi ogni come.") ;; #0178 it
  (data (i32.const 392204) "Quando non siamo pi\c3\b9 in grado di cambiare una situazione, siamo chiamati a cambiare noi stessi.") ;; #0179 it
  (data (i32.const 392300) "All'uomo si pu\c3\b2 togliere tutto tranne una cosa: l'ultima delle libert\c3\a0 umane, scegliere il proprio atteggiamento in qualsiasi circostanza.") ;; #0180 it
  (data (i32.const 392440) "Il bamb\c3\b9 che si piega \c3\a8 pi\c3\b9 forte della quercia che resiste.") ;; #0181 it
  (data (i32.const 392503) "Le difficolt\c3\a0 spesso preparano persone comuni a un destino straordinario.") ;; #0182 it
  (data (i32.const 392577) "Le nostre ferite sono spesso le aperture verso la parte migliore e pi\c3\b9 bella di noi.") ;; #0183 it
  (data (i32.const 392662) "La resilienza \c3\a8 accettare la propria nuova realt\c3\a0, anche se \c3\a8 meno bella di quella che si aveva prima.") ;; #0184 it
  (data (i32.const 392767) "L'uomo non ha mai creato un materiale resiliente quanto lo spirito umano.") ;; #0185 it
  (data (i32.const 392840) "Il dolore e la resilienza convivono.") ;; #0186 it
  (data (i32.const 392876) "Non conta se vieni messo a terra; conta se ti rialzi.") ;; #0187 it
  (data (i32.const 392929) "Non conta quanto colpisci forte. Conta quanto riesci a incassare e continuare ad andare avanti.") ;; #0188 it
  (data (i32.const 393024) "Buona parte dell'arte di vivere \c3\a8 la resilienza.") ;; #0189 it
  (data (i32.const 393073) "Niente \c3\a8 impossibile. La parola stessa, in inglese, lo dice: \22I'm possible\22, sono possibile!") ;; #0190 it
  (data (i32.const 393166) "Le stelle non possono brillare senza oscurit\c3\a0.") ;; #0191 it
  (data (i32.const 393213) "La ferita \c3\a8 il punto da cui la Luce entra in te.") ;; #0192 it
  (data (i32.const 393262) "Quando \c3\a8 abbastanza buio, si vedono le stelle.") ;; #0193 it
  (data (i32.const 393309) "Il fuoco \c3\a8 la prova dell'oro; l'avversit\c3\a0, degli uomini forti.") ;; #0194 it
  (data (i32.const 393373) "Le difficolt\c3\a0 rafforzano la mente, come la fatica rafforza il corpo.") ;; #0195 it
  (data (i32.const 393442) "Anche se nessuno pu\c3\b2 tornare indietro e ricominciare da capo, chiunque pu\c3\b2 cominciare da adesso e scrivere un nuovo finale.") ;; #0196 it
  (data (i32.const 393567) "Sono stata assolutamente terrorizzata in ogni momento della mia vita, e non ho mai lasciato che questo mi impedisse di fare una sola cosa che volessi fare.") ;; #0197 it
  (data (i32.const 393722) "Il dolore \c3\a8 il modo in cui impariamo ad amare. Il tuo cuore non si sta spezzando. Fa male perch\c3\a9 sta diventando pi\c3\b9 grande.") ;; #0198 it
  (data (i32.const 393848) "Quando scegli la speranza, tutto \c3\a8 possibile.") ;; #0199 it
  (data (i32.const 393894) "Non lasciare che ci\c3\b2 che non puoi fare interferisca con ci\c3\b2 che puoi fare.") ;; #0200 it
  (data (i32.const 393970) "La via d'uscita migliore \c3\a8 sempre attraversare.") ;; #0201 it
  (data (i32.const 394018) "In due parole posso riassumere tutto ci\c3\b2 che ho imparato sulla vita: va avanti.") ;; #0202 it
  (data (i32.const 394098) "La vitalit\c3\a0 si manifesta non solo nella capacit\c3\a0 di perseverare, ma in quella di ricominciare.") ;; #0203 it
  (data (i32.const 394194) "Ma l'uomo non \c3\a8 fatto per la sconfitta. Un uomo pu\c3\b2 essere distrutto, ma non sconfitto.") ;; #0204 it
  (data (i32.const 394283) "La vita non \c3\a8 sempre questione di avere buone carte, ma a volte di giocare bene una mano cattiva.") ;; #0205 it
  (data (i32.const 394381) "La speranza \c3\a8 quella cosa piumata che si posa sull'anima.") ;; #0206 it
  (data (i32.const 394439) "Tutto ci\c3\b2 che si fa nel mondo si fa con la speranza.") ;; #0207 it
  (data (i32.const 394492) "La speranza \c3\a8 riuscire a vedere che c'\c3\a8 luce nonostante tutta l'oscurit\c3\a0.") ;; #0208 it
  (data (i32.const 394568) "Dobbiamo accettare la delusione finita, ma non perdere mai la speranza infinita.") ;; #0209 it
  (data (i32.const 394648) "Solo nell'oscurit\c3\a0 si possono vedere le stelle.") ;; #0210 it
  (data (i32.const 394696) "Anche la notte pi\c3\b9 buia finir\c3\a0, e sorger\c3\a0 il sole.") ;; #0211 it
  (data (i32.const 394749) "L'ottimismo \c3\a8 la fede che conduce alla realizzazione. Nulla si pu\c3\b2 fare senza speranza e fiducia.") ;; #0212 it
  (data (i32.const 394848) "Tieni gli occhi sulle stelle e i piedi per terra.") ;; #0213 it
  (data (i32.const 394897) "La speranza \c3\a8 un sogno a occhi aperti.") ;; #0214 it
  (data (i32.const 394936) "Finch\c3\a9 c'\c3\a8 vita, c'\c3\a8 speranza.") ;; #0215 it
  (data (i32.const 394969) "C'\c3\a8 del buono in questo mondo, ed \c3\a8 giusto combattere per questo.") ;; #0216 it
  (data (i32.const 395036) "La speranza \c3\a8 una cosa buona, forse la migliore delle cose, e le cose buone non muoiono mai.") ;; #0217 it
  (data (i32.const 395129) "L'ora pi\c3\b9 buia dura soltanto sessanta minuti.") ;; #0218 it
  (data (i32.const 395175) "Non perdere mai la speranza. Le tempeste rendono le persone pi\c3\b9 forti e non durano per sempre.") ;; #0219 it
  (data (i32.const 395270) "La speranza sorride dalla soglia dell'anno che verr\c3\a0, sussurrando: \22sar\c3\a0 pi\c3\b9 felice\22.") ;; #0220 it
  (data (i32.const 395358) "Vivere senza speranza \c3\a8 smettere di vivere.") ;; #0221 it
  (data (i32.const 395402) "In ogni cosa, \c3\a8 meglio sperare che disperare.") ;; #0222 it
  (data (i32.const 395448) "La speranza \c3\a8 importante perch\c3\a9 pu\c3\b2 rendere il momento presente meno difficile da sopportare.") ;; #0223 it
  (data (i32.const 395544) "Per quanto lungo sia l'inverno, la primavera arriva sempre.") ;; #0224 it
  (data (i32.const 395603) "Non tutto il male vien per nuocere.") ;; #0225 it
  (data (i32.const 395638) "Il sole stesso \c3\a8 debole quando sorge, e acquista forza e coraggio man mano che il giorno avanza.") ;; #0226 it
  (data (i32.const 395735) "La speranza \c3\a8 l'unica cosa pi\c3\b9 forte della paura.") ;; #0227 it
  (data (i32.const 395786) "La felicit\c3\a0 si pu\c3\b2 trovare anche nei momenti pi\c3\b9 bui, se solo ci si ricorda di accendere la luce.") ;; #0228 it
  (data (i32.const 395886) "La speranza comincia nel buio: la speranza ostinata che, se ti presenti e provi a fare la cosa giusta, l'alba arriver\c3\a0.") ;; #0229 it
  (data (i32.const 396006) "Lascia che siano le tue speranze, e non le tue ferite, a dare forma al tuo futuro.") ;; #0230 it
  (data (i32.const 396088) "La speranza \c3\a8 rinnovabile: se finisce alla fine della giornata, puoi ricominciare la mattina.") ;; #0231 it
  (data (i32.const 396182) "Ci\c3\b2 che l'ossigeno \c3\a8 per i polmoni, la speranza lo \c3\a8 per il senso della vita.") ;; #0232 it
  (data (i32.const 396262) "Il minimo che puoi fare nella vita \c3\a8 capire che cosa speri.") ;; #0233 it
  (data (i32.const 396322) "Non c'\c3\a8 medicina come la speranza, n\c3\a9 incentivo cos\c3\ac grande, n\c3\a9 tonico cos\c3\ac potente come l'attesa di qualcosa di meglio domani.") ;; #0234 it
  (data (i32.const 396454) "La speranza \c3\a8 il pilastro che regge il mondo.") ;; #0235 it
  (data (i32.const 396500) "La speranza non tacer\c3\a0 mai.") ;; #0236 it
  (data (i32.const 396528) "Alla sera sopraggiunge il pianto e al mattino la gioia.") ;; #0237 it
  (data (i32.const 396583) "Invecchia con me! Il meglio deve ancora venire.") ;; #0238 it
  (data (i32.const 396630) "Non \c3\a8 bello pensare che domani \c3\a8 un giorno nuovo, ancora senza errori?") ;; #0239 it
  (data (i32.const 396702) "Dopotutto, domani \c3\a8 un altro giorno.") ;; #0240 it
  (data (i32.const 396739) "La speranza \c3\a8 pazienza con la lampada accesa.") ;; #0241 it
  (data (i32.const 396785) "Sono preparato al peggio, ma spero nel meglio.") ;; #0242 it
  (data (i32.const 396831) "Non dobbiamo mai disperare, perch\c3\a9 non possiamo mai essere spezzati senza rimedio.") ;; #0243 it
  (data (i32.const 396914) "Non piangeremo, ma troveremo forza in ci\c3\b2 che resta.") ;; #0244 it
  (data (i32.const 396967) "Sii come l'uccello che, posandosi su un ramo troppo esile, lo sente cedere sotto di s\c3\a9 e tuttavia canta, sapendo di avere le ali.") ;; #0245 it
  (data (i32.const 397097) "Finch\c3\a9 respiro, spero.") ;; #0246 it
  (data (i32.const 397120) "Non tutti i giorni sono buoni, ma c'\c3\a8 qualcosa di buono in ogni giorno.") ;; #0247 it
  (data (i32.const 397192) "Nel profondo dell'inverno ho finalmente imparato che dentro di me c'era un'invincibile estate.") ;; #0248 it
  (data (i32.const 397286) "\c3\88 nei nostri momenti pi\c3\b9 bui che dobbiamo concentrarci per vedere la luce.") ;; #0249 it
  (data (i32.const 397362) "Il mondo \c3\a8 rotondo, e il luogo che pu\c3\b2 sembrare la fine potrebbe essere solo l'inizio.") ;; #0250 it
  (data (i32.const 397450) "La fede \c3\a8 l'uccello che sente la luce e canta quando l'alba \c3\a8 ancora buia.") ;; #0251 it
  (data (i32.const 397526) "Per quanto lunga sia la notte, il giorno sorger\c3\a0.") ;; #0252 it
  (data (i32.const 397576) "Tieniti stretto il cappello. Tieniti stretta la speranza. E carica l'orologio, perch\c3\a9 domani \c3\a8 un altro giorno.") ;; #0253 it
  (data (i32.const 397689) "Ci aspettano cose molto, molto migliori di quelle che ci lasciamo alle spalle.") ;; #0254 it
  (data (i32.const 397767) "Nonostante tutto, credo ancora che le persone siano buone di cuore.") ;; #0255 it
  (data (i32.const 397834) "Pensa a tutta la bellezza che ancora ti circonda e sii felice.") ;; #0256 it
  (data (i32.const 397896) "Spesso \c3\a8 nei cieli pi\c3\b9 bui che vediamo le stelle pi\c3\b9 luminose.") ;; #0257 it
  (data (i32.const 397961) "La forza e la crescita arrivano solo con lo sforzo e la lotta continui.") ;; #0258 it
  (data (i32.const 398032) "Dalle tue vulnerabilit\c3\a0 nascer\c3\a0 la tua forza.") ;; #0259 it
  (data (i32.const 398079) "Una donna \c3\a8 come una bustina di t\c3\a8: non sai quanto \c3\a8 forte finch\c3\a9 non la metti nell'acqua calda.") ;; #0260 it
  (data (i32.const 398179) "La forza \c3\a8 il frutto della lotta. Devi fare ci\c3\b2 che gli altri non fanno per ottenere ci\c3\b2 che gli altri non ottengono.") ;; #0261 it
  (data (i32.const 398299) "I pi\c3\b9 forti di tutti i guerrieri sono questi due: il tempo e la pazienza.") ;; #0262 it
  (data (i32.const 398373) "Nessuno pu\c3\b2 farti sentire inferiore senza il tuo consenso.") ;; #0263 it
  (data (i32.const 398432) "Hai potere sulla tua mente, non sugli eventi esterni. Comprendi questo e troverai la forza.") ;; #0264 it
  (data (i32.const 398523) "L'ostacolo all'azione fa avanzare l'azione. Ci\c3\b2 che si frappone sul cammino diventa il cammino.") ;; #0265 it
  (data (i32.const 398619) "Se qualcosa di esterno ti turba, il dolore non dipende dalla cosa in s\c3\a9, ma dal giudizio che ne dai; e questo hai il potere di revocarlo in qualsiasi momento.") ;; #0266 it
  (data (i32.const 398778) "Non perdere altro tempo a discutere su come dovrebbe essere un uomo buono. Siilo.") ;; #0267 it
  (data (i32.const 398859) "Sii come il promontorio contro cui le onde si infrangono di continuo: resta saldo e placa la furia delle acque intorno a s\c3\a9.") ;; #0268 it
  (data (i32.const 398984) "Da piccole ghiande nascono grandi querce.") ;; #0269 it
  (data (i32.const 399025) "Non \c3\a8 perch\c3\a9 le cose sono difficili che non osiamo; \c3\a8 perch\c3\a9 non osiamo che sono difficili.") ;; #0270 it
  (data (i32.const 399120) "Soffriamo pi\c3\b9 spesso nell'immaginazione che nella realt\c3\a0.") ;; #0271 it
  (data (i32.const 399179) "Dominare gli altri \c3\a8 forza. Dominare s\c3\a9 stessi \c3\a8 il vero potere.") ;; #0272 it
  (data (i32.const 399246) "Anche se uno vincesse in battaglia mille volte mille uomini, il vincitore pi\c3\b9 nobile \c3\a8 colui che vince s\c3\a9 stesso.") ;; #0273 it
  (data (i32.const 399362) "La forza sta nelle differenze, non nelle somiglianze.") ;; #0274 it
  (data (i32.const 399415) "I deboli non sanno perdonare. Il perdono \c3\a8 una qualit\c3\a0 dei forti.") ;; #0275 it
  (data (i32.const 399482) "La forza non viene dalla vittoria. Sono le tue lotte a sviluppare la tua forza.") ;; #0276 it
  (data (i32.const 399561) "La forza \c3\a8 questione di mente risoluta.") ;; #0277 it
  (data (i32.const 399601) "Sono il padrone del mio destino, sono il capitano della mia anima.") ;; #0278 it
  (data (i32.const 399667) "Ringrazio gli d\c3\a8i, quali che siano, per la mia anima invincibile.") ;; #0279 it
  (data (i32.const 399733) "Un eroe \c3\a8 una persona comune che trova la forza di perseverare e resistere nonostante ostacoli schiaccianti.") ;; #0280 it
  (data (i32.const 399842) "Ci\c3\b2 che ci sta alle spalle e ci\c3\b2 che ci sta davanti sono piccole cose in confronto a ci\c3\b2 che abbiamo dentro.") ;; #0281 it
  (data (i32.const 399953) "La pi\c3\b9 grande prova di coraggio sulla terra \c3\a8 sopportare la sconfitta senza perdersi d'animo.") ;; #0282 it
  (data (i32.const 400048) "Di tutte le virt\c3\b9 che possiamo imparare, nessuna \c3\a8 pi\c3\b9 utile, pi\c3\b9 essenziale per la sopravvivenza e pi\c3\b9 capace di migliorare la qualit\c3\a0 della vita della capacit\c3\a0 di trasformare l'avversit\c3\a0 in una sfida piacevole.") ;; #0283 it
  (data (i32.const 400268) "Se non c'\c3\a8 lotta, non c'\c3\a8 progresso.") ;; #0284 it
  (data (i32.const 400306) "Sii l'eroina della tua vita, non la vittima.") ;; #0285 it
  (data (i32.const 400350) "Stai dritta e renditi conto di chi sei: sei pi\c3\b9 grande delle tue circostanze.") ;; #0286 it
  (data (i32.const 400428) "Non abbassare mai la testa. Tienila sempre alta. Guarda il mondo dritto negli occhi.") ;; #0287 it
  (data (i32.const 400512) "Non c'\c3\a8 niente di pi\c3\b9 forte al mondo della dolcezza.") ;; #0288 it
  (data (i32.const 400566) "Niente \c3\a8 cos\c3\ac forte come la dolcezza, niente cos\c3\ac dolce come la vera forza.") ;; #0289 it
  (data (i32.const 400644) "La quercia dorme nella ghianda.") ;; #0290 it
  (data (i32.const 400675) "Con il nuovo giorno arrivano nuova forza e nuovi pensieri.") ;; #0291 it
  (data (i32.const 400733) "La nostra forza nasce dalle nostre debolezze.") ;; #0292 it
  (data (i32.const 400778) "La fortezza \c3\a8 la custode e il sostegno delle altre virt\c3\b9.") ;; #0293 it
  (data (i32.const 400837) "Non sono un uccello, e nessuna rete mi imprigiona: sono un essere umano libero, con una volont\c3\a0 indipendente.") ;; #0294 it
  (data (i32.const 400947) "La mia missione nella vita non \c3\a8 semplicemente sopravvivere, ma fiorire.") ;; #0295 it
  (data (i32.const 401020) "Non puoi avere esitazioni su chi sei.") ;; #0296 it
  (data (i32.const 401057) "Il modo pi\c3\b9 comune in cui le persone rinunciano al proprio potere \c3\a8 pensare di non averne.") ;; #0297 it
  (data (i32.const 401149) "Pensa come una regina. Una regina non ha paura di fallire.") ;; #0298 it
  (data (i32.const 401207) "Scopri chi sei e siilo di proposito.") ;; #0299 it
  (data (i32.const 401243) "Non devi mai avere paura di ci\c3\b2 che fai quando \c3\a8 giusto.") ;; #0300 it
  (data (i32.const 401301) "Quando loro scendono in basso, noi voliamo in alto.") ;; #0301 it
  (data (i32.const 401352) "L'abilit\c3\a0 pu\c3\b2 portarti in cima, ma ci vuole carattere per restarci.") ;; #0302 it
  (data (i32.const 401421) "Quando non c'\c3\a8 un nemico dentro, i nemici fuori non possono farti del male.") ;; #0303 it
  (data (i32.const 401497) "La nostra paura pi\c3\b9 profonda non \c3\a8 di essere inadeguati. La nostra paura pi\c3\b9 profonda \c3\a8 di essere potenti oltre ogni misura.") ;; #0304 it
  (data (i32.const 401625) "Abbi fiducia in te stesso: ogni cuore vibra a quella corda di ferro.") ;; #0305 it
  (data (i32.const 401693) "Sei tu ad avere le chiavi del tuo essere. Sei tu a portare il passaporto per la tua felicit\c3\a0.") ;; #0306 it
  (data (i32.const 401787) "Siamo ci\c3\b2 che facciamo ripetutamente. L'eccellenza, quindi, non \c3\a8 un atto, ma un'abitudine.") ;; #0307 it
  (data (i32.const 401880) "La disciplina \c3\a8 il ponte tra gli obiettivi e i risultati.") ;; #0308 it
  (data (i32.const 401938) "Dobbiamo tutti soffrire una di due cose: il dolore della disciplina o il dolore del rimpianto.") ;; #0309 it
  (data (i32.const 402032) "La motivazione \c3\a8 ci\c3\b2 che ti fa cominciare. L'abitudine \c3\a8 ci\c3\b2 che ti fa continuare.") ;; #0310 it
  (data (i32.const 402118) "Il successo non \c3\a8 altro che poche, semplici discipline praticate ogni giorno.") ;; #0311 it
  (data (i32.const 402196) "Non desiderare che fosse pi\c3\b9 facile; desidera essere migliore.") ;; #0312 it
  (data (i32.const 402259) "O guidi tu la giornata, o \c3\a8 la giornata a guidare te.") ;; #0313 it
  (data (i32.const 402313) "Con l'autodisciplina, quasi tutto \c3\a8 possibile.") ;; #0314 it
  (data (i32.const 402360) "Il guerriero di successo \c3\a8 un uomo comune con una concentrazione da laser.") ;; #0315 it
  (data (i32.const 402435) "Non temo l'uomo che ha praticato 10.000 calci una volta, ma temo l'uomo che ha praticato un calcio 10.000 volte.") ;; #0316 it
  (data (i32.const 402547) "La disciplina \c3\a8 scegliere tra ci\c3\b2 che vuoi adesso e ci\c3\b2 che vuoi di pi\c3\b9.") ;; #0317 it
  (data (i32.const 402623) "Nessuno \c3\a8 libero se non \c3\a8 padrone di s\c3\a9 stesso.") ;; #0318 it
  (data (i32.const 402673) "Prima di' a te stesso cosa vuoi essere; poi fai ci\c3\b2 che devi fare.") ;; #0319 it
  (data (i32.const 402740) "L'autodisciplina \c3\a8 il potere magico che ti rende praticamente inarrestabile.") ;; #0320 it
  (data (i32.const 402817) "Il prezzo dell'eccellenza \c3\a8 la disciplina. Il costo della mediocrit\c3\a0 \c3\a8 la delusione.") ;; #0321 it
  (data (i32.const 402904) "Il duro lavoro batte il talento quando il talento non lavora duro.") ;; #0322 it
  (data (i32.const 402970) "Piccole discipline ripetute con costanza ogni giorno portano a grandi risultati raggiunti lentamente nel tempo.") ;; #0323 it
  (data (i32.const 403081) "Non cambierai mai la tua vita finch\c3\a9 non cambierai qualcosa che fai ogni giorno.") ;; #0324 it
  (data (i32.const 403162) "L'eccellenza \c3\a8 il risultato graduale del cercare sempre di fare meglio.") ;; #0325 it
  (data (i32.const 403234) "I campioni continuano a giocare finch\c3\a9 non fanno le cose per bene.") ;; #0326 it
  (data (i32.const 403301) "Ho odiato ogni minuto di allenamento, ma mi dicevo: non mollare. Soffri adesso e vivi il resto della tua vita da campione.") ;; #0327 it
  (data (i32.const 403423) "L'incontro si vince o si perde lontano dai testimoni, dietro le quinte, in palestra e l\c3\a0 fuori sulla strada, molto prima che io danzi sotto quelle luci.") ;; #0328 it
  (data (i32.const 403576) "Non contare i giorni; fai in modo che i giorni contino.") ;; #0329 it
  (data (i32.const 403631) "La dedizione fa avverare i sogni.") ;; #0330 it
  (data (i32.const 403664) "Riposati alla fine, non a met\c3\a0.") ;; #0331 it
  (data (i32.const 403696) "Non esistono scorciatoie per nessun posto che valga la pena raggiungere.") ;; #0332 it
  (data (i32.const 403768) "L'unico posto in cui il successo viene prima del lavoro \c3\a8 il vocabolario.") ;; #0333 it
  (data (i32.const 403842) "Il talento costa meno del sale da cucina. Ci\c3\b2 che separa la persona di talento da quella di successo \c3\a8 tanto duro lavoro.") ;; #0334 it
  (data (i32.const 403965) "I dilettanti si siedono ad aspettare l'ispirazione; noialtri ci alziamo e andiamo a lavorare.") ;; #0335 it
  (data (i32.const 404058) "Pi\c3\b9 mi alleno, pi\c3\b9 sono fortunato.") ;; #0336 it
  (data (i32.const 404094) "Non aspettare che il ferro sia caldo per batterlo; rendilo caldo battendolo.") ;; #0337 it
  (data (i32.const 404170) "Il rispetto di s\c3\a9 \c3\a8 il frutto della disciplina; il senso della dignit\c3\a0 cresce con la capacit\c3\a0 di dire di no a s\c3\a9 stessi.") ;; #0338 it
  (data (i32.const 404295) "Ci\c3\b2 che fai ogni giorno conta pi\c3\b9 di ci\c3\b2 che fai ogni tanto.") ;; #0339 it
  (data (i32.const 404358) "La disciplina \c3\a8 libert\c3\a0.") ;; #0340 it
  (data (i32.const 404384) "Concentra tutti i tuoi pensieri sul lavoro che hai davanti. I raggi del sole non bruciano finch\c3\a9 non vengono messi a fuoco.") ;; #0341 it
  (data (i32.const 404508) "Ben fatto \c3\a8 meglio che ben detto.") ;; #0342 it
  (data (i32.const 404542) "Il tempo perduto non si ritrova mai pi\c3\b9.") ;; #0343 it
  (data (i32.const 404583) "Senza duro lavoro, crescono solo le erbacce.") ;; #0344 it
  (data (i32.const 404627) "Il successo non riguarda sempre la grandezza. Riguarda la costanza.") ;; #0345 it
  (data (i32.const 404694) "Il successo non \c3\a8 un caso. \c3\88 duro lavoro, perseveranza, apprendimento, studio, sacrificio e, soprattutto, amore per ci\c3\b2 che si fa.") ;; #0346 it
  (data (i32.const 404827) "La volont\c3\a0 di vincere \c3\a8 importante, ma la volont\c3\a0 di prepararsi \c3\a8 vitale.") ;; #0347 it
  (data (i32.const 404904) "Non ho mai sognato il successo. Ho lavorato per ottenerlo.") ;; #0348 it
  (data (i32.const 404962) "Niente funzioner\c3\a0 se non lavori tu.") ;; #0349 it
  (data (i32.const 404998) "L'abitudine \c3\a8 il migliore dei servitori o il peggiore dei padroni.") ;; #0350 it
  (data (i32.const 405065) "Prima siamo noi a creare le nostre abitudini, poi sono le nostre abitudini a creare noi.") ;; #0351 it
  (data (i32.const 405153) "\c3\88 la partenza che ferma la maggior parte delle persone.") ;; #0352 it
  (data (i32.const 405209) "L'allenamento non \c3\a8 ci\c3\b2 che fai quando sei gi\c3\a0 bravo. \c3\88 ci\c3\b2 che fai per diventarlo.") ;; #0353 it
  (data (i32.const 405297) "Fai oggi qualcosa per cui il tuo io futuro ti ringrazier\c3\a0.") ;; #0354 it
  (data (i32.const 405356) "Concentrati sull'essere produttivo, non sull'essere impegnato.") ;; #0355 it
  (data (i32.const 405418) "La disciplina \c3\a8 ricordare ci\c3\b2 che vuoi.") ;; #0356 it
  (data (i32.const 405459) "Fai di ogni giorno il tuo capolavoro.") ;; #0357 it
  (data (i32.const 405496) "Sii rapido, ma non avere fretta.") ;; #0358 it
  (data (i32.const 405528) "Non aver paura di crescere lentamente; abbi paura solo di restare fermo.") ;; #0359 it
  (data (i32.const 405600) "L'unico modo per dare un senso al cambiamento \c3\a8 tuffarcisi dentro, muoversi con esso e unirsi alla danza.") ;; #0360 it
  (data (i32.const 405706) "La vita \c3\a8 come andare in bicicletta. Per mantenere l'equilibrio, devi continuare a muoverti.") ;; #0361 it
  (data (i32.const 405799) "Dicono sempre che il tempo cambia le cose, ma in realt\c3\a0 sei tu che devi cambiarle.") ;; #0362 it
  (data (i32.const 405882) "Il progresso \c3\a8 impossibile senza cambiamento, e chi non sa cambiare idea non pu\c3\b2 cambiare nulla.") ;; #0363 it
  (data (i32.const 405980) "Il cambiamento \c3\a8 la legge della vita. E chi guarda solo al passato o al presente \c3\a8 destinato a perdere il futuro.") ;; #0364 it
  (data (i32.const 406095) "Il segreto del cambiamento \c3\a8 concentrare tutta la tua energia non nel combattere il vecchio, ma nel costruire il nuovo.") ;; #0365 it
  (data (i32.const 406215) "Ci\c3\b2 che ottieni raggiungendo i tuoi obiettivi non \c3\a8 importante quanto ci\c3\b2 che diventi raggiungendoli.") ;; #0366 it
  (data (i32.const 406319) "Crescere fa male. Cambiare fa male. Ma niente fa male quanto restare bloccati in un posto a cui non appartieni.") ;; #0367 it
  (data (i32.const 406430) "E arriv\c3\b2 il giorno in cui il rischio di restare chiusa in un bocciolo fu pi\c3\b9 doloroso del rischio di sbocciare.") ;; #0368 it
  (data (i32.const 406543) "Faccio sempre ci\c3\b2 che non so fare, per imparare a farlo.") ;; #0369 it
  (data (i32.const 406600) "Se non provi a fare qualcosa al di l\c3\a0 di ci\c3\b2 che gi\c3\a0 sai fare, non crescerai mai.") ;; #0370 it
  (data (i32.const 406684) "Sappiamo ci\c3\b2 che siamo, ma non ci\c3\b2 che potremmo essere.") ;; #0371 it
  (data (i32.const 406741) "I nostri dubbi sono traditori, e ci fanno perdere il bene che spesso potremmo ottenere, per paura di tentare.") ;; #0372 it
  (data (i32.const 406850) "Se facessimo tutte le cose di cui siamo capaci, stupiremmo letteralmente noi stessi.") ;; #0373 it
  (data (i32.const 406934) "Il momento migliore per piantare un albero era 20 anni fa. Il secondo momento migliore \c3\a8 adesso.") ;; #0374 it
  (data (i32.const 407031) "Fai ci\c3\b2 che puoi, con ci\c3\b2 che hai, dove sei.") ;; #0375 it
  (data (i32.const 407077) "Tra un anno potresti desiderare di aver cominciato oggi.") ;; #0376 it
  (data (i32.const 407133) "Cambia i tuoi pensieri e cambierai il tuo mondo.") ;; #0377 it
  (data (i32.const 407181) "Non puoi cambiare la tua destinazione dall'oggi al domani, ma puoi cambiare la tua direzione dall'oggi al domani.") ;; #0378 it
  (data (i32.const 407294) "Tutti pensano a cambiare il mondo, ma nessuno pensa a cambiare s\c3\a9 stesso.") ;; #0379 it
  (data (i32.const 407368) "Migliorare \c3\a8 cambiare; essere perfetti \c3\a8 cambiare spesso.") ;; #0380 it
  (data (i32.const 407427) "La crescita comincia quando iniziamo ad accettare le nostre debolezze.") ;; #0381 it
  (data (i32.const 407497) "La pi\c3\b9 grande scoperta della mia generazione \c3\a8 che un essere umano pu\c3\b2 cambiare la propria vita cambiando il proprio atteggiamento.") ;; #0382 it
  (data (i32.const 407631) "Non sei mai troppo vecchio per fissarti un nuovo obiettivo o fare un nuovo sogno.") ;; #0383 it
  (data (i32.const 407712) "Agisci come se ci\c3\b2 che fai facesse la differenza. La fa.") ;; #0384 it
  (data (i32.const 407769) "Ci\c3\b2 che pi\c3\b9 temiamo di fare \c3\a8 di solito ci\c3\b2 che pi\c3\b9 abbiamo bisogno di fare.") ;; #0385 it
  (data (i32.const 407850) "La zona di comfort \c3\a8 un bel posto, ma l\c3\ac non cresce mai niente.") ;; #0386 it
  (data (i32.const 407915) "Non seguir\c3\b2 il sentiero dove porta; andr\c3\b2 dove non c'\c3\a8 sentiero e lascer\c3\b2 una traccia.") ;; #0387 it
  (data (i32.const 408005) "Divenire \c3\a8 meglio che essere.") ;; #0388 it
  (data (i32.const 408035) "Non tutto ci\c3\b2 che si affronta pu\c3\b2 essere cambiato, ma niente pu\c3\b2 essere cambiato finch\c3\a9 non lo si affronta.") ;; #0389 it
  (data (i32.const 408146) "Le tue circostanze attuali non determinano dove puoi arrivare; determinano solo da dove parti.") ;; #0390 it
  (data (i32.const 408240) "Un giorno ti sveglierai e non ci sar\c3\a0 pi\c3\b9 tempo per fare le cose che hai sempre voluto. Falle adesso.") ;; #0391 it
  (data (i32.const 408343) "Fai del tuo meglio finch\c3\a9 non sai fare di meglio. Quando sai fare di meglio, fai meglio.") ;; #0392 it
  (data (i32.const 408432) "La cosa bella dell'imparare \c3\a8 che nessuno pu\c3\b2 portartelo via.") ;; #0393 it
  (data (i32.const 408495) "L'istruzione \c3\a8 l'arma pi\c3\b9 potente che si possa usare per cambiare il mondo.") ;; #0394 it
  (data (i32.const 408572) "Chi non vince ogni giorno qualche paura non ha imparato il segreto della vita.") ;; #0395 it
  (data (i32.const 408650) "La vita comincia dove finisce la tua zona di comfort.") ;; #0396 it
  (data (i32.const 408703) "Non posso cambiare la direzione del vento, ma posso regolare le vele per raggiungere sempre la mia destinazione.") ;; #0397 it
  (data (i32.const 408815) "Non possiamo diventare ci\c3\b2 che vogliamo restando ci\c3\b2 che siamo.") ;; #0398 it
  (data (i32.const 408880) "A poco a poco, il poco diventa molto.") ;; #0399 it
  (data (i32.const 408917) "Non c'\c3\a8 niente di permanente, tranne il cambiamento.") ;; #0400 it
  (data (i32.const 408970) "Nessun uomo si bagna due volte nello stesso fiume, perch\c3\a9 non \c3\a8 pi\c3\b9 lo stesso fiume e lui non \c3\a8 pi\c3\b9 lo stesso uomo.") ;; #0401 it
  (data (i32.const 409090) "Senza crescita e progresso continui, parole come miglioramento, risultato e successo non hanno significato.") ;; #0402 it
  (data (i32.const 409197) "Ci\c3\b2 che deve dare luce deve sopportare di bruciare.") ;; #0403 it
  (data (i32.const 409249) "Non conta ci\c3\b2 che ti succede, ma come reagisci.") ;; #0404 it
  (data (i32.const 409297) "Comincia subito a vivere, e conta ogni giorno come una vita a s\c3\a9.") ;; #0405 it
  (data (i32.const 409363) "Comincia da dove sei. Usa ci\c3\b2 che hai. Fai ci\c3\b2 che puoi.") ;; #0406 it
  (data (i32.const 409421) "Ammiriamo la bellezza della farfalla, ma raramente riconosciamo i cambiamenti che ha attraversato per raggiungere quella bellezza.") ;; #0407 it
  (data (i32.const 409551) "Non \c3\a8 la specie pi\c3\b9 forte a sopravvivere, n\c3\a9 la pi\c3\b9 intelligente, ma quella pi\c3\b9 capace di adattarsi al cambiamento.") ;; #0408 it
  (data (i32.const 409671) "Quando lascio andare ci\c3\b2 che sono, divento ci\c3\b2 che potrei essere.") ;; #0409 it
  (data (i32.const 409738) "Non posso tornare a ieri, perch\c3\a9 allora ero una persona diversa.") ;; #0410 it
  (data (i32.const 409803) "Il vero cambiamento, quello duraturo, avviene un passo alla volta.") ;; #0411 it
  (data (i32.const 409869) "Mi hanno insegnato che la strada del progresso non \c3\a8 n\c3\a9 rapida n\c3\a9 facile.") ;; #0412 it
  (data (i32.const 409945) "L'avversit\c3\a0 fa s\c3\ac che alcuni uomini si spezzino, e altri battano record.") ;; #0413 it
  (data (i32.const 410019) "La prosperit\c3\a0 non \c3\a8 priva di paure e dispiaceri, e l'avversit\c3\a0 non \c3\a8 priva di conforti e speranze.") ;; #0414 it
  (data (i32.const 410121) "L'avversit\c3\a0 \c3\a8 la prima via verso la verit\c3\a0.") ;; #0415 it
  (data (i32.const 410167) "Gli aquiloni volano pi\c3\b9 in alto controvento, non con il vento a favore.") ;; #0416 it
  (data (i32.const 410239) "L'avversit\c3\a0 ha l'effetto di far emergere talenti che, in tempi prosperi, sarebbero rimasti sopiti.") ;; #0417 it
  (data (i32.const 410338) "Il blocco di granito che era un ostacolo sul cammino del debole diventa un gradino sul cammino del forte.") ;; #0418 it
  (data (i32.const 410443) "Gli ostacoli sono quelle cose spaventose che vedi quando distogli lo sguardo dal tuo obiettivo.") ;; #0419 it
  (data (i32.const 410538) "Gli ostacoli non devono fermarti. Se sbatti contro un muro, non voltarti e non arrenderti. Trova il modo di scalarlo, attraversarlo o aggirarlo.") ;; #0420 it
  (data (i32.const 410682) "I problemi non sono segnali di stop; sono indicazioni.") ;; #0421 it
  (data (i32.const 410736) "Volgi il viso verso il sole e le ombre cadranno dietro di te.") ;; #0422 it
  (data (i32.const 410797) "L'uomo di carattere trova un fascino particolare nella difficolt\c3\a0.") ;; #0423 it
  (data (i32.const 410864) "Le difficolt\c3\a0 servono a risvegliare, non a scoraggiare. Lo spirito umano \c3\a8 fatto per rafforzarsi nel conflitto.") ;; #0424 it
  (data (i32.const 410977) "Se non puoi volare, corri; se non puoi correre, cammina; se non puoi camminare, striscia; ma qualunque cosa tu faccia, continua ad andare avanti.") ;; #0425 it
  (data (i32.const 411122) "La vera misura di un uomo non \c3\a8 dove si trova nei momenti di comodit\c3\a0 e convenienza, ma dove si trova nei momenti di sfida e controversia.") ;; #0426 it
  (data (i32.const 411262) "L'oscurit\c3\a0 non pu\c3\b2 scacciare l'oscurit\c3\a0; solo la luce pu\c3\b2 farlo.") ;; #0427 it
  (data (i32.const 411330) "La fede \c3\a8 fare il primo passo anche quando non vedi tutta la scala.") ;; #0428 it
  (data (i32.const 411398) "Non c'\c3\a8 scuola come l'avversit\c3\a0.") ;; #0429 it
  (data (i32.const 411432) "Ci\c3\b2 che fa male insegna.") ;; #0430 it
  (data (i32.const 411457) "L'avversit\c3\a0 \c3\a8 come un vento forte. Ci strappa via tutto tranne ci\c3\b2 che non pu\c3\b2 essere strappato, cos\c3\ac che ci vediamo come siamo davvero.") ;; #0431 it
  (data (i32.const 411598) "Ci\c3\b2 che rende bello il deserto \c3\a8 che da qualche parte nasconde un pozzo.") ;; #0432 it
  (data (i32.const 411672) "Il pessimista vede la difficolt\c3\a0 in ogni opportunit\c3\a0. L'ottimista vede l'opportunit\c3\a0 in ogni difficolt\c3\a0.") ;; #0433 it
  (data (i32.const 411780) "Le sfide rendono la vita interessante, e superarle \c3\a8 ci\c3\b2 che le d\c3\a0 significato.") ;; #0434 it
  (data (i32.const 411862) "L'avversit\c3\a0 \c3\a8 la polvere di diamante con cui il Cielo leviga i suoi gioielli.") ;; #0435 it
  (data (i32.const 411941) "Le tempeste fanno mettere agli alberi radici pi\c3\b9 profonde.") ;; #0436 it
  (data (i32.const 412000) "Per come la vedo io, se vuoi l'arcobaleno, devi sopportare la pioggia.") ;; #0437 it
  (data (i32.const 412070) "La vita non \c3\a8 aspettare che passi la tempesta. \c3\88 imparare a ballare sotto la pioggia.") ;; #0438 it
  (data (i32.const 412157) "L'avversit\c3\a0 rivela il genio, la prosperit\c3\a0 lo nasconde.") ;; #0439 it
  (data (i32.const 412214) "Quando il gioco si fa duro, i duri cominciano a giocare.") ;; #0440 it
  (data (i32.const 412270) "Un eroe non \c3\a8 pi\c3\b9 coraggioso di un uomo comune; \c3\a8 solo coraggioso cinque minuti di pi\c3\b9.") ;; #0441 it
  (data (i32.const 412361) "La lotta stessa verso la vetta basta a riempire il cuore di un uomo. Bisogna immaginare Sisifo felice.") ;; #0442 it
  (data (i32.const 412463) "A volte l'avversit\c3\a0 \c3\a8 proprio ci\c3\b2 che devi affrontare per avere successo.") ;; #0443 it
  (data (i32.const 412539) "I tempi difficili non creano eroi. \c3\88 nei tempi difficili che si rivela l'eroe che \c3\a8 in noi.") ;; #0444 it
  (data (i32.const 412632) "Le montagne non si superano se non per sentieri tortuosi.") ;; #0445 it
  (data (i32.const 412689) "Il dolore \c3\a8 inevitabile. La sofferenza \c3\a8 facoltativa.") ;; #0446 it
  (data (i32.const 412744) "I problemi sono solo opportunit\c3\a0 in abiti da lavoro.") ;; #0447 it
  (data (i32.const 412797) "La calamit\c3\a0 \c3\a8 la prova dell'integrit\c3\a0.") ;; #0448 it
  (data (i32.const 412838) "La prosperit\c3\a0 fa gli amici, l'avversit\c3\a0 li mette alla prova.") ;; #0449 it
  (data (i32.const 412900) "Chiunque sa tenere il timone quando il mare \c3\a8 calmo.") ;; #0450 it
  (data (i32.const 412953) "Pi\c3\b9 dura \c3\a8 la battaglia, pi\c3\b9 dolce \c3\a8 la vittoria.") ;; #0451 it
  (data (i32.const 413006) "Dolci sono i frutti dell'avversit\c3\a0.") ;; #0452 it
  (data (i32.const 413042) "Ogni avversit\c3\a0, ogni fallimento, ogni dolore porta con s\c3\a9 il seme di un beneficio pari o maggiore.") ;; #0453 it
  (data (i32.const 413142) "Pi\c3\b9 grande \c3\a8 la difficolt\c3\a0, pi\c3\b9 grande \c3\a8 la gloria nel superarla.") ;; #0454 it
  (data (i32.const 413212) "Sono le difficolt\c3\a0 a mostrare a una persona chi \c3\a8.") ;; #0455 it
  (data (i32.const 413264) "Nessun albero mette radici salde se molti venti non lo scuotono.") ;; #0456 it
  (data (i32.const 413328) "\c3\88 una strada aspra quella che conduce alle vette della grandezza.") ;; #0457 it
  (data (i32.const 413394) "Le strade difficili spesso portano a destinazioni bellissime.") ;; #0458 it
  (data (i32.const 413455) "Nel mezzo del caos c'\c3\a8 anche l'opportunit\c3\a0.") ;; #0459 it
  (data (i32.const 413500) "Ci\c3\b2 che ci sembra una prova amara \c3\a8 spesso una benedizione travestita.") ;; #0460 it
  (data (i32.const 413572) "I grandi spiriti hanno sempre incontrato una violenta opposizione da parte delle menti mediocri.") ;; #0461 it
  (data (i32.const 413668) "Il dolore passa, la bellezza resta.") ;; #0462 it
  (data (i32.const 413703) "Le cose vanno meglio per chi sa trarre il meglio da come vanno le cose.") ;; #0463 it
  (data (i32.const 413774) "Non \c3\a8 il momento di pensare a ci\c3\b2 che non hai. Pensa a ci\c3\b2 che puoi fare con ci\c3\b2 che c'\c3\a8.") ;; #0464 it
  (data (i32.const 413868) "L'ostacolo \c3\a8 la via.") ;; #0465 it
  (data (i32.const 413889) "Un viaggio di mille miglia comincia con un passo.") ;; #0466 it
  (data (i32.const 413938) "L'azione \c3\a8 la chiave fondamentale di ogni successo.") ;; #0467 it
  (data (i32.const 413990) "Non devi essere grande per cominciare, ma devi cominciare per diventare grande.") ;; #0468 it
  (data (i32.const 414069) "Il modo per cominciare \c3\a8 smettere di parlare e iniziare a fare.") ;; #0469 it
  (data (i32.const 414133) "Non aspettare; il momento non sar\c3\a0 mai quello perfetto.") ;; #0470 it
  (data (i32.const 414189) "Sapere non basta; bisogna applicare. Volere non basta; bisogna fare.") ;; #0471 it
  (data (i32.const 414257) "L'azione non porta sempre la felicit\c3\a0, ma non c'\c3\a8 felicit\c3\a0 senza azione.") ;; #0472 it
  (data (i32.const 414332) "Pensare non vincer\c3\a0 la paura, ma agire s\c3\ac.") ;; #0473 it
  (data (i32.const 414376) "Un giorno non \c3\a8 un giorno della settimana.") ;; #0474 it
  (data (i32.const 414419) "Fatto \c3\a8 meglio che perfetto.") ;; #0475 it
  (data (i32.const 414448) "Piccole azioni compiute valgono pi\c3\b9 di grandi azioni progettate.") ;; #0476 it
  (data (i32.const 414513) "Sbagli il 100% dei tiri che non fai.") ;; #0477 it
  (data (i32.const 414549) "L'ispirazione esiste, ma deve trovarti mentre lavori.") ;; #0478 it
  (data (i32.const 414602) "La visione senza azione \c3\a8 solo un sogno. L'azione senza visione \c3\a8 solo un passatempo. La visione con l'azione pu\c3\b2 cambiare il mondo.") ;; #0479 it
  (data (i32.const 414737) "Il futuro dipende da ci\c3\b2 che fai oggi.") ;; #0480 it
  (data (i32.const 414776) "Non rimandare a domani quello che puoi fare oggi.") ;; #0481 it
  (data (i32.const 414825) "Fai le cose difficili finch\c3\a9 sono facili, e quelle grandi finch\c3\a9 sono piccole.") ;; #0482 it
  (data (i32.const 414905) "Chi ben comincia \c3\a8 a met\c3\a0 dell'opera.") ;; #0483 it
  (data (i32.const 414944) "Se passi troppo tempo a pensare a una cosa, non la farai mai.") ;; #0484 it
  (data (i32.const 415005) "Ci\c3\b2 che fai parla cos\c3\ac forte che non riesco a sentire ci\c3\b2 che dici.") ;; #0485 it
  (data (i32.const 415075) "Va' con fiducia nella direzione dei tuoi sogni. Vivi la vita che hai immaginato.") ;; #0486 it
  (data (i32.const 415155) "Se hai costruito castelli in aria, il tuo lavoro non \c3\a8 perduto; \c3\a8 l\c3\ac che devono stare. Ora mettici sotto le fondamenta.") ;; #0487 it
  (data (i32.const 415277) "Le idee sono facili. Realizzarle \c3\a8 difficile.") ;; #0488 it
  (data (i32.const 415323) "Comincia, sii audace e osa essere saggio.") ;; #0489 it
  (data (i32.const 415364) "Sogna in grande e osa fallire.") ;; #0490 it
  (data (i32.const 415394) "Non confondere mai il movimento con l'azione.") ;; #0491 it
  (data (i32.const 415439) "Non lasciare che ieri occupi troppo spazio nell'oggi.") ;; #0492 it
  (data (i32.const 415492) "Anche se sei sulla strada giusta, verrai investito se resti l\c3\ac seduto.") ;; #0493 it
  (data (i32.const 415563) "Un'idea non accompagnata dall'azione non diventer\c3\a0 mai pi\c3\b9 grande del neurone che occupava.") ;; #0494 it
  (data (i32.const 415656) "Le chiacchiere non cuociono il riso.") ;; #0495 it
  (data (i32.const 415692) "Se non ora, quando?") ;; #0496 it
  (data (i32.const 415711) "Per cominciare, comincia.") ;; #0497 it
  (data (i32.const 415736) "Insegui ci\c3\b2 che conquista il tuo cuore, non ci\c3\b2 che attira i tuoi occhi.") ;; #0498 it
  (data (i32.const 415810) "La vita \c3\a8 per il dieci per cento ci\c3\b2 che ti accade e per il novanta per cento come reagisci.") ;; #0499 it
  (data (i32.const 415904) "Se l'opportunit\c3\a0 non bussa, costruisci una porta.") ;; #0500 it
  (data (i32.const 415954) "L'unico viaggio impossibile \c3\a8 quello che non cominci mai.") ;; #0501 it
  (data (i32.const 416012) "\c3\88 nei tuoi momenti di decisione che si forgia il tuo destino.") ;; #0502 it
  (data (i32.const 416074) "Fissare degli obiettivi \c3\a8 il primo passo per trasformare l'invisibile in visibile.") ;; #0503 it
  (data (i32.const 416157) "Le opportunit\c3\a0 non capitano. Le crei tu.") ;; #0504 it
  (data (i32.const 416198) "Il dubbio uccide pi\c3\b9 sogni di quanti ne uccider\c3\a0 mai il fallimento.") ;; #0505 it
  (data (i32.const 416267) "Non lasciarti spingere dalle paure della tua mente. Lasciati guidare dai sogni del tuo cuore.") ;; #0506 it
  (data (i32.const 416360) "Metti il cuore, la mente e l'anima anche nei tuoi gesti pi\c3\b9 piccoli. Questo \c3\a8 il segreto del successo.") ;; #0507 it
  (data (i32.const 416464) "Non si pu\c3\b2 attraversare il mare restando fermi a guardare l'acqua.") ;; #0508 it
  (data (i32.const 416531) "La cosa pi\c3\b9 difficile \c3\a8 decidere di agire; il resto \c3\a8 solo tenacia.") ;; #0509 it
  (data (i32.const 416601) "Il modo pi\c3\b9 efficace per farlo \c3\a8 farlo.") ;; #0510 it
  (data (i32.const 416642) "Non stare seduto ad aspettare che arrivino le opportunit\c3\a0. Alzati e creale.") ;; #0511 it
  (data (i32.const 416718) "Che meraviglia che nessuno debba aspettare un solo istante prima di cominciare a migliorare il mondo.") ;; #0512 it
  (data (i32.const 416819) "Una persona pu\c3\b2 fare la differenza, e tutti dovrebbero provarci.") ;; #0513 it
  (data (i32.const 416884) "Abbiamo scelto di andare sulla Luna in questo decennio, e di fare le altre cose, non perch\c3\a9 siano facili, ma perch\c3\a9 sono difficili.") ;; #0514 it
  (data (i32.const 417017) "Le opportunit\c3\a0 si moltiplicano man mano che vengono colte.") ;; #0515 it
  (data (i32.const 417076) "Non puoi aspettare l'ispirazione. Devi inseguirla con una clava.") ;; #0516 it
  (data (i32.const 417140) "Fallo adesso. Il futuro non \c3\a8 promesso a nessuno.") ;; #0517 it
  (data (i32.const 417190) "Dare il meglio in questo momento ti mette nella posizione migliore per il momento successivo.") ;; #0518 it
  (data (i32.const 417283) "Il futuro comincia oggi, non domani.") ;; #0519 it
  (data (i32.const 417319) "Che tu creda di farcela o di non farcela, avrai comunque ragione.") ;; #0520 it
  (data (i32.const 417384) "Credi di potercela fare e sei gi\c3\a0 a met\c3\a0 strada.") ;; #0521 it
  (data (i32.const 417434) "La nostra vita \c3\a8 ci\c3\b2 che i nostri pensieri ne fanno.") ;; #0522 it
  (data (i32.const 417488) "La felicit\c3\a0 della tua vita dipende dalla qualit\c3\a0 dei tuoi pensieri.") ;; #0523 it
  (data (i32.const 417557) "Basta pochissimo per avere una vita felice; \c3\a8 tutto dentro di te, nel tuo modo di pensare.") ;; #0524 it
  (data (i32.const 417648) "Un atteggiamento positivo pu\c3\b2 davvero far avverare i sogni.") ;; #0525 it
  (data (i32.const 417708) "L'ottimismo \c3\a8 una calamita per la felicit\c3\a0.") ;; #0526 it
  (data (i32.const 417753) "I limiti esistono solo nella nostra mente. Ma se usiamo l'immaginazione, le nostre possibilit\c3\a0 diventano illimitate.") ;; #0527 it
  (data (i32.const 417870) "L'unico limite alla nostra realizzazione di domani saranno i nostri dubbi di oggi.") ;; #0528 it
  (data (i32.const 417952) "L'ottimismo perpetuo moltiplica le forze.") ;; #0529 it
  (data (i32.const 417993) "Se senti una voce dentro di te che dice che non sai dipingere, allora dipingi, e quella voce tacer\c3\a0.") ;; #0530 it
  (data (i32.const 418094) "Tutto ci\c3\b2 che la mente umana pu\c3\b2 concepire e credere, lo pu\c3\b2 realizzare.") ;; #0531 it
  (data (i32.const 418169) "Chi ha fiducia in s\c3\a9 stesso conquista la fiducia degli altri.") ;; #0532 it
  (data (i32.const 418231) "Quando sostituisci i pensieri negativi con quelli positivi, cominci ad avere risultati positivi.") ;; #0533 it
  (data (i32.const 418327) "Quando cambi il modo di guardare le cose, le cose che guardi cambiano.") ;; #0534 it
  (data (i32.const 418397) "La felicit\c3\a0 non \c3\a8 qualcosa di gi\c3\a0 pronto. Viene dalle tue azioni.") ;; #0535 it
  (data (i32.const 418465) "La fiducia in s\c3\a9 e il duro lavoro ti porteranno sempre al successo.") ;; #0536 it
  (data (i32.const 418533) "Troppi di noi non vivono i propri sogni perch\c3\a9 vivono le proprie paure.") ;; #0537 it
  (data (i32.const 418605) "Punta alla Luna. Anche se la manchi, atterrerai tra le stelle.") ;; #0538 it
  (data (i32.const 418667) "Non conta ci\c3\b2 che guardi, ma ci\c3\b2 che vedi.") ;; #0539 it
  (data (i32.const 418711) "Non sono il prodotto delle mie circostanze. Sono il prodotto delle mie decisioni.") ;; #0540 it
  (data (i32.const 418792) "La fiducia non viene dall'avere sempre ragione, ma dal non avere paura di sbagliare.") ;; #0541 it
  (data (i32.const 418876) "Se vuoi sollevarti, solleva qualcun altro.") ;; #0542 it
  (data (i32.const 418918) "Il successo non si misura tanto dalla posizione raggiunta nella vita, quanto dagli ostacoli superati.") ;; #0543 it
  (data (i32.const 419019) "L'eccellenza \c3\a8 fare una cosa comune in modo non comune.") ;; #0544 it
  (data (i32.const 419075) "Ci\c3\b2 che pensi di te stesso \c3\a8 molto pi\c3\b9 importante di ci\c3\b2 che gli altri pensano di te.") ;; #0545 it
  (data (i32.const 419164) "L'uomo non \c3\a8 altro che il prodotto dei suoi pensieri. Diventa ci\c3\b2 che pensa.") ;; #0546 it
  (data (i32.const 419242) "Se una cosa non ti piace, cambiala. Se non puoi cambiarla, cambia il tuo atteggiamento.") ;; #0547 it
  (data (i32.const 419329) "Si dice spesso che la motivazione non dura. Beh, nemmeno la doccia. Per questo la consigliamo ogni giorno.") ;; #0548 it
  (data (i32.const 419435) "Il tuo atteggiamento, non la tua attitudine, determiner\c3\a0 la tua altitudine.") ;; #0549 it
  (data (i32.const 419511) "Il pensiero positivo ti permetter\c3\a0 di fare tutto meglio del pensiero negativo.") ;; #0550 it
  (data (i32.const 419590) "L'ottimismo \c3\a8 la qualit\c3\a0 pi\c3\b9 associata al successo e alla felicit\c3\a0, pi\c3\b9 di qualsiasi altra.") ;; #0551 it
  (data (i32.const 419686) "Credi in te stesso! Abbi fiducia nelle tue capacit\c3\a0!") ;; #0552 it
  (data (i32.const 419739) "Devi aspettarti grandi cose da te stesso prima di poterle realizzare.") ;; #0553 it
  (data (i32.const 419808) "Attribuisco il mio successo a questo: non ho mai dato n\c3\a9 accettato scuse.") ;; #0554 it
  (data (i32.const 419882) "L'immaginazione \c3\a8 pi\c3\b9 importante della conoscenza.") ;; #0555 it
  (data (i32.const 419934) "Con gli anni ho imparato che, quando la mente \c3\a8 decisa, la paura diminuisce.") ;; #0556 it
  (data (i32.const 420011) "Devi fare le cose che pensi di non poter fare.") ;; #0557 it
  (data (i32.const 420057) "Pensare con chiarezza richiede pi\c3\b9 coraggio che intelligenza.") ;; #0558 it
  (data (i32.const 420119) "Non \c3\a8 il peso a schiacciarti, ma il modo in cui lo porti.") ;; #0559 it
  (data (i32.const 420177) "L'abilit\c3\a0 \c3\a8 ci\c3\b2 che sei capace di fare. La motivazione determina ci\c3\b2 che fai. L'atteggiamento determina quanto bene lo fai.") ;; #0560 it
  (data (i32.const 420304) "La preoccupazione non svuota il domani del suo dolore, svuota l'oggi della sua forza.") ;; #0561 it
  (data (i32.const 420389) "L'uomo non \c3\a8 tanto turbato dai problemi reali quanto dalle ansie che immagina su di essi.") ;; #0562 it
  (data (i32.const 420479) "Se pensi di essere battuto, lo sei.") ;; #0563 it
  (data (i32.const 420514) "Prima o poi, chi vince \c3\a8 chi pensa di potercela fare.") ;; #0564 it
  (data (i32.const 420568) "Diventiamo ci\c3\b2 a cui pensiamo.") ;; #0565 it
  (data (i32.const 420599) "Se cerchi sempre di essere normale, non saprai mai quanto puoi essere straordinario.") ;; #0566 it
  (data (i32.const 420683) "A volte sono arrivata a credere a sei cose impossibili prima di colazione.") ;; #0567 it
  (data (i32.const 420757) "Il peggior nemico della creativit\c3\a0 \c3\a8 il dubbio su s\c3\a9 stessi.") ;; #0568 it
  (data (i32.const 420820) "Abito nella possibilit\c3\a0.") ;; #0569 it
  (data (i32.const 420845) "Sono le nostre scelte a mostrare ci\c3\b2 che siamo veramente, molto pi\c3\b9 delle nostre capacit\c3\a0.") ;; #0570 it
  (data (i32.const 420938) "Guarda le stelle e non i tuoi piedi.") ;; #0571 it
  (data (i32.const 420974) "Per quanto difficile possa sembrare la vita, c'\c3\a8 sempre qualcosa che puoi fare e in cui puoi riuscire.") ;; #0572 it
  (data (i32.const 421077) "Non ho talenti particolari. Sono solo appassionatamente curioso.") ;; #0573 it
  (data (i32.const 421141) "Cerca di non diventare un uomo di successo, ma piuttosto un uomo di valore.") ;; #0574 it
  (data (i32.const 421216) "La pazienza \c3\a8 amara, ma il suo frutto \c3\a8 dolce.") ;; #0575 it
  (data (i32.const 421264) "Adotta il ritmo della natura: il suo segreto \c3\a8 la pazienza.") ;; #0576 it
  (data (i32.const 421324) "La natura non ha fretta, eppure tutto si compie.") ;; #0577 it
  (data (i32.const 421372) "Gli alberi che crescono lentamente danno i frutti migliori.") ;; #0578 it
  (data (i32.const 421431) "Il genio \c3\a8 eterna pazienza.") ;; #0579 it
  (data (i32.const 421459) "La pazienza \c3\a8 compagna della saggezza.") ;; #0580 it
  (data (i32.const 421498) "Chi sa avere pazienza pu\c3\b2 avere ci\c3\b2 che vuole.") ;; #0581 it
  (data (i32.const 421546) "Abbi pazienza con tutte le cose, ma prima di tutto con te stesso.") ;; #0582 it
  (data (i32.const 421611) "Un momento di pazienza pu\c3\b2 evitare un grande disastro. Un momento di impazienza pu\c3\b2 rovinare una vita intera.") ;; #0583 it
  (data (i32.const 421722) "La pazienza non \c3\a8 solo la capacit\c3\a0 di aspettare; \c3\a8 il modo in cui ci comportiamo mentre aspettiamo.") ;; #0584 it
  (data (i32.const 421824) "Roma non fu costruita in un giorno.") ;; #0585 it
  (data (i32.const 421859) "Tutto arriva a poco a poco e al momento stabilito.") ;; #0586 it
  (data (i32.const 421909) "Sii paziente e forte; un giorno questo dolore ti sar\c3\a0 utile.") ;; #0587 it
  (data (i32.const 421970) "La goccia scava la pietra, non con la forza, ma con la costanza.") ;; #0588 it
  (data (i32.const 422034) "Tutta la saggezza umana si riassume in due parole: attendere e sperare.") ;; #0589 it
  (data (i32.const 422105) "La chiave di tutto \c3\a8 la pazienza. Il pulcino si ottiene covando l'uovo, non rompendolo.") ;; #0590 it
  (data (i32.const 422193) "La pazienza e il tempo fanno pi\c3\b9 della forza o della passione.") ;; #0591 it
  (data (i32.const 422256) "La nostra pazienza otterr\c3\a0 pi\c3\b9 della nostra forza.") ;; #0592 it
  (data (i32.const 422308) "Come sono poveri quelli che non hanno pazienza! Quale ferita \c3\a8 mai guarita se non a poco a poco?") ;; #0593 it
  (data (i32.const 422405) "La pazienza \c3\a8 l'arte di sperare.") ;; #0594 it
  (data (i32.const 422438) "Un pugno di pazienza vale pi\c3\b9 di un sacco di cervello.") ;; #0595 it
  (data (i32.const 422493) "Anche la pazienza \c3\a8 una forma di azione.") ;; #0596 it
  (data (i32.const 422534) "Chi va piano va sano e va lontano.") ;; #0597 it
  (data (i32.const 422568) "Con il tempo e la pazienza, la foglia di gelso diventa seta.") ;; #0598 it
  (data (i32.const 422628) "La pazienza attira la felicit\c3\a0; avvicina ci\c3\b2 che \c3\a8 lontano.") ;; #0599 it
  (data (i32.const 422690) "Perdere la pazienza \c3\a8 perdere la battaglia.") ;; #0600 it
  (data (i32.const 422734) "La pazienza \c3\a8 potere. La pazienza non \c3\a8 assenza di azione; \c3\a8 saper scegliere il momento.") ;; #0601 it
  (data (i32.const 422825) "Saggio nel decidere e paziente nell'eseguire.") ;; #0602 it
  (data (i32.const 422870) "Sono straordinariamente paziente, purch\c3\a9 alla fine si faccia a modo mio.") ;; #0603 it
  (data (i32.const 422943) "Se sei paziente in un momento di rabbia, eviterai cento giorni di dolore.") ;; #0604 it
  (data (i32.const 423016) "La pazienza \c3\a8 il sostegno della debolezza; l'impazienza, la rovina della forza.") ;; #0605 it
  (data (i32.const 423096) "La resistenza \c3\a8 pazienza concentrata.") ;; #0606 it
  (data (i32.const 423134) "La pazienza e la diligenza, come la fede, spostano le montagne.") ;; #0607 it
  (data (i32.const 423197) "Guardati dalla furia di un uomo paziente.") ;; #0608 it
  (data (i32.const 423238) "La pazienza \c3\a8 la chiave del paradiso.") ;; #0609 it
  (data (i32.const 423276) "Abbi pazienza verso tutto ci\c3\b2 che \c3\a8 irrisolto nel tuo cuore.") ;; #0610 it
  (data (i32.const 423338) "Nessuna grande cosa nasce all'improvviso.") ;; #0611 it
  (data (i32.const 423379) "Forse un giorno sar\c3\a0 piacevole ricordare anche questo.") ;; #0612 it
  (data (i32.const 423434) "Resistete, e serbatevi a giorni migliori.") ;; #0613 it
  (data (i32.const 423475) "Sopporta, mio cuore; hai sopportato di peggio.") ;; #0614 it
  (data (i32.const 423521) "Anche questo passer\c3\a0.") ;; #0615 it
  (data (i32.const 423543) "Non rinunciare mai a un sogno solo per il tempo che ci vorr\c3\a0 per realizzarlo. Il tempo passer\c3\a0 comunque.") ;; #0616 it
  (data (i32.const 423649) "Lascia che tutto ti accada: bellezza e terrore. Continua ad andare. Nessun sentimento \c3\a8 definitivo.") ;; #0617 it
  (data (i32.const 423749) "Nessun fiocco di neve cade mai nel posto sbagliato.") ;; #0618 it
  (data (i32.const 423800) "Lascia andare o sarai trascinato.") ;; #0619 it
  (data (i32.const 423833) "La determinazione \c3\a8 la sveglia della volont\c3\a0 umana.") ;; #0620 it
  (data (i32.const 423886) "La differenza tra l'impossibile e il possibile sta nella determinazione di una persona.") ;; #0621 it
  (data (i32.const 423973) "Fissa obiettivi alti e non fermarti finch\c3\a9 non li raggiungi.") ;; #0622 it
  (data (i32.const 424034) "Il desiderio \c3\a8 la chiave della motivazione, ma sono la determinazione e l'impegno in una ricerca instancabile del tuo obiettivo a permetterti di raggiungere il successo che cerchi.") ;; #0623 it
  (data (i32.const 424215) "Ogni ostacolo \c3\a8 distrutto dal rigore.") ;; #0624 it
  (data (i32.const 424253) "Non mi scoraggio, perch\c3\a9 ogni tentativo sbagliato che scarto \c3\a8 un altro passo avanti.") ;; #0625 it
  (data (i32.const 424340) "Non lasciare mai che la paura di sbagliare ti impedisca di giocare la partita.") ;; #0626 it
  (data (i32.const 424418) "Se non riesci a giocare meglio di loro, lavora pi\c3\b9 di loro.") ;; #0627 it
  (data (i32.const 424478) "Penso davvero che un campione non si definisca dalle vittorie, ma da come riesce a rialzarsi quando cade.") ;; #0628 it
  (data (i32.const 424583) "Devi credere in te stesso quando nessun altro lo fa.") ;; #0629 it
  (data (i32.const 424635) "Pi\c3\b9 difficile \c3\a8 la vittoria, pi\c3\b9 grande \c3\a8 la gioia di vincere.") ;; #0630 it
  (data (i32.const 424701) "Le medaglie d'oro non sono fatte d'oro. Sono fatte di sudore, determinazione e una lega rara chiamata fegato.") ;; #0631 it
  (data (i32.const 424810) "L'et\c3\a0 non \c3\a8 un ostacolo. \c3\88 un limite che imponi alla tua mente.") ;; #0632 it
  (data (i32.const 424876) "La differenza tra ordinario e straordinario \c3\a8 quel piccolo extra.") ;; #0633 it
  (data (i32.const 424942) "Vincere non \c3\a8 tutto, ma voler vincere s\c3\ac.") ;; #0634 it
  (data (i32.const 424985) "La perfezione non \c3\a8 raggiungibile, ma se inseguiamo la perfezione possiamo raggiungere l'eccellenza.") ;; #0635 it
  (data (i32.const 425086) "Una volta che impari a mollare, diventa un'abitudine.") ;; #0636 it
  (data (i32.const 425139) "Oggi far\c3\b2 ci\c3\b2 che gli altri non fanno, cos\c3\ac domani potr\c3\b2 ottenere ci\c3\b2 che gli altri non possono.") ;; #0637 it
  (data (i32.const 425240) "Non puoi porre limiti a niente. Pi\c3\b9 sogni, pi\c3\b9 lontano arrivi.") ;; #0638 it
  (data (i32.const 425304) "C'\c3\a8 chi parte meglio di me, ma io finisco forte.") ;; #0639 it
  (data (i32.const 425353) "Nulla di grande \c3\a8 mai stato realizzato senza entusiasmo.") ;; #0640 it
  (data (i32.const 425410) "Preferisco essere cenere che polvere!") ;; #0641 it
  (data (i32.const 425447) "Decidi di non restare mai in ozio.") ;; #0642 it
  (data (i32.const 425481) "Un sogno non diventa realt\c3\a0 per magia; servono sudore, determinazione e duro lavoro.") ;; #0643 it
  (data (i32.const 425566) "Non ci sono segreti per il successo. \c3\88 il risultato della preparazione, del duro lavoro e dell'imparare dal fallimento.") ;; #0644 it
  (data (i32.const 425686) "La nostra pi\c3\b9 grande paura non dovrebbe essere il fallimento, ma avere successo in cose della vita che non contano davvero.") ;; #0645 it
  (data (i32.const 425810) "Siate affamati, siate folli.") ;; #0646 it
  (data (i32.const 425838) "Il vostro tempo \c3\a8 limitato, quindi non sprecatelo vivendo la vita di qualcun altro.") ;; #0647 it
  (data (i32.const 425922) "Se lavori a qualcosa di entusiasmante che ti sta davvero a cuore, non hai bisogno di essere spinto. \c3\88 la visione a trascinarti.") ;; #0648 it
  (data (i32.const 426050) "L'unico modo di fare un ottimo lavoro \c3\a8 amare quello che fate.") ;; #0649 it
  (data (i32.const 426113) "Non si possono unire i puntini guardando avanti; si possono unire solo guardando indietro.") ;; #0650 it
  (data (i32.const 426203) "A volte la vita ti colpisce in testa con un mattone. Non perdere la fede.") ;; #0651 it
  (data (i32.const 426276) "Quando una cosa \c3\a8 abbastanza importante, la fai anche se le probabilit\c3\a0 non sono a tuo favore.") ;; #0652 it
  (data (i32.const 426372) "Tieni sempre a mente che la tua determinazione a riuscire \c3\a8 pi\c3\b9 importante di qualsiasi altra cosa.") ;; #0653 it
  (data (i32.const 426473) "Il dolore \c3\a8 temporaneo. Arrendersi \c3\a8 per sempre.") ;; #0654 it
  (data (i32.const 426523) "Sono rimasta in piedi su una montagna di no per un solo s\c3\ac.") ;; #0655 it
  (data (i32.const 426583) "Ho dovuto guadagnarmi da vivere e crearmi le mie opportunit\c3\a0. Ma ce l'ho fatta!") ;; #0656 it
  (data (i32.const 426663) "Non ci sono arrivata desiderandolo o sperandolo, ma lavorando per ottenerlo.") ;; #0657 it
  (data (i32.const 426739) "Lotta per le cose che ti stanno a cuore, ma fallo in un modo che spinga gli altri a unirsi a te.") ;; #0658 it
  (data (i32.const 426835) "La vita non \c3\a8 facile per nessuno di noi. Ma che importa? Dobbiamo avere perseveranza e, soprattutto, fiducia in noi stessi.") ;; #0659 it
  (data (i32.const 426959) "Dobbiamo credere di essere dotati per qualcosa, e che questa cosa, a qualunque costo, debba essere raggiunta.") ;; #0660 it
  (data (i32.const 427068) "Non si nota mai ci\c3\b2 che \c3\a8 stato fatto; si vede solo ci\c3\b2 che resta da fare.") ;; #0661 it
  (data (i32.const 427145) "Alzo la mia voce non per gridare, ma perch\c3\a9 chi non ha voce possa essere ascoltato.") ;; #0662 it
  (data (i32.const 427229) "Un bambino, un insegnante, un libro e una penna possono cambiare il mondo.") ;; #0663 it
  (data (i32.const 427303) "Quando il mondo intero tace, anche una sola voce diventa potente.") ;; #0664 it
  (data (i32.const 427368) "Perch\c3\a9 \c3\a8 l\c3\ac.") ;; #0665 it
  (data (i32.const 427383) "Questo \c3\a8 un piccolo passo per un uomo, ma un balzo gigantesco per l'umanit\c3\a0.") ;; #0666 it
  (data (i32.const 427461) "Non dirmi che il limite \c3\a8 il cielo quando ci sono impronte sulla Luna.") ;; #0667 it
  (data (i32.const 427532) "La Terra \c3\a8 la culla dell'umanit\c3\a0, ma non si pu\c3\b2 vivere per sempre in una culla.") ;; #0668 it
  (data (i32.const 427614) "L'esplorazione \c3\a8 davvero l'essenza dello spirito umano.") ;; #0669 it
  (data (i32.const 427670) "I guerrieri vittoriosi prima vincono e poi vanno in guerra, mentre quelli sconfitti prima vanno in guerra e poi cercano di vincere.") ;; #0670 it
  (data (i32.const 427801) "Tutti i nostri sogni possono avverarsi, se abbiamo il coraggio di inseguirli.") ;; #0671 it
  (data (i32.const 427878) "Primo, pensa. Secondo, sogna. Terzo, credi. E infine, osa.") ;; #0672 it
  (data (i32.const 427936) "Un sogno che sogni da solo \c3\a8 solo un sogno. Un sogno che sogni insieme agli altri \c3\a8 realt\c3\a0.") ;; #0673 it
  (data (i32.const 428030) "Aggrappati ai sogni, perch\c3\a9 se i sogni muoiono, la vita \c3\a8 un uccello con le ali spezzate che non pu\c3\b2 volare.") ;; #0674 it
  (data (i32.const 428141) "I sogni sono la pietra di paragone del nostro carattere.") ;; #0675 it
  (data (i32.const 428197) "Non lasciare che nessuno ti rubi l'immaginazione, la creativit\c3\a0 o la curiosit\c3\a0.") ;; #0676 it
  (data (i32.const 428278) "Non lasciare mai che i tuoi ricordi siano pi\c3\b9 grandi dei tuoi sogni.") ;; #0677 it
  (data (i32.const 428347) "Tutti gli uomini sognano, ma non allo stesso modo.") ;; #0678 it
  (data (i32.const 428397) "I sogni si avverano. Senza questa possibilit\c3\a0, la natura non ci spingerebbe ad averli.") ;; #0679 it
  (data (i32.const 428484) "Custodisci le tue visioni e i tuoi sogni, perch\c3\a9 sono figli della tua anima, i progetti dei tuoi pi\c3\b9 grandi traguardi.") ;; #0680 it
  (data (i32.const 428604) "Il punto di partenza di ogni conquista \c3\a8 il desiderio.") ;; #0681 it
  (data (i32.const 428659) "Un obiettivo \c3\a8 un sogno con una scadenza.") ;; #0682 it
  (data (i32.const 428701) "\c3\88 la possibilit\c3\a0 di realizzare un sogno che rende la vita interessante.") ;; #0683 it
  (data (i32.const 428774) "E quando desideri qualcosa, tutto l'universo cospira affinch\c3\a9 tu realizzi il tuo desiderio.") ;; #0684 it
  (data (i32.const 428866) "Sogna come se dovessi vivere per sempre. Vivi come se dovessi morire oggi.") ;; #0685 it
  (data (i32.const 428940) "La pi\c3\b9 grande avventura che puoi intraprendere \c3\a8 vivere la vita dei tuoi sogni.") ;; #0686 it
  (data (i32.const 429021) "Punta in alto, perch\c3\a9 in te si nascondono le stelle. Sogna in profondit\c3\a0, perch\c3\a9 ogni sogno precede la meta.") ;; #0687 it
  (data (i32.const 429132) "Sogno i miei quadri e dipingo i miei sogni.") ;; #0688 it
  (data (i32.const 429175) "I sogni non funzionano se non lavori tu.") ;; #0689 it
  (data (i32.const 429215) "Mantieni vivi i tuoi sogni. Comprendi che realizzare qualsiasi cosa richiede fede e fiducia in s\c3\a9, visione, duro lavoro, determinazione e dedizione.") ;; #0690 it
  (data (i32.const 429364) "Se puoi immaginarlo, puoi realizzarlo.") ;; #0691 it
  (data (i32.const 429402) "I sognatori sono i salvatori del mondo.") ;; #0692 it
  (data (i32.const 429441) "Fai sogni elevati, e come sognerai, cos\c3\ac diventerai.") ;; #0693 it
  (data (i32.const 429494) "Alcune persone sognano il successo, mentre altre si alzano ogni mattina e lo fanno accadere.") ;; #0694 it
  (data (i32.const 429586) "Io ho un sogno.") ;; #0695 it
  (data (i32.const 429601) "Ci\c3\b2 che oggi \c3\a8 dimostrato un tempo era solo immaginato.") ;; #0696 it
  (data (i32.const 429658) "Punta alla Luna. Se la manchi, potresti colpire una stella.") ;; #0697 it
  (data (i32.const 429717) "Nulla accade se prima non lo sogniamo.") ;; #0698 it
  (data (i32.const 429755) "Chi sogna di giorno conosce molte cose che sfuggono a chi sogna solo di notte.") ;; #0699 it
  (data (i32.const 429833) "Per compiere grandi cose non basta agire, bisogna anche sognare; non basta pianificare, bisogna anche credere.") ;; #0700 it
  (data (i32.const 429943) "Segui la tua beatitudine e l'universo aprir\c3\a0 porte dove prima c'erano solo muri.") ;; #0701 it
  (data (i32.const 430024) "Senza slanci di immaginazione o di sogno, perdiamo l'entusiasmo delle possibilit\c3\a0.") ;; #0702 it
  (data (i32.const 430107) "Sognare, dopotutto, \c3\a8 un modo di pianificare.") ;; #0703 it
  (data (i32.const 430153) "Stai andando verso posti fantastici! Oggi \c3\a8 il tuo giorno! La tua montagna ti aspetta, quindi mettiti in cammino!") ;; #0704 it
  (data (i32.const 430267) "Hai un cervello nella testa. Hai i piedi nelle scarpe. Puoi andare in qualsiasi direzione tu scelga.") ;; #0705 it
  (data (i32.const 430367) "A meno che qualcuno come te non ci tenga davvero tantissimo, niente migliorer\c3\a0. Niente.") ;; #0706 it
  (data (i32.const 430455) "Dimmi, che cosa pensi di fare della tua unica vita, selvaggia e preziosa?") ;; #0707 it
  (data (i32.const 430528) "Due strade divergevano in un bosco, e io, io presi quella meno battuta, e questo ha fatto tutta la differenza.") ;; #0708 it
  (data (i32.const 430638) "Non tutti quelli che vagano sono perduti.") ;; #0709 it
  (data (i32.const 430679) "Ho fatto un respiro profondo e ho ascoltato il vecchio vanto del mio cuore: io sono, io sono, io sono.") ;; #0710 it
  (data (i32.const 430781) "Forse tutti i draghi della nostra vita sono principesse che aspettano solo di vederci agire, una volta sola, con bellezza e coraggio.") ;; #0711 it
  (data (i32.const 430914) "Che cosa tenteresti di fare se sapessi di non poter fallire?") ;; #0712 it
  (data (i32.const 430974) "Ho visto l'angelo nel marmo e ho scolpito fino a liberarlo.") ;; #0713 it
  (data (i32.const 431033) "Le persone con degli obiettivi hanno successo perch\c3\a9 sanno dove stanno andando.") ;; #0714 it
  (data (i32.const 431113) "Ci\c3\b2 che cerchi sta cercando te.") ;; #0715 it
  (data (i32.const 431145) "Non affliggerti. Tutto ci\c3\b2 che perdi ritorna in un'altra forma.") ;; #0716 it
  (data (i32.const 431209) "Dai fuoco alla tua vita. Cerca chi alimenta le tue fiamme.") ;; #0717 it
  (data (i32.const 431267) "Ieri ero intelligente, cos\c3\ac volevo cambiare il mondo. Oggi sono saggio, cos\c3\ac sto cambiando me stesso.") ;; #0718 it
  (data (i32.const 431370) "Sei nato con le ali, perch\c3\a9 preferisci strisciare nella vita?") ;; #0719 it
  (data (i32.const 431432) "Rispondi a ogni richiamo che entusiasma il tuo spirito.") ;; #0720 it
  (data (i32.const 431487) "Se ti irrita ogni attrito, come potr\c3\a0 essere levigato il tuo specchio?") ;; #0721 it
  (data (i32.const 431558) "I dolori che senti sono messaggeri. Ascoltali.") ;; #0722 it
  (data (i32.const 431604) "La libert\c3\a0 \c3\a8 l'unico obiettivo degno nella vita. Si conquista smettendo di curarsi di ci\c3\b2 che non dipende da noi.") ;; #0723 it
  (data (i32.const 431720) "Non spiegare la tua filosofia. Incarnala.") ;; #0724 it
  (data (i32.const 431761) "Se vuoi migliorare, accetta di essere considerato sciocco e ignorante.") ;; #0725 it
  (data (i32.const 431831) "Finch\c3\a9 vivi, continua a imparare a vivere.") ;; #0726 it
  (data (i32.const 431874) "A volte anche vivere \c3\a8 un atto di coraggio.") ;; #0727 it
  (data (i32.const 431918) "Nessun vento \c3\a8 favorevole per chi non sa dove andare.") ;; #0728 it
  (data (i32.const 431972) "La fortuna \c3\a8 ci\c3\b2 che accade quando la preparazione incontra l'opportunit\c3\a0.") ;; #0729 it
  (data (i32.const 432049) "Ieri \c3\a8 storia, domani \c3\a8 un mistero, oggi \c3\a8 un dono di Dio, ed \c3\a8 per questo che si chiama presente.") ;; #0730 it
  (data (i32.const 432151) "Se vuoi andare veloce, vai da solo. Se vuoi andare lontano, vai insieme agli altri.") ;; #0731 it
  (data (i32.const 432234) "Non abbiate paura.") ;; #0732 it
  (data (i32.const 432252) "Non ho paura del domani, perch\c3\a9 ho visto ieri e amo l'oggi.") ;; #0733 it
  (data (i32.const 432312) "Ogni giorno \c3\a8 un giorno nuovo.") ;; #0734 it
  (data (i32.const 432343) "L'unico viaggio \c3\a8 quello interiore.") ;; #0735 it
  (data (i32.const 432379) "Ancora imparo.") ;; #0736 it
  (data (i32.const 432393) "Non conta la lunghezza della vita, ma la sua profondit\c3\a0.") ;; #0737 it
  (data (i32.const 432450) "Una volta presa una decisione, l'universo cospira perch\c3\a9 si realizzi.") ;; #0738 it
  (data (i32.const 432520) "Essere grandi significa essere fraintesi.") ;; #0739 it
  (data (i32.const 432561) "Concludi ogni giornata e lasciala alle spalle. Hai fatto ci\c3\b2 che potevi.") ;; #0740 it
  (data (i32.const 432634) "Gli anni insegnano molte cose che i giorni non sanno.") ;; #0741 it
  (data (i32.const 432687) "Scrivi nel tuo cuore che ogni giorno \c3\a8 il giorno migliore dell'anno.") ;; #0742 it
  (data (i32.const 432756) "La vita pu\c3\b2 essere capita solo guardando indietro, ma deve essere vissuta guardando avanti.") ;; #0743 it
  (data (i32.const 432848) "Gli inizi sono sempre disordinati.") ;; #0744 it
  (data (i32.const 432882) "La visione \c3\a8 l'arte di vedere ci\c3\b2 che \c3\a8 invisibile agli altri.") ;; #0745 it
  (data (i32.const 432947) "Quando una porta della felicit\c3\a0 si chiude, se ne apre un'altra.") ;; #0746 it
  (data (i32.const 433011) "Da soli possiamo fare cos\c3\ac poco; insieme possiamo fare cos\c3\ac tanto.") ;; #0747 it
  (data (i32.const 433079) "L'unica cosa peggiore dell'essere ciechi \c3\a8 avere la vista ma non avere una visione.") ;; #0748 it
  (data (i32.const 433163) "Nessun pessimista ha mai scoperto il segreto delle stelle, n\c3\a9 navigato verso una terra inesplorata.") ;; #0749 it
  (data (i32.const 433263) "Possiamo fare tutto ci\c3\b2 che vogliamo, se perseveriamo abbastanza a lungo.") ;; #0750 it
  (data (i32.const 433337) "Ci\c3\b2 che cerco non \c3\a8 l\c3\a0 fuori, \c3\a8 dentro di me.") ;; #0751 it
  (data (i32.const 433386) "L'impegno e il coraggio non bastano senza uno scopo e una direzione.") ;; #0752 it
  (data (i32.const 433454) "Il mondo cambia con il tuo esempio, non con la tua opinione.") ;; #0753 it
  (data (i32.const 433514) "Non possiamo aiutare tutti, ma tutti possono aiutare qualcuno.") ;; #0754 it
  (data (i32.const 433576) "Ogni persona deve vivere la propria vita come un esempio per gli altri.") ;; #0755 it
  (data (i32.const 433647) "Se non ti piace la strada che stai percorrendo, comincia a costruirne un'altra.") ;; #0756 it
  (data (i32.const 433726) "Dalla vita ottieni ci\c3\b2 che hai il coraggio di chiedere.") ;; #0757 it
  (data (i32.const 433782) "Il successo non \c3\a8 quanti soldi guadagni; \c3\a8 la differenza che fai nella vita delle persone.") ;; #0758 it
  (data (i32.const 433874) "Non c'\c3\a8 agonia pi\c3\b9 grande che portare dentro di s\c3\a9 una storia non raccontata.") ;; #0759 it
  (data (i32.const 433954) "Ci rendiamo conto dell'importanza della nostra voce solo quando veniamo messi a tacere.") ;; #0760 it
  (data (i32.const 434041) "Il successo non \c3\a8 quanto in alto sei salito, ma come fai una differenza positiva nel mondo.") ;; #0761 it
  (data (i32.const 434133) "La miglior vendetta \c3\a8 un successo enorme.") ;; #0762 it
  (data (i32.const 434175) "Il lutto pu\c3\b2 essere il giardino della compassione.") ;; #0763 it
  (data (i32.const 434226) "Continua ad andare avanti, ed \c3\a8 probabile che tu inciampi in qualcosa, magari quando meno te lo aspetti.") ;; #0764 it
  (data (i32.const 434331) "Il duro lavoro senza talento \c3\a8 un peccato, ma il talento senza duro lavoro \c3\a8 una tragedia.") ;; #0765 it
  (data (i32.const 434423) "Non \c3\a8 finita finch\c3\a9 non \c3\a8 finita.") ;; #0766 it
  (data (i32.const 434459) "O troveremo una strada, o ne apriremo una.") ;; #0767 it
  (data (i32.const 434501) "Il segreto del successo \c3\a8 la costanza nello scopo.") ;; #0768 it
  (data (i32.const 434552) "Persisti e persevera, e scoprirai che la maggior parte delle cose raggiungibili \c3\a8 possibile.") ;; #0769 it
  (data (i32.const 434645) "La maggior parte delle persone si arrende proprio quando sta per avere successo. Mollano a un passo dal traguardo.") ;; #0770 it
  (data (i32.const 434759) "Se devi dubitare di qualcosa, dubita dei tuoi limiti.") ;; #0771 it
  (data (i32.const 434812) "Niente pu\c3\b2 sostituire il duro lavoro.") ;; #0772 it
  (data (i32.const 434850) "La differenza tra provare e trionfare \c3\a8 solo un pizzico di grinta in pi\c3\b9!") ;; #0773 it
  (data (i32.const 434925) "La perseveranza \c3\a8 fallire diciannove volte e riuscire alla ventesima.") ;; #0774 it
  (data (i32.const 434995) "La perseveranza sta al carattere dell'uomo come il carbonio sta all'acciaio.") ;; #0775 it
  (data (i32.const 435071) "L'uomo che sa spingersi oltre quando lo sforzo diventa doloroso \c3\a8 quello che vincer\c3\a0.") ;; #0776 it
  (data (i32.const 435158) "Non arrenderti. Non arrenderti mai.") ;; #0777 it
  (data (i32.const 435193) "Molte persone sono andate pi\c3\b9 lontano di quanto pensassero perch\c3\a9 qualcun altro credeva che potessero farcela.") ;; #0778 it
  (data (i32.const 435305) "Non puoi salire la scala del successo con le mani in tasca.") ;; #0779 it
  (data (i32.const 435364) "I traguardi di oggi erano le cose impossibili di ieri.") ;; #0780 it
  (data (i32.const 435418) "Niente \c3\a8 particolarmente difficile se lo dividi in piccoli compiti.") ;; #0781 it
  (data (i32.const 435486) "La perseveranza e lo spirito hanno fatto meraviglie in ogni epoca.") ;; #0782 it
  (data (i32.const 435552) "Il coraggio \c3\a8 il prezzo che la vita esige per concedere la pace.") ;; #0783 it
  (data (i32.const 435617) "L'avventura vale la pena di per s\c3\a9.") ;; #0784 it
  (data (i32.const 435653) "Il coraggio \c3\a8 una storia d'amore con l'ignoto.") ;; #0785 it
  (data (i32.const 435700) "Ci\c3\b2 che devi fare quando una cosa non ti piace \c3\a8 cambiarla.") ;; #0786 it
  (data (i32.const 435761) "Sii coraggioso. Corri dei rischi. Niente pu\c3\b2 sostituire l'esperienza.") ;; #0787 it
  (data (i32.const 435831) "Chi \c3\a8 coraggioso \c3\a8 libero.") ;; #0788 it
  (data (i32.const 435859) "Non devo avere paura. La paura uccide la mente.") ;; #0789 it
  (data (i32.const 435906) "Il coraggio \c3\a8 la qualit\c3\a0 principale di un leader.") ;; #0790 it
  (data (i32.const 435957) "La cosa pi\c3\b9 coraggiosa che puoi fare quando non ti senti coraggioso \c3\a8 dichiararti coraggioso e agire di conseguenza.") ;; #0791 it
  (data (i32.const 436075) "Il coraggio \c3\a8 fare ci\c3\b2 che ti fa paura. Non pu\c3\b2 esserci coraggio senza paura.") ;; #0792 it
  (data (i32.const 436155) "La fortuna e l'amore aiutano gli audaci.") ;; #0793 it
  (data (i32.const 436195) "Esponiti alla tua paura pi\c3\b9 profonda; dopo, la paura non avr\c3\a0 pi\c3\b9 potere.") ;; #0794 it
  (data (i32.const 436271) "Il coraggio \c3\a8 come l'amore: ha bisogno di speranza per nutrirsi.") ;; #0795 it
  (data (i32.const 436336) "\c3\88 curioso che il coraggio fisico sia cos\c3\ac comune nel mondo, e il coraggio morale cos\c3\ac raro.") ;; #0796 it
  (data (i32.const 436430) "Il contrario del coraggio, nella nostra societ\c3\a0, non \c3\a8 la codardia, \c3\a8 il conformismo.") ;; #0797 it
  (data (i32.const 436518) "I codardi muoiono molte volte prima della loro morte; i valorosi assaggiano la morte una volta sola.") ;; #0798 it
  (data (i32.const 436618) "Non aver paura della grandezza: alcuni nascono grandi, altri raggiungono la grandezza, altri ancora se la vedono imporre.") ;; #0799 it
  (data (i32.const 436739) "Tendi il tuo coraggio fino all'ultimo, e non falliremo.") ;; #0800 it
  (data (i32.const 436794) "Il coraggio \c3\a8 la paura che resiste un minuto in pi\c3\b9.") ;; #0801 it
  (data (i32.const 436848) "Fallire non \c3\a8 cadere, ma rifiutarsi di rialzarsi.") ;; #0802 it
  (data (i32.const 436898) "L'uomo di successo trae profitto dai propri errori e ci riprova in un modo diverso.") ;; #0803 it
  (data (i32.const 436981) "Costruisci il successo partendo dai fallimenti. Lo scoraggiamento e il fallimento sono due dei gradini pi\c3\b9 sicuri verso il successo.") ;; #0804 it
  (data (i32.const 437114) "Gli errori sono sempre perdonabili, se si ha il coraggio di ammetterli.") ;; #0805 it
  (data (i32.const 437185) "Non temere gli errori. Non ce ne sono.") ;; #0806 it
  (data (i32.const 437223) "Quando commetti un errore, ci sono solo tre cose da fare: ammetterlo, imparare da esso e non ripeterlo.") ;; #0807 it
  (data (i32.const 437326) "Il fallimento \c3\a8 una deviazione, non un vicolo cieco.") ;; #0808 it
  (data (i32.const 437379) "Un fallimento non \c3\a8 sempre un errore. Pu\c3\b2 essere semplicemente il meglio che si potesse fare in quelle circostanze. Il vero errore \c3\a8 smettere di provare.") ;; #0809 it
  (data (i32.const 437535) "Se non fallisci ogni tanto, \c3\a8 segno che non stai facendo nulla di molto innovativo.") ;; #0810 it
  (data (i32.const 437619) "Il fallimento capita sempre. Capita ogni giorno in allenamento. Ci\c3\b2 che ti rende migliore \c3\a8 come reagisci.") ;; #0811 it
  (data (i32.const 437727) "Non esistono errori o fallimenti, solo lezioni.") ;; #0812 it
  (data (i32.const 437774) "Ho imparato di pi\c3\b9 dai miei errori che dai miei successi.") ;; #0813 it
  (data (i32.const 437832) "\c3\88 il fallimento a darti la giusta prospettiva sul successo.") ;; #0814 it
  (data (i32.const 437892) "Il successo \c3\a8 quanto in alto rimbalzi quando tocchi il fondo.") ;; #0815 it
  (data (i32.const 437954) "Non lasciare che la paura di perdere sia pi\c3\b9 grande dell'emozione di vincere.") ;; #0816 it
  (data (i32.const 438032) "Impariamo dal fallimento, non dal successo!") ;; #0817 it
  (data (i32.const 438075) "Non puoi avere paura di fallire. \c3\88 l'unico modo per avere successo.") ;; #0818 it
  (data (i32.const 438143) "Un uomo non \c3\a8 finito quando viene sconfitto. \c3\88 finito quando si arrende.") ;; #0819 it
  (data (i32.const 438217) "Lo spirito umano \c3\a8 pi\c3\b9 forte di qualsiasi cosa possa accadergli.") ;; #0820 it
  (data (i32.const 438283) "La vita non \c3\a8 quanto veloce corri o quanto in alto sali, ma quanto bene ti rialzi.") ;; #0821 it
  (data (i32.const 438366) "Senza fango, niente loto.") ;; #0822 it
  (data (i32.const 438391) "Se vuoi vedere il sole, devi affrontare la tempesta.") ;; #0823 it
  (data (i32.const 438443) "Le persone pi\c3\b9 forti trovano il coraggio e l'affetto per aiutare gli altri, anche quando stanno attraversando la propria tempesta.") ;; #0824 it
  (data (i32.const 438574) "Non esiste rovinarsi la vita. La vita, alla fine, \c3\a8 una cosa piuttosto resiliente.") ;; #0825 it
  (data (i32.const 438657) "La resilienza \c3\a8 sapere che sei l'unico ad avere il potere e la responsabilit\c3\a0 di rialzarti.") ;; #0826 it
  (data (i32.const 438750) "Una volta affrontata la tua paura, niente \c3\a8 mai difficile come pensi.") ;; #0827 it
  (data (i32.const 438820) "Quando la vita ti butta a terra, cerca di cadere di schiena. Perch\c3\a9 se riesci a guardare in alto, riesci a rialzarti.") ;; #0828 it
  (data (i32.const 438938) "Da ogni crisi nasce la possibilit\c3\a0 di rinascere.") ;; #0829 it
  (data (i32.const 438987) "Niente \c3\a8 permanente in questo mondo crudele, nemmeno i nostri guai.") ;; #0830 it
  (data (i32.const 439055) "Le avversit\c3\a0 fanno o distruggono le persone.") ;; #0831 it
  (data (i32.const 439100) "Trasforma le tue cicatrici in stelle.") ;; #0832 it
  (data (i32.const 439137) "Il cancro pu\c3\b2 portarmi via tutte le mie capacit\c3\a0 fisiche. Ma non pu\c3\b2 toccare la mia mente, non pu\c3\b2 toccare il mio cuore e non pu\c3\b2 toccare la mia anima.") ;; #0833 it
  (data (i32.const 439293) "Sii acqua, amico mio.") ;; #0834 it
  (data (i32.const 439314) "I giorni difficili sono i migliori, perch\c3\a9 \c3\a8 l\c3\ac che nascono i campioni.") ;; #0835 it
  (data (i32.const 439388) "C'\c3\a8 sempre luce, se solo abbiamo il coraggio di vederla. Se solo abbiamo il coraggio di esserla.") ;; #0836 it
  (data (i32.const 439485) "La speranza \c3\a8 un verbo con le maniche rimboccate.") ;; #0837 it
  (data (i32.const 439535) "Sperare \c3\a8 consegnarsi al futuro.") ;; #0838 it
  (data (i32.const 439568) "La speranza non \c3\a8 un biglietto della lotteria da stringere sul divano sentendosi fortunati. \c3\88 un'ascia con cui sfondare le porte in caso di emergenza.") ;; #0839 it
  (data (i32.const 439720) "Stiamo di buon animo, ricordando che le disgrazie pi\c3\b9 difficili da sopportare sono quelle che non arrivano mai.") ;; #0840 it
  (data (i32.const 439832) "Il modo migliore per tirarsi su il morale \c3\a8 cercare di tirarlo su a qualcun altro.") ;; #0841 it
  (data (i32.const 439915) "Quando splende il sole, posso fare qualsiasi cosa; nessuna montagna \c3\a8 troppo alta, nessun problema troppo difficile da superare.") ;; #0842 it
  (data (i32.const 440044) "Non dubitate mai che un piccolo gruppo di cittadini consapevoli e impegnati possa cambiare il mondo.") ;; #0843 it
  (data (i32.const 440144) "Tieni il viso rivolto al sole e non vedrai l'ombra.") ;; #0844 it
  (data (i32.const 440195) "Un giorno, guardando indietro, gli anni della lotta ti sembreranno i pi\c3\b9 belli.") ;; #0845 it
  (data (i32.const 440275) "Alla fine, tutto si sistema. Se non si \c3\a8 sistemato, vuol dire che non \c3\a8 ancora la fine.") ;; #0846 it
  (data (i32.const 440364) "La speranza \c3\a8 compagna del potere e madre del successo.") ;; #0847 it
  (data (i32.const 440420) "La speranza \c3\a8 gi\c3\a0, di per s\c3\a9, una forma di felicit\c3\a0.") ;; #0848 it
  (data (i32.const 440476) "Il sole non splende su di noi, ma dentro di noi.") ;; #0849 it
  (data (i32.const 440524) "La speranza risveglia, come nient'altro pu\c3\b2 fare, una passione per il possibile.") ;; #0850 it
  (data (i32.const 440605) "Non lasciare che il tuo fuoco si spenga, scintilla dopo scintilla insostituibile.") ;; #0851 it
  (data (i32.const 440686) "Siamo tutti nel fango, ma alcuni di noi guardano le stelle.") ;; #0852 it
  (data (i32.const 440745) "Pi\c3\b9 buia \c3\a8 la notte, pi\c3\b9 luminose sono le stelle; pi\c3\b9 profondo \c3\a8 il dolore, pi\c3\b9 vicino \c3\a8 Dio!") ;; #0853 it
  (data (i32.const 440845) "Le nuvole arrivano fluttuando nella mia vita, non pi\c3\b9 per portare pioggia o annunciare tempesta, ma per dare colore al mio cielo al tramonto.") ;; #0854 it
  (data (i32.const 440987) "Il carattere \c3\a8 potere.") ;; #0855 it
  (data (i32.const 441010) "Non ho paura; sono nata per fare questo.") ;; #0856 it
  (data (i32.const 441050) "L'autocontrollo \c3\a8 forza. Il pensiero giusto \c3\a8 padronanza. La calma \c3\a8 potere.") ;; #0857 it
  (data (i32.const 441129) "L'arma pi\c3\b9 grande contro lo stress \c3\a8 la nostra capacit\c3\a0 di scegliere un pensiero piuttosto che un altro.") ;; #0858 it
  (data (i32.const 441236) "Non desiderare di essere altro da ci\c3\b2 che sei, e cerca di esserlo perfettamente.") ;; #0859 it
  (data (i32.const 441317) "Nessuno ci salva se non noi stessi. Nessuno pu\c3\b2 e nessuno deve. Siamo noi a dover percorrere il sentiero.") ;; #0860 it
  (data (i32.const 441423) "Il potere non ti viene dato. Devi prendertelo.") ;; #0861 it
  (data (i32.const 441469) "Non mi limiter\c3\b2 solo perch\c3\a9 la gente non accetta che io sappia fare qualcos'altro.") ;; #0862 it
  (data (i32.const 441553) "Nessuno ha mai misurato, nemmeno i poeti, quanto possa contenere un cuore.") ;; #0863 it
  (data (i32.const 441627) "Non tutti possiamo fare grandi cose. Ma possiamo fare piccole cose con grande amore.") ;; #0864 it
  (data (i32.const 441711) "Anche se \c3\a8 piccola, \c3\a8 feroce.") ;; #0865 it
  (data (i32.const 441742) "Non puoi fuggire da una debolezza; prima o poi devi affrontarla fino in fondo, o soccombere.") ;; #0866 it
  (data (i32.const 441834) "Non andartene docile in quella buona notte. Infuriati, infuriati contro il morire della luce.") ;; #0867 it
  (data (i32.const 441927) "La forza non viene da ci\c3\b2 che sai fare. Viene dal superare le cose che un tempo pensavi di non poter fare.") ;; #0868 it
  (data (i32.const 442034) "L'eccellenza non \c3\a8 un'abilit\c3\a0. \c3\88 un atteggiamento.") ;; #0869 it
  (data (i32.const 442087) "Fai prima i lavori difficili. Quelli facili si sistemeranno da soli.") ;; #0870 it
  (data (i32.const 442155) "\c3\88 meglio non offrire nessuna scusa che offrirne una cattiva.") ;; #0871 it
  (data (i32.const 442216) "Il duro lavoro \c3\a8 una condanna solo se non ha significato.") ;; #0872 it
  (data (i32.const 442274) "Diventiamo giusti compiendo azioni giuste, temperanti compiendo azioni temperanti, coraggiosi compiendo azioni coraggiose.") ;; #0873 it
  (data (i32.const 442396) "Non confondere mai l'attivit\c3\a0 con il risultato.") ;; #0874 it
  (data (i32.const 442444) "Pi\c3\b9 lavori duro, pi\c3\b9 \c3\a8 difficile arrendersi.") ;; #0875 it
  (data (i32.const 442491) "La pratica non rende perfetti. Solo la pratica perfetta rende perfetti.") ;; #0876 it
  (data (i32.const 442562) "Il successo \c3\a8 dove la preparazione incontra l'opportunit\c3\a0.") ;; #0877 it
  (data (i32.const 442622) "Qualit\c3\a0 significa fare le cose bene quando nessuno sta guardando.") ;; #0878 it
  (data (i32.const 442688) "Sono le ultime tre o quattro ripetizioni a far crescere il muscolo.") ;; #0879 it
  (data (i32.const 442755) "L'autodisciplina comincia con la padronanza dei propri pensieri.") ;; #0880 it
  (data (i32.const 442819) "Ami la vita? Allora non sprecare il tempo, perch\c3\a9 \c3\a8 di questo che \c3\a8 fatta la vita.") ;; #0881 it
  (data (i32.const 442904) "Non mi fermo quando sono stanco. Mi fermo quando ho finito.") ;; #0882 it
  (data (i32.const 442963) "L'unico giorno facile \c3\a8 stato ieri.") ;; #0883 it
  (data (i32.const 442999) "Con gentilezza puoi scuotere il mondo.") ;; #0884 it
  (data (i32.const 443037) "Riesamina tutto ci\c3\b2 che ti \c3\a8 stato detto; scarta ci\c3\b2 che offende la tua anima.") ;; #0885 it
  (data (i32.const 443118) "Il cambiamento \c3\a8 il risultato finale di ogni vero apprendimento.") ;; #0886 it
  (data (i32.const 443183) "Chi smette di imparare \c3\a8 vecchio, che abbia vent'anni o ottanta.") ;; #0887 it
  (data (i32.const 443248) "Il vero viaggio di scoperta non consiste nel cercare nuove terre, ma nell'avere nuovi occhi.") ;; #0888 it
  (data (i32.const 443340) "Solo quando ci perdiamo cominciamo a capire noi stessi.") ;; #0889 it
  (data (i32.const 443395) "Le cose non cambiano; siamo noi a cambiare.") ;; #0890 it
  (data (i32.const 443438) "Il progresso comporta sempre dei rischi. Non puoi rubare la seconda base tenendo il piede sulla prima.") ;; #0891 it
  (data (i32.const 443540) "Il pericolo pi\c3\b9 grande nei periodi di turbolenza non \c3\a8 la turbolenza; \c3\a8 agire con la logica di ieri.") ;; #0892 it
  (data (i32.const 443643) "Dobbiamo essere disposti a lasciar andare la vita che avevamo pianificato per avere la vita che ci sta aspettando.") ;; #0893 it
  (data (i32.const 443757) "Il privilegio di una vita \c3\a8 diventare chi sei veramente.") ;; #0894 it
  (data (i32.const 443814) "Conoscere la propria oscurit\c3\a0 \c3\a8 il metodo migliore per affrontare l'oscurit\c3\a0 degli altri.") ;; #0895 it
  (data (i32.const 443906) "Non c'\c3\a8 presa di coscienza senza dolore.") ;; #0896 it
  (data (i32.const 443947) "Ci\c3\b2 che conta \c3\a8 quello che impari dopo aver creduto di sapere tutto.") ;; #0897 it
  (data (i32.const 444017) "Il nostro compito nella vita non \c3\a8 superare gli altri, ma superare noi stessi.") ;; #0898 it
  (data (i32.const 444096) "Essere ci\c3\b2 che siamo, e diventare ci\c3\b2 che siamo capaci di diventare, \c3\a8 l'unico fine della vita.") ;; #0899 it
  (data (i32.const 444194) "Quella che il bruco chiama la fine del mondo, il maestro la chiama farfalla.") ;; #0900 it
  (data (i32.const 444270) "Se non sei disposto a imparare, nessuno pu\c3\b2 aiutarti. Se sei determinato a imparare, nessuno pu\c3\b2 fermarti.") ;; #0901 it
  (data (i32.const 444378) "Nel lungo periodo, diamo forma alla nostra vita e diamo forma a noi stessi.") ;; #0902 it
  (data (i32.const 444453) "Dall'avversit\c3\a0 nasce l'opportunit\c3\a0.") ;; #0903 it
  (data (i32.const 444490) "L'avversit\c3\a0 \c3\a8 sempre stata considerata la condizione in cui l'uomo impara pi\c3\b9 facilmente a conoscere s\c3\a9 stesso.") ;; #0904 it
  (data (i32.const 444605) "I momenti difficili hanno un valore scientifico. Sono occasioni che un buon allievo non si lascerebbe sfuggire.") ;; #0905 it
  (data (i32.const 444716) "Ogni muro \c3\a8 una porta.") ;; #0906 it
  (data (i32.const 444739) "Il dolore e la sofferenza sono sempre inevitabili per una grande intelligenza e un cuore profondo.") ;; #0907 it
  (data (i32.const 444837) "Lunga e dura \c3\a8 la via che dall'inferno conduce alla luce.") ;; #0908 it
  (data (i32.const 444895) "Accetta le sfide, cos\c3\ac potrai provare l'euforia della vittoria.") ;; #0909 it
  (data (i32.const 444959) "Quando \c3\a8 evidente che gli obiettivi non possono essere raggiunti, non cambiare gli obiettivi; cambia i passi per arrivarci.") ;; #0910 it
  (data (i32.const 445083) "La vittoria \c3\a8 pi\c3\b9 dolce quando si \c3\a8 conosciuta la sconfitta.") ;; #0911 it
  (data (i32.const 445146) "\c3\88 un errore guardare troppo lontano. Si pu\c3\b2 affrontare un solo anello della catena del destino alla volta.") ;; #0912 it
  (data (i32.const 445254) "Non perdere tempo a battere contro un muro sperando di trasformarlo in una porta.") ;; #0913 it
  (data (i32.const 445335) "Comincia da qualsiasi punto.") ;; #0914 it
  (data (i32.const 445363) "L'azione \c3\a8 eloquenza.") ;; #0915 it
  (data (i32.const 445385) "Non aspettate i capi; fatelo da soli, da persona a persona.") ;; #0916 it
  (data (i32.const 445444) "Non giudicare ogni giorno dal raccolto che fai, ma dai semi che pianti.") ;; #0917 it
  (data (i32.const 445515) "Fai qualcosa di meraviglioso; la gente potrebbe imitarti.") ;; #0918 it
  (data (i32.const 445572) "\c3\88 sempre il momento giusto per fare ci\c3\b2 che \c3\a8 giusto.") ;; #0919 it
  (data (i32.const 445628) "Un obiettivo ben fissato \c3\a8 gi\c3\a0 raggiunto a met\c3\a0.") ;; #0920 it
  (data (i32.const 445679) "Le cose non accadono. Le cose si fanno accadere.") ;; #0921 it
  (data (i32.const 445727) "L'ottanta per cento del successo \c3\a8 esserci.") ;; #0922 it
  (data (i32.const 445771) "Non puoi costruirti una reputazione su ci\c3\b2 che farai.") ;; #0923 it
  (data (i32.const 445825) "Tu puoi rimandare, ma il tempo no.") ;; #0924 it
  (data (i32.const 445859) "Scrivi qualcosa che valga la pena di leggere, o fai qualcosa che valga la pena di scrivere.") ;; #0925 it
  (data (i32.const 445950) "Alcune persone vogliono che accada, altre sperano che accada, altre ancora lo fanno accadere.") ;; #0926 it
  (data (i32.const 446043) "Pi\c3\b9 voglio fare una cosa, meno la chiamo lavoro.") ;; #0927 it
  (data (i32.const 446092) "Il pessimista si lamenta del vento; l'ottimista spera che cambi; il realista regola le vele.") ;; #0928 it
  (data (i32.const 446184) "L'ottimismo \c3\a8 essenziale per la realizzazione, ed \c3\a8 anche il fondamento del coraggio e del vero progresso.") ;; #0929 it
  (data (i32.const 446292) "Sei ci\c3\b2 che credi di essere.") ;; #0930 it
  (data (i32.const 446321) "Credi e agisci come se fosse impossibile fallire.") ;; #0931 it
  (data (i32.const 446370) "La mente \c3\a8 luogo a s\c3\a9, e in s\c3\a9 pu\c3\b2 fare un cielo dell'inferno, un inferno del cielo.") ;; #0932 it
  (data (i32.const 446458) "Se ti rendessi conto di quanto sono potenti i tuoi pensieri, non avresti mai pi\c3\b9 un pensiero negativo.") ;; #0933 it
  (data (i32.const 446561) "Io sono il pi\c3\b9 grande. Lo dicevo ancora prima di sapere di esserlo.") ;; #0934 it
  (data (i32.const 446629) "Impossibile \c3\a8 solo una parola grossa usata da uomini piccoli.") ;; #0935 it
  (data (i32.const 446691) "\c3\88 la ripetizione delle affermazioni che porta a crederci.") ;; #0936 it
  (data (i32.const 446749) "Se la mia mente pu\c3\b2 concepirlo e il mio cuore pu\c3\b2 crederci, allora posso realizzarlo.") ;; #0937 it
  (data (i32.const 446836) "La fiducia \c3\a8 contagiosa. Anche la mancanza di fiducia.") ;; #0938 it
  (data (i32.const 446891) "Nutri la tua mente con grandi pensieri, perch\c3\a9 non andrai mai pi\c3\b9 in alto di quanto pensi.") ;; #0939 it
  (data (i32.const 446983) "Fai grandi pensieri, ma assapora i piccoli piaceri.") ;; #0940 it
  (data (i32.const 447034) "Difendi i tuoi limiti, e di sicuro saranno tuoi.") ;; #0941 it
  (data (i32.const 447082) "Il successo \c3\a8 piacere a s\c3\a9 stessi, amare ci\c3\b2 che si fa e amare il modo in cui lo si fa.") ;; #0942 it
  (data (i32.const 447172) "L'anima si tinge del colore dei suoi pensieri.") ;; #0943 it
  (data (i32.const 447218) "Il successo non \c3\a8 la chiave della felicit\c3\a0. La felicit\c3\a0 \c3\a8 la chiave del successo.") ;; #0944 it
  (data (i32.const 447303) "La pazienza \c3\a8 accettare con calma che le cose possano accadere in un ordine diverso da quello che avevi in mente.") ;; #0945 it
  (data (i32.const 447417) "La pazienza e la fortezza vincono ogni cosa.") ;; #0946 it
  (data (i32.const 447461) "Abbi pazienza. Tutte le cose sono difficili prima di diventare facili.") ;; #0947 it
  (data (i32.const 447531) "La pazienza \c3\a8 una virt\c3\b9 che conquista.") ;; #0948 it
  (data (i32.const 447571) "Tutto arriva a chi si d\c3\a0 da fare mentre aspetta.") ;; #0949 it
  (data (i32.const 447620) "Se ho fatto qualche scoperta di valore, lo devo pi\c3\b9 all'attenzione paziente che a qualsiasi altro talento.") ;; #0950 it
  (data (i32.const 447727) "La pazienza \c3\a8 necessaria, e non si pu\c3\b2 raccogliere subito dove si \c3\a8 seminato.") ;; #0951 it
  (data (i32.const 447807) "Con saggezza e lentamente; inciampa chi corre in fretta.") ;; #0952 it
  (data (i32.const 447863) "Servono anche coloro che si limitano a restare in piedi e attendere.") ;; #0953 it
  (data (i32.const 447931) "Solo il tempo pu\c3\b2 guarire ci\c3\b2 che la ragione non pu\c3\b2.") ;; #0954 it
  (data (i32.const 447987) "La determinazione ti d\c3\a0 la risolutezza per andare avanti nonostante gli ostacoli che ti si parano davanti.") ;; #0955 it
  (data (i32.const 448094) "Possono vincere coloro che credono di poterlo fare.") ;; #0956 it
  (data (i32.const 448145) "Non ci sono limiti. Ci sono altopiani, ma non devi restarci; devi andare oltre.") ;; #0957 it
  (data (i32.const 448224) "Un obiettivo non sempre \c3\a8 fatto per essere raggiunto; spesso serve semplicemente come qualcosa a cui mirare.") ;; #0958 it
  (data (i32.const 448333) "User\c3\b2 tutti i miei strumenti, il talento che Dio mi ha dato, e far\c3\b2 la vita migliore possibile.") ;; #0959 it
  (data (i32.const 448430) "I campioni non si fanno in palestra. Sono fatti di qualcosa che hanno nel profondo: un desiderio, un sogno, una visione.") ;; #0960 it
  (data (i32.const 448550) "La strada verso il successo \c3\a8 sempre in costruzione.") ;; #0961 it
  (data (i32.const 448603) "L'ambizione \c3\a8 entusiasmo con uno scopo.") ;; #0962 it
  (data (i32.const 448643) "I sogni sono illustrazioni del libro che la tua anima sta scrivendo su di te.") ;; #0963 it
  (data (i32.const 448720) "Non fare sogni piccoli, perch\c3\a9 non hanno il potere di muovere il cuore degli uomini.") ;; #0964 it
  (data (i32.const 448805) "Un uomo non \c3\a8 vecchio finch\c3\a9 i rimpianti non prendono il posto dei sogni.") ;; #0965 it
  (data (i32.const 448880) "Nei sogni comincia la responsabilit\c3\a0.") ;; #0966 it
  (data (i32.const 448918) "Cammina piano, perch\c3\a9 cammini sui miei sogni.") ;; #0967 it
  (data (i32.const 448964) "Tutto ci\c3\b2 che vediamo o sembriamo non \c3\a8 che un sogno dentro un sogno.") ;; #0968 it
  (data (i32.const 449035) "Non rinunciare ai tuoi sogni, o i tuoi sogni rinunceranno a te.") ;; #0969 it
  (data (i32.const 449098) "Non c'\c3\a8 niente come un sogno per creare il futuro.") ;; #0970 it
  (data (i32.const 449149) "Il potere dell'immaginazione ci rende infiniti.") ;; #0971 it
  (data (i32.const 449196) "Tu vedi le cose e ti chiedi: \22Perch\c3\a9?\22. Ma io sogno cose che non sono mai state e mi chiedo: \22Perch\c3\a9 no?\22.") ;; #0972 it
  (data (i32.const 449304) "Attacca il tuo carro a una stella.") ;; #0973 it
  (data (i32.const 449338) "Chi avanza con fiducia nella direzione dei propri sogni incontra un successo inaspettato nelle ore pi\c3\b9 comuni.") ;; #0974 it
  (data (i32.const 449449) "La nostra vita pi\c3\b9 vera \c3\a8 quando sogniamo a occhi aperti.") ;; #0975 it
  (data (i32.const 449508) "Va' fin dove riesci a vedere; quando arriverai l\c3\ac, potrai vedere pi\c3\b9 lontano.") ;; #0976 it
  (data (i32.const 449587) "Il modo migliore per realizzare i propri sogni \c3\a8 svegliarsi.") ;; #0977 it
  (data (i32.const 449648) "Chi guarda fuori sogna; chi guarda dentro si sveglia.") ;; #0978 it
  (data (i32.const 449701) "Non ti viene mai dato un desiderio senza che ti venga dato anche il potere di realizzarlo.") ;; #0979 it
  (data (i32.const 449791) "Una vita senza ricerca non \c3\a8 degna di essere vissuta.") ;; #0980 it
  (data (i32.const 449845) "L'unica vera saggezza \c3\a8 sapere di non sapere.") ;; #0981 it
  (data (i32.const 449891) "Sii gentile, perch\c3\a9 ogni persona che incontri sta combattendo una dura battaglia.") ;; #0982 it
  (data (i32.const 449973) "Nessun atto di gentilezza, per quanto piccolo, \c3\a8 mai sprecato.") ;; #0983 it
  (data (i32.const 450036) "Le cose migliori e pi\c3\b9 belle del mondo non si possono vedere n\c3\a9 toccare. Devono essere sentite con il cuore.") ;; #0984 it
  (data (i32.const 450146) "Ci\c3\b2 che abbiamo goduto una volta non possiamo mai perderlo. Tutto ci\c3\b2 che amiamo profondamente diventa parte di noi.") ;; #0985 it
  (data (i32.const 450264) "La felicit\c3\a0 non \c3\a8 un traguardo; \c3\a8 una conseguenza.") ;; #0986 it
  (data (i32.const 450317) "Lo scopo della vita \c3\a8 viverla, assaporare l'esperienza fino in fondo.") ;; #0987 it
  (data (i32.const 450387) "L'arte di essere saggi \c3\a8 l'arte di sapere cosa ignorare.") ;; #0988 it
  (data (i32.const 450444) "Chi impara ma non pensa \c3\a8 perduto. Chi pensa ma non impara \c3\a8 in grave pericolo.") ;; #0989 it
  (data (i32.const 450525) "La miglior vendetta \c3\a8 non somigliare al tuo nemico.") ;; #0990 it
  (data (i32.const 450577) "La perdita non \c3\a8 altro che cambiamento, e il cambiamento \c3\a8 la delizia della Natura.") ;; #0991 it
  (data (i32.const 450662) "Soffermati sulla bellezza della vita. Guarda le stelle e immagina di correre con loro.") ;; #0992 it
  (data (i32.const 450748) "Quando ti alzi al mattino, pensa al prezioso privilegio di essere vivo.") ;; #0993 it
  (data (i32.const 450819) "Non \c3\a8 che abbiamo poco tempo da vivere, ma che ne sprechiamo molto.") ;; #0994 it
  (data (i32.const 450887) "Mentre aspettiamo di vivere, la vita passa.") ;; #0995 it
  (data (i32.const 450930) "Ovunque ci sia un essere umano, c'\c3\a8 un'occasione per fare del bene.") ;; #0996 it
  (data (i32.const 450998) "Soffre pi\c3\b9 del necessario chi soffre prima che sia necessario.") ;; #0997 it
  (data (i32.const 451061) "L'ignoranza \c3\a8 la causa della paura.") ;; #0998 it
  (data (i32.const 451097) "Vivere \c3\a8 la cosa pi\c3\b9 rara al mondo. La maggior parte della gente esiste, nient'altro.") ;; #0999 it
  (data (i32.const 451184) "Scusami per averti fatto soffrire. Ti amo.") ;; #1000 it dedication

  ;; =================================================== dedications ==
  ;;  Messages pinned to one exact date. They override the rotation on
  ;;  that day only and are never part of the schedule below.
  (data (i32.const 451232)
    "\25\51\00\00\e8\03\00\00" ;; 2026-11-16 -> #1000
  )

