;; ============================================================================
;;
;;   quotes.wat :: a quote-of-the-day engine, hand-written in WebAssembly Text
;;
;; ============================================================================
;;
;;   This file is GENERATED by `python -m tools.qotd wat`. Edit the fragments
;;   in src/wat/ or the seeds in database/ instead, then rebuild.
;;
;;   The module has no imports. Everything the page needs (calendar math, the
;;   pseudo-random schedule, and every quote with its author) lives in its
;;   linear memory and is reached through a handful of exports:
;;
;;     quote_for_date(y, m, d) -> i32     index of the quote for a civil date
;;     quote_text_ptr/len(i)   -> i32     UTF-8 (ASCII) bytes of the quote
;;     quote_author_ptr/len(i) -> i32     UTF-8 (ASCII) bytes of the author
;;
;;   The embedded schedule covers one full Gregorian cycle (146097 days,
;;   2000-01-01 .. 2399-12-31). Outside it, the same schedule is recomputed
;;   on the fly with PCG32 and a Fisher-Yates shuffle.
;;
(module

;; ------------------------------------------------------------ build --
;;  generator     qotd 1.0.0
;;  quotes        1000
;;  authors       498
;;  themes        15
;;  dedications   1
;;  locales       en, pt-BR, es, fr, it
;;  calendar      day 1 2026-11-16, 764 legacy quotes; new quotes
;;                from day 765, full rotation from day 1001
;;  pool          370938 bytes, 5687 strings, fnv1a 0x97e38454
;;  schedule      146097 days from 2000-01-01, seed 0x853c49e6748fea9b
;;  sequence      0xda3e39cb94b95bdb
;;  memory        747440 bytes in 12 pages

  (memory (export "memory") 12)

  ;; ========================================================= state ==
  ;;  Mirrors of the header fields, loaded once by $init.

  (global $MAGIC  i32 (i32.const 0x44544F51)) ;; "QOTD"
  (global $FORMAT i32 (i32.const 4))

  (global $ready          (mut i32) (i32.const 0))
  (global $quote_count    (mut i32) (i32.const 0))
  (global $author_count   (mut i32) (i32.const 0))
  (global $records        (mut i32) (i32.const 0))
  (global $pool           (mut i32) (i32.const 0))
  (global $pool_len       (mut i32) (i32.const 0))
  (global $schedule       (mut i32) (i32.const 0))
  (global $schedule_base  (mut i32) (i32.const 0))
  (global $schedule_len   (mut i32) (i32.const 0))
  (global $scratch        (mut i32) (i32.const 0))
  (global $pool_fnv1a     (mut i32) (i32.const 0))
  (global $dedication_count (mut i32) (i32.const 0))
  (global $dedications    (mut i32) (i32.const 0))
  (global $record_count   (mut i32) (i32.const 0)) ;; quotes + dedications

  ;;  Calendar growth (see 50-schedule.wat): launch day, quotes at launch, and
  ;;  the first days of the fresh run and of the full rotation
  (global $launch       (mut i32) (i32.const 0))
  (global $legacy       (mut i32) (i32.const 0))
  (global $grown        (mut i32) (i32.const 0))
  (global $fresh_start  (mut i32) (i32.const 0))
  (global $cycle_start  (mut i32) (i32.const 0))
  (global $FRESH_BLOCK  i32 (i32.const 0x40000000))

  ;;  Locales: K blocks of records, one per language (see 60-strings.wat)
  (global $locale_count (mut i32) (i32.const 0))
  (global $locales      (mut i32) (i32.const 0))

  ;;  PCG32 generator state (see 30-pcg32.wat)
  (global $pcg_state (mut i64) (i64.const 0))
  (global $pcg_inc   (mut i64) (i64.const 0))
  (global $PCG_MULTIPLIER i64 (i64.const 6364136223846793005))

  ;;  Schedule parameters, shared with tools/qotd/schedule.py
  (global $SCHEDULE_SEED     i64 (i64.const 0x853c49e6748fea9b))
  (global $SCHEDULE_SEQUENCE i64 (i64.const 0xda3e39cb94b95bdb))

  ;;  Which raw permutation currently sits in scratch memory
  (global $cached_block (mut i32) (i32.const 0))
  (global $cached_valid (mut i32) (i32.const 0))
  (global $cached_n     (mut i32) (i32.const 0))

  ;; ========================================================= civil ==
  ;;  Proleptic Gregorian calendar, after Howard Hinnant's algorithms.
  ;;  Day 0 is 1970-01-01. Mirrors tools/qotd/civil.py.

  ;; days_from_civil(y, m, d) -> days since 1970-01-01
  (func $days_from_civil (export "days_from_civil")
    (param $y i32) (param $m i32) (param $d i32) (result i32)
    (local $era i32) (local $yoe i32) (local $mp i32) (local $doy i32) (local $doe i32)
    ;; y -= m <= 2
    (local.set $y (i32.sub (local.get $y) (i32.le_s (local.get $m) (i32.const 2))))
    ;; era = (y >= 0 ? y : y - 399) / 400
    (local.set $era
      (i32.div_s
        (select (local.get $y)
                (i32.sub (local.get $y) (i32.const 399))
                (i32.ge_s (local.get $y) (i32.const 0)))
        (i32.const 400)))
    ;; yoe = y - era * 400                                   [0, 399]
    (local.set $yoe (i32.sub (local.get $y) (i32.mul (local.get $era) (i32.const 400))))
    ;; mp = m > 2 ? m - 3 : m + 9                            [0, 11], March = 0
    (local.set $mp
      (select (i32.sub (local.get $m) (i32.const 3))
              (i32.add (local.get $m) (i32.const 9))
              (i32.gt_s (local.get $m) (i32.const 2))))
    ;; doy = (153 * mp + 2) / 5 + d - 1                      [0, 365]
    (local.set $doy
      (i32.add
        (i32.div_s (i32.add (i32.mul (i32.const 153) (local.get $mp)) (i32.const 2))
                   (i32.const 5))
        (i32.sub (local.get $d) (i32.const 1))))
    ;; doe = yoe * 365 + yoe / 4 - yoe / 100 + doy           [0, 146096]
    (local.set $doe
      (i32.add
        (i32.sub
          (i32.add (i32.mul (local.get $yoe) (i32.const 365))
                   (i32.div_s (local.get $yoe) (i32.const 4)))
          (i32.div_s (local.get $yoe) (i32.const 100)))
        (local.get $doy)))
    ;; era * 146097 + doe - 719468
    (i32.sub
      (i32.add (i32.mul (local.get $era) (i32.const 146097)) (local.get $doe))
      (i32.const 719468)))

  ;; civil_from_days(z) -> y * 10000 + m * 100 + d   (for years 0..214748)
  (func $civil_from_days (export "civil_from_days") (param $z i32) (result i32)
    (local $era i32) (local $doe i32) (local $yoe i32) (local $y i32)
    (local $doy i32) (local $mp i32) (local $d i32) (local $m i32)
    (local.set $z (i32.add (local.get $z) (i32.const 719468)))
    (local.set $era
      (i32.div_s
        (select (local.get $z)
                (i32.sub (local.get $z) (i32.const 146096))
                (i32.ge_s (local.get $z) (i32.const 0)))
        (i32.const 146097)))
    (local.set $doe (i32.sub (local.get $z) (i32.mul (local.get $era) (i32.const 146097))))
    ;; yoe = (doe - doe/1460 + doe/36524 - doe/146096) / 365
    (local.set $yoe
      (i32.div_s
        (i32.sub
          (i32.add
            (i32.sub (local.get $doe) (i32.div_s (local.get $doe) (i32.const 1460)))
            (i32.div_s (local.get $doe) (i32.const 36524)))
          (i32.div_s (local.get $doe) (i32.const 146096)))
        (i32.const 365)))
    (local.set $y (i32.add (local.get $yoe) (i32.mul (local.get $era) (i32.const 400))))
    ;; doy = doe - (365 * yoe + yoe/4 - yoe/100)
    (local.set $doy
      (i32.sub (local.get $doe)
        (i32.sub
          (i32.add (i32.mul (i32.const 365) (local.get $yoe))
                   (i32.div_s (local.get $yoe) (i32.const 4)))
          (i32.div_s (local.get $yoe) (i32.const 100)))))
    (local.set $mp
      (i32.div_s (i32.add (i32.mul (i32.const 5) (local.get $doy)) (i32.const 2))
                 (i32.const 153)))
    (local.set $d
      (i32.add
        (i32.sub (local.get $doy)
                 (i32.div_s (i32.add (i32.mul (i32.const 153) (local.get $mp)) (i32.const 2))
                            (i32.const 5)))
        (i32.const 1)))
    (local.set $m
      (select (i32.add (local.get $mp) (i32.const 3))
              (i32.sub (local.get $mp) (i32.const 9))
              (i32.lt_s (local.get $mp) (i32.const 10))))
    (local.set $y (i32.add (local.get $y) (i32.le_s (local.get $m) (i32.const 2))))
    (i32.add
      (i32.add (i32.mul (local.get $y) (i32.const 10000))
               (i32.mul (local.get $m) (i32.const 100)))
      (local.get $d)))

  ;; is_leap_year(y) -> 0 | 1
  (func $is_leap_year (export "is_leap_year") (param $y i32) (result i32)
    (i32.and
      (i32.eqz (i32.rem_s (local.get $y) (i32.const 4)))
      (i32.or
        (i32.ne (i32.rem_s (local.get $y) (i32.const 100)) (i32.const 0))
        (i32.eqz (i32.rem_s (local.get $y) (i32.const 400))))))

  ;; days_in_month(y, m) -> 28..31, or 0 for an invalid month
  (func $days_in_month (export "days_in_month") (param $y i32) (param $m i32) (result i32)
    (if (i32.gt_u (i32.sub (local.get $m) (i32.const 1)) (i32.const 11))
      (then (return (i32.const 0))))
    (if (i32.eq (local.get $m) (i32.const 2))
      (then (return (i32.add (i32.const 28) (call $is_leap_year (local.get $y))))))
    ;; 30 days hath September, April, June and November
    (select (i32.const 30) (i32.const 31)
      (i32.or
        (i32.or (i32.eq (local.get $m) (i32.const 4)) (i32.eq (local.get $m) (i32.const 6)))
        (i32.or (i32.eq (local.get $m) (i32.const 9)) (i32.eq (local.get $m) (i32.const 11))))))

  ;; is_valid_date(y, m, d) -> 0 | 1
  (func $is_valid_date (export "is_valid_date")
    (param $y i32) (param $m i32) (param $d i32) (result i32)
    (i32.and
      (i32.ge_s (local.get $d) (i32.const 1))
      (i32.le_s (local.get $d) (call $days_in_month (local.get $y) (local.get $m)))))

  ;; weekday(z) -> 0 (Sunday) .. 6 (Saturday)
  (func $weekday (export "weekday") (param $z i32) (result i32)
    (if (result i32) (i32.ge_s (local.get $z) (i32.const -4))
      (then (i32.rem_s (i32.add (local.get $z) (i32.const 4)) (i32.const 7)))
      (else (i32.add (i32.rem_s (i32.add (local.get $z) (i32.const 5)) (i32.const 7))
                     (i32.const 6)))))

  ;; ========================================================= pcg32 ==
  ;;  PCG-XSH-RR with 64-bit state and 32-bit output (O'Neill, 2014).
  ;;  Mirrors tools/qotd/pcg32.py bit for bit.

  ;; pcg32_next() -> u32
  (func $pcg_next (export "pcg32_next") (result i32)
    (local $old i64) (local $xorshifted i32) (local $rot i32)
    (local.set $old (global.get $pcg_state))
    ;; advance the LCG: state = old * MULTIPLIER + inc  (mod 2^64)
    (global.set $pcg_state
      (i64.add (i64.mul (local.get $old) (global.get $PCG_MULTIPLIER))
               (global.get $pcg_inc)))
    ;; xorshifted = ((old >> 18) ^ old) >> 27, truncated to 32 bits
    (local.set $xorshifted
      (i32.wrap_i64
        (i64.shr_u
          (i64.xor (i64.shr_u (local.get $old) (i64.const 18)) (local.get $old))
          (i64.const 27))))
    ;; rot = old >> 59
    (local.set $rot (i32.wrap_i64 (i64.shr_u (local.get $old) (i64.const 59))))
    (i32.rotr (local.get $xorshifted) (local.get $rot)))

  ;; pcg32_seed(initstate, initseq)
  (func $pcg_seed (export "pcg32_seed") (param $initstate i64) (param $initseq i64)
    (global.set $pcg_state (i64.const 0))
    (global.set $pcg_inc
      (i64.or (i64.shl (local.get $initseq) (i64.const 1)) (i64.const 1)))
    (drop (call $pcg_next))
    (global.set $pcg_state (i64.add (global.get $pcg_state) (local.get $initstate)))
    (drop (call $pcg_next)))

  ;; pcg32_bounded(bound) -> [0, bound), multiply-shift reduction
  (func $pcg_bounded (export "pcg32_bounded") (param $bound i32) (result i32)
    (i32.wrap_i64
      (i64.shr_u
        (i64.mul (i64.extend_i32_u (call $pcg_next))
                 (i64.extend_i32_u (local.get $bound)))
        (i64.const 32))))

  ;; ======================================================= shuffle ==
  ;;  Materialise the raw permutation of n items for a block into scratch
  ;;  memory. Mirrors raw_permutation(block, n) in tools/qotd/schedule.py.

  (func $scratch_slot (param $i i32) (result i32)
    (i32.add (global.get $scratch) (i32.shl (local.get $i) (i32.const 2))))

  (func $perm_at (param $i i32) (result i32)
    (i32.load (call $scratch_slot (local.get $i))))

  (func $permute (param $block i32) (param $n i32)
    (local $i i32) (local $j i32)
    (local $pi i32) (local $pj i32) (local $tmp i32)
    ;; already there? permutations are pure functions of (block, n)
    (if (i32.and (global.get $cached_valid)
                 (i32.and (i32.eq (global.get $cached_block) (local.get $block))
                          (i32.eq (global.get $cached_n) (local.get $n))))
      (then (return)))
    (call $pcg_seed
      (i64.xor (global.get $SCHEDULE_SEED) (i64.extend_i32_s (local.get $block)))
      (global.get $SCHEDULE_SEQUENCE))
    ;; identity: scratch[i] = i
    (local.set $i (i32.const 0))
    (block $filled
      (loop $fill
        (br_if $filled (i32.ge_u (local.get $i) (local.get $n)))
        (i32.store (call $scratch_slot (local.get $i)) (local.get $i))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $fill)))
    ;; Fisher-Yates, top down: swap(i, bounded(i + 1)) for i = n-1 .. 1
    (local.set $i (i32.sub (local.get $n) (i32.const 1)))
    (block $shuffled
      (loop $swap
        (br_if $shuffled (i32.le_s (local.get $i) (i32.const 0)))
        (local.set $j (call $pcg_bounded (i32.add (local.get $i) (i32.const 1))))
        (local.set $pi (call $scratch_slot (local.get $i)))
        (local.set $pj (call $scratch_slot (local.get $j)))
        (local.set $tmp (i32.load (local.get $pi)))
        (i32.store (local.get $pi) (i32.load (local.get $pj)))
        (i32.store (local.get $pj) (local.get $tmp))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br $swap)))
    (global.set $cached_block (local.get $block))
    (global.set $cached_n (local.get $n))
    (global.set $cached_valid (i32.const 1)))

  ;; ====================================================== schedule ==
  ;;  Which quote is shown on which day. Mirrors tools/qotd/schedule.py.

  ;; floor(a / b) for b > 0
  (func $floor_div (param $a i32) (param $b i32) (result i32)
    (local $q i32)
    (local.set $q (i32.div_s (local.get $a) (local.get $b)))
    (if (i32.lt_s (i32.rem_s (local.get $a) (local.get $b)) (i32.const 0))
      (then (local.set $q (i32.sub (local.get $q) (i32.const 1)))))
    (local.get $q))

;; block_entry(block, n, pos, prev) -> the quote on day `pos` of a block
  ;;  of n quotes. Only its first two days can be touched by the seam rule;
  ;;  `prev` is the quote shown the day before the block, or -1 to take it
  ;;  from the end of the previous block of the same rotation.
  (func $block_entry (param $block i32) (param $n i32) (param $pos i32) (param $prev i32)
    (result i32)
    (local $first i32) (local $second i32)
    (call $permute (local.get $block) (local.get $n))
    (if (i32.gt_u (local.get $pos) (i32.const 1))
      (then (return (call $perm_at (local.get $pos)))))
    (local.set $first (call $perm_at (i32.const 0)))
    (local.set $second (call $perm_at (i32.const 1)))
    (if (i32.lt_s (local.get $prev) (i32.const 0))
      (then
        (call $permute (i32.sub (local.get $block) (i32.const 1)) (local.get $n))
        (local.set $prev (call $perm_at (i32.sub (local.get $n) (i32.const 1))))))
    ;; seam rule: never open a block with the quote that closed the last one
    (if (i32.eq (local.get $first) (local.get $prev))
      (then
        (local.set $first (local.get $second))
        (local.set $second (local.get $prev))))
    (select (local.get $first) (local.get $second) (i32.eqz (local.get $pos))))

  ;; rotation(rel, n) -> the plain rotation of n quotes, rel days after its start
  (func $rotation (param $rel i32) (param $n i32) (result i32)
    (local $block i32)
    (local.set $block (call $floor_div (local.get $rel) (local.get $n)))
    (call $block_entry (local.get $block) (local.get $n)
      (i32.sub (local.get $rel) (i32.mul (local.get $block) (local.get $n)))
      (i32.const -1)))

  ;; fresh_at(i) -> the i-th quote of the one-off shuffle of quotes added after launch
  (func $fresh_at (param $i i32) (result i32)
    (call $permute (global.get $FRESH_BLOCK)
                   (i32.sub (global.get $quote_count) (global.get $legacy)))
    (i32.add (global.get $legacy) (call $perm_at (local.get $i))))

  ;; quote_for_day_computed(day) -> index, ignoring the embedded table.
  ;;  Phase 1, before launch + L: the original L-quote rotation, untouched.
  ;;  Phase 2, the next N - L days: the newly added quotes, shuffled once.
  ;;  Phase 3, after that: the rotation of all N, seamed onto phase 2.
  (func $quote_for_day_computed (export "quote_for_day_computed")
    (param $day i32) (result i32)
    (local $n i32) (local $rel i32) (local $block i32) (local $prev i32)
    (call $assert_ready)
    (local.set $n (global.get $quote_count))
    (if (i32.eqz (global.get $grown))
      (then (return (call $rotation
        (i32.sub (local.get $day) (global.get $schedule_base)) (local.get $n)))))
    (if (i32.lt_s (local.get $day) (global.get $fresh_start))
      (then (return (call $rotation
        (i32.sub (local.get $day) (global.get $schedule_base)) (global.get $legacy)))))
    (if (i32.lt_s (local.get $day) (global.get $cycle_start))
      (then (return (call $fresh_at (i32.sub (local.get $day) (global.get $fresh_start))))))
    (local.set $rel (i32.sub (local.get $day) (global.get $cycle_start)))
    (local.set $block (call $floor_div (local.get $rel) (local.get $n)))
    ;; the first full block follows the last quote of the fresh run
    (local.set $prev (i32.const -1))
    (if (i32.eqz (local.get $block))
      (then (local.set $prev (call $fresh_at
        (i32.sub (i32.sub (local.get $n) (global.get $legacy)) (i32.const 1))))))
    (call $block_entry (local.get $block) (local.get $n)
      (i32.sub (local.get $rel) (i32.mul (local.get $block) (local.get $n)))
      (local.get $prev)))

  ;; quote_for_day(day) -> index, using the embedded table when possible
  (func $quote_for_day (export "quote_for_day") (param $day i32) (result i32)
    (local $rel i32)
    (call $assert_ready)
    (local.set $rel (i32.sub (local.get $day) (global.get $schedule_base)))
    ;; unsigned compare folds "rel < 0" into "rel >= len"
    (if (result i32) (i32.lt_u (local.get $rel) (global.get $schedule_len))
      (then
        (i32.load16_u
          (i32.add (global.get $schedule) (i32.shl (local.get $rel) (i32.const 1)))))
      (else (call $quote_for_day_computed (local.get $day)))))

  ;; launch_day() -> days since 1970-01-01 of DAY 1 (from the calendar table)
  (func $launch_day (export "launch_day") (result i32)
    (global.get $launch))

  ;; legacy_count() -> how many quotes the site launched with
  (func (export "legacy_count") (result i32) (global.get $legacy))

  ;; day_number(y, m, d) -> 1 on launch day, 2 the day after, ...
  (func $day_number (export "day_number")
    (param $y i32) (param $m i32) (param $d i32) (result i32)
    (i32.add
      (i32.sub (call $days_from_civil (local.get $y) (local.get $m) (local.get $d))
               (call $launch_day))
      (i32.const 1)))

  ;; dedication_for_day(day) -> record index of a dedication, or -1
  ;;  The table is tiny and sorted by day, so a linear scan that stops early
  ;;  beats anything cleverer.
  (func $dedication_for_day (export "dedication_for_day") (param $day i32) (result i32)
    (local $i i32) (local $entry i32) (local $entry_day i32)
    (call $assert_ready)
    (block $none
      (loop $scan
        (br_if $none (i32.ge_u (local.get $i) (global.get $dedication_count)))
        (local.set $entry (i32.add (global.get $dedications) (i32.shl (local.get $i) (i32.const 3))))
        (local.set $entry_day (i32.load (local.get $entry)))
        (if (i32.eq (local.get $entry_day) (local.get $day))
          (then (return (i32.load offset=4 (local.get $entry)))))
        (br_if $none (i32.gt_s (local.get $entry_day) (local.get $day)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $scan)))
    (i32.const -1))

  ;; entry_for_day(day) -> what the page shows that day: a dedication if one
  ;;  is pinned to it, otherwise the scheduled quote.
  (func $entry_for_day (export "entry_for_day") (param $day i32) (result i32)
    (local $pinned i32)
    (local.set $pinned (call $dedication_for_day (local.get $day)))
    (if (result i32) (i32.ge_s (local.get $pinned) (i32.const 0))
      (then (local.get $pinned))
      (else (call $quote_for_day (local.get $day)))))

  ;; quote_for_date(y, m, d) -> record index for that date, or -1 if invalid
  (func $quote_for_date (export "quote_for_date")
    (param $y i32) (param $m i32) (param $d i32) (result i32)
    (if (i32.eqz (call $is_valid_date (local.get $y) (local.get $m) (local.get $d)))
      (then (return (i32.const -1))))
    (call $entry_for_day
      (call $days_from_civil (local.get $y) (local.get $m) (local.get $d))))

  ;; ======================================================= strings ==
  ;;  Accessors over the record table and the string pool. Records come in
  ;;  one block per locale; locale 0 is the English source.

  ;; record_l(i, k) -> address of record i in locale k (traps when out of range)
  (func $record_l (param $i i32) (param $k i32) (result i32)
    (call $assert_ready)
    (if (i32.ge_u (local.get $i) (global.get $record_count)) (then (unreachable)))
    (if (i32.ge_u (local.get $k) (global.get $locale_count)) (then (unreachable)))
    (i32.add (global.get $records)
      (i32.shl
        (i32.add (i32.mul (local.get $k) (global.get $record_count)) (local.get $i))
        (i32.const 4))))

  (func $record (param $i i32) (result i32)
    (call $record_l (local.get $i) (i32.const 0)))

  (func (export "localized_text_ptr") (param $i i32) (param $k i32) (result i32)
    (i32.load offset=0 (call $record_l (local.get $i) (local.get $k))))

  (func (export "localized_text_len") (param $i i32) (param $k i32) (result i32)
    (i32.load offset=4 (call $record_l (local.get $i) (local.get $k))))

  (func (export "localized_author_ptr") (param $i i32) (param $k i32) (result i32)
    (i32.load offset=8 (call $record_l (local.get $i) (local.get $k))))

  (func (export "localized_author_len") (param $i i32) (param $k i32) (result i32)
    (i32.load offset=12 (call $record_l (local.get $i) (local.get $k))))

