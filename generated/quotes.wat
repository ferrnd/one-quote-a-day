          (i32.shl (memory.size) (i32.const 16)))
      (then (unreachable)))
    (if (i32.ne (call $fnv1a (global.get $pool) (global.get $pool_len))
                (global.get $pool_fnv1a))
      (then (unreachable)))
    (global.set $cached_valid (i32.const 0))
    (global.set $ready (i32.const 1)))

  (start $init)

